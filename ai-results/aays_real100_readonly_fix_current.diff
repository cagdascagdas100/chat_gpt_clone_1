@@ -0,0 +1,592 @@
+from __future__ import annotations
+
+import csv
+import datetime as dt
+import json
+from pathlib import Path
+from typing import Iterable
+
+from sqlalchemy import text
+from sqlalchemy.orm import Session
+
+from app.core.config import get_settings
+from app.core.db_resolver import resolve_database_url_info
+from app.schemas.ops import (
+    ConsistencyPathCheckItem,
+    HandoffCheckItem,
+    RuntimeConsistencyCheckResponse,
+    RuntimeStorageRegistryResponse,
+    SecurityTopographyHandoffReadinessResponse,
+)
+from app.services.cost_engine_service import get_cost50_integration_status
+
+
+BACKEND_ROOT = Path(__file__).resolve().parents[2]
+REPO_ROOT = Path(__file__).resolve().parents[3]
+REGISTRY_PATH = BACKEND_ROOT / "config" / "runtime-storage-registry.json"
+CLEAN2_BRIDGE_ROOT = Path("C:/AAYS_GITHUB_BRIDGE_CLEAN2")
+CLEAN_BRIDGE_ROOT = Path("C:/AAYS_GITHUB_BRIDGE_CLEAN")
+FRONTEND_ROOT = REPO_ROOT / "england_map_web"
+DEFAULT_ESTATE_ROOT = Path(r"E:\AAYS_DATA\estate_agents")
+
+
+def _now_utc() -> dt.datetime:
+    return dt.datetime.now(dt.UTC)
+
+
+def _safe_read_json(path: Path) -> dict:
+    if not path.exists() or not path.is_file():
+        return {}
+    for encoding in ("utf-8", "utf-8-sig", "utf-16", "utf-16-le", "cp1254", "cp1252"):
+        try:
+            raw = json.loads(path.read_text(encoding=encoding))
+        except Exception:
+            continue
+        if isinstance(raw, dict):
+            return raw
+    return {}
+
+
+def _read_csv_row_count(path: Path) -> int | None:
+    if not path.exists() or not path.is_file():
+        return None
+    try:
+        with path.open("r", encoding="utf-8-sig", newline="") as fh:
+            return sum(1 for _ in csv.DictReader(fh))
+    except Exception:
+        return None
+
+
+def _api_base_url_default() -> str:
+    config_path = REPO_ROOT / "england_map_web" / "config" / "regions.local.json"
+    payload = _safe_read_json(config_path)
+    value = str(payload.get("landIntelligenceApiBaseUrl") or "").strip()
+    return value or "same-origin"
+
+
+def _registry_value(payload: dict, key: str, default: str) -> str:
+    value = payload.get(key)
+    if value is None:
+        return default
+    text_value = str(value).strip()
+    return text_value or default
+
+
+def _registry_path(payload: dict, key: str) -> Path | None:
+    value = payload.get(key)
+    if value is None:
+        return None
+    text_value = str(value).strip()
+    if not text_value:
+        return None
+    return Path(text_value).expanduser()
+
+
+def _pick_existing_path(candidates: Iterable[Path]) -> Path | None:
+    materialized = [p for p in candidates if p is not None]
+    if not materialized:
+        return None
+    for candidate in materialized:
+        if candidate.exists():
+            return candidate
+    return materialized[0]
+
+
+def _resolve_bridge_root(settings, payload: dict) -> tuple[Path, list[str]]:
+    bridge_root_override = getattr(settings, "bridge_root_override", None)
+    env_override = bridge_root_override.expanduser() if bridge_root_override else None
+    registry_value = _registry_path(payload, "canonical_bridge_root")
+    settings_default = settings.cost50_bridge_root.expanduser()
+
+    ordered_candidates: list[tuple[str, Path | None]] = [
+        ("ENV_OVERRIDE", env_override),
+        ("REGISTRY", registry_value),
+        ("SETTINGS_DEFAULT", settings_default),
+        ("CLEAN2", CLEAN2_BRIDGE_ROOT),
+        ("CLEAN", CLEAN_BRIDGE_ROOT),
+    ]
+    bridge_resolution_order = [f"{label}:{path}" for label, path in ordered_candidates if path is not None]
+    selected = _pick_existing_path([path for _, path in ordered_candidates if path is not None]) or settings_default
+    return selected, bridge_resolution_order
+
+
+def _path_check(key: str, path_value: str) -> ConsistencyPathCheckItem:
+    path = Path(path_value).expanduser()
+    exists = path.exists()
+    return ConsistencyPathCheckItem(
+        key=key,
+        path=str(path),
+        exists=exists,
+        is_dir=path.is_dir() if exists else None,
+        is_file=path.is_file() if exists else None,
+    )
+
+
+def _missing_path_check(key: str) -> ConsistencyPathCheckItem:
+    return ConsistencyPathCheckItem(
+        key=key,
+        path="",
+        exists=False,
+        is_dir=None,
+        is_file=None,
+    )
+
+
+def get_runtime_storage_registry() -> RuntimeStorageRegistryResponse:
+    settings = get_settings()
+    payload = _safe_read_json(REGISTRY_PATH)
+    loaded = bool(payload)
+    notes: list[str] = []
+    if not REGISTRY_PATH.exists():
+        notes.append("runtime-storage-registry.json bulunamadi; settings fallback kullanildi.")
+    elif not loaded:
+        notes.append("runtime-storage-registry.json okunamadi; settings fallback kullanildi.")
+
+    canonical_bridge_root, bridge_resolution_order = _resolve_bridge_root(settings, payload)
+    runner_results_candidates = [
+        _registry_path(payload, "runner_results_dir"),
+        canonical_bridge_root / "ai-results",
+        canonical_bridge_root / "ai_results",
+        settings.cost50_runner_results_dir.expanduser(),
+    ]
+    runner_results_dir = _pick_existing_path([path for path in runner_results_candidates if path is not None])
+    if runner_results_dir is None:
+        runner_results_dir = settings.cost50_runner_results_dir.expanduser()
+    if not canonical_bridge_root.exists():
+        notes.append(f"canonical_bridge_root bulunamadi: {canonical_bridge_root}")
+
+    return RuntimeStorageRegistryResponse(
+        generated_at=_now_utc(),
+        registry_path=str(REGISTRY_PATH),
+        registry_loaded=loaded,
+        db_profile=_registry_value(payload, "db_profile", "primary"),
+        canonical_bridge_root=str(canonical_bridge_root),
+        bridge_resolution_order=bridge_resolution_order,
+        runner_results_dir=str(runner_results_dir),
+        quality_reports_dir=_registry_value(payload, "quality_reports_dir", str(settings.cost50_quality_reports_dir)),
+        handoff_ready_dir=_registry_value(payload, "handoff_ready_dir", str(settings.cost50_handoff_ready_dir)),
+        audit_outputs_dir=_registry_value(payload, "audit_outputs_dir", str(settings.cost50_audit_outputs_dir)),
+        contractor_preflight_path=_registry_value(
+            payload,
+            "contractor_preflight_path",
+            str(settings.contractor_preflight_audit_path),
+        ),
+        api_base_url=_registry_value(payload, "api_base_url", _api_base_url_default()),
+        notes=notes,
+    )
+
+
+def get_runtime_consistency_check(db: Session, *, refresh: bool = False) -> RuntimeConsistencyCheckResponse:
+    settings = get_settings()
+    registry = get_runtime_storage_registry()
+    resolved = resolve_database_url_info(require=False)
+    warnings: list[str] = []
+
+    db_connectivity = "ok"
+    try:
+        db.execute(text("SELECT 1"))
+    except Exception as exc:
+        db_connectivity = "degraded"
+        warnings.append(f"DB connectivity check failed: {exc}")
+
+    status = get_cost50_integration_status(refresh=refresh)
+    runner_artifact_coverage = {
+        "heartbeat_status_present": bool(status.runner_heartbeat.status),
+        "current_task_present": bool(status.current_task.task_id),
+        "final_lock_markers_present": bool(
+            status.final_lock.final_lock is True
+            and status.final_lock.handoff_complete is True
+            and status.final_lock.no_new_tasks is True
+        ),
+        "final_accuracy_markers_present": bool(
+            status.final_lock.final_accuracy_validation_done is True
+            and status.accuracy.source_accuracy.current is not None
+            and status.accuracy.parcel_match_accuracy.current is not None
+        ),
+    }
+
+    path_checks = [
+        _path_check("canonical_bridge_root", registry.canonical_bridge_root),
+        _path_check("runner_results_dir", registry.runner_results_dir),
+        _path_check("quality_reports_dir", registry.quality_reports_dir),
+        _path_check("handoff_ready_dir", registry.handoff_ready_dir),
+        _path_check("audit_outputs_dir", registry.audit_outputs_dir),
+        _path_check("contractor_preflight_path", registry.contractor_preflight_path),
+    ]
+    dem_path = settings.dem_copernicus_root.expanduser()
+    dem_exists = dem_path.exists() and dem_path.is_dir()
+    dem_blocker = None
+    path_checks.append(_path_check("dem_copernicus_root", str(dem_path)))
+    if not dem_exists:
+        dem_blocker = "BLOCKED_BY_DEM_PATH_MISSING"
+        warnings.append(f"{dem_blocker}: {dem_path}")
+
+    for row in path_checks:
+        if not row.exists:
+            warnings.append(f"Path missing: {row.key}")
+
+    if resolved is None:
+        warnings.append("Canonical DB URL bulunamadi (TYLI_DATABASE_URL -> DATABASE_URL).")
+
+    return RuntimeConsistencyCheckResponse(
+        generated_at=_now_utc(),
+        db_profile=registry.db_profile or "primary",
+        database_url_present=resolved is not None,
+        database_url_source=resolved.source if resolved else None,
+        db_connectivity=db_connectivity,
+        runner_artifact_coverage=runner_artifact_coverage,
+        path_checks=path_checks,
+        dem_source_path=str(dem_path),
+        dem_source_exists=dem_exists,
+        dem_blocker=dem_blocker,
+        warnings=warnings,
+    )
+
+
+def _as_bool(payload: dict, key: str) -> bool | None:
+    if not isinstance(payload, dict):
+        return None
+    value = payload.get(key)
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)):
+        return bool(value)
+    if value is None:
+        return None
+    text_value = str(value).strip().lower()
+    if text_value in {"true", "1", "yes", "y"}:
+        return True
+    if text_value in {"false", "0", "no", "n"}:
+        return False
+    return None
+
+
+def _as_int(payload: dict, key: str) -> int | None:
+    if not isinstance(payload, dict):
+        return None
+    value = payload.get(key)
+    if value is None:
+        return None
+    try:
+        return int(value)
+    except Exception:
+        return None
+
+
+def _as_str(payload: dict, key: str) -> str | None:
+    if not isinstance(payload, dict):
+        return None
+    value = payload.get(key)
+    if value is None:
+        return None
+    text_value = str(value).strip()
+    return text_value or None
+
+
+def _pick_first_existing_file(bridge_roots: list[Path], relative_path: str) -> Path | None:
+    for root in bridge_roots:
+        candidate = root / relative_path
+        if candidate.exists() and candidate.is_file():
+            return candidate
+    if bridge_roots:
+        return bridge_roots[0] / relative_path
+    return None
+
+
+def _unique_paths(paths: Iterable[Path]) -> list[Path]:
+    output: list[Path] = []
+    seen: set[str] = set()
+    for path in paths:
+        normalized = str(path)
+        if normalized in seen:
+            continue
+        seen.add(normalized)
+        output.append(path)
+    return output
+
+
