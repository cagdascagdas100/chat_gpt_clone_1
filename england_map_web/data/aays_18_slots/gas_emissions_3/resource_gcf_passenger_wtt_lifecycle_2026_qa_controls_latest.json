xpected_handling":"Preserve reporting surface."},{"fact_id":"F8","source_fact":"WTT factors are Scope 3 upstream factors and should not be merged into Scope 1 tailpipe emissions without explicit accounting.","expected_handling":"Preserve scope separation."},{"fact_id":"F9","source_fact":"The method is vehicle/fuel-category based rather than parcel based.","expected_handling":"Do not infer parcel value."},{"fact_id":"F10","source_fact":"Fuel-specific lifecycle ratios must remain paired with the relevant transport fuel.","expected_handling":"Prevent cross-fuel substitution."}],"guard_patterns":[{"pattern_id":"REQUIRE_OFFICIAL_SOURCE_ROW"},{"pattern_id":"PRESERVE_SCOPE_AND_BOUNDARY"},{"pattern_id":"PRESERVE_TEMPORAL_VERSION"},{"pattern_id":"PRESERVE_METHOD_PROVENANCE"},{"pattern_id":"PRESERVE_UNIT_OR_BASIS"},{"pattern_id":"PRESERVE_REVISION_STATUS"},{"pattern_id":"REQUIRE_AUTHORITY_CONTEXT"},{"pattern_id":"PRESERVE_AGGREGATION_LEVEL"},{"pattern_id":"DO_NOT_INFER_PARCEL_VALUE"},{"pattern_id":"REQUIRE_EXPLICIT_QA_REVIEW"}],"generation_rule":"10 facts x 10 guards = 100 controls","counts":{"source_rows":2,"fact_rows":10,"guard_patterns":10,"control_rows":100,"total_rows":102,"passed":102},"browser_acceptance_executed":false,"parcel_binding_executed":false,"final_ready":false,"fake_data":false}