{"schema_version":1,"slot_id":"height_difference_3","batch_id":125,"continuation_key":"6e8e709b6bad7b9807055e2b8b5de98cd4945ee3dee57825e72ba1b824eadd0f","recorded_at":"2026-07-26T07:08:00+03:00","purpose":"HMLR_BOUNDARY_SEMANTICS_EA_DTM_VS_DSM_OS_GRID_ORIENTATION_AND_KNOWN_ISSUES_QA_NO_NUMERIC_PROMOTION","fresh_source_evidence":[{"id":"B125_SRC_001","provider":"HM Land Registry","url":"https://use-land-property-data.service.gov.uk/datasets/inspire/tech-guidance","fact":"HMLR polygon coordinates are captured against British National Grid and BNG-to-WGS84 reprojection can shift features by up to 15 metres."},{"id":"B125_SRC_002","provider":"HM Land Registry","url":"https://use-land-property-data.service.gov.uk/datasets/inspire","fact":"INSPIRE Index Polygons contain freehold registered property and are only a subset of the full Index Polygons database."},{"id":"B125_SRC_003","provider":"HM Land Registry","url":"https://use-land-property-data.service.gov.uk/datasets/inspire","fact":"The extent of land in a registered title cannot be established from INSPIRE polygons; the individual title plan is required."},{"id":"B125_SRC_004","provider":"HM Land Registry","url":"https://use-land-property-data.service.gov.uk/datasets/inspire","fact":"A title can contain several separate polygons and each individual polygon has its own Land Registry-INSPIRE ID."},{"id":"B125_SRC_005","provider":"HM Land Registry","url":"https://use-land-property-data.service.gov.uk/datasets/nps/tech-spec/1","fact":"National Polygon geometry is a single area and Poly_ID is a lifecycle-managed unique spatial-object reference linked to a Title_No."},{"id":"B125_SRC_006","provider":"HM Land Registry","url":"https://www.gov.uk/government/publications/boundary-agreements-and-determined-boundaries-pg40s4/practice-guide-40-land-registry-plans-supplement-4-boundary-agreements-and-determined-boundaries","fact":"A registered-estate boundary is a general boundary unless it is shown as determined; a determined boundary records the exact line for registration purposes."},{"id":"B125_SRC_007","provider":"HM Land Registry","url":"https://www.gov.uk/government/publications/hm-land-registry-plans-boundaries-pg40s3/land-registry-plans-boundaries-practice-guide-40-supplement-3","fact":"Legal and physical boundaries are distinct concepts and a legal boundary is rarely identified with precision on the ground or in plans."},{"id":"B125_SRC_008","provider":"Environment Agency","url":"https://environment.data.gov.uk/dataset/13787b9a-26a4-4775-8523-806d13af58fc","fact":"The 1m DTM removes surface objects from DSM data using bespoke algorithms and manual editing to model terrain surface only."},{"id":"B125_SRC_009","provider":"Environment Agency","url":"https://environment.data.gov.uk/dataset/13787b9a-26a4-4775-8523-806d13af58fc","fact":"The DTM uses last-or-only pulse source measurements and must not be substituted with a DSM containing buildings or vegetation."},{"id":"B125_SRC_010","provider":"Environment Agency","url":"https://environment.data.gov.uk/dataset/13787b9a-26a4-4775-8523-806d13af58fc","fact":"Repeat-survey composite selection uses the newest best-resolution data; resampled data is bilinearly interpolated before merge."},{"id":"B125_SRC_011","provider":"Environment Agency","url":"https://environment.data.gov.uk/dataset/13787b9a-26a4-4775-8523-806d13af58fc","fact":"DTM1m is supplied as 5km OS National Grid GeoTIFF tiles in metres referenced to Ordnance Survey Newlyn using OSTN15; contributing surveys have +/-15cm vertical RMSE."},{"id":"B125_SRC_012","provider":"Environment Agency","url":"https://environment.data.gov.uk/dataset/13787b9a-26a4-4775-8523-806d13af58fc","fact":"The dataset lists WMS, Metadata Survey Index WMS/WFS, WCS, WMTS and OGC API Features services, enabling service and provenance cross-checks."},{"id":"B125_SRC_013","provider":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/height-and-imagery/os-terrain-50","fact":"OS Terrain 50 is an open DTM updated annually in July and is supplied in 10km National Grid tiles."},{"id":"B125_SRC_014","provider":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/height-and-imagery/os-terrain-50/os-terrain-50-known-data-issues","fact":"The current OS Terrain 50 known-data-issues page reports no live known data issues."},{"id":"B125_SRC_015","provider":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-technical-specification/grid-data","fact":"Terrain50 ASCII grid headers reference the tile corner while height values are pixel-centre values; rows run west-to-east with 200 50m pixels per row."},{"id":"B125_SRC_016","provider":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-overview/data-structure","fact":"Terrain50 raster tiles have no overlap and no common edge values; tile-edge and tidal discontinuities must not be repaired by neighbour substitution."}],"candidate_source_role_qa":[{"row_no":61536,"parcel_id":"parcel_61536","inspire_id":"36760596","required_tile":"TQ26","hmlr_role":"INDICATIVE_SAMPLING_GEOMETRY_NOT_LEGAL_BOUNDARY","ea_product_required":"DTM_1M_NOT_DSM","ea_survey_metadata_required":true,"os_role":"COARSE_INDEPENDENT_CROSSCHECK","os_known_issues_checked":true,"terrain50_source_value_m":null,"promotion_allowed":false},{"row_no":61537,"parcel_id":"parcel_61537","inspire_id":"36758146","required_tile":"TQ27","hmlr_role":"INDICATIVE_SAMPLING_GEOMETRY_NOT_LEGAL_BOUNDARY","ea_product_required":"DTM_1M_NOT_DSM","ea_survey_metadata_required":true,"os_role":"COARSE_INDEPENDENT_CROSSCHECK","os_known_issues_checked":true,"terrain50_source_value_m":28.2,"promotion_allowed":false},{"row_no":61538,"parcel_id":"parcel_61538","inspire_id":"36781190","required_tile":"TQ27","hmlr_role":"INDICATIVE_SAMPLING_GEOMETRY_NOT_LEGAL_BOUNDARY","ea_product_required":"DTM_1M_NOT_DSM","ea_survey_metadata_required":true,"os_role":"COARSE_INDEPENDE