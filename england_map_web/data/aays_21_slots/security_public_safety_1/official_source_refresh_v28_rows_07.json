{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V28","part":7,"rows":[{"row":121,"status":"PASS_HSE_LEGIONELLA_LANDLORD_DUTY","source":"HSE Legionella landlord responsibilities","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Landlords have legal responsibilities to protect tenants from health risks including legionella.","quality_score":"4","adoption":"LEGIONELLA_LANDLORD_DUTY","direct_score_input":false},{"row":122,"status":"PASS_HSE_LEGIONELLA_HSWA_COSHH","source":"HSE Legionella landlord responsibilities","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"The duty is supported by the Health and Safety at Work Act and COSHH risk-control framework.","quality_score":"4","adoption":"LEGIONELLA_LEGAL_FRAMEWORK","direct_score_input":false},{"row":123,"status":"PASS_HSE_LEGIONELLA_IDENTIFY_ASSESS","source":"HSE Legionella duties","url":"https://www.hse.gov.uk/legionnaires/what-you-must-do/","verified":"Dutyholders must identify and assess sources of legionella risk.","quality_score":"4","adoption":"LEGIONELLA_RISK_ASSESSMENT","direct_score_input":false},{"row":124,"status":"PASS_HSE_LEGIONELLA_MANAGE_CONTROL","source":"HSE Legionella duties","url":"https://www.hse.gov.uk/legionnaires/what-you-must-do/","verified":"Dutyholders must manage, prevent or control identified legionella risks.","quality_score":"4","adoption":"LEGIONELLA_RISK_CONTROL","direct_score_input":false},{"row":125,"status":"PASS_HSE_LEGIONELLA_RECORD_REVIEW","source":"HSE Legionella duties","url":"https://www.hse.gov.uk/legionnaires/what-you-must-do/","verified":"Required records must be maintained and control arrangements reviewed.","quality_score":"4","adoption":"LEGIONELLA_RECORD_REVIEW","direct_score_input":false},{"row":126,"status":"PASS_HSE_DOMESTIC_PROPORTIONATE_ASSESSMENT","source":"HSE Legionella landlord responsibilities","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Domestic rental risk assessment should be practical and proportionate rather than automatically extensive.","quality_score":"4","adoption":"LEGIONELLA_PROPORTIONATE_ASSESSMENT","direct_score_input":false},{"row":127,"status":"PASS_HSE_VACANT_PROPERTY_ACTION","source":"HSE Legionella landlord responsibilities","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Properties left vacant require additional attention because stagnant water can change the risk.","quality_score":"4","adoption":"LEGIONELLA_VACANCY_CONTROL","direct_score_input":false},{"row":128,"status":"PASS_WITH_HSE_DOMESTIC_LOW_RISK_CONTEXT","source":"HSE Legionella landlord responsibilities","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Many small domestic systems are generally low risk where water turnover is regular, but this is a typical context rather than a property measurement.","quality_score":"3","adoption":"LEGIONELLA_DOMESTIC_CONTEXT_GUARD","direct_score_input":false},{"row":129,"status":"PASS_WITH_HSE_SAMPLING_NOT_ROUTINE","source":"HSE Legionella landlord responsibilities","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Routine legionella sampling is usually not required for domestic hot and cold water systems and is reserved for specific circumstances.","quality_score":"3","adoption":"LEGIONELLA_SAMPLING_SCOPE_GUARD","direct_score_input":false},{"row":130,"status":"PASS_UKHSA_NOTIFIABLE_GUIDANCE_CURRENT","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"The notifiable-disease guidance was last updated on 19 May 2026.","quality_score":"4","adoption":"CURRENT_NOTIFIABLE_DISEASE_GUIDANCE","direct_score_input":false},{"row":131,"status":"PASS_UKHSA_RMP_REPORT_DUTY","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"Registered medical practitioners must report suspected notifiable diseases to UKHSA.","quality_score":"4","adoption":"NOTIFIABLE_DISEASE_REPORT_DUTY","direct_score_input":false},{"row":132,"status":"PASS_UKHSA_URGENT_24_HOURS","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"Urgent suspected cases must be reported by telephone to the local health protection team within 24 hours.","quality_score":"4","adoption":"URGENT_DISEASE_24H_REPORT","direct_score_input":false},{"row":133,"status":"PASS_UKHSA_ROUTINE_THREE_DAYS","source":"UKHSA report a notifiable disease","url":"https://www.gov.uk/guidance/report-a-notifiable-disease","verified":"Routine suspected cases should be reported through the service within three days.","quality_score":"4","adoption":"ROUTINE_DISEASE_3DAY_REPORT","direct_score_input":false},{"row":134,"status":"PASS_UKHSA_NO_LAB_WAIT","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"Practitioners must not wait for laboratory confirmation before reporting a suspected notifiable disease.","quality_score":"4","adoption":"NOTIFIABLE_SUSPICION_REPORT","direct_score_input":false},{"row":135,"status":"PASS_UKHSA_OTHER_SIGNIFICANT_DISEASE","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"Other suspected infectious diseases presenting significant human-health risk can also be reported.","quality_score":"4","adoption":"OTHER_SIGNIFICANT_DISEASE_ROUTE","direct_score_input":false},{"row":136,"status":"PASS_UKHSA_CHEMICAL_RADIATION_HAZARD_ROUTE","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"Other public-health hazards such as chemical or radiation exposure are routed to the local health protection team.","quality_score":"4","adoption":"PUBLIC_HEALTH_HAZARD_ROUTE","direct_score_input":false},{"row":137,"status":"PASS_UKHSA_LAB_ORGANISM_DUTY","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"Diagnostic laboratories must report notifiable causative organisms to UKHSA.","quality_score":"4","adoption":"NOTIFIABLE_ORGANISM_DUTY","direct_score_input":false},{"row":138,"status":"PASS_UKHSA_OUTBREAK_RESPONSE_USE","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/guidance/notifiable-diseases-and-how-to-report-them","verified":"Health protection teams use reports for outbreak control, contact tracing, testing support and trend identification.","quality_score":"4","adoption":"NOTIFIABLE_PUBLIC_HEALTH_USE","direct_score_input":false},{"row":139,"status":"PASS_WITH_UKHSA_WEEKLY_PUBLICATION_PAUSE","source":"UKHSA NOIDs collection","url":"https://www.gov.uk/government/collections/notifications-of-infectious-diseases-noids","verified":"Weekly NOIDs publication remains paused for reporting-system development, while operational public-health action continues.","quality_score":"3","adoption":"NOIDS_PUBLICATION_PAUSE_GUARD","direct_score_input":false},{"row":140,"status":"PASS_WITH_UKHSA_NOT_PARCEL_SCORE","source":"UKHSA notifiable diseases","url":"https://www.gov.uk/government/publications/notifiable-diseases-causative-agents-reports-for-2026","verified":"Notification and laboratory counts reflect reporting and surveillance processes and are not exact parcel-level infection probabilities.","quality_score":"3","adoption":"INFECTIOUS_DISEASE_CONTEXT_ONLY","direct_score_input":false}]}