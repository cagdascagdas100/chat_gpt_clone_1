{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V72","part":5,"rows":[{"row":81,"status":"PASS_WATER_BEADS_01","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-alert-water-beads-psa7","verified":"OPSS classifies water beads as presenting serious risks of gastrointestinal blockage and asphyxiation.","quality_score":"4","adoption":"WATER_BEADS_01","direct_score_input":false},{"row":82,"status":"PASS_WATER_BEADS_02","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-alert-water-beads-psa7","verified":"Dehydrated water beads can expand after swallowing and obstruct the gastrointestinal tract, sometimes requiring surgery.","quality_score":"4","adoption":"WATER_BEADS_02","direct_score_input":false},{"row":83,"status":"PASS_WATER_BEADS_03","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-alert-water-beads-psa7","verified":"Ingested water beads can be difficult to detect and may not appear on x-ray.","quality_score":"4","adoption":"WATER_BEADS_03","direct_score_input":false},{"row":84,"status":"PASS_WATER_BEADS_04","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-alert-water-beads-psa7","verified":"A bead inhaled into the airway can cause coughing, choking or suffocation.","quality_score":"4","adoption":"WATER_BEADS_04","direct_score_input":false},{"row":85,"status":"PASS_WATER_BEADS_05","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-alert-water-beads-psa7","verified":"Water beads are also sold as jelly balls, sensory beads, water crystals, gel beads and other names.","quality_score":"4","adoption":"WATER_BEADS_05","direct_score_input":false},{"row":86,"status":"PASS_WATER_BEADS_06","source":"OPSS water-bead safety","url":"https://www.gov.uk/government/news/opss-issues-safety-alert-to-warn-of-the-risks-of-water-beads","verified":"OPSS reports that water beads can expand up to 400 times their original size when exposed to liquid.","quality_score":"4","adoption":"WATER_BEADS_06","direct_score_input":false},{"row":87,"status":"PASS_WATER_BEADS_07","source":"OPSS water-bead safety","url":"https://www.gov.uk/government/news/opss-issues-safety-alert-to-warn-of-the-risks-of-water-beads","verified":"OPSS advises keeping water beads away from children under 5 and using them with older children or vulnerable adults only under close supervision.","quality_score":"4","adoption":"WATER_BEADS_07","direct_score_input":false},{"row":88,"status":"PASS_WATER_BEADS_08","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-report-juncture-water-beads-50000-pcs-sold-via-amazon-2607-0042","verified":"Recent OPSS reports record withdrawal or recall of non-compliant water-bead products presenting serious airway risks.","quality_score":"4","adoption":"WATER_BEADS_08","direct_score_input":false},{"row":89,"status":"PASS_WITH_WATER_BEADS_09","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-alert-water-beads-psa7","verified":"Water-bead risk depends on bead size and expansion, hydration state, accessibility, user age, supervision, ingestion and treatment delay.","quality_score":"3","adoption":"WATER_BEADS_GUARD_09","direct_score_input":false},{"row":90,"status":"PASS_WITH_WATER_BEADS_10","source":"OPSS water-bead safety","url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-alert-water-beads-psa7","verified":"OPSS water-bead evidence is product-, bead-, user-, exposure-, clinical- and time-specific and is not an exact parcel-level injury probability.","quality_score":"3","adoption":"WATER_BEADS_GUARD_10","direct_score_input":false},{"row":91,"status":"PASS_LASER_01","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"CAA Safety Notice SN-2020/017 version 4 is current and dated 24 November 2025.","quality_score":"4","adoption":"LASER_01","direct_score_input":false},{"row":92,"status":"PASS_LASER_02","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser illumination can temporarily impair a pilot's vision and require another crew member to take control.","quality_score":"4","adoption":"LASER_02","direct_score_input":false},{"row":93,"status":"PASS_LASER_03","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser attacks create avoidable distraction and incapacitation risk during high-workload phases such as approach and landing.","quality_score":"4","adoption":"LASER_03","direct_score_input":false},{"row":94,"status":"PASS_LASER_04","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser incidents affect commercial aviation, general aviation and emergency helicopters, including single-pilot operations.","quality_score":"4","adoption":"LASER_04","direct_score_input":false},{"row":95,"status":"PASS_LASER_05","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"The current Safety Notice reinforces Mandatory Occurrence Reporting requirements for laser attacks.","quality_score":"4","adoption":"LASER_05","direct_score_input":false},{"row":96,"status":"PASS_LASER_06","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"CAA guidance covers preparation, actions during and after an attack, reporting and post-event eye-health assessment.","quality_score":"4","adoption":"LASER_06","direct_score_input":false},{"row":97,"status":"PASS_LASER_07","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"People who see a laser being shone at an aircraft are advised to contact the police.","quality_score":"4","adoption":"LASER_07","direct_score_input":false},{"row":98,"status":"PASS_LASER_08","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"The Laser Misuse (Vehicles) Act 2018 permits an unlimited fine and imprisonment of up to 5 years for endangering an aircraft.","quality_score":"4","adoption":"LASER_08","direct_score_input":false},{"row":99,"status":"PASS_WITH_LASER_09","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"Laser risk depends on device power and wavelength, distance, beam stability, aircraft phase, cockpit exposure, crew composition and response.","quality_score":"3","adoption":"LASER_GUARD_09","direct_score_input":false},{"row":100,"status":"PASS_WITH_LASER_10","source":"CAA laser-attack safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"CAA laser evidence is event-, device-, aircraft-, crew-, location- and time-specific and is not an exact parcel-level aviation-incident probability.","quality_score":"3","adoption":"LASER_GUARD_10","direct_score_input":false}]}