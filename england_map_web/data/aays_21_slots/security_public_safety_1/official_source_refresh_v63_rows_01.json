ns/furniture-and-furnishings-fire-safety-regulations","verified":"Suppliers should retain evidence that relevant filling materials and covers meet applicable fire-safety requirements.","quality_score":"4","adoption":"FURN_08","direct_score_input":false},{"row":19,"status":"PASS_WITH_FURN_09","source":"OPSS furniture fire safety","url":"https://www.gov.uk/government/publications/furniture-and-furnishings-fire-safety-regulations","verified":"Furniture fire risk depends on materials, construction, ignition source, product condition, setting and user behaviour.","quality_score":"3","adoption":"FURN_GUARD_09","direct_score_input":false},{"row":20,"status":"PASS_WITH_FURN_10","source":"OPSS furniture fire safety","url":"https://www.gov.uk/government/publications/furniture-and-furnishings-fire-safety-regulations","verified":"Furniture evidence is product-, material-, test-, premises- and use-specific and is not an exact parcel-level fire probability.","quality_score":"3","adoption":"FURN_GUARD_10","direct_score_input":false}]}