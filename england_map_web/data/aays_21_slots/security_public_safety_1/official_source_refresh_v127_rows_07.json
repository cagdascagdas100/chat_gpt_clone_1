{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V127","part":7,"row_range":[121,140],"rows":[{"row":121,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf.htm","verified":"Electromagnetic fields are produced by electrical and electronic equipment and are present in virtually all workplaces.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":122,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf-regulations.htm","verified":"EMFs include static electric, static magnetic and time-varying electric, magnetic and electromagnetic fields up to 300 GHz.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":123,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf.htm","verified":"Most workplaces have EMF levels that do not require additional controls, but higher-intensity sources require assessment.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":124,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf-regulations.htm","verified":"Employers must carry out a suitable and sufficient risk assessment and provide necessary information and training.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":125,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf.htm","verified":"The CEMFAW Regulations require employers to assess potential exposure against action levels and exposure limit values.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":126,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf-regulations.htm","verified":"Employers must ensure exposure remains below applicable limits and implement an action plan where needed.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":127,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf.htm","verified":"Covered effects include sensory effects, nerve stimulation or heating, shocks and interference with implanted or body-worn medical devices.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":128,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf-regulations.htm","verified":"Assessment must consider workers at particular risk and indirect hazards such as uncontrolled attraction of ferromagnetic objects near strong magnets.","quality_score":"4","adoption":"HSE_ELECTROMAGNETIC_FIELDS_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":129,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf.htm","verified":"EMF risk depends on field frequency and intensity, distance, exposure duration, equipment mode, conductive objects, implanted devices and worker-specific susceptibility.","quality_score":"3","adoption":"HSE_ELECTROMAGNETIC_FIELDS_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":130,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE electromagnetic-fields-at-work guidance","family_id":"HSE_ELECTROMAGNETIC_FIELDS","url":"https://www.hse.gov.uk/radiation/nonionising/emf.htm","verified":"General assessment of EMF exposure, exposure limits, action plans, indirect effects and vulnerable workers guidance does not prove current conditions or control performance at an individual parcel and does not establish an exact incident, exposure or illness probability.","quality_score":"3","adoption":"HSE_ELECTROMAGNETIC_FIELDS_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":131,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/biosafety/safe-deliberate-work-with-biological-agents.htm","verified":"Deliberate work means intentionally handling, propagating, processing or manipulating biological agents as part of planned work.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":132,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/pubns/misc208.htm","verified":"COSHH and the Health and Safety at Work Act are central legal requirements for deliberate work with biological agents.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":133,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/biosafety/law.htm","verified":"Biological agents are classified into four hazard groups according to disease severity, spread and availability of prophylaxis or treatment.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":134,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/biosafety/safe-deliberate-work-with-biological-agents.htm","verified":"The Approved List supports classification and risk assessment, but an unlisted agent must not automatically be treated as Hazard Group 1.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":135,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/pubns/misc208.htm","verified":"Risk assessment must consider the agent, disease and transmission route, procedure, volume and concentration, likelihood of exposure and control measures.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":136,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/biosafety/law.htm","verified":"Containment measures should match the hazard group and the risks of the specific work.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":137,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/biosafety/safe-deliberate-work-with-biological-agents.htm","verified":"Incident plans should cover cleaning, disinfection, contaminated waste, recording, medical advice and emergency containment where severe disease could result.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":138,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/pubns/misc208.htm","verified":"Specified use of Hazard Group 2, 3 or 4 agents and consignment of Hazard Group 4 agents must be notified to HSE as required.","quality_score":"4","adoption":"HSE_BIOLOGICAL_AGENTS_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":139,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/biosafety/safe-deliberate-work-with-biological-agents.htm","verified":"Biological-agent risk depends on agent and hazard group, transmission route, concentration and volume, procedure, containment, worker immunity, vaccination and incident response.","quality_score":"3","adoption":"HSE_BIOLOGICAL_AGENTS_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":140,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE deliberate-work biological-agent safety guidance","family_id":"HSE_BIOLOGICAL_AGENTS","url":"https://www.hse.gov.uk/biosafety/safe-deliberate-work-with-biological-agents.htm","verified":"General classification, risk assessment, containment, incident response and notification for biological agents guidance does not prove current conditions or control performance at an individual parcel and does not establish an exact incident, exposure or illness probability.","quality_score":"3","adoption":"HSE_BIOLOGICAL_AGENTS_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"}]}