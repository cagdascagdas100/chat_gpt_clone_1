{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V25","part":4,"rows":[{"row":66,"status":"PASS_HSE_TRANSPORT_FATAL_HAZARD","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Workplace transport accidents can kill workers and other people affected by vehicle movements.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_FATAL_HAZARD","direct_score_input":false},{"row":67,"status":"PASS_HSE_VEHICLE_STRIKE_HAZARDS","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"HSE identifies people being knocked down, run over or crushed by vehicles, plant and trailers as core workplace transport hazards.","quality_score":"4","adoption":"VEHICLE_STRIKE_HAZARD_SCOPE","direct_score_input":false},{"row":68,"status":"PASS_HSE_FALL_FROM_VEHICLE_HAZARD","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Falls while entering, leaving, loading, unloading or working on vehicles are included in workplace transport risk.","quality_score":"4","adoption":"VEHICLE_FALL_HAZARD_SCOPE","direct_score_input":false},{"row":69,"status":"PASS_HSE_TRANSPORT_RISK_ASSESSMENT","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Risk assessments must consider all workplace transport activities, including loading and unloading.","quality_score":"4","adoption":"TRANSPORT_RISK_ASSESSMENT","direct_score_input":false},{"row":70,"status":"PASS_HSE_MOVEMENT_MAPPING","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"HSE recommends mapping vehicle and pedestrian movements to identify interaction points.","quality_score":"4","adoption":"VEHICLE_PEDESTRIAN_MOVEMENT_MAP","direct_score_input":false},{"row":71,"status":"PASS_HSE_CONTACT_REDUCTION","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Site improvements should reduce contact between pedestrians and vehicles.","quality_score":"4","adoption":"PEDESTRIAN_VEHICLE_SEPARATION","direct_score_input":false},{"row":72,"status":"PASS_HSE_INFREQUENT_TASKS","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Risk assessment must include less frequent activities such as waste-skip changes.","quality_score":"4","adoption":"INFREQUENT_TRANSPORT_TASKS","direct_score_input":false},{"row":73,"status":"PASS_HSE_DELIVERY_DRIVER_SCOPE","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Delivery drivers must be included because unfamiliarity with the site can make them particularly vulnerable.","quality_score":"4","adoption":"VISITING_DRIVER_SCOPE","direct_score_input":false},{"row":74,"status":"PASS_HSE_SEPARATE_ROUTES","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Separate pedestrian and vehicle routes should be provided where possible.","quality_score":"4","adoption":"SEPARATE_TRAFFIC_ROUTES","direct_score_input":false},{"row":75,"status":"PASS_HSE_ONE_WAY_SYSTEM","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"A one-way traffic system should be used where practicable to reduce conflict and reversing.","quality_score":"4","adoption":"ONE_WAY_SITE_SYSTEM","direct_score_input":false},{"row":76,"status":"PASS_HSE_SAFE_CROSSINGS","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Appropriate crossing points should be provided where pedestrians and traffic meet.","quality_score":"4","adoption":"SAFE_PEDESTRIAN_CROSSINGS","direct_score_input":false},{"row":77,"status":"PASS_HSE_ROUTE_SIGNS","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Traffic routes, speed limits and pedestrian crossings should be indicated with suitable signs.","quality_score":"4","adoption":"WORKPLACE_TRAFFIC_SIGNAGE","direct_score_input":false},{"row":78,"status":"PASS_HSE_WORKPLACE_LIGHTING","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Lighting must be adequate wherever people and vehicles work or move.","quality_score":"4","adoption":"TRANSPORT_AREA_LIGHTING","direct_score_input":false},{"row":79,"status":"PASS_HSE_ROUTE_SURFACE","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Workplace traffic surfaces should be firm, even and suitable for their purpose.","quality_score":"4","adoption":"SAFE_TRAFFIC_SURFACE","direct_score_input":false},{"row":80,"status":"PASS_HSE_LOADING_AREA","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Safe areas should be provided for vehicle loading and unloading.","quality_score":"4","adoption":"SAFE_LOADING_UNLOADING_AREA","direct_score_input":false},{"row":81,"status":"PASS_HSE_VEHICLE_SUITABILITY","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Work vehicles must be suitable for the purpose for which they are used.","quality_score":"4","adoption":"WORK_VEHICLE_SUITABILITY","direct_score_input":false},{"row":82,"status":"PASS_HSE_VEHICLE_MAINTENANCE","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Brakes, steering, tyres, lights, mirrors and safety systems must be maintained in good repair.","quality_score":"4","adoption":"WORK_VEHICLE_MAINTENANCE","direct_score_input":false},{"row":83,"status":"PASS_HSE_REVERSING_DEATH_SHARE","source":"HSE reversing guidance","url":"https://www.hse.gov.uk/workplacetransport/information/reversing.htm","verified":"HSE states that nearly a quarter of workplace-transport deaths occur during reversing.","quality_score":"4","adoption":"REVERSING_FATALITY_CONTEXT","direct_score_input":false},{"row":84,"status":"PASS_HSE_REMOVE_REVERSING","source":"HSE reversing guidance","url":"https://www.hse.gov.uk/workplacetransport/information/reversing.htm","verified":"The need for reversing should be removed where possible, for example through drive-through loading positions.","quality_score":"4","adoption":"REVERSING_ELIMINATION","direct_score_input":false},{"row":85,"status":"PASS_HSE_MARK_REVERSING_AREAS","source":"HSE reversing guidance","url":"https://www.hse.gov.uk/workplacetransport/information/reversing.htm","verified":"Unavoidable reversing areas should be planned and clearly marked.","quality_score":"4","adoption":"MARKED_REVERSING_AREA","direct_score_input":false},{"row":86,"status":"PASS_HSE_EXCLUDE_PEDESTRIANS_REVERSING","source":"HSE reversing guidance","url":"https://www.hse.gov.uk/workplacetransport/information/reversing.htm","verified":"People who do not need to be in a reversing area should be kept clear.","quality_score":"4","adoption":"REVERSING_PEDESTRIAN_EXCLUSION","direct_score_input":false},{"row":87,"status":"PASS_HSE_TRAINED_BANKSMAN","source":"HSE reversing guidance","url":"https://www.hse.gov.uk/workplacetransport/information/reversing.htm","verified":"A trained signaller or banksman may be used to keep the reversing area clear and guide drivers.","quality_score":"4","adoption":"TRAINED_REVERSING_SIGNALLER","direct_score_input":false},{"row":88,"status":"PASS_HSE_VIOLENCE_LAW_SCOPE","source":"HSE work-related violence law","url":"https://www.hse.gov.uk/violence/employer/the-law.htm","verified":"Health and safety law applies to work-related violence and aggression as it does to other workplace risks.","quality_score":"4","adoption":"WORKPLACE_VIOLENCE_LEGAL_SCOPE","direct_score_input":false},{"row":89,"status":"PASS_HSE_LONE_WORKER_CONTROL","source":"HSE lone-working risk management","url":"https://www.hse.gov.uk/lone-working/employer/manage-the-risks-of-working-alone.htm","verified":"Employers must assess and manage risks to lone workers under the Management of Health and Safety at Work Regulations.","quality_score":"4","adoption":"LONE_WORKER_RISK_CONTROL","direct_score_input":false},{"row":90,"status":"PASS_WITH_HSE_WORK_ACTIVITY_CONTEXT","source":"HSE workplace transport and lone working","url":"https://www.hse.gov.uk/lone-working/employer/index.htm","verified":"Workplace transport, violence and lone-working controls depend on the actual work activity and are not inherent parcel-level safety scores.","quality_score":"3","adoption":"WORK_ACTIVITY_CONTEXT_ONLY","direct_score_input":false}]}