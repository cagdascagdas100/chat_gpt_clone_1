{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V29","part":7,"rows":[{"row":129,"status":"PASS_APHA_REPORT_LEGAL_DUTY","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Suspected notifiable animal disease must be reported; failure to report suspicion is against the law.","quality_score":"4","adoption":"ANIMAL_DISEASE_REPORT_DUTY","direct_score_input":false},{"row":130,"status":"PASS_APHA_24_7_REPORTING","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/get-help-with-animal-and-plant-health","verified":"APHA accepts notifiable-disease reports 24 hours a day, seven days a week.","quality_score":"4","adoption":"APHA_24_7_REPORTING","direct_score_input":false},{"row":131,"status":"PASS_APHA_DUTY_VET","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"The first report is handled by an APHA duty vet who asks about the animals and circumstances.","quality_score":"4","adoption":"APHA_DUTY_VET_TRIAGE","direct_score_input":false},{"row":132,"status":"PASS_APHA_PHONE_RULE_OUT","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"The duty vet assesses whether the disease can be ruled out by telephone.","quality_score":"4","adoption":"APHA_PHONE_TRIAGE","direct_score_input":false},{"row":133,"status":"PASS_APHA_VET_INSPECTOR_VISIT","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"If it cannot be ruled out, a veterinary inspector will usually visit the premises.","quality_score":"4","adoption":"APHA_INSPECTOR_VISIT","direct_score_input":false},{"row":134,"status":"PASS_APHA_PREVISIT_RESTRICTIONS","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"APHA can require restrictions before the inspector arrives.","quality_score":"4","adoption":"APHA_PREVISIT_RESTRICTIONS","direct_score_input":false},{"row":135,"status":"PASS_APHA_ANIMAL_MOVEMENT_STOP","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Restrictions can stop movement of susceptible animals on or off the premises.","quality_score":"4","adoption":"ANIMAL_MOVEMENT_RESTRICTION","direct_score_input":false},{"row":136,"status":"PASS_APHA_FOMITE_MOVEMENT_STOP","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Restrictions can also cover meat products, equipment, vehicles and other disease-transmission routes.","quality_score":"4","adoption":"FOMITE_MOVEMENT_RESTRICTION","direct_score_input":false},{"row":137,"status":"PASS_APHA_SAMPLING","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"The veterinary inspector may take samples when notifiable disease cannot be excluded.","quality_score":"4","adoption":"APHA_DISEASE_SAMPLING","direct_score_input":false},{"row":138,"status":"PASS_APHA_CONTROL_ZONES","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Confirmed outbreaks can lead to legally controlled disease zones.","quality_score":"4","adoption":"ANIMAL_DISEASE_CONTROL_ZONES","direct_score_input":false},{"row":139,"status":"PASS_APHA_CULLING_CONTROL","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"APHA may cull susceptible animals to control disease spread.","quality_score":"4","adoption":"ANIMAL_DISEASE_CULLING_CONTROL","direct_score_input":false},{"row":140,"status":"PASS_APHA_CLEAN_DISINFECT","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"APHA may carry out initial cleansing and disinfection of affected premises.","quality_score":"4","adoption":"ANIMAL_DISEASE_CLEAN_DISINFECT","direct_score_input":false},{"row":141,"status":"PASS_APHA_RESTOCK_RULES","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Strict restocking rules may be imposed after disease control action.","quality_score":"4","adoption":"ANIMAL_DISEASE_RESTOCK_CONTROL","direct_score_input":false},{"row":142,"status":"PASS_APHA_ACTIVITY_LIMITS","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Exports, hunting and animal gatherings can be restricted where needed to control spread.","quality_score":"4","adoption":"ANIMAL_DISEASE_ACTIVITY_LIMITS","direct_score_input":false},{"row":143,"status":"PASS_APHA_RULED_OUT_RELEASE","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Restrictions end when suspicion of notifiable disease is formally ruled out.","quality_score":"4","adoption":"ANIMAL_DISEASE_RESTRICTION_RELEASE","direct_score_input":false},{"row":144,"status":"PASS_APHA_FOLLOWUP_DIAGNOSTICS","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"After exclusion, APHA-supported diagnostic investigation may help identify another cause and prevention measures.","quality_score":"4","adoption":"APHA_FOLLOWUP_DIAGNOSTICS","direct_score_input":false},{"row":145,"status":"PASS_APHA_COMPENSATION_LIMIT","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Compensation may be available for healthy animals culled by government but not merely for zone-related losses.","quality_score":"4","adoption":"ANIMAL_DISEASE_COMPENSATION_SCOPE","direct_score_input":false},{"row":146,"status":"PASS_APHA_WELFARE_ROUTE","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/get-help-with-animal-and-plant-health","verified":"APHA also provides separate routes for urgent and non-urgent farm-animal welfare concerns.","quality_score":"4","adoption":"APHA_WELFARE_REPORT_ROUTE","direct_score_input":false},{"row":147,"status":"PASS_WITH_APHA_ZONE_DYNAMIC","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Disease zones, movement controls and outbreak status are dynamic and require current official checking.","quality_score":"3","adoption":"ANIMAL_DISEASE_DYNAMIC_GUARD","direct_score_input":false},{"row":148,"status":"PASS_WITH_APHA_SPECIES_DISEASE_SCOPE","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/government/collections/notifiable-diseases-in-animals","verified":"Reporting and control actions depend on the suspected disease, species and epidemiological evidence.","quality_score":"3","adoption":"ANIMAL_DISEASE_SCOPE_GUARD","direct_score_input":false},{"row":149,"status":"PASS_WITH_APHA_NOT_PARCEL_SCORE","source":"APHA notifiable animal disease guidance","url":"https://www.gov.uk/guidance/what-happens-when-you-report-a-notifiable-disease-in-your-animals","verified":"Outbreak controls and premises restrictions are not converted into a universal parcel-level disease probability.","quality_score":"3","adoption":"ANIMAL_DISEASE_CONTEXT_ONLY","direct_score_input":false}]}