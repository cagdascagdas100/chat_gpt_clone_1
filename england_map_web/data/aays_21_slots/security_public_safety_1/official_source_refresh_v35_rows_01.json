{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V35","part":1,"rows":[{"row":1,"status":"PASS_GAS_ANNUAL_CHECK","source":"HSE landlord gas safety checks","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswho.htm","verified":"Landlord-provided gas appliances and flues require a gas safety check every year.","quality_score":"4","adoption":"PASS_GAS_ANNUAL_CHECK","direct_score_input":false},{"row":2,"status":"PASS_GAS_PERMANENT_PORTABLE_SCOPE","source":"HSE gas appliance scope","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswhat.htm","verified":"Both permanent and portable landlord-provided gas appliances are within the annual check scope.","quality_score":"4","adoption":"PASS_GAS_PERMANENT_PORTABLE_SCOPE","direct_score_input":false},{"row":3,"status":"PASS_GAS_LPG_HEATER_SCOPE","source":"HSE gas appliance scope","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswhat.htm","verified":"A mobile LPG space heater provided for a tenant requires a gas safety check.","quality_score":"4","adoption":"PASS_GAS_LPG_HEATER_SCOPE","direct_score_input":false},{"row":4,"status":"PASS_GAS_FLUE_SCOPE","source":"HSE gas appliance scope","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswhat.htm","verified":"Flues serving landlord-provided gas appliances are included in the annual safety-check duty.","quality_score":"4","adoption":"PASS_GAS_FLUE_SCOPE","direct_score_input":false},{"row":5,"status":"PASS_GAS_TENANT_APPLIANCE_PIPEWORK","source":"HSE gas appliance scope","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswhat.htm","verified":"For a tenant-owned appliance, the landlord remains responsible for associated installation and pipework but not the appliance itself.","quality_score":"4","adoption":"PASS_GAS_TENANT_APPLIANCE_PIPEWORK","direct_score_input":false},{"row":6,"status":"PASS_GAS_COMMUNAL_APPLIANCE","source":"HSE communal gas appliance guidance","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswhat.htm","verified":"A communal gas appliance used by multiple dwellings must be maintained and included in annual safety checking.","quality_score":"4","adoption":"PASS_GAS_COMMUNAL_APPLIANCE","direct_score_input":false},{"row":7,"status":"PASS_GAS_EMPTY_PROPERTY","source":"HSE landlord gas safety checks","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswho.htm","verified":"Before new tenants enter an empty property, appliances and flues must be safe and supported by a current gas safety record.","quality_score":"4","adoption":"PASS_GAS_EMPTY_PROPERTY","direct_score_input":false},{"row":8,"status":"PASS_GAS_FLAT_ABOVE_SHOP","source":"HSE landlord gas safety checks","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswho.htm","verified":"Domestic landlord gas duties apply to a rented flat above a shop.","quality_score":"4","adoption":"PASS_GAS_FLAT_ABOVE_SHOP","direct_score_input":false},{"row":9,"status":"PASS_GAS_DEFECT_PROMPT_ACTION","source":"HSE landlord gas safety checks","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswho.htm","verified":"A landlord must take prompt action to correct defects identified by the safety check.","quality_score":"4","adoption":"PASS_GAS_DEFECT_PROMPT_ACTION","direct_score_input":false},{"row":10,"status":"PASS_GAS_UNSAFE_APPLIANCE_NOT_USED","source":"HSE domestic gas safety FAQ","url":"https://www.hse.gov.uk/gas/domestic/faqs.htm","verified":"A suspected unsafe gas appliance must not be used until checked and made safe by a Gas Safe registered engineer.","quality_score":"4","adoption":"PASS_GAS_UNSAFE_APPLIANCE_NOT_USED","direct_score_input":false},{"row":11,"status":"PASS_GAS_CHECK_RECORD_TWO_YEARS","source":"HSE landlord gas FAQ","url":"https://www.hse.gov.uk/gas/domestic/faqlandlord.htm","verified":"Landlords must retain the annual gas safety check record for two years.","quality_score":"4","adoption":"PASS_GAS_CHECK_RECORD_TWO_YEARS","direct_score_input":false},{"row":12,"status":"PASS_GAS_RECORD_EXISTING_TENANT_28_DAYS","source":"HSE landlord gas FAQ","url":"https://www.hse.gov.uk/gas/domestic/faqlandlord.htm","verified":"Existing tenants must receive a copy of the gas safety record within 28 days of the check.","quality_score":"4","adoption":"PASS_GAS_RECORD_EXISTING_TENANT_28_DAYS","direct_score_input":false},{"row":13,"status":"PASS_GAS_RECORD_NEW_TENANT_BEFORE_MOVE","source":"HSE landlord gas FAQ","url":"https://www.hse.gov.uk/gas/domestic/faqlandlord.htm","verified":"New tenants must receive the current gas safety record before moving in.","quality_score":"4","adoption":"PASS_GAS_RECORD_NEW_TENANT_BEFORE_MOVE","direct_score_input":false},{"row":14,"status":"PASS_GAS_EARLY_CHECK_FLEXIBILITY","source":"HSE landlord gas FAQ","url":"https://www.hse.gov.uk/gas/domestic/faqlandlord.htm","verified":"An annual check may be completed up to two months early while retaining the original annual deadline.","quality_score":"4","adoption":"PASS_GAS_EARLY_CHECK_FLEXIBILITY","direct_score_input":false},{"row":15,"status":"PASS_GAS_MAINTENANCE_PROGRAMME","source":"HSE gas appliance maintenance","url":"https://www.hse.gov.uk/gas/landlords/gasappliances.htm","verified":"Effective gas maintenance normally combines periodic inspection, performance testing and necessary remedial work.","quality_score":"4","adoption":"PASS_GAS_MAINTENANCE_PROGRAMME","direct_score_input":false},{"row":16,"status":"PASS_GAS_NO_FORCED_ENTRY","source":"HSE gas appliance maintenance","url":"https://www.hse.gov.uk/gas/landlords/gasappliances.htm","verified":"A landlord must not use force to enter a property to carry out gas maintenance or safety checks.","quality_score":"4","adoption":"PASS_GAS_NO_FORCED_ENTRY","direct_score_input":false},{"row":17,"status":"PASS_GAS_REGISTERED_ENGINEER","source":"HSE gas appliance maintenance","url":"https://www.hse.gov.uk/gas/landlords/gasappliances.htm","verified":"Gas maintenance checks and repairs must be completed by a Gas Safe registered engineer.","quality_score":"4","adoption":"PASS_GAS_REGISTERED_ENGINEER","direct_score_input":false},{"row":18,"status":"PASS_WITH_GAS_ANNUAL_CHECK_NOT_MAINTENANCE","source":"HSE landlord gas FAQ","url":"https://www.hse.gov.uk/gas/domestic/faqlandlord.htm","verified":"An annual gas safety check does not by itself demonstrate that effective ongoing maintenance has been completed.","quality_score":"3","adoption":"PASS_WITH_GAS_ANNUAL_CHECK_NOT_MAINTENANCE","direct_score_input":false},{"row":19,"status":"PASS_WITH_GAS_OWNERSHIP_BOUNDARY","source":"HSE gas appliance scope","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswhat.htm","verified":"Appliance ownership and the flue or pipework served must be established because responsibilities differ for tenant-owned equipment.","quality_score":"3","adoption":"PASS_WITH_GAS_OWNERSHIP_BOUNDARY","direct_score_input":false},{"row":20,"status":"PASS_WITH_GAS_NOT_PARCEL_SCORE","source":"HSE landlord gas safety","url":"https://www.hse.gov.uk/gas/landlords/safetycheckswho.htm","verified":"Landlord gas duties are property-management controls and are not converted into an exact parcel-level safety probability.","quality_score":"3","adoption":"PASS_WITH_GAS_NOT_PARCEL_SCORE","direct_score_input":false},{"row":21,"status":"PASS_LPG_PROPANE_BUTANE","source":"HSE LPG overview","url":"https://www.hse.gov.uk/gas/lpg/about.htm","verified":"LPG is supplied primarily as propane, butane or a mixture of the two.","quality_score":"4","adoption":"PASS_LPG_PROPANE_BUTANE","direct_score_input":false},{"row":22,"status":"PASS_LPG_ODORANT","source":"HSE LPG overview","url":"https://www.hse.gov.uk/gas/lpg/about.htm","verified":"A strong odorant is added to LPG so that a release is easier to detect.","quality_score":"4","adoption":"PASS_LPG_ODORANT","direct_score_input":false},{"row":23,"status":"PASS_LPG_FLAMMABLE","source":"HSE LPG overview","url":"https://www.hse.gov.uk/gas/lpg/about.htm","verified":"LPG is flammable.","quality_score":"4","adoption":"PASS_LPG_FLAMMABLE","direct_score_input":false},{"row":24,"status":"PASS_LPG_HEAVIER_THAN_AIR","source":"HSE LPG overview","url":"https://www.hse.gov.uk/gas/lpg/about.htm","verified":"LPG is heavier than air and can collect in low areas.","quality_score":"4","adoption":"PASS_LPG_HEAVIER_THAN_AIR","direct_score_input":false},{"row":25,"status":"PASS_LPG_LOW_SPOT_HAZARDS","source":"HSE LPG overview","url":"https://www.hse.gov.uk/gas/lpg/about.htm","verified":"Accumulation in drains or basements can create fire, explosion or suffocation hazards.","quality_score":"4","adoption":"PASS_LPG_LOW_SPOT_HAZARDS","direct_score_input":false},{"row":26,"status":"PASS_LPG_SUPPLY_FORMS","source":"HSE LPG overview","url":"https://www.hse.gov.uk/gas/lpg/about.htm","verified":"LPG can be supplied in canisters, cylinders or bulk storage tanks.","quality_score":"4","adoption":"PASS_LPG_SUPPLY_FORMS","direct_score_input":false},{"row":27,"status":"PASS_LPG_DSEAR_BULK_STORAGE","source":"HSE LPG and DSEAR","url":"https://www.hse.gov.uk/electricity/atex/lpg.htm","verified":"DSEAR applies to bulk LPG storage.","quality_score":"4","adoption":"PASS_LPG_DSEAR_BULK_STORAGE","direct_score_input":false},{"row":28,"status":"PASS_LPG_DSEAR_CYLINDER_FILLING","source":"HSE LPG and DSEAR","url":"https://www.hse.gov.uk/electricity/atex/lpg.htm","verified":"DSEAR applies to LPG cylinder filling operations.","quality_score":"4","adoption":"PASS_LPG_DSEAR_CYLINDER_FILLING","direct_score_input":false},{"row":29,"status":"PASS_LPG_DSEAR_OUTDOOR_STORAGE","source":"HSE LPG and DSEAR","url":"https://www.hse.gov.uk/electricity/atex/lpg.htm","verified":"DSEAR applies to outdoor LPG cylinder storage areas.","quality_score":"4","adoption":"PASS_LPG_DSEAR_OUTDOOR_STORAGE","direct_score_input":false},{"row":30,"status":"PASS_LPG_INDOOR_SITE_ASSESSMENT","source":"HSE LPG and DSEAR","url":"https://www.hse.gov.uk/electricity/atex/lpg.htm","verified":"Indoor LPG cylinder storage requires a site-specific risk assessment, including ventilation.","quality_score":"4","adoption":"PASS_LPG_INDOOR_SITE_ASSESSMENT","direct_score_input":false},{"row":31,"status":"PASS_LPG_INSTALLATION_RECORDS","source":"HSE safe use of LPG","url":"https://www.hse.gov.uk/gas/lpg/safeuse.htm","verified":"Users should consider recording pipework routes, risk assessments and maintenance information for the installation.","quality_score":"4","adoption":"PASS_LPG_INSTALLATION_RECORDS","direct_score_input":false},{"row":32,"status":"PASS_LPG_STRUCTURAL_STABILITY","source":"HSE safe use of LPG","url":"https://www.hse.gov.uk/gas/lpg/safeuse.htm","verified":"LPG users should consider workplace structural stability in case escaped gas causes fire or explosion.","quality_score":"4","adoption":"PASS_LPG_STRUCTURAL_STABILITY","direct_score_input":false},{"row":33,"status":"PASS_LPG_RISK_ASSESSMENT","source":"HSE LPG legal framework","url":"https://www.hse.gov.uk/gas/lpg/legalframework.htm","verified":"The employer must make a suitable and sufficient assessment of risks presented by an LPG installation.","quality_score":"4","adoption":"PASS_LPG_RISK_ASSESSMENT","direct_score_input":false},{"row":34,"status":"PASS_LPG_COMPETENT_ASSISTANCE","source":"HSE LPG legal framework","url":"https://www.hse.gov.uk/gas/lpg/legalframework.htm","verified":"Employers must appoint competent assistance to support compliance with LPG safety duties.","quality_score":"4","adoption":"PASS_LPG_COMPETENT_ASSISTANCE","direct_score_input":false},{"row":35,"status":"PASS_LPG_WRITTEN_EXAMINATION_SCHEME","source":"HSE LPG legal framework","url":"https://www.hse.gov.uk/gas/lpg/legalframework.htm","verified":"Relevant pressure-system parts require a written scheme and periodic examination by a competent person.","quality_score":"4","adoption":"PASS_LPG_WRITTEN_EXAMINATION_SCHEME","direct_score_input":false},{"row":36,"status":"PASS_LPG_EMERGENCY_MEASURES","source":"HSE LPG legal framework","url":"https://www.hse.gov.uk/gas/lpg/legalframework.htm","verified":"Users must maintain emergency measures where LPG creates fire or explosion risks.","quality_score":"4","adoption":"PASS_LPG_EMERGENCY_MEASURES","direct_score_input":false},{"row":37,"status":"PASS_LPG_TANK_USER_RESPONSIBILITIES","source":"HSE bulk LPG tank safety","url":"https://www.hse.gov.uk/gas/lpg/storagetank.htm","verified":"The site user retains responsibilities for tank siting, surrounding conditions, tanker access, security, impact protection and emergency arrangements.","quality_score":"4","adoption":"PASS_LPG_TANK_USER_RESPONSIBILITIES","direct_score_input":false},{"row":38,"status":"PASS_WITH_LPG_SUPPLIER_USER_BOUNDARY","source":"HSE bulk LPG tank safety","url":"https://www.hse.gov.uk/gas/lpg/storagetank.htm","verified":"Tank ownership and maintenance responsibilities must be confirmed with the LPG supplier because arrangements can vary.","quality_score":"3","adoption":"PASS_WITH_LPG_SUPPLIER_USER_BOUNDARY","direct_score_input":false},{"row":39,"status":"PASS_WITH_LPG_ZONE_DEPENDS_ON_CONTROLS","source":"HSE LPG and DSEAR","url":"https://www.hse.gov.uk/electricity/atex/lpg.htm","verified":"Whether an outdoor or indoor cylinder area requires hazardous-area zoning depends on design, maintenance, ventilation and site conditions.","quality_score":"3","adoption":"PASS_WITH_LPG_ZONE_DEPENDS_ON_CONTROLS","direct_score_input":false},{"row":40,"status":"PASS_WITH_LPG_NOT_PARCEL_SCORE","source":"HSE LPG safety","url":"https://www.hse.gov.uk/gas/lpg/about.htm","verified":"LPG guidance describes installation and operational controls and is not an exact parcel-level probability.","quality_score":"3","adoption":"PASS_WITH_LPG_NOT_PARCEL_SCORE","direct_score_input":false}]}