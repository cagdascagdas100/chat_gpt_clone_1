{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V67","part":2,"rows":[{"row":21,"status":"PASS_LIFTING_01","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"Lifting operations must be properly resourced, planned and organised so they are carried out safely.","quality_score":"4","adoption":"LIFTING_01","direct_score_input":false},{"row":22,"status":"PASS_LIFTING_02","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/construction/safetytopics/lifting-operations.htm","verified":"Every lifting operation involving lifting equipment must be planned by a competent person.","quality_score":"4","adoption":"LIFTING_02","direct_score_input":false},{"row":23,"status":"PASS_LIFTING_03","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/construction/safetytopics/lifting-operations.htm","verified":"Lifting operations must be appropriately supervised and carried out in a safe manner.","quality_score":"4","adoption":"LIFTING_03","direct_score_input":false},{"row":24,"status":"PASS_LIFTING_04","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"Lifting equipment and accessories must have adequate strength and stability for foreseeable forces and failure modes.","quality_score":"4","adoption":"LIFTING_04","direct_score_input":false},{"row":25,"status":"PASS_LIFTING_05","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"Loads should not be suspended over occupied areas where this can be avoided, and danger zones require restricted access.","quality_score":"4","adoption":"LIFTING_05","direct_score_input":false},{"row":26,"status":"PASS_LIFTING_06","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/construction/safetytopics/lifting-operations.htm","verified":"Crane operators, slingers and people directing lifts must be trained and competent.","quality_score":"4","adoption":"LIFTING_06","direct_score_input":false},{"row":27,"status":"PASS_LIFTING_07","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Lifting equipment requires pre-use or periodic checks, maintenance and statutory thorough examination as applicable.","quality_score":"4","adoption":"LIFTING_07","direct_score_input":false},{"row":28,"status":"PASS_LIFTING_08","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"Complex or high-risk lifts should have a detailed written plan defining actions and responsibilities.","quality_score":"4","adoption":"LIFTING_08","direct_score_input":false},{"row":29,"status":"PASS_WITH_LIFTING_09","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/construction/safetytopics/lifting-operations.htm","verified":"Lifting risk depends on equipment, load, ground, weather, configuration, route, competence and supervision.","quality_score":"3","adoption":"LIFTING_GUARD_09","direct_score_input":false},{"row":30,"status":"PASS_WITH_LIFTING_10","source":"HSE lifting-operation safety","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Lifting evidence is lift-, equipment-, load-, site- and team-specific and is not an exact parcel-level injury probability.","quality_score":"3","adoption":"LIFTING_GUARD_10","direct_score_input":false},{"row":31,"status":"PASS_HYDRAULIC_01","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"High-pressure hydraulic fluid can be injected through the skin and may require major surgery or amputation.","quality_score":"4","adoption":"HYDRAULIC_01","direct_score_input":false},{"row":32,"status":"PASS_HYDRAULIC_02","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"Even a pinprick-sized leak in pressurised pipework can cause a major injury.","quality_score":"4","adoption":"HYDRAULIC_02","direct_score_input":false},{"row":33,"status":"PASS_HYDRAULIC_03","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"Operators must not search for hydraulic leaks with bare hands.","quality_score":"4","adoption":"HYDRAULIC_03","direct_score_input":false},{"row":34,"status":"PASS_HYDRAULIC_04","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"Pipe couplings and replacement parts must be correct and compatible; makeshift repairs are unsafe.","quality_score":"4","adoption":"HYDRAULIC_04","direct_score_input":false},{"row":35,"status":"PASS_HYDRAULIC_05","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"Damaged hydraulic hoses must be replaced rather than left in service.","quality_score":"4","adoption":"HYDRAULIC_05","direct_score_input":false},{"row":36,"status":"PASS_HYDRAULIC_06","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"Pressure must be released and supported components made safe before maintenance or adjustment.","quality_score":"4","adoption":"HYDRAULIC_06","direct_score_input":false},{"row":37,"status":"PASS_HYDRAULIC_07","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"Design controls can include over-pressure protection, burst valves, guards, shut-off valves, check valves and mechanical supports.","quality_score":"4","adoption":"HYDRAULIC_07","direct_score_input":false},{"row":38,"status":"PASS_HYDRAULIC_08","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/safetybulletins/hydraulic-injection-injury.htm","verified":"Any suspected injection injury requires immediate professional medical treatment.","quality_score":"4","adoption":"HYDRAULIC_08","direct_score_input":false},{"row":39,"status":"PASS_WITH_HYDRAULIC_09","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/safetybulletins/hydraulic-injection-injury.htm","verified":"Hydraulic-injection severity depends on pressure, proximity, jet size, injected fluid, body site and treatment delay.","quality_score":"3","adoption":"HYDRAULIC_GUARD_09","direct_score_input":false},{"row":40,"status":"PASS_WITH_HYDRAULIC_10","source":"HSE hydraulic-injection safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/fluid.htm","verified":"Hydraulic-injection evidence is system-, component-, fluid-, task- and casualty-specific and is not an exact parcel-level injury probability.","quality_score":"3","adoption":"HYDRAULIC_GUARD_10","direct_score_input":false}]}