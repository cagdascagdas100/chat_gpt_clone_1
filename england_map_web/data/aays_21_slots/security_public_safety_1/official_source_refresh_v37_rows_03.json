{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V37","part":3,"rows":[{"row":41,"status":"PASS_RADON_WORKPLACE_01","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Radon is a radioactive gas that cannot be seen, smelled or tasted without specialist detection equipment.","quality_score":"4","adoption":"RADON_WORKPLACE_01","direct_score_input":false},{"row":42,"status":"PASS_RADON_WORKPLACE_02","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Radon originates from rocks and soil and can accumulate inside buildings.","quality_score":"4","adoption":"RADON_WORKPLACE_02","direct_score_input":false},{"row":43,"status":"PASS_RADON_WORKPLACE_03","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Breathing radon is identified by HSE as the second largest cause of lung cancer in the UK.","quality_score":"4","adoption":"RADON_WORKPLACE_03","direct_score_input":false},{"row":44,"status":"PASS_RADON_WORKPLACE_04","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Employers must review the potential radon hazard in their premises.","quality_score":"4","adoption":"RADON_WORKPLACE_04","direct_score_input":false},{"row":45,"status":"PASS_RADON_WORKPLACE_05","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Radon levels depend on location, building structure and how the building is used.","quality_score":"4","adoption":"RADON_WORKPLACE_05","direct_score_input":false},{"row":46,"status":"PASS_RADON_WORKPLACE_06","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"All indoor workplace types can have elevated radon levels.","quality_score":"4","adoption":"RADON_WORKPLACE_06","direct_score_input":false},{"row":47,"status":"PASS_RADON_WORKPLACE_07","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Underground workplaces and ground-floor or basement areas can have significant radon levels.","quality_score":"4","adoption":"RADON_WORKPLACE_07","direct_score_input":false},{"row":48,"status":"PASS_RADON_WORKPLACE_08","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Workplaces in radon affected areas should be tested unless a detailed assessment supports a low expected level.","quality_score":"4","adoption":"RADON_WORKPLACE_08","direct_score_input":false},{"row":49,"status":"PASS_WITH_RADON_WORKPLACE_09","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"The indicative radon map is a screening tool and address-specific measurement may still be required.","quality_score":"3","adoption":"RADON_WORKPLACE_GUARD_09","direct_score_input":false},{"row":50,"status":"PASS_WITH_RADON_WORKPLACE_10","source":"HSE radon in workplaces","url":"https://www.hse.gov.uk/radiation/ionising/radon.htm","verified":"Radon evidence is location- and building-specific and is not an exact parcel-level safety probability.","quality_score":"3","adoption":"RADON_WORKPLACE_GUARD_10","direct_score_input":false},{"row":51,"status":"PASS_FOOD_ALLERGEN_01","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Retail and catering food businesses must provide allergen information and follow food-labelling rules.","quality_score":"4","adoption":"FOOD_ALLERGEN_01","direct_score_input":false},{"row":52,"status":"PASS_FOOD_ALLERGEN_02","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Allergen information is required for both prepacked and non-prepacked food and drink.","quality_score":"4","adoption":"FOOD_ALLERGEN_02","direct_score_input":false},{"row":53,"status":"PASS_FOOD_ALLERGEN_03","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Food businesses must manage allergens effectively during food preparation.","quality_score":"4","adoption":"FOOD_ALLERGEN_03","direct_score_input":false},{"row":54,"status":"PASS_FOOD_ALLERGEN_04","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Staff must receive training on allergens.","quality_score":"4","adoption":"FOOD_ALLERGEN_04","direct_score_input":false},{"row":55,"status":"PASS_FOOD_ALLERGEN_05","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Food businesses must identify when any of the 14 regulated allergens are used as ingredients.","quality_score":"4","adoption":"FOOD_ALLERGEN_05","direct_score_input":false},{"row":56,"status":"PASS_FOOD_ALLERGEN_06","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Allergen requirements also apply to relevant additives, processing aids and substances present in the final product.","quality_score":"4","adoption":"FOOD_ALLERGEN_06","direct_score_input":false},{"row":57,"status":"PASS_FOOD_ALLERGEN_07","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"For delivery or takeaway, written allergen information should be available before ordering and again when food is delivered.","quality_score":"4","adoption":"FOOD_ALLERGEN_07","direct_score_input":false},{"row":58,"status":"PASS_FOOD_ALLERGEN_08","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Kitchen controls should reduce allergen cross-contamination risks.","quality_score":"4","adoption":"FOOD_ALLERGEN_08","direct_score_input":false},{"row":59,"status":"PASS_WITH_FOOD_ALLERGEN_09","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"A precautionary allergen statement should not replace effective segregation, cleaning and risk control.","quality_score":"3","adoption":"FOOD_ALLERGEN_GUARD_09","direct_score_input":false},{"row":60,"status":"PASS_WITH_FOOD_ALLERGEN_10","source":"Food Standards Agency allergen guidance","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Allergen safety is product-, recipe- and process-specific and is not an exact parcel-level probability.","quality_score":"3","adoption":"FOOD_ALLERGEN_GUARD_10","direct_score_input":false}]}