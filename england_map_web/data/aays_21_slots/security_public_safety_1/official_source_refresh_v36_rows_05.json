{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V36","part":5,"rows":[{"row":81,"status":"PASS_EVENT_CROWD_SAFETY_01","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Event organisers are responsible for maintaining overall health and safety so far as reasonably practicable.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_01","direct_score_input":false},{"row":82,"status":"PASS_EVENT_CROWD_SAFETY_02","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Events should be planned, managed, monitored and reviewed after completion.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_02","direct_score_input":false},{"row":83,"status":"PASS_EVENT_CROWD_SAFETY_03","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Roles and responsibilities for crowd safety should be clearly allocated.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_03","direct_score_input":false},{"row":84,"status":"PASS_EVENT_CROWD_SAFETY_04","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Organisers should work with venue owners, contractors, emergency services and relevant authorities.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_04","direct_score_input":false},{"row":85,"status":"PASS_EVENT_CROWD_SAFETY_05","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Crowd-risk assessment should consider arrival, entry, circulation, exit and dispersal.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_05","direct_score_input":false},{"row":86,"status":"PASS_EVENT_CROWD_SAFETY_06","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Assessments should consider crowd movement, density, dynamics and behaviour.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_06","direct_score_input":false},{"row":87,"status":"PASS_EVENT_CROWD_SAFETY_07","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Venue and site design should support safe movement and emergency access.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_07","direct_score_input":false},{"row":88,"status":"PASS_EVENT_CROWD_SAFETY_08","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"A site plan should identify structures, barriers, routes, facilities and emergency arrangements.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_08","direct_score_input":false},{"row":89,"status":"PASS_EVENT_CROWD_SAFETY_09","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Controls should cover the periods before, during and after the event.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_09","direct_score_input":false},{"row":90,"status":"PASS_EVENT_CROWD_SAFETY_10","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Barriers should be selected and positioned for the loads and crowd behaviour expected.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_10","direct_score_input":false},{"row":91,"status":"PASS_EVENT_CROWD_SAFETY_11","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Transport and pedestrian interfaces should be planned.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_11","direct_score_input":false},{"row":92,"status":"PASS_EVENT_CROWD_SAFETY_12","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Organisers must plan for incidents, emergencies and evacuation where necessary.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_12","direct_score_input":false},{"row":93,"status":"PASS_EVENT_CROWD_SAFETY_13","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Emergency communications should provide clear official messages to the public.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_13","direct_score_input":false},{"row":94,"status":"PASS_EVENT_CROWD_SAFETY_14","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"First-aid and medical needs assessment should consider workers and the visiting public.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_14","direct_score_input":false},{"row":95,"status":"PASS_EVENT_CROWD_SAFETY_15","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Site operations should be actively monitored once physical activity begins.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_15","direct_score_input":false},{"row":96,"status":"PASS_EVENT_CROWD_SAFETY_16","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Changes in conditions should trigger review and adjustment of controls.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_16","direct_score_input":false},{"row":97,"status":"PASS_EVENT_CROWD_SAFETY_17","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Post-event review should capture incidents, near misses and lessons for future events.","quality_score":"4","adoption":"EVENT_CROWD_SAFETY_17","direct_score_input":false},{"row":98,"status":"PASS_WITH_EVENT_CROWD_SAFETY_18","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Safety Advisory Group involvement is advisory and does not transfer the organiser's legal responsibilities.","quality_score":"3","adoption":"EVENT_CROWD_SAFETY_GUARD_18","direct_score_input":false},{"row":99,"status":"PASS_WITH_EVENT_CROWD_SAFETY_19","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Crowd controls depend on event type, venue, attendance, weather, behaviour and live conditions.","quality_score":"3","adoption":"EVENT_CROWD_SAFETY_GUARD_19","direct_score_input":false},{"row":100,"status":"PASS_WITH_EVENT_CROWD_SAFETY_20","source":"HSE event and crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management.htm","verified":"Event-planning guidance is operational context and is not an exact parcel-level safety probability.","quality_score":"3","adoption":"EVENT_CROWD_SAFETY_GUARD_20","direct_score_input":false}]}