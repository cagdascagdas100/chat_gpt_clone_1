ecurity","verified":"Recovery and post-incident support are included in the security-planning cycle.","quality_score":"4","adoption":"SCHOOL_INCIDENT_RECOVERY","direct_score_input":false},{"row":57,"status":"PASS_DFE_SECURITY_STAFF_TRAINING","source":"DfE School and college security","url":"https://www.gov.uk/government/publications/school-and-college-security/school-and-college-security","verified":"Staff training is an explicit part of security preparedness.","quality_score":"4","adoption":"SCHOOL_SECURITY_TRAINING","direct_score_input":false},{"row":58,"status":"PASS_DFE_GENERIC_EMERGENCY_PLAN","source":"DfE School and college security","url":"https://www.gov.uk/government/publications/school-and-college-security/school-and-college-security","verified":"Emergency plans should be generic enough to cover a range of incidents.","quality_score":"4","adoption":"SCHOOL_GENERIC_EMERGENCY_PLAN","direct_score_input":false},{"row":59,"status":"PASS_WITH_DFE_SECURITY_NOT_EXHAUSTIVE","source":"DfE School and college security","url":"https://www.gov.uk/government/publications/school-and-college-security/school-and-college-security","verified":"The guidance explicitly does not provide an exhaustive list of security threats and must be combined with current local intelligence.","quality_score":"3","adoption":"SCHOOL_SECURITY_SCOPE_GUARD","direct_score_input":false},{"row":60,"status":"PASS_WITH_DFE_NOT_PARCEL_SCORE","source":"DfE safeguarding and security guidance","url":"https://www.gov.uk/government/publications/school-and-college-security/school-and-college-security","verified":"Safeguarding and security duties describe organisational controls and are not exact parcel-level safety probabilities.","quality_score":"3","adoption":"SCHOOL_CONTEXT_ONLY","direct_score_input":false}]}