{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V47","part":4,"rows":[{"row":61,"status":"PASS_LOLER_01","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Organisations undertaking lifting operations must manage and control lifting risks to prevent injury or damage.","quality_score":"4","adoption":"LOLER_01","direct_score_input":false},{"row":62,"status":"PASS_LOLER_02","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"All lifting operations involving lifting equipment must be properly planned.","quality_score":"4","adoption":"LOLER_02","direct_score_input":false},{"row":63,"status":"PASS_LOLER_03","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"People planning and carrying out lifting operations must be sufficiently competent.","quality_score":"4","adoption":"LOLER_03","direct_score_input":false},{"row":64,"status":"PASS_LOLER_04","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Lifting operations must be appropriately supervised.","quality_score":"4","adoption":"LOLER_04","direct_score_input":false},{"row":65,"status":"PASS_LOLER_05","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Lifting operations must be carried out in a safe manner.","quality_score":"4","adoption":"LOLER_05","direct_score_input":false},{"row":66,"status":"PASS_LOLER_06","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Equipment not designed for lifting people but liable to be misused that way must be clearly marked against lifting people.","quality_score":"4","adoption":"LOLER_06","direct_score_input":false},{"row":67,"status":"PASS_LOLER_07","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Thorough examinations are required during the lifetime of lifting equipment to detect and address deterioration.","quality_score":"4","adoption":"LOLER_07","direct_score_input":false},{"row":68,"status":"PASS_LOLER_08","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"The detail, resources and competence used in a lifting plan must reflect the complexity and risk of the operation.","quality_score":"4","adoption":"LOLER_08","direct_score_input":false},{"row":69,"status":"PASS_WITH_LOLER_09","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Lifting controls depend on equipment, load, environment, people, complexity, stability, accessories and examination status.","quality_score":"3","adoption":"LOLER_GUARD_09","direct_score_input":false},{"row":70,"status":"PASS_WITH_LOLER_10","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Lifting-operation evidence is equipment-, load- and operation-specific and is not an exact parcel-level dropped-load probability.","quality_score":"3","adoption":"LOLER_GUARD_10","direct_score_input":false},{"row":71,"status":"PASS_PUWER_01","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Work equipment provided for use must be suitable for its intended use.","quality_score":"4","adoption":"PUWER_01","direct_score_input":false},{"row":72,"status":"PASS_PUWER_02","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Work equipment must be safe, maintained in a safe condition and inspected where needed to prevent deterioration.","quality_score":"4","adoption":"PUWER_02","direct_score_input":false},{"row":73,"status":"PASS_PUWER_03","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Work equipment should be used only by people who have received adequate information, instruction and training.","quality_score":"4","adoption":"PUWER_03","direct_score_input":false},{"row":74,"status":"PASS_PUWER_04","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Suitable safety measures can include guarding, emergency stops, energy isolation, markings and warning devices.","quality_score":"4","adoption":"PUWER_04","direct_score_input":false},{"row":75,"status":"PASS_PUWER_05","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Work equipment includes machinery, appliances, apparatus, tools and installations used at work.","quality_score":"4","adoption":"PUWER_05","direct_score_input":false},{"row":76,"status":"PASS_PUWER_06","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/maintenance.htm","verified":"PUWER requires work equipment to be maintained in an efficient state, efficient order and good repair.","quality_score":"4","adoption":"PUWER_06","direct_score_input":false},{"row":77,"status":"PASS_PUWER_07","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/maintenance.htm","verified":"Maintenance operations must be planned and capable of being carried out safely by competent people.","quality_score":"4","adoption":"PUWER_07","direct_score_input":false},{"row":78,"status":"PASS_PUWER_08","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/training-competence.htm","verified":"Training must cover safe methods, risks arising from equipment use and the precautions to be taken.","quality_score":"4","adoption":"PUWER_08","direct_score_input":false},{"row":79,"status":"PASS_WITH_PUWER_09","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Work-equipment controls depend on equipment type, intended use, condition, guarding, energy sources, users and maintenance activity.","quality_score":"3","adoption":"PUWER_GUARD_09","direct_score_input":false},{"row":80,"status":"PASS_WITH_PUWER_10","source":"HSE work equipment and PUWER","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"PUWER evidence is equipment-, task- and user-specific and is not an exact parcel-level machinery-injury probability.","quality_score":"3","adoption":"PUWER_GUARD_10","direct_score_input":false}]}