{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V32","part":4,"rows":[{"row":61,"status":"PASS_WELDING_FUME_LUNG_CANCER","source":"HSE welding-fume overview","url":"https://www.hse.gov.uk/welding/protect-your-workers/index.htm","verified":"All welding fume can cause lung cancer.","quality_score":"4","adoption":"WELDING_FUME_CARCINOGEN","direct_score_input":false},{"row":62,"status":"PASS_WELDING_ANY_AMOUNT_SCOPE","source":"HSE welding-fume overview","url":"https://www.hse.gov.uk/welding/protect-your-workers/index.htm","verified":"The duty to control welding-fume risk applies to specialist and occasional welders regardless of how small the amount of welding is.","quality_score":"4","adoption":"WELDING_ALL_WORK_SCOPE","direct_score_input":false},{"row":63,"status":"PASS_WELDING_RISK_ASSESSMENT","source":"HSE welding controls","url":"https://www.hse.gov.uk/welding/welding-controls.htm","verified":"Employers must assess welding-fume exposure risks and identify suitable controls.","quality_score":"4","adoption":"WELDING_RISK_ASSESSMENT","direct_score_input":false},{"row":64,"status":"PASS_WELDING_COLD_JOINING","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Alternative cold-joining techniques should be considered to avoid welding fume.","quality_score":"4","adoption":"WELDING_COLD_JOINING","direct_score_input":false},{"row":65,"status":"PASS_WELDING_REDUCE_AMOUNT","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Reducing the amount of welding is an exposure-control option.","quality_score":"4","adoption":"WELDING_REDUCE_DURATION","direct_score_input":false},{"row":66,"status":"PASS_WELDING_LOWER_FUME_PROCESS","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Materials and processes that generate less fume should be considered.","quality_score":"4","adoption":"WELDING_LOW_FUME_PROCESS","direct_score_input":false},{"row":67,"status":"PASS_WELDING_AUTOMATE_MECHANISE","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Automation, mechanisation, distance welding or enclosure can reduce worker exposure.","quality_score":"4","adoption":"WELDING_AUTOMATION_CONTROL","direct_score_input":false},{"row":68,"status":"PASS_WELDING_LEV_INDOOR_SOURCE","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Indoor welding should use local exhaust ventilation to remove fume at source when welding cannot be avoided.","quality_score":"4","adoption":"WELDING_LEV_CONTROL","direct_score_input":false},{"row":69,"status":"PASS_WELDING_ON_TORCH_EXTRACTION","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"On-torch extraction is an official LEV option.","quality_score":"4","adoption":"WELDING_ON_TORCH_LEV","direct_score_input":false},{"row":70,"status":"PASS_WELDING_BOOTH_BENCH_LEV","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Extracted benches, booths and movable LEV are recognised source-control options.","quality_score":"4","adoption":"WELDING_LEV_OPTIONS","direct_score_input":false},{"row":71,"status":"PASS_WELDING_RPE_IF_LEV_INADEQUATE","source":"HSE welding controls","url":"https://www.hse.gov.uk/welding/welding-controls.htm","verified":"Suitable RPE is required where LEV alone does not adequately control welding fume or is not reasonably practicable.","quality_score":"4","adoption":"WELDING_RPE_FALLBACK","direct_score_input":false},{"row":72,"status":"PASS_WELDING_OUTDOOR_RPE","source":"HSE welding controls","url":"https://www.hse.gov.uk/welding/welding-controls.htm","verified":"Outdoor welding cannot rely on LEV, so suitable RPE is required.","quality_score":"4","adoption":"WELDING_OUTDOOR_RPE","direct_score_input":false},{"row":73,"status":"PASS_WITH_WELDING_FFP3_SHORT_DURATION","source":"HSE welding controls","url":"https://www.hse.gov.uk/welding/welding-controls.htm","verified":"For work not expected to exceed one hour, FFP3 or a half-mask with P3 filter may be adequate only when suitability and fit conditions are met.","quality_score":"3","adoption":"WELDING_SHORT_DURATION_RPE_GUARD","direct_score_input":false},{"row":74,"status":"PASS_WITH_WELDING_POWERED_RPE_LONGER","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Longer-duration work should use powered air-fed protection with at least APF20, subject to task-specific suitability.","quality_score":"3","adoption":"WELDING_LONG_DURATION_RPE_GUARD","direct_score_input":false},{"row":75,"status":"PASS_WELDING_CLEAN_SHAVEN","source":"HSE welding-fume controls","url":"https://www.hse.gov.uk/welding/protect-your-workers/avoid-reduce-exposure.htm","verified":"Tight-fitting RPE requires a clean-shaven sealing area.","quality_score":"4","adoption":"WELDING_RPE_SEAL","direct_score_input":false},{"row":76,"status":"PASS_WELDING_FACE_FIT","source":"HSE welding controls","url":"https://www.hse.gov.uk/welding/welding-controls.htm","verified":"Tight-fitting face-seal RPE requires face-fit testing for each wearer.","quality_score":"4","adoption":"WELDING_FACE_FIT","direct_score_input":false},{"row":77,"status":"PASS_WELDING_RPE_PROGRAMME","source":"HSE welding controls","url":"https://www.hse.gov.uk/welding/welding-controls.htm","verified":"An RPE management programme should cover fit testing, spare parts, clean storage and PPE compatibility.","quality_score":"4","adoption":"WELDING_RPE_PROGRAMME","direct_score_input":false},{"row":78,"status":"PASS_WELDING_LEV_14_MONTH_TEST","source":"HSE welding-control maintenance","url":"https://www.hse.gov.uk/welding/protect-your-workers/monitor-controls.htm","verified":"A competent ventilation engineer should thoroughly examine and test LEV performance at least every 14 months.","quality_score":"4","adoption":"WELDING_LEV_TEST_INTERVAL","direct_score_input":false},{"row":79,"status":"PASS_WELDING_RECORDS_5_YEARS","source":"HSE welding-control maintenance","url":"https://www.hse.gov.uk/welding/protect-your-workers/monitor-controls.htm","verified":"LEV examination and test records should be retained for at least five years.","quality_score":"4","adoption":"WELDING_LEV_RECORD_RETENTION","direct_score_input":false},{"row":80,"status":"PASS_WITH_WELDING_NOT_PARCEL_SCORE","source":"HSE welding-fume overview","url":"https://www.hse.gov.uk/welding/protect-your-workers/index.htm","verified":"Welding controls regulate work activity and are not a universal parcel-level safety probability.","quality_score":"3","adoption":"WELDING_CONTEXT_ONLY","direct_score_input":false}]}