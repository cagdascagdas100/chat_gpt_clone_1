{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V20","part":4,"rows":[{"row":55,"status":"PASS_LEGIONELLA_COSHH_FRAMEWORK","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"COSHH provides the framework for identifying, assessing and controlling legionella risk.","quality_score":"4","adoption":"COSHH_BIOLOGICAL_AGENT_GATE","direct_score_input":false},{"row":56,"status":"PASS_LEGIONELLA_CONTROL_DUTIES","source":"HSE Legionella duties","url":"https://www.hse.gov.uk/legionnaires/what-you-must-do/","verified":"Responsible persons must identify and assess sources, manage, prevent or control risks and maintain appropriate records.","quality_score":"4","adoption":"LEGIONELLA_CONTROL_CONTRACT","direct_score_input":false},{"row":57,"status":"PASS_LEGIONELLA_DOMESTIC_LOW_RISK","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Most regularly used domestic systems are generally low risk because water use and turnover are frequent.","quality_score":"4","adoption":"DOMESTIC_LOW_RISK_CONTEXT","direct_score_input":false},{"row":58,"status":"PASS_LEGIONELLA_TESTING_NOT_ROUTINE","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Microbiological sampling is not usually required for domestic hot and cold water systems.","quality_score":"4","adoption":"NO_ROUTINE_SAMPLING_GUARD","direct_score_input":false},{"row":59,"status":"PASS_LEGIONELLA_NO_TEST_CERTIFICATE","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Health and safety law does not require landlords to obtain a legionella test certificate.","quality_score":"4","adoption":"FALSE_CERTIFICATE_REQUIREMENT_GUARD","direct_score_input":false},{"row":60,"status":"PASS_LEGIONELLA_TEMPERATURE_MONITORING","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Temperature monitoring is distinguished from sampling and can confirm that a system remains controlled.","quality_score":"4","adoption":"TEMPERATURE_CONTROL_CHECK","direct_score_input":false},{"row":61,"status":"PASS_LEGIONELLA_NO_FIXED_REVIEW_INTERVAL","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"The law does not prescribe an annual or biennial risk-assessment review interval.","quality_score":"4","adoption":"NO_FALSE_REVIEW_FREQUENCY","direct_score_input":false},{"row":62,"status":"PASS_LEGIONELLA_PERIODIC_REVIEW","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Risk assessments should be reviewed periodically and when circumstances change.","quality_score":"4","adoption":"CHANGE_TRIGGERED_REVIEW","direct_score_input":false},{"row":63,"status":"PASS_LEGIONELLA_NO_PROACTIVE_DOMESTIC_INSPECTION","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"HSE and local authorities do not proactively inspect domestic premises for landlord legionella assessments.","quality_score":"4","adoption":"INSPECTION_MODEL_CONTEXT","direct_score_input":false},{"row":64,"status":"PASS_LEGIONELLA_LIABILITY","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"A landlord may face prosecution if a tenant contracts Legionnaires' disease and the legal duty was not fulfilled.","quality_score":"4","adoption":"ENFORCEMENT_CONTEXT","direct_score_input":false},{"row":65,"status":"PASS_LEGIONELLA_GROWTH_TEMPERATURE","source":"HSE workplace Legionella risks","url":"https://www.hse.gov.uk/legionnaires/workplace-risks.htm","verified":"A foreseeable growth risk exists where water temperatures are between 20°C and 45°C.","quality_score":"4","adoption":"GROWTH_TEMPERATURE_RANGE","direct_score_input":false},{"row":66,"status":"PASS_LEGIONELLA_RISK_FACTORS","source":"HSE workplace Legionella risks","url":"https://www.hse.gov.uk/legionnaires/workplace-risks.htm","verified":"Risk increases with aerosol generation, stored or recirculated water and nutrients such as rust, sludge, scale and biofilm.","quality_score":"4","adoption":"SYSTEM_RISK_FACTOR_SCHEMA","direct_score_input":false},{"row":67,"status":"PASS_MARTYNS_RESOURCES_CURRENT","source":"ProtectUK Martyn's Law resources","url":"https://www.protectuk.police.uk/martyns-law/resources","verified":"ProtectUK published an updated Martyn's Law resource collection on 16 July 2026.","quality_score":"4","adoption":"CURRENT_PROTECTIVE_SECURITY_RESOURCES","direct_score_input":false},{"row":68,"status":"PASS_MARTYNS_STATUTORY_GUIDANCE","source":"ProtectUK Martyn's Law resources","url":"https://www.protectuk.police.uk/martyns-law/resources","verified":"The collection links statutory guidance covering scope, core concepts and legal compliance.","quality_score":"4","adoption":"STATUTORY_GUIDANCE_DISCOVERY","direct_score_input":false},{"row":69,"status":"PASS_MARTYNS_SIA_REGULATOR","source":"ProtectUK Martyn's Law resources","url":"https://www.protectuk.police.uk/martyns-law/resources","verified":"The Security Industry Authority is identified as the regulator responsible for oversight and enforcement.","quality_score":"4","adoption":"REGULATOR_IDENTITY_GATE","direct_score_input":false},{"row":70,"status":"PASS_ACT_AWARENESS_CURRENT","source":"ProtectUK ACT Awareness","url":"https://www.protectuk.police.uk/group/130","verified":"The ACT Awareness e-learning page was updated on 26 May 2026 and describes a 45-minute course with six core chapters.","quality_score":"4","adoption":"CURRENT_ACT_TRAINING","direct_score_input":false},{"row":71,"status":"PASS_WITH_ACT_REGISTRATION_CAVEAT","source":"ProtectUK ACT Awareness","url":"https://www.protectuk.police.uk/group/130","verified":"Course completion and certificate access require user registration, so it is not treated as an unauthenticated data source.","quality_score":"3","adoption":"REGISTRATION_REQUIRED_GUARD","direct_score_input":false},{"row":72,"status":"PASS_ACT_TOPIC_SCOPE","source":"ProtectUK ACT Awareness","url":"https://www.protectuk.police.uk/group/130","verified":"Core topics include suspicious activity and items, marauding attacks and security vulnerabilities.","quality_score":"4","adoption":"SECURITY_AWARENESS_TOPIC_SCOPE","direct_score_input":false}]}