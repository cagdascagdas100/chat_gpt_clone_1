{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V26","part":3,"rows":[{"row":41,"status":"PASS_RADON_NATURAL_GAS_DEFINITION","source":"UKHSA UKradon","url":"https://www.ukradon.org/information/level","verified":"Radon is a colourless, odourless radioactive gas formed by decay of naturally occurring uranium in rocks and soils.","quality_score":"4","adoption":"RADON_HAZARD_DEFINITION","direct_score_input":false},{"row":42,"status":"PASS_RADON_ACTION_LEVEL","source":"UKHSA UKradon Action Level","url":"https://www.ukradon.org/information/level","verified":"UKHSA recommends reducing residential radon where the annual average is at or above 200 Bq per cubic metre.","quality_score":"4","adoption":"RADON_ACTION_LEVEL","direct_score_input":false},{"row":43,"status":"PASS_RADON_TARGET_LEVEL","source":"UKHSA UKradon Target Level","url":"https://www.ukradon.org/information/level","verified":"The UK radon Target Level is 100 Bq per cubic metre for remediation and protection outcomes.","quality_score":"4","adoption":"RADON_TARGET_LEVEL","direct_score_input":false},{"row":44,"status":"PASS_RADON_AFFECTED_AREA_THRESHOLD","source":"UKHSA-BGS radon map","url":"https://www.ukradon.org/radonmaps/","verified":"A radon Affected Area has at least a 1% estimated chance of a home reaching or exceeding the 200 Bq per cubic metre Action Level.","quality_score":"4","adoption":"RADON_AFFECTED_AREA_THRESHOLD","direct_score_input":false},{"row":45,"status":"PASS_RADON_MAP_1KM_GRID","source":"BGS indicative radon atlas","url":"https://www.data.gov.uk/dataset/fb44e1b8-3cce-477e-84fa-c4a45fc36b75/indicative-atlas-of-radon-potential-for-great-britain-version-34","verified":"The indicative atlas classifies one-kilometre grid squares by the highest mapped radon potential within each square.","quality_score":"4","adoption":"RADON_GRID_CONTRACT","direct_score_input":false},{"row":46,"status":"PASS_RADON_MAP_PROBABILITY_BANDS","source":"UKHSA UK radon maps","url":"https://www.ukradon.org/information/ukmaps","verified":"Map shading represents increasing probability of higher indoor radon, from below one home in one hundred to above one in three.","quality_score":"4","adoption":"RADON_PROBABILITY_BANDS","direct_score_input":false},{"row":47,"status":"PASS_RADON_ADDRESS_SEARCH_PURPOSE","source":"UKHSA radon address search","url":"https://www.ukradon.org/services/address_search","verified":"An address search reports the estimated probability that an address is above the Action Level.","quality_score":"4","adoption":"RADON_ADDRESS_PROBABILITY","direct_score_input":false},{"row":48,"status":"PASS_RADON_SEARCH_NOT_MEASUREMENT","source":"UKHSA radon address search","url":"https://www.ukradon.org/services/address_search","verified":"An address report gives estimated risk, not the measured radon concentration at that address.","quality_score":"4","adoption":"RADON_SEARCH_MEASUREMENT_SEPARATION","direct_score_input":false},{"row":49,"status":"PASS_RADON_MEASUREMENT_ONLY_CONFIRMATION","source":"UKHSA radon address search","url":"https://www.ukradon.org/services/address_search","verified":"Only a radon measurement can determine whether a property is above or below the Action Level.","quality_score":"4","adoption":"RADON_MEASUREMENT_CONFIRMATION","direct_score_input":false},{"row":50,"status":"PASS_RADON_THREE_MONTH_TEST","source":"UKHSA measuring radon","url":"https://www.ukradon.org/information/measuringradon","verified":"A typical validated domestic assessment uses a three-month test to average short-term and seasonal variation.","quality_score":"4","adoption":"RADON_THREE_MONTH_METHOD","direct_score_input":false},{"row":51,"status":"PASS_RADON_TWO_DETECTOR_METHOD","source":"UKHSA measuring radon","url":"https://www.ukradon.org/information/measuringradon","verified":"Domestic testing normally places one detector in a living area and one in an occupied bedroom.","quality_score":"4","adoption":"RADON_TWO_DETECTOR_METHOD","direct_score_input":false},{"row":52,"status":"PASS_RADON_VALIDATED_LAB","source":"UKHSA measuring radon","url":"https://www.ukradon.org/information/measuringradon","verified":"UKHSA advises using a validated laboratory for radon measurement.","quality_score":"4","adoption":"VALIDATED_RADON_LAB_GATE","direct_score_input":false},{"row":53,"status":"PASS_RADON_SHORT_TEST_UNCERTAINTY","source":"UKHSA measuring radon","url":"https://www.ukradon.org/information/measuringradon","verified":"Shorter tests have greater uncertainty because indoor radon varies substantially from day to day and with weather.","quality_score":"4","adoption":"SHORT_TEST_UNCERTAINTY_GUARD","direct_score_input":false},{"row":54,"status":"PASS_RADON_BASEMENT_EXTRA_RISK","source":"UKHSA radon map guidance","url":"https://www.ukradon.org/information/ukmaps","verified":"Basements, cellars and underground sites are treated as having additional potential for high radon regardless of map colour.","quality_score":"4","adoption":"UNDERGROUND_ROOM_RADON_GUARD","direct_score_input":false},{"row":55,"status":"PASS_RADON_BUILDING_PROTECTION","source":"UKHSA radon and Building Regulations","url":"https://www.ukradon.org/information/buildingregs","verified":"New buildings and extensions in relevant high-radon areas may require basic or full protective measures under Building Regulations guidance.","quality_score":"4","adoption":"RADON_BUILDING_PROTECTION","direct_score_input":false},{"row":56,"status":"PASS_RADON_ACTIVE_SUMP","source":"UKHSA radon sumps","url":"https://www.ukradon.org/information/reducelevels_sump","verified":"An active fan-assisted radon sump is identified as the most effective common method for reducing indoor radon under suitable floors.","quality_score":"4","adoption":"ACTIVE_RADON_SUMP_CONTROL","direct_score_input":false},{"row":57,"status":"PASS_RADON_POSITIVE_VENTILATION","source":"UKHSA positive ventilation","url":"https://www.ukradon.org/information/reducelevels_positivevent","verified":"Positive ventilation can dilute indoor radon and may reduce entry from the ground.","quality_score":"4","adoption":"POSITIVE_VENTILATION_CONTROL","direct_score_input":false},{"row":58,"status":"PASS_WITH_RADON_MAP_INDICATIVE","source":"BGS indicative radon atlas","url":"https://www.data.gov.uk/dataset/fb44e1b8-3cce-477e-84fa-c4a45fc36b75/indicative-atlas-of-radon-potential-for-great-britain-version-34","verified":"The free atlas is indicative and simplified; it is not a definitive address-level result.","quality_score":"3","adoption":"INDICATIVE_MAP_GUARD","direct_score_input":false},{"row":59,"status":"PASS_WITH_RADON_ADDRESS_SCOPE_LIMIT","source":"UKHSA radon address search","url":"https://www.ukradon.org/services/address_search","verified":"The standard address search is unsuitable for large buildings over 25 metres and development plots require a BGS GeoReport.","quality_score":"3","adoption":"RADON_SEARCH_SCOPE_GUARD","direct_score_input":false},{"row":60,"status":"PASS_WITH_RADON_PROBABILITY_NOT_LEVEL","source":"UKHSA UKradon","url":"https://www.ukradon.org/services/address_search","verified":"Mapped or searched probability is not converted into a measured parcel radon level; testing remains required.","quality_score":"3","adoption":"RADON_CONTEXT_NOT_MEASUREMENT","direct_score_input":false}]}