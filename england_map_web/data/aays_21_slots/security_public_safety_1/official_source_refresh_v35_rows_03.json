{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V35","part":3,"rows":[{"row":81,"status":"PASS_CONFINED_ENCLOSED_AND_SPECIFIED_RISK","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"A confined space is enclosed or largely enclosed and has a reasonably foreseeable specified risk.","quality_score":"4","adoption":"PASS_CONFINED_ENCLOSED_AND_SPECIFIED_RISK","direct_score_input":false},{"row":82,"status":"PASS_CONFINED_FIRE_RISK","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Fire is one of the specified risks that can make an enclosed space a confined space.","quality_score":"4","adoption":"PASS_CONFINED_FIRE_RISK","direct_score_input":false},{"row":83,"status":"PASS_CONFINED_EXPLOSION_RISK","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Explosion is one of the specified confined-space risks.","quality_score":"4","adoption":"PASS_CONFINED_EXPLOSION_RISK","direct_score_input":false},{"row":84,"status":"PASS_CONFINED_LOSS_CONSCIOUSNESS","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Loss of consciousness is a specified confined-space risk.","quality_score":"4","adoption":"PASS_CONFINED_LOSS_CONSCIOUSNESS","direct_score_input":false},{"row":85,"status":"PASS_CONFINED_ASPHYXIATION","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Asphyxiation is a specified confined-space risk.","quality_score":"4","adoption":"PASS_CONFINED_ASPHYXIATION","direct_score_input":false},{"row":86,"status":"PASS_CONFINED_DROWNING","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Drowning is a specified confined-space risk.","quality_score":"4","adoption":"PASS_CONFINED_DROWNING","direct_score_input":false},{"row":87,"status":"PASS_CONFINED_SIZE_NOT_DETERMINATIVE","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"A confined space can be small and restrictive or a much larger enclosure such as a grain silo.","quality_score":"4","adoption":"PASS_CONFINED_SIZE_NOT_DETERMINATIVE","direct_score_input":false},{"row":88,"status":"PASS_CONFINED_AVOID_ENTRY","source":"HSE confined-space legislation","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"Where possible, entry should be avoided by carrying out the work from outside.","quality_score":"4","adoption":"PASS_CONFINED_AVOID_ENTRY","direct_score_input":false},{"row":89,"status":"PASS_CONFINED_SAFE_SYSTEM","source":"HSE confined-space legislation","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"If entry is unavoidable, a safe system of work is required.","quality_score":"4","adoption":"PASS_CONFINED_SAFE_SYSTEM","direct_score_input":false},{"row":90,"status":"PASS_CONFINED_EMERGENCY_BEFORE_START","source":"HSE confined-space legislation","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"Adequate emergency arrangements must be in place before confined-space work starts.","quality_score":"4","adoption":"PASS_CONFINED_EMERGENCY_BEFORE_START","direct_score_input":false},{"row":91,"status":"PASS_CONFINED_SUITABLE_RISK_ASSESSMENT","source":"HSE confined-space legislation","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"Employers and self-employed people must complete a suitable and sufficient risk assessment.","quality_score":"4","adoption":"PASS_CONFINED_SUITABLE_RISK_ASSESSMENT","direct_score_input":false},{"row":92,"status":"PASS_CONFINED_IDENTIFY_HAZARDS","source":"HSE confined-space legislation","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"The assessment must identify confined-space hazards.","quality_score":"4","adoption":"PASS_CONFINED_IDENTIFY_HAZARDS","direct_score_input":false},{"row":93,"status":"PASS_CONFINED_DETERMINE_PRECAUTIONS","source":"HSE confined-space legislation","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"The assessment must determine the precautions needed for the work.","quality_score":"4","adoption":"PASS_CONFINED_DETERMINE_PRECAUTIONS","direct_score_input":false},{"row":94,"status":"PASS_CONFINED_VENTILATE_FUMES","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Harmful fumes may require ventilation or removal before or during entry.","quality_score":"4","adoption":"PASS_CONFINED_VENTILATE_FUMES","direct_score_input":false},{"row":95,"status":"PASS_CONFINED_LOCK_VALVES","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Where liquids or gases could enter, valves may need to be securely isolated or locked shut.","quality_score":"4","adoption":"PASS_CONFINED_LOCK_VALVES","direct_score_input":false},{"row":96,"status":"PASS_CONFINED_CAPABLE_TRAINED","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"People doing confined-space work must be capable and trained in the work and emergency equipment.","quality_score":"4","adoption":"PASS_CONFINED_CAPABLE_TRAINED","direct_score_input":false},{"row":97,"status":"PASS_CONFINED_RESCUE_PLAN","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Emergency arrangements must explain how a person will be monitored and rescued if overcome.","quality_score":"4","adoption":"PASS_CONFINED_RESCUE_PLAN","direct_score_input":false},{"row":98,"status":"PASS_WITH_CONFINED_NO_RELIANCE_ON_EMERGENCY_SERVICES","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Relying only on the public emergency services is not an adequate confined-space rescue plan.","quality_score":"3","adoption":"PASS_WITH_CONFINED_NO_RELIANCE_ON_EMERGENCY_SERVICES","direct_score_input":false},{"row":99,"status":"PASS_WITH_CONFINED_ATMOSPHERE_CAN_CHANGE","source":"HSE confined spaces introduction","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"A space that was safe previously may not remain safe because the atmosphere and process conditions can change.","quality_score":"3","adoption":"PASS_WITH_CONFINED_ATMOSPHERE_CAN_CHANGE","direct_score_input":false},{"row":100,"status":"PASS_WITH_CONFINED_NOT_PARCEL_SCORE","source":"HSE confined spaces guide","url":"https://www.hse.gov.uk/pubns/indg258.htm","verified":"Confined-space duties are entry- and task-specific and are not converted into parcel-level probability.","quality_score":"3","adoption":"PASS_WITH_CONFINED_NOT_PARCEL_SCORE","direct_score_input":false},{"row":101,"status":"PASS_LOAD_ALL_LOADS_SECURE","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"All loads carried on vehicles must be secure regardless of vehicle, load type or journey length.","quality_score":"4","adoption":"PASS_LOAD_ALL_LOADS_SECURE","direct_score_input":false},{"row":102,"status":"PASS_LOAD_PROTECT_WORKERS_PUBLIC","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"Safe load securing protects loaders, unloaders, drivers, road users and pedestrians.","quality_score":"4","adoption":"PASS_LOAD_PROTECT_WORKERS_PUBLIC","direct_score_input":false},{"row":103,"status":"PASS_LOAD_HANDLING_EFFECT","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"An unsecured load can affect vehicle handling.","quality_score":"4","adoption":"PASS_LOAD_HANDLING_EFFECT","direct_score_input":false},{"row":104,"status":"PASS_LOAD_BRAKING_DISTANCE","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"An unsecured load can increase braking distance.","quality_score":"4","adoption":"PASS_LOAD_BRAKING_DISTANCE","direct_score_input":false},{"row":105,"status":"PASS_LOAD_ROLLOVER","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"An unsecured load can increase rollover risk.","quality_score":"4","adoption":"PASS_LOAD_ROLLOVER","direct_score_input":false},{"row":106,"status":"PASS_LOAD_SMALL_ITEMS_FATAL","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"Even small light items can kill if they fall from a moving vehicle.","quality_score":"4","adoption":"PASS_LOAD_SMALL_ITEMS_FATAL","direct_score_input":false},{"row":107,"status":"PASS_LOAD_SHARED_RESPONSIBILITY","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"Operators, drivers and consignors all have load-security responsibilities.","quality_score":"4","adoption":"PASS_LOAD_SHARED_RESPONSIBILITY","direct_score_input":false},{"row":108,"status":"PASS_LOAD_DRIVER_CHECK_BEFORE_SET_OFF","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"Drivers should check load security before setting off where they can.","quality_score":"4","adoption":"PASS_LOAD_DRIVER_CHECK_BEFORE_SET_OFF","direct_score_input":false},{"row":109,"status":"PASS_LOAD_DOUBT_DO_NOT_PROCEED","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"A driver should not proceed if there is doubt about load security.","quality_score":"4","adoption":"PASS_LOAD_DOUBT_DO_NOT_PROCEED","direct_score_input":false},{"row":110,"status":"PASS_LOAD_RESTRAINT_CHECKS_JOURNEY","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"Load restraints should be checked during the journey, especially after settling, harsh braking or swerving.","quality_score":"4","adoption":"PASS_LOAD_RESTRAINT_CHECKS_JOURNEY","direct_score_input":false},{"row":111,"status":"PASS_LOAD_CONSIGNOR_STABLE_PACKAGE","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"The consignor must make the load stable and package it so that it can be secured.","quality_score":"4","adoption":"PASS_LOAD_CONSIGNOR_STABLE_PACKAGE","direct_score_input":false},{"row":112,"status":"PASS_LOAD_PLAN_CONTENT","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"A load plan can record weight, placement, securing method, unloading precautions and a dated photograph.","quality_score":"4","adoption":"PASS_LOAD_PLAN_CONTENT","direct_score_input":false},{"row":113,"status":"PASS_LOAD_SYSTEM_COMPONENTS","source":"DVSA load-securing basics","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/2-load-securing-the-basics","verified":"A securing system can combine vehicle structure, movement barriers, lashings and friction surfaces.","quality_score":"4","adoption":"PASS_LOAD_SYSTEM_COMPONENTS","direct_score_input":false},{"row":114,"status":"PASS_LOAD_NO_SINGLE_SYSTEM","source":"DVSA load-securing basics","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/2-load-securing-the-basics","verified":"No single securing system is suitable for every load and vehicle combination.","quality_score":"4","adoption":"PASS_LOAD_NO_SINGLE_SYSTEM","direct_score_input":false},{"row":115,"status":"PASS_LOAD_SHIFT_SLOW_STOP","source":"DVSA unstable-load guidance","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/3-what-to-do-if-a-load-becomes-unstable-during-a-journey","verified":"If a load shifts, the driver must slow down, avoid heavy braking or steering and find a safe stopping place.","quality_score":"4","adoption":"PASS_LOAD_SHIFT_SLOW_STOP","direct_score_input":false},{"row":116,"status":"PASS_LOAD_MUST_RESECURE","source":"DVSA unstable-load guidance","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/3-what-to-do-if-a-load-becomes-unstable-during-a-journey","verified":"A journey must not continue until a shifted load is secure.","quality_score":"4","adoption":"PASS_LOAD_MUST_RESECURE","direct_score_input":false},{"row":117,"status":"PASS_LOAD_ATTACHMENT_STRENGTH","source":"DVSA load-securing methods","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/4-ways-to-secure-a-load-in-an-hgv-or-goods-vehicle","verified":"Attachment points must be strong enough for the expected loads.","quality_score":"4","adoption":"PASS_LOAD_ATTACHMENT_STRENGTH","direct_score_input":false},{"row":118,"status":"PASS_WITH_LOAD_CODE_NOT_ENFORCEMENT_STANDARD","source":"DVSA load-security code","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/about-the-code-of-practice","verified":"The code supports compliance but DVSA and police use defect categorisation rather than the code itself to decide enforcement action.","quality_score":"3","adoption":"PASS_WITH_LOAD_CODE_NOT_ENFORCEMENT_STANDARD","direct_score_input":false},{"row":119,"status":"PASS_WITH_LOAD_DYNAMIC_RECHECK","source":"DVSA load security responsibilities","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"Load security can change during a journey as restraints lose tension or loads settle, so an initial check is not permanent proof.","quality_score":"3","adoption":"PASS_WITH_LOAD_DYNAMIC_RECHECK","direct_score_input":false},{"row":120,"status":"PASS_WITH_LOAD_NOT_PARCEL_SCORE","source":"DVSA load security","url":"https://www.gov.uk/guidance/securing-loads-on-hgvs-and-goods-vehicles/1-responsibility-for-load-security","verified":"Vehicle load controls describe a transport operation and are not parcel-level safety probabilities.","quality_score":"3","adoption":"PASS_WITH_LOAD_NOT_PARCEL_SCORE","direct_score_input":false}]}