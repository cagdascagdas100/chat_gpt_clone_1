{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V82","part":3,"rows":[{"row":41,"status":"PASS_MUMPS_01","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/publications/mumps-the-green-book-chapter","verified":"Mumps is an acute viral illness caused by a paramyxovirus.","quality_score":"4","adoption":"MUMPS_01","direct_score_input":false},{"row":42,"status":"PASS_MUMPS_02","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/collections/mumps-guidance-data-and-analysis","verified":"Mumps is commonly characterised by parotid swelling, which may be bilateral or unilateral.","quality_score":"4","adoption":"MUMPS_02","direct_score_input":false},{"row":43,"status":"PASS_MUMPS_03","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/publications/mumps-confirmed-cases-and-notifications/mumps-confirmed-cases-and-notifications","verified":"Asymptomatic mumps infection is common, particularly in children.","quality_score":"4","adoption":"MUMPS_03","direct_score_input":false},{"row":44,"status":"PASS_MUMPS_04","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/publications/measles-mumps-and-rubella-lab-confirmed-cases-in-england-2025","verified":"MMR or MMRV vaccination is the principal population-level prevention measure for mumps.","quality_score":"4","adoption":"MUMPS_04","direct_score_input":false},{"row":45,"status":"PASS_MUMPS_05","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/publications/mumps-the-green-book-chapter","verified":"Mumps is a notifiable disease and suspected cases should be reported through health-protection arrangements.","quality_score":"4","adoption":"MUMPS_05","direct_score_input":false},{"row":46,"status":"PASS_MUMPS_06","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/collections/mumps-guidance-data-and-analysis","verified":"UKHSA enhanced surveillance uses oral-fluid, serum or PCR testing to confirm reported cases.","quality_score":"4","adoption":"MUMPS_06","direct_score_input":false},{"row":47,"status":"PASS_MUMPS_07","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/publications/mumps-confirmed-cases-and-notifications/mumps-confirmed-cases-and-notifications","verified":"UKHSA publishes quarterly laboratory-confirmed mumps reports and notification data.","quality_score":"4","adoption":"MUMPS_07","direct_score_input":false},{"row":48,"status":"PASS_MUMPS_08","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/publications/measles-mumps-and-rubella-lab-confirmed-cases-in-england-2025","verified":"The Green Book mumps chapter was updated in 2026 to reflect the routine vaccination schedule and MMRV programme.","quality_score":"4","adoption":"MUMPS_08","direct_score_input":false},{"row":49,"status":"PASS_WITH_MUMPS_09","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/publications/mumps-the-green-book-chapter","verified":"Mumps risk depends on vaccination history, immunity, contact intensity, setting, age, outbreak status, testing and timing.","quality_score":"3","adoption":"MUMPS_GUARD_09","direct_score_input":false},{"row":50,"status":"PASS_WITH_MUMPS_10","source":"UKHSA mumps immunisation and surveillance","url":"https://www.gov.uk/government/collections/mumps-guidance-data-and-analysis","verified":"UKHSA mumps evidence is case-, contact-, vaccine-, setting-, laboratory- and time-specific and is not an exact parcel-level infection probability.","quality_score":"3","adoption":"MUMPS_GUARD_10","direct_score_input":false},{"row":51,"status":"PASS_HEPATITIS_E_01","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/collections/hepatitis-e","verified":"Hepatitis E is liver inflammation caused by hepatitis E virus, which can infect humans and animals.","quality_score":"4","adoption":"HEPATITIS_E_01","direct_score_input":false},{"row":52,"status":"PASS_HEPATITIS_E_02","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/publications/hepatitis-e-symptoms-transmission-prevention-treatment/hepatitis-e-symptoms-transmission-treatment-and-prevention","verified":"HEV infection is often mild or asymptomatic but outcomes can range to acute liver failure.","quality_score":"4","adoption":"HEPATITIS_E_02","direct_score_input":false},{"row":53,"status":"PASS_HEPATITIS_E_03","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/publications/hepatitis-e-health-protection-response-to-reports-of-infection","verified":"Pregnant people, older people, people with chronic liver disease and immunosuppressed people can experience more severe disease.","quality_score":"4","adoption":"HEPATITIS_E_03","direct_score_input":false},{"row":54,"status":"PASS_HEPATITIS_E_04","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/guidance/viral-hepatitis-a-guide-to-local-and-national-data","verified":"In immunosuppressed people, hepatitis E can persist and cause chronic liver inflammation.","quality_score":"4","adoption":"HEPATITIS_E_04","direct_score_input":false},{"row":55,"status":"PASS_HEPATITIS_E_05","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/collections/hepatitis-e","verified":"Thorough cooking of meat and meat products reduces foodborne hepatitis-E risk.","quality_score":"4","adoption":"HEPATITIS_E_05","direct_score_input":false},{"row":56,"status":"PASS_HEPATITIS_E_06","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/publications/hepatitis-e-symptoms-transmission-prevention-treatment/hepatitis-e-symptoms-transmission-treatment-and-prevention","verified":"People should avoid raw or undercooked meat and shellfish and use safe water practices when travelling where sanitation is poor.","quality_score":"4","adoption":"HEPATITIS_E_06","direct_score_input":false},{"row":57,"status":"PASS_HEPATITIS_E_07","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/publications/hepatitis-e-health-protection-response-to-reports-of-infection","verified":"Handwashing after toilet use and before preparing or eating food is an important prevention measure.","quality_score":"4","adoption":"HEPATITIS_E_07","direct_score_input":false},{"row":58,"status":"PASS_HEPATITIS_E_08","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/guidance/viral-hepatitis-a-guide-to-local-and-national-data","verified":"Hepatitis E is notifiable and UKHSA uses surveillance and follow-up information to understand transmission and disease burden.","quality_score":"4","adoption":"HEPATITIS_E_08","direct_score_input":false},{"row":59,"status":"PASS_WITH_HEPATITIS_E_09","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/collections/hepatitis-e","verified":"Hepatitis-E risk depends on food source, cooking, sanitation, travel, pregnancy, immune status, liver disease, exposure timing and viral genotype.","quality_score":"3","adoption":"HEPATITIS_E_GUARD_09","direct_score_input":false},{"row":60,"status":"PASS_WITH_HEPATITIS_E_10","source":"UKHSA hepatitis-E prevention and surveillance","url":"https://www.gov.uk/government/publications/hepatitis-e-symptoms-transmission-prevention-treatment/hepatitis-e-symptoms-transmission-treatment-and-prevention","verified":"UKHSA hepatitis-E evidence is source-, food-, traveller-, patient-, surveillance- and time-specific and is not an exact parcel-level infection probability.","quality_score":"3","adoption":"HEPATITIS_E_GUARD_10","direct_score_input":false}]}