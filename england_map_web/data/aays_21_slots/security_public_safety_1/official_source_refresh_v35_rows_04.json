{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V35","part":4,"rows":[{"row":121,"status":"PASS_LASER_AIRCRAFT_HAZARD","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser illumination can distract or impair flight crew and create an aviation safety hazard.","quality_score":"4","adoption":"PASS_LASER_AIRCRAFT_HAZARD","direct_score_input":false},{"row":122,"status":"PASS_LASER_HIGH_WORKLOAD_PHASE","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser attacks during approach and landing can affect crews during high-workload phases of flight.","quality_score":"4","adoption":"PASS_LASER_HIGH_WORKLOAD_PHASE","direct_score_input":false},{"row":123,"status":"PASS_LASER_TEMPORARY_VISION_IMPAIRMENT","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"A laser strike can temporarily impair a pilot's vision.","quality_score":"4","adoption":"PASS_LASER_TEMPORARY_VISION_IMPAIRMENT","direct_score_input":false},{"row":124,"status":"PASS_LASER_CONTROL_TRANSFER","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"A laser-impaired pilot may need to transfer control to another crew member.","quality_score":"4","adoption":"PASS_LASER_CONTROL_TRANSFER","direct_score_input":false},{"row":125,"status":"PASS_LASER_SINGLE_PILOT_CONCERN","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser attacks are a particular concern for single-pilot operations without another crew member to take control.","quality_score":"4","adoption":"PASS_LASER_SINGLE_PILOT_CONCERN","direct_score_input":false},{"row":126,"status":"PASS_LASER_GENERAL_AVIATION_SCOPE","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"General aviation aircraft can be targeted by lasers.","quality_score":"4","adoption":"PASS_LASER_GENERAL_AVIATION_SCOPE","direct_score_input":false},{"row":127,"status":"PASS_LASER_EMERGENCY_HELICOPTER_SCOPE","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Emergency helicopter flights can be targeted by lasers.","quality_score":"4","adoption":"PASS_LASER_EMERGENCY_HELICOPTER_SCOPE","direct_score_input":false},{"row":128,"status":"PASS_LASER_AIRPORT_PROXIMITY","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser attacks are frequently associated with areas near large city airports.","quality_score":"4","adoption":"PASS_LASER_AIRPORT_PROXIMITY","direct_score_input":false},{"row":129,"status":"PASS_LASER_POLICE_REPORTING","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"A person who sees a laser being shone at an aircraft should contact the police.","quality_score":"4","adoption":"PASS_LASER_POLICE_REPORTING","direct_score_input":false},{"row":130,"status":"PASS_LASER_MISUSE_ACT","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"The Laser Misuse (Vehicles) Act 2018 applies to conduct that endangers an aircraft.","quality_score":"4","adoption":"PASS_LASER_MISUSE_ACT","direct_score_input":false},{"row":131,"status":"PASS_LASER_UNLIMITED_FINE","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"A laser offence endangering an aircraft can attract an unlimited fine.","quality_score":"4","adoption":"PASS_LASER_UNLIMITED_FINE","direct_score_input":false},{"row":132,"status":"PASS_LASER_UP_TO_FIVE_YEARS","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"A laser offence endangering an aircraft can lead to imprisonment of up to five years.","quality_score":"4","adoption":"PASS_LASER_UP_TO_FIVE_YEARS","direct_score_input":false},{"row":133,"status":"PASS_LASER_WORKING_GROUP","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"The CAA coordinates the UK Laser Working Group to address laser-attack risks.","quality_score":"4","adoption":"PASS_LASER_WORKING_GROUP","direct_score_input":false},{"row":134,"status":"PASS_LASER_CURRENT_NOTICE","source":"CAA Safety Notice 2020/017 version 4","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"CAA Safety Notice SN-2020/017 version 4 is current and dated 24 November 2025.","quality_score":"4","adoption":"PASS_LASER_CURRENT_NOTICE","direct_score_input":false},{"row":135,"status":"PASS_LASER_NOTICE_REPORTING","source":"CAA Safety Notice 2020/017 version 4","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"The current notice addresses reporting requirements for laser attacks.","quality_score":"4","adoption":"PASS_LASER_NOTICE_REPORTING","direct_score_input":false},{"row":136,"status":"PASS_LASER_NOTICE_DURING_AFTER_ACTIONS","source":"CAA Safety Notice 2020/017 version 4","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"The notice provides actions for operators and crews during and after a laser attack.","quality_score":"4","adoption":"PASS_LASER_NOTICE_DURING_AFTER_ACTIONS","direct_score_input":false},{"row":137,"status":"PASS_LASER_NOTICE_EYE_HEALTH","source":"CAA Safety Notice 2020/017 version 4","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"The notice provides eye-health guidance following laser exposure.","quality_score":"4","adoption":"PASS_LASER_NOTICE_EYE_HEALTH","direct_score_input":false},{"row":138,"status":"PASS_WITH_LASER_HISTORIC_COUNTS","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Incident counts shown on the safety-plan page are historical and must not be treated as a current live incident total.","quality_score":"3","adoption":"PASS_WITH_LASER_HISTORIC_COUNTS","direct_score_input":false},{"row":139,"status":"PASS_WITH_LASER_REPORT_NOT_FINAL_CAUSE","source":"CAA laser safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/sn-2020017v4/","verified":"A reported laser occurrence is a safety signal and does not by itself establish final legal responsibility or medical outcome.","quality_score":"3","adoption":"PASS_WITH_LASER_REPORT_NOT_FINAL_CAUSE","direct_score_input":false},{"row":140,"status":"PASS_WITH_LASER_NOT_PARCEL_SCORE","source":"CAA laser safety","url":"https://www.caa.co.uk/safety-initiatives/how-we-regulate/safety-plan/mitigating-key-safety-risks/lasers/","verified":"Laser safety information is aviation occurrence context and is not an exact parcel-level risk probability.","quality_score":"3","adoption":"PASS_WITH_LASER_NOT_PARCEL_SCORE","direct_score_input":false},{"row":141,"status":"PASS_VESSEL_UP_TO_24M","source":"MCA small commercial vessel codes","url":"https://www.gov.uk/government/collections/small-craft-codes-of-practice","verified":"The small commercial vessel code collection concerns commercial vessels up to 24 metres.","q