{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V88","part":3,"rows":[{"row":41,"status":"PASS_NOROVIRUS_01","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/collections/norovirus-guidance-data-and-analysis","verified":"UKHSA describes norovirus as a highly infectious cause of gastroenteritis.","quality_score":"4","adoption":"NOROVIRUS_01","direct_score_input":false},{"row":42,"status":"PASS_NOROVIRUS_02","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/publications/norovirus-how-to-stop-it-spreading","verified":"Norovirus is readily transmitted from one infected person to another.","quality_score":"4","adoption":"NOROVIRUS_02","direct_score_input":false},{"row":43,"status":"PASS_NOROVIRUS_03","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/collections/norovirus-guidance-data-and-analysis","verified":"Outbreaks are common in semi-enclosed settings including hospitals, nursing homes, schools and cruise ships.","quality_score":"4","adoption":"NOROVIRUS_03","direct_score_input":false},{"row":44,"status":"PASS_NOROVIRUS_04","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/publications/norovirus-how-to-stop-it-spreading","verified":"Outbreaks can also occur in restaurants and hotels.","quality_score":"4","adoption":"NOROVIRUS_04","direct_score_input":false},{"row":45,"status":"PASS_NOROVIRUS_05","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/collections/norovirus-guidance-data-and-analysis","verified":"Illness is usually mild and commonly lasts one to two days.","quality_score":"4","adoption":"NOROVIRUS_05","direct_score_input":false},{"row":46,"status":"PASS_NOROVIRUS_06","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/publications/norovirus-how-to-stop-it-spreading","verified":"Symptoms include vomiting, projectile vomiting, diarrhoea and fever.","quality_score":"4","adoption":"NOROVIRUS_06","direct_score_input":false},{"row":47,"status":"PASS_NOROVIRUS_07","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/collections/norovirus-guidance-data-and-analysis","verified":"Most people recover within a couple of days, but infection can be more dangerous for very young and elderly people.","quality_score":"4","adoption":"NOROVIRUS_07","direct_score_input":false},{"row":48,"status":"PASS_NOROVIRUS_08","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/publications/norovirus-how-to-stop-it-spreading","verified":"Norovirus is a frequent cause of gastroenteritis outbreaks in NHS hospitals and is monitored through national surveillance.","quality_score":"4","adoption":"NOROVIRUS_08","direct_score_input":false},{"row":49,"status":"PASS_WITH_NOROVIRUS_09","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/collections/norovirus-guidance-data-and-analysis","verified":"Norovirus risk depends on contact intensity, contamination, hygiene, setting, outbreak status, age, vulnerability and timing.","quality_score":"3","adoption":"NOROVIRUS_GUARD_09","direct_score_input":false},{"row":50,"status":"PASS_WITH_NOROVIRUS_10","source":"UKHSA norovirus guidance and surveillance","url":"https://www.gov.uk/government/publications/norovirus-how-to-stop-it-spreading","verified":"UKHSA norovirus evidence is person-, contact-, setting-, outbreak-, surveillance- and time-specific and is not an exact parcel-level infection probability.","quality_score":"3","adoption":"NOROVIRUS_GUARD_10","direct_score_input":false},{"row":51,"status":"PASS_RABIES_01","source":"UKHSA rabies prevention and response","url":"https://www.gov.uk/guidance/rabies-epidemiology-transmission-and-prevention","verified":"Rabies is a viral infection of the central nervous system affecting mammals and humans.","quality_score":"4","adoption":"RABIES_01","direct_score_input":false},{"row":52,"status":"PASS_RABIES_02","source":"UKHSA rabies prevention and response","url":"https://ukhsa.blog.gov.uk/2025/06/18/how-to-avoid-rabies-and-what-to-do-if-youre-exposed-while-travelling/","verified":"Rabies infects mammals in many parts of the world, particularly in Asia and Africa.","quality_score":"4","adoption":"RABIES_02","direct_score_input":false},{"row":53,"status":"PASS_RABIES_03","source":"UKHSA rabies prevention and response","url":"https://www.gov.uk/guidance/rabies-epidemiology-transmission-and-prevention","verified":"Dogs and cats are major human exposure risks, while bats can carry rabies or rabies-like viruses.","quality_score":"4","adoption":"RABIES_03","direct_score_input":false},{"row":54,"status":"PASS_RABIES_04","source":"UKHSA rabies prevention and response","url":"https://ukhsa.blog.gov.uk/2025/06/18/how-to-avoid-rabies-and-what-to-do-if-youre-exposed-while-travelling/","verified":"Classical rabies has been eliminated from terrestrial animal populations in the UK.","quality_score":"4","adoption":"RABIES_04","direct_score_input":false},{"row":55,"status":"PASS_RABIES_05","source":"UKHSA rabies prevention and response","url":"https://www.gov.uk/guidance/rabies-epidemiology-transmission-and-prevention","verified":"Human rabies is extremely rare in the UK and recent cases have generally been acquired abroad.","quality_score":"4","adoption":"RABIES_05","direct_score_input":false},{"row":56,"status":"PASS_RABIES_06","source":"UKHSA rabies prevention and response","url":"https://ukhsa.blog.gov.uk/2025/06/18/how-to-avoid-rabies-and-what-to-do-if-youre-exposed-while-travelling/","verified":"People usually acquire rabies through a bite or scratch from an infected animal.","quality_score":"4","adoption":"RABIES_06","direct_score_input":false},{"row":57,"status":"PASS_RABIES_07","source":"UKHSA rabies prevention and response","url":"https://www.gov.uk/guidance/rabies-epidemiology-transmission-and-prevention","verified":"Prompt post-exposure treatment is highly effective before clinical disease develops.","quality_score":"4","adoption":"RABIES_07","direct_score_input":false},{"row":58,"status":"PASS_RABIES_08","source":"UKHSA rabies prevention and response","url":"https://ukhsa.blog.gov.uk/2025/06/18/how-to-avoid-rabies-and-what-to-do-if-youre-exposed-while-travelling/","verified":"Travellers should avoid animal contact, wash bites or scratches thoroughly and seek medical attention without delay.","quality_score":"4","adoption":"RABIES_08","direct_score_input":false},{"row":59,"status":"PASS_WITH_RABIES_09","source":"UKHSA rabies prevention and response","url":"https://www.gov.uk/guidance/rabies-epidemiology-transmission-and-prevention","verified":"Rabies risk depends on animal species, geography, exposure route, wound, vaccination, access to treatment and treatment timing.","quality_score":"3","adoption":"RABIES_GUARD_09","direct_score_input":false},{"row":60,"status":"PASS_WITH_RABIES_10","source":"UKHSA rabies prevention and response","url":"https://ukhsa.blog.gov.uk/2025/06/18/how-to-avoid-rabies-and-what-to-do-if-youre-exposed-while-travelling/","verified":"UKHSA rabies evidence is animal-, exposure-, traveller-, geography-, vaccine-, treatment- and time-specific and is not an exact parcel-level infection probability.","quality_score":"3","adoption":"RABIES_GUARD_10","direct_score_input":false}]}