{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V38","part":2,"rows":[{"row":26,"status":"PASS_LIFTING_06","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Areas below loads suspended for significant periods should be treated as danger zones with restricted access.","quality_score":"4","adoption":"LIFTING_06","direct_score_input":false},{"row":27,"status":"PASS_LIFTING_07","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"Lifting equipment must receive thorough examination at the required intervals or under a competent-person examination scheme.","quality_score":"4","adoption":"LIFTING_07","direct_score_input":false},{"row":28,"status":"PASS_LIFTING_08","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"A dangerous defect identified during examination must be reported and the equipment must not be used until the defect is remedied.","quality_score":"4","adoption":"LIFTING_08","direct_score_input":false},{"row":29,"status":"PASS_WITH_LIFTING_09","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"The planning detail, supervision and examination scope must be proportionate to the lift, equipment, environment and foreseeable failure modes.","quality_score":"3","adoption":"LIFTING_GUARD_09","direct_score_input":false},{"row":30,"status":"PASS_WITH_LIFTING_10","source":"HSE lifting operations and LOLER","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Lifting evidence is operation- and equipment-specific and is not an exact parcel-level probability.","quality_score":"3","adoption":"LIFTING_GUARD_10","direct_score_input":false},{"row":31,"status":"PASS_FIRE_SAFETY_01","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/who-is-responsible.html","verified":"Employers, owners, landlords, occupiers and others with control of non-domestic premises may be responsible persons for fire safety.","quality_score":"4","adoption":"FIRE_SAFETY_01","direct_score_input":false},{"row":32,"status":"PASS_FIRE_SAFETY_02","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/fire-risk-assessments","verified":"Where there is more than one responsible person, they must cooperate and coordinate their fire-safety arrangements.","quality_score":"4","adoption":"FIRE_SAFETY_02","direct_score_input":false},{"row":33,"status":"PASS_FIRE_SAFETY_03","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/who-is-responsible.html","verified":"The responsible person must carry out and regularly review a fire risk assessment.","quality_score":"4","adoption":"FIRE_SAFETY_03","direct_score_input":false},{"row":34,"status":"PASS_FIRE_SAFETY_04","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/fire-risk-assessments","verified":"The fire risk assessment must be recorded in writing.","quality_score":"4","adoption":"FIRE_SAFETY_04","direct_score_input":false},{"row":35,"status":"PASS_FIRE_SAFETY_05","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/who-is-responsible.html","verified":"The assessment should identify fire hazards and the people who may be at risk.","quality_score":"4","adoption":"FIRE_SAFETY_05","direct_score_input":false},{"row":36,"status":"PASS_FIRE_SAFETY_06","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/fire-risk-assessments","verified":"Fire risks should be removed where possible or reduced with suitable control measures.","quality_score":"4","adoption":"FIRE_SAFETY_06","direct_score_input":false},{"row":37,"status":"PASS_FIRE_SAFETY_07","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/who-is-responsible.html","verified":"Emergency routes and exits must be considered and kept suitable for safe evacuation.","quality_score":"4","adoption":"FIRE_SAFETY_07","direct_score_input":false},{"row":38,"status":"PASS_FIRE_SAFETY_08","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/fire-risk-assessments","verified":"Fire detection, warning, firefighting equipment, emergency planning, information and training must be considered.","quality_score":"4","adoption":"FIRE_SAFETY_08","direct_score_input":false},{"row":39,"status":"PASS_WITH_FIRE_SAFETY_09","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/who-is-responsible.html","verified":"The controls must reflect the premises, occupancy, vulnerable people, shared responsibilities and changes in use or layout.","quality_score":"3","adoption":"FIRE_SAFETY_GUARD_09","direct_score_input":false},{"row":40,"status":"PASS_WITH_FIRE_SAFETY_10","source":"GOV.UK workplace fire safety","url":"https://www.gov.uk/workplace-fire-safety-your-responsibilities/fire-risk-assessments","verified":"Workplace fire-safety evidence is premises-specific and is not an exact parcel-level probability.","quality_score":"3","adoption":"FIRE_SAFETY_GUARD_10","direct_score_input":false},{"row":41,"status":"PASS_EMERGENCY_ALERT_01","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts","verified":"Emergency Alerts is a UK government system for warning and advising people during life-threatening emergencies.","quality_score":"4","adoption":"EMERGENCY_ALERT_01","direct_score_input":false},{"row":42,"status":"PASS_EMERGENCY_ALERT_02","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts/how-alerts-work","verified":"The government does not need a recipient's phone number or precise location to broadcast an alert.","quality_score":"4","adoption":"EMERGENCY_ALERT_02","direct_score_input":false},{"row":43,"status":"PASS_EMERGENCY_ALERT_03","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts","verified":"Alerts may be sent only by emergency services and authorised government or public bodies dealing with emergencies.","quality_score":"4","adoption":"EMERGENCY_ALERT_03","direct_score_input":false},{"row":44,"status":"PASS_EMERGENCY_ALERT_04","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts/how-alerts-work","verified":"A compatible device may make a loud siren-like sound, vibrate and read out the alert.","quality_score":"4","adoption":"EMERGENCY_ALERT_04","direct_score_input":false},{"row":45,"status":"PASS_EMERGENCY_ALERT_05","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts","verified":"Recipients should stop and follow the instructions contained in a genuine emergency alert.","quality_score":"4","adoption":"EMERGENCY_ALERT_05","direct_score_input":false},{"row":46,"status":"PASS_EMERGENCY_ALERT_06","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts/how-alerts-work","verified":"Alerts are targeted using the device's current mast area and do not require location services to be enabled.","quality_score":"4","adoption":"EMERGENCY_ALERT_06","direct_score_input":false},{"row":47,"status":"PASS_EMERGENCY_ALERT_07","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts","verified":"Compatible devices can receive alerts over UK 4G and 5G networks without mobile data or Wi-Fi.","quality_score":"4","adoption":"EMERGENCY_ALERT_07","direct_score_input":false},{"row":48,"status":"PASS_EMERGENCY_ALERT_08","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts/how-alerts-work","verified":"Emergency Alerts are free and do not require registration or an app download.","quality_score":"4","adoption":"EMERGENCY_ALERT_08","direct_score_input":false},{"row":49,"status":"PASS_WITH_EMERGENCY_ALERT_09","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts","verified":"A device that is off, on 2G or 3G, Wi-Fi only, incompatible or sometimes in airplane mode may not receive an alert.","quality_score":"3","adoption":"EMERGENCY_ALERT_GUARD_09","direct_score_input":false},{"row":50,"status":"PASS_WITH_EMERGENCY_ALERT_10","source":"UK Government Emergency Alerts","url":"https://www.gov.uk/alerts/how-alerts-work","verified":"Emergency Alerts supplement rather than replace other warning channels, and a driver should stop safely before reading one.","quality_score":"3","adoption":"EMERGENCY_ALERT_GUARD_10","direct_score_input":false}]}