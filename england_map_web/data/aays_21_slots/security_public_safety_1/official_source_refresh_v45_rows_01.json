{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V45","part":1,"rows":[{"row":1,"status":"PASS_SCAFFOLDING_01","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/construction/faq-scaffold.htm","verified":"Scaffolds should be designed, erected, altered and dismantled only by competent people under the direction of a competent supervisor.","quality_score":"4","adoption":"SCAFFOLDING_01","direct_score_input":false},{"row":2,"status":"PASS_SCAFFOLDING_02","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/safetybulletins/ladders-and-scaffold-security.htm","verified":"Scaffolding from which a person might fall 2 metres or more must be inspected on completion and a report issued by a competent person.","quality_score":"4","adoption":"SCAFFOLDING_02","direct_score_input":false},{"row":3,"status":"PASS_SCAFFOLDING_03","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/safetybulletins/ladders-and-scaffold-security.htm","verified":"Such scaffolding must be inspected at least weekly while in use.","quality_score":"4","adoption":"SCAFFOLDING_03","direct_score_input":false},{"row":4,"status":"PASS_SCAFFOLDING_04","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/safetybulletins/ladders-and-scaffold-security.htm","verified":"Additional inspection may be needed after bad weather.","quality_score":"4","adoption":"SCAFFOLDING_04","direct_score_input":false},{"row":5,"status":"PASS_SCAFFOLDING_05","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/safetybulletins/ladders-and-scaffold-security.htm","verified":"Scaffolding must be inspected after any modification.","quality_score":"4","adoption":"SCAFFOLDING_05","direct_score_input":false},{"row":6,"status":"PASS_SCAFFOLDING_06","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/safetybulletins/ladders-and-scaffold-security.htm","verified":"Collective fall protection should be established as early as possible to minimise reliance on personal fall-protection equipment.","quality_score":"4","adoption":"SCAFFOLDING_06","direct_score_input":false},{"row":7,"status":"PASS_SCAFFOLDING_07","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/safetybulletins/ladders-and-scaffold-security.htm","verified":"A visible scaffold tag can supplement inspection reports, although a tag system itself is not a legal requirement.","quality_score":"4","adoption":"SCAFFOLDING_07","direct_score_input":false},{"row":8,"status":"PASS_SCAFFOLDING_08","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/safetybulletins/ladders-and-scaffold-security.htm","verified":"Construction sites should prevent unauthorised scaffold access using suitable perimeter controls, ladder removal or secure ladder guards.","quality_score":"4","adoption":"SCAFFOLDING_08","direct_score_input":false},{"row":9,"status":"PASS_WITH_SCAFFOLDING_09","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/construction/faq-scaffold.htm","verified":"Scaffold controls depend on design, height, loading, access, weather, public exposure, inspection history and competent supervision.","quality_score":"3","adoption":"SCAFFOLDING_GUARD_09","direct_score_input":false},{"row":10,"status":"PASS_WITH_SCAFFOLDING_10","source":"HSE scaffolding safety","url":"https://www.hse.gov.uk/construction/faq-scaffold.htm","verified":"Scaffolding evidence is structure-, task- and site-specific and is not an exact parcel-level fall or trespass probability.","quality_score":"3","adoption":"SCAFFOLDING_GUARD_10","direct_score_input":false},{"row":11,"status":"PASS_ROOF_WORK_01","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"All roof work must be organised and planned so that it is carried out safely.","quality_score":"4","adoption":"ROOF_WORK_01","direct_score_input":false},{"row":12,"status":"PASS_ROOF_WORK_02","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"Roof work is high risk even when a task takes only a few minutes.","quality_score":"4","adoption":"ROOF_WORK_02","direct_score_input":false},{"row":13,"status":"PASS_ROOF_WORK_03","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"People carrying out roof work must be trained, competent and instructed in the precautions required.","quality_score":"4","adoption":"ROOF_WORK_03","direct_score_input":false},{"row":14,"status":"PASS_ROOF_WORK_04","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"A method statement is a common way to manage roof work and communicate precautions.","quality_score":"4","adoption":"ROOF_WORK_04","direct_score_input":false},{"row":15,"status":"PASS_ROOF_WORK_05","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"Clients and contractors on business premises should agree how roof work will be managed.","quality_score":"4","adoption":"ROOF_WORK_05","direct_score_input":false},{"row":16,"status":"PASS_ROOF_WORK_06","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"Safe access to the roof must be considered.","quality_score":"4","adoption":"ROOF_WORK_06","direct_score_input":false},{"row":17,"status":"PASS_ROOF_WORK_07","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"Roof edges and openings must be controlled to prevent falls.","quality_score":"4","adoption":"ROOF_WORK_07","direct_score_input":false},{"row":18,"status":"PASS_ROOF_WORK_08","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"Fragile surfaces must be identified and protected against.","quality_score":"4","adoption":"ROOF_WORK_08","direct_score_input":false},{"row":19,"status":"PASS_WITH_ROOF_WORK_09","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"Roof-work controls depend on roof type, fragility, slope, access, duration, weather, work method and rescue arrangements.","quality_score":"3","adoption":"ROOF_WORK_GUARD_09","direct_score_input":false},{"row":20,"status":"PASS_WITH_ROOF_WORK_10","source":"HSE roof work safety","url":"https://www.hse.gov.uk/construction/safetytopics/roofwork.htm","verified":"Roof-work evidence is task-, structure- and condition-specific and is not an exact parcel-level fall probability.","quality_score":"3","adoption":"ROOF_WORK_GUARD_10","direct_score_input":false}]}