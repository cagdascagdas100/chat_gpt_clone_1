{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V39","part":1,"rows":[{"row":1,"status":"PASS_SLIPS_TRIPS_01","source":"HSE slips and trips","url":"https://www.hse.gov.uk/slips/employers.htm","verified":"Employers must assess slip and trip risks and take action where control is needed.","quality_score":"4","adoption":"SLIPS_TRIPS_01","direct_score_input":false},{"row":2,"status":"PASS_SLIPS_TRIPS_02","source":"HSE slips and trips","url":"https://www.hse.gov.uk/Slips/preventing.htm","verified":"Workplace floors should be suitable, in good condition and free from obstructions so people can move safely.","quality_score":"4","adoption":"SLIPS_TRIPS_02","direct_score_input":false},{"row":3,"status":"PASS_SLIPS_TRIPS_03","source":"HSE slips and trips","url":"https://www.hse.gov.uk/slips/workers.htm","verified":"Risk controls should address contamination, flooring, cleaning, obstacles, lighting and footwear where relevant.","quality_score":"4","adoption":"SLIPS_TRIPS_03","direct_score_input":false},{"row":4,"status":"PASS_SLIPS_TRIPS_04","source":"HSE slips and trips","url":"https://www.hse.gov.uk/slips/employers.htm","verified":"Spillages should be cleared promptly and the affected area made safe.","quality_score":"4","adoption":"SLIPS_TRIPS_04","direct_score_input":false},{"row":5,"status":"PASS_SLIPS_TRIPS_05","source":"HSE slips and trips","url":"https://www.hse.gov.uk/Slips/preventing.htm","verified":"Walkways should be kept clear of trailing cables, stored items and other trip hazards.","quality_score":"4","adoption":"SLIPS_TRIPS_05","direct_score_input":false},{"row":6,"status":"PASS_SLIPS_TRIPS_06","source":"HSE slips and trips","url":"https://www.hse.gov.uk/slips/workers.htm","verified":"Defects such as uneven surfaces or potholes should be repaired rather than left as permanent hazards.","quality_score":"4","adoption":"SLIPS_TRIPS_06","direct_score_input":false},{"row":7,"status":"PASS_SLIPS_TRIPS_07","source":"HSE slips and trips","url":"https://www.hse.gov.uk/slips/employers.htm","verified":"Workers should report dangerous conditions, near misses and shortcomings in protective arrangements.","quality_score":"4","adoption":"SLIPS_TRIPS_07","direct_score_input":false},{"row":8,"status":"PASS_SLIPS_TRIPS_08","source":"HSE slips and trips","url":"https://www.hse.gov.uk/Slips/preventing.htm","verified":"Slip and trip controls should be checked to confirm that the chosen measures remain effective.","quality_score":"4","adoption":"SLIPS_TRIPS_08","direct_score_input":false},{"row":9,"status":"PASS_WITH_SLIPS_TRIPS_09","source":"HSE slips and trips","url":"https://www.hse.gov.uk/slips/workers.htm","verified":"Suitable controls depend on the actual surface, contaminant, weather, lighting, traffic and users at the location.","quality_score":"3","adoption":"SLIPS_TRIPS_GUARD_09","direct_score_input":false},{"row":10,"status":"PASS_WITH_SLIPS_TRIPS_10","source":"HSE slips and trips","url":"https://www.hse.gov.uk/slips/employers.htm","verified":"Slip and trip guidance is workplace-context evidence and is not an exact parcel-level probability.","quality_score":"3","adoption":"SLIPS_TRIPS_GUARD_10","direct_score_input":false},{"row":11,"status":"PASS_MANUAL_HANDLING_01","source":"HSE manual handling","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Manual handling includes lifting, lowering, pushing, pulling, carrying or moving a load by hand or bodily force.","quality_score":"4","adoption":"MANUAL_HANDLING_01","direct_score_input":false},{"row":12,"status":"PASS_MANUAL_HANDLING_02","source":"HSE manual handling","url":"https://www.hse.gov.uk/msd/manual-handling/the-law.htm","verified":"Employers should avoid hazardous manual handling so far as reasonably practicable.","quality_score":"4","adoption":"MANUAL_HANDLING_02","direct_score_input":false},{"row":13,"status":"PASS_MANUAL_HANDLING_03","source":"HSE manual handling","url":"https://www.hse.gov.uk/pubns/indg143.htm","verified":"Manual handling operations that cannot be avoided must be assessed for risk of injury.","quality_score":"4","adoption":"MANUAL_HANDLING_03","direct_score_input":false},{"row":14,"status":"PASS_MANUAL_HANDLING_04","source":"HSE manual handling","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Identified risks should be reduced to as low as reasonably practicable.","quality_score":"4","adoption":"MANUAL_HANDLING_04","direct_score_input":false},{"row":15,"status":"PASS_MANUAL_HANDLING_05","source":"HSE manual handling","url":"https://www.hse.gov.uk/msd/manual-handling/the-law.htm","verified":"The law does not set a single safe weight limit for every manual handling task.","quality_score":"4","adoption":"MANUAL_HANDLING_05","direct_score_input":false},{"row":16,"status":"PASS_MANUAL_HANDLING_06","source":"HSE manual handling","url":"https://www.hse.gov.uk/pubns/indg143.htm","verified":"Assessment should consider the task, load, working environment and individual capability.","quality_score":"4","adoption":"MANUAL_HANDLING_06","direct_score_input":false},{"row":17,"status":"PASS_MANUAL_HANDLING_07","source":"HSE manual handling","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Mechanical aids or changes to the process can reduce the need for hazardous handling.","quality_score":"4","adoption":"MANUAL_HANDLING_07","direct_score_input":false},{"row":18,"status":"PASS_MANUAL_HANDLING_08","source":"HSE manual handling","url":"https://www.hse.gov.uk/msd/manual-handling/the-law.htm","verified":"Workers need suitable information and training, but training does not replace eliminating or reducing the hazard.","quality_score":"4","adoption":"MANUAL_HANDLING_08","direct_score_input":false},{"row":19,"status":"PASS_WITH_MANUAL_HANDLING_09","source":"HSE manual handling","url":"https://www.hse.gov.uk/pubns/indg143.htm","verified":"The safe method depends on load size, shape, grip, posture, frequency, route and the individual worker.","quality_score":"3","adoption":"MANUAL_HANDLING_GUARD_09","direct_score_input":false},{"row":20,"status":"PASS_WITH_MANUAL_HANDLING_10","source":"HSE manual handling","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Manual-handling evidence is task- and person-specific and is not an exact parcel-level probability.","quality_score":"3","adoption":"MANUAL_HANDLING_GUARD_10","direct_score_input":false}]}