{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V127","part":1,"row_range":[1,20],"rows":[{"row":1,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"The law requires danger to workers in or near excavations to be prevented.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":2,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"A competent person must inspect excavation supports or battering at the start of the working shift and at other specified times.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":3,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"No work should take place in an excavation until the required precautions have made it safe.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":4,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Commercial clients should provide relevant pre-construction information on ground conditions, underground structures, watercourses and existing services.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":5,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Excavation planning must address the risk of collapse and select suitable support, battering or other protective measures.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":6,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Falling or dislodged material must be prevented from endangering people in or near an excavation.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":7,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Suitable measures are required to prevent people, plant or materials falling into excavations.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":8,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Planning must consider undermining nearby structures, underground or overhead services, and inflow of ground or surface water.","quality_score":"4","adoption":"HSE_EXCAVATION_SAFETY_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":9,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Excavation risk depends on ground conditions, depth, support or battering, nearby structures, services, weather, water, plant movements and inspection findings.","quality_score":"3","adoption":"HSE_EXCAVATION_SAFETY_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":10,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE excavation safety guidance","family_id":"HSE_EXCAVATION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"General planning, inspection and control of collapse, falls, services and water hazards in excavations guidance does not prove current conditions or control performance at an individual parcel and does not establish an exact incident, exposure or illness probability.","quality_score":"3","adoption":"HSE_EXCAVATION_SAFETY_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":11,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Demolition work is treated in law as construction work and must be planned and managed accordingly.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":12,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Commercial clients must appoint designers and contractors with the relevant skills, knowledge and experience.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":13,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Clients and principal designers must provide useful pre-construction information to those who need it.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":14,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Principal designers must plan and manage health and safety during the pre-construction phase.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":15,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Principal contractors must plan and manage health and safety during demolition work.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":16,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Site managers must ensure workers are supervised and follow the agreed safe working practices.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":17,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Exclusion and debris zones must reflect the demolition technique, surrounding space and the distance debris could fall, and may need to change as work progresses.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":18,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Demolition or dismantling arrangements should be recorded before work begins, and ordinary scaffolding must not be relied on to support a structure unless specifically designed for that purpose.","quality_score":"4","adoption":"HSE_DEMOLITION_SAFETY_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":19,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Demolition risk depends on the structure, sequence, demolition method, temporary support, exclusion zones, plant, debris trajectory, utilities and worker competence.","quality_score":"3","adoption":"HSE_DEMOLITION_SAFETY_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":20,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE demolition and structural-stability guidance","family_id":"HSE_DEMOLITION_SAFETY","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"General planning, competence, exclusion zones, structural stability and supervision during demolition guidance does not prove current conditions or control performance at an individual parcel and does not establish an exact incident, exposure or illness probability.","quality_score":"3","adoption":"HSE_DEMOLITION_SAFETY_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"}]}