{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V24","part":2,"rows":[{"row":21,"status":"PASS_CQC_STATUTORY_NOTIFICATION_DUTY","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"Providers must notify CQC about specified changes, events and incidents affecting services or people using them.","quality_score":"4","adoption":"CQC_NOTIFICATION_DUTY","direct_score_input":false},{"row":22,"status":"PASS_CQC_FAILURE_TO_NOTIFY_OFFENCE","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"Failure to make a required statutory notification is an offence.","quality_score":"4","adoption":"NOTIFICATION_OFFENCE_GATE","direct_score_input":false},{"row":23,"status":"PASS_CQC_NOTIFICATION_TIMESCALES","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"Notification timescales depend on the notification type and are stated on the relevant form page.","quality_score":"4","adoption":"NOTIFICATION_TIMESCALE_CONTRACT","direct_score_input":false},{"row":24,"status":"PASS_CQC_CURRENT_FORM_REQUIREMENT","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"Providers must use the specific current form for each notification type.","quality_score":"4","adoption":"CURRENT_FORM_VERSION_GATE","direct_score_input":false},{"row":25,"status":"PASS_CQC_NOTIFICATION_REFERENCE","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"Portal submissions receive an automatic reference number and Word-form submissions receive an acknowledgement reference.","quality_score":"4","adoption":"NOTIFICATION_REFERENCE_TRACKING","direct_score_input":false},{"row":26,"status":"PASS_CQC_REGISTERED_PERSON_ACCOUNTABILITY","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"A registered person may delegate submission but remains responsible for correct notification.","quality_score":"4","adoption":"REGISTERED_PERSON_ACCOUNTABILITY","direct_score_input":false},{"row":27,"status":"PASS_CQC_PRIVACY_IDENTIFIER","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"Most person-related notifications should use a unique identifier rather than names, dates of birth or NHS numbers.","quality_score":"4","adoption":"NOTIFICATION_PRIVACY_GUARD","direct_score_input":false},{"row":28,"status":"PASS_CQC_LFPSE_FOUR_NOTIFICATION_TYPES","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"NHS trusts and NHS Blood and Transplant can route four specified notification types through LFPSE for forwarding to CQC.","quality_score":"4","adoption":"LFPSE_CQC_INFORMATION_SHARING","direct_score_input":false},{"row":29,"status":"PASS_CQC_OTHER_NOTIFICATIONS_DIRECT","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"Other notification types still have to be submitted directly to CQC.","quality_score":"4","adoption":"DIRECT_NOTIFICATION_BOUNDARY","direct_score_input":false},{"row":30,"status":"PASS_CQC_MEDICINE_ERROR_SCOPE","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"A medicine error is notified to CQC when it causes a listed notifiable event such as death, serious injury, abuse allegation or police investigation.","quality_score":"4","adoption":"MEDICINE_ERROR_NOTIFICATION_SCOPE","direct_score_input":false},{"row":31,"status":"PASS_CQC_DUTY_OF_CANDOUR_ALL_PROVIDERS","source":"CQC Regulation 20","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/health-social-care-act/regulation-20","verified":"The statutory duty of candour applies to every health and social care provider regulated by CQC.","quality_score":"4","adoption":"DUTY_OF_CANDOUR_SCOPE","direct_score_input":false},{"row":32,"status":"PASS_CQC_NOTIFIABLE_SAFETY_THREE_CRITERIA","source":"CQC notifiable safety incidents","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/health-social-care-act/regulation-20/incidents","verified":"A notifiable safety incident must be unintended or unexpected, occur during a regulated activity and meet the applicable death or harm threshold.","quality_score":"4","adoption":"NOTIFIABLE_SAFETY_INCIDENT_TEST","direct_score_input":false},{"row":33,"status":"PASS_CQC_CANDOUR_PROMPT_ACTION","source":"CQC duty of candour procedure","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/health-social-care-act/regulation-20/what-you-must-do","verified":"The duty of candour procedure must start as soon as reasonably practicable after discovery.","quality_score":"4","adoption":"PROMPT_CANDOUR_ACTION","direct_score_input":false},{"row":34,"status":"PASS_CQC_RELEVANT_PERSON_SUPPORT","source":"CQC Regulation 20 in full","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/health-social-care-act/regulation-20/regulation-20-in-full","verified":"The registered person must notify the relevant person and provide reasonable support.","quality_score":"4","adoption":"CANDOUR_NOTIFICATION_AND_SUPPORT","direct_score_input":false},{"row":35,"status":"PASS_CQC_REGISTERED_PERSON_CANDOUR_OWNER","source":"CQC duty of candour procedure","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/health-social-care-act/regulation-20/what-you-must-do","verified":"The registered provider or registered manager owns the duty even where tasks are delegated.","quality_score":"4","adoption":"CANDOUR_OWNER","direct_score_input":false},{"row":36,"status":"PASS_CQC_PROVIDER_NOT_INDIVIDUAL_REGULATION","source":"CQC duty of candour regulation","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/health-social-care-act/regulation-20/how-we-regulate","verified":"CQC regulates the registered provider's compliance and does not judge the performance of individual clinicians through this regulation.","quality_score":"4","adoption":"PROVIDER_LEVEL_REGULATION","direct_score_input":false},{"row":37,"status":"PASS_CQC_CRIMINAL_ENFORCEMENT","source":"CQC duty of candour regulation","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/health-social-care-act/regulation-20/how-we-regulate","verified":"Regulation 20 permits CQC to move directly to criminal enforcement where appropriate.","quality_score":"4","adoption":"CANDOUR_ENFORCEMENT_GATE","direct_score_input":false},{"row":38,"status":"PASS_CQC_REG18_INCIDENT_SCOPE","source":"CQC Regulation 18","url":"https://www.cqc.org.uk/guidance-regulation/providers/regulations-service-providers-and-managers/cqc-registration-regulations/regs-regulation-18","verified":"Regulation 18 requires notification of listed incidents affecting the health, safety and welfare of service users.","quality_score":"4","adoption":"REG18_INCIDENT_CONTRACT","direct_score_input":false},{"row":39,"status":"PASS_CQC_NOTIFICATION_REGULATORY_USE","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"CQC uses notifications to identify concerns, consider regulatory action and monitor trends.","quality_score":"4","adoption":"NOTIFICATION_REGULATORY_USE","direct_score_input":false},{"row":40,"status":"PASS_WITH_CQC_NOTIFICATION_NOT_COMPLIANCE","source":"CQC notifications guidance","url":"https://www.cqc.org.uk/guidance-regulation/providers/registration/guidance","verified":"A submitted notification records an event or change and is not evidence that the provider is otherwise safe or compliant.","quality_score":"3","adoption":"NOTIFICATION_CONTEXT_ONLY","direct_score_input":false}]}