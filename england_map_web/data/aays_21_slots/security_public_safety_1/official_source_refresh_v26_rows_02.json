oduct-safety-alerts-reports-recalls","verified":"Individual records identify the product and normally provide model, batch, barcode, retailer or marketplace details where available.","quality_score":"4","adoption":"PRODUCT_IDENTIFIER_SCHEMA","direct_score_input":false},{"row":38,"status":"PASS_WITH_OPSS_DYNAMIC_TOTALS","source":"OPSS product safety catalogue","url":"https://www.gov.uk/product-safety-alerts-reports-recalls","verified":"Catalogue totals and filter counts change as records are added or reclassified and are stored only as time-stamped snapshots.","quality_score":"3","adoption":"DYNAMIC_CATALOGUE_COUNT_GUARD","direct_score_input":false},{"row":39,"status":"PASS_WITH_OPSS_RISK_NOT_PROVIDED","source":"OPSS product safety catalogue","url":"https://www.gov.uk/product-safety-alerts-reports-recalls","verified":"Some official records state that a risk level is not provided, so no risk category is inferred.","quality_score":"3","adoption":"MISSING_RISK_NOT_INFERRED","direct_score_input":false},{"row":40,"status":"PASS_WITH_OPSS_PRODUCT_NOT_PARCEL_SCORE","source":"OPSS product safety catalogue","url":"https://www.gov.uk/product-safety-alerts-reports-recalls","verified":"Product-specific alerts and recalls describe affected goods and do not measure the public-safety probability of a land parcel.","quality_score":"3","adoption":"PRODUCT_CONTEXT_ONLY","direct_score_input":false}]}