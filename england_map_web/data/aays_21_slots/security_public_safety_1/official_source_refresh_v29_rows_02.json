{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V29","part":2,"rows":[{"row":23,"status":"PASS_PUWER_OWNER_OPERATOR_CONTROL","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"PUWER places duties on people and organisations that own, operate or control work equipment.","quality_score":"4","adoption":"PUWER_DUTYHOLDER_SCOPE","direct_score_input":false},{"row":24,"status":"PASS_PUWER_HIRED_EQUIPMENT_SCOPE","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"PUWER applies where employees use equipment that is hired or otherwise not owned by the employer.","quality_score":"4","adoption":"PUWER_HIRED_EQUIPMENT_SCOPE","direct_score_input":false},{"row":25,"status":"PASS_PUWER_EQUIPMENT_DEFINITION","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Work equipment includes machinery, appliances, apparatus, tools and installations used at work.","quality_score":"4","adoption":"WORK_EQUIPMENT_DEFINITION","direct_score_input":false},{"row":26,"status":"PASS_PUWER_USE_DEFINITION","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Use includes starting, stopping, programming, setting, transporting, repairing, modifying, maintaining, servicing and cleaning equipment.","quality_score":"4","adoption":"WORK_EQUIPMENT_USE_SCOPE","direct_score_input":false},{"row":27,"status":"PASS_PUWER_SUITABLE_PURPOSE","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Equipment must be constructed or adapted so it is suitable for the intended purpose.","quality_score":"4","adoption":"PUWER_SUITABLE_PURPOSE","direct_score_input":false},{"row":28,"status":"PASS_PUWER_WORKING_CONDITIONS","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Selection must account for workplace conditions and health and safety risks.","quality_score":"4","adoption":"PUWER_WORKING_CONDITIONS","direct_score_input":false},{"row":29,"status":"PASS_PUWER_MAINTAIN_SAFE","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Equipment must be maintained in an efficient state, efficient working order and good repair.","quality_score":"4","adoption":"PUWER_MAINTENANCE","direct_score_input":false},{"row":30,"status":"PASS_PUWER_MAINTENANCE_LOG","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Where a maintenance log exists, it must be kept up to date.","quality_score":"4","adoption":"PUWER_MAINTENANCE_LOG","direct_score_input":false},{"row":31,"status":"PASS_PUWER_INSTALLATION_INSPECTION","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Safety-dependent installation requires inspection after installation and before first use.","quality_score":"4","adoption":"PUWER_INSTALLATION_INSPECTION","direct_score_input":false},{"row":32,"status":"PASS_PUWER_DETERIORATION_INSPECTION","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Equipment exposed to deteriorating conditions must be inspected so defects are detected before danger develops.","quality_score":"4","adoption":"PUWER_DETERIORATION_INSPECTION","direct_score_input":false},{"row":33,"status":"PASS_PUWER_INFORMATION","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Users, supervisors and managers must receive adequate and clear health and safety information.","quality_score":"4","adoption":"PUWER_INFORMATION_DUTY","direct_score_input":false},{"row":34,"status":"PASS_PUWER_INSTRUCTIONS_MARKINGS","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Written instructions, markings and warnings must be provided where necessary.","quality_score":"4","adoption":"PUWER_INSTRUCTIONS_MARKINGS","direct_score_input":false},{"row":35,"status":"PASS_PUWER_TRAINING","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"People using, supervising or managing equipment must receive adequate training on correct use, risks and precautions.","quality_score":"4","adoption":"PUWER_TRAINING","direct_score_input":false},{"row":36,"status":"PASS_PUWER_SPECIFIC_RISK_RESTRICTION","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Use of equipment presenting specific risk must be restricted to trained and appointed people.","quality_score":"4","adoption":"PUWER_RESTRICTED_USE","direct_score_input":false},{"row":37,"status":"PASS_PUWER_DANGEROUS_PARTS","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Effective measures must prevent access to dangerous machinery parts.","quality_score":"4","adoption":"PUWER_DANGEROUS_PART_GUARD","direct_score_input":false},{"row":38,"status":"PASS_PUWER_GUARDING_HIERARCHY","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Fixed or interlocked guards should be used according to the regulation 11 protective hierarchy where practicable.","quality_score":"4","adoption":"PUWER_GUARDING_HIERARCHY","direct_score_input":false},{"row":39,"status":"PASS_PUWER_EJECTION_RUPTURE","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Risks from falling or ejected material and rupture or disintegration of equipment must be prevented or controlled.","quality_score":"4","adoption":"PUWER_EJECTION_RUPTURE_CONTROL","direct_score_input":false},{"row":40,"status":"PASS_PUWER_TEMPERATURE","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Hot and cold equipment or processed material risks must be controlled to prevent injury.","quality_score":"4","adoption":"PUWER_TEMPERATURE_CONTROL","direct_score_input":false},{"row":41,"status":"PASS_PUWER_SAFE_CONTROLS","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Equipment must have appropriately identified and safe starting, stopping and operating controls.","quality_score":"4","adoption":"PUWER_CONTROL_SYSTEMS","direct_score_input":false},{"row":42,"status":"PASS_PUWER_ENERGY_ISOLATION","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Suitable means of isolation from electric, hydraulic, pneumatic and gravitational energy must be provided where appropriate.","quality_score":"4","adoption":"PUWER_ENERGY_ISOLATION","direct_score_input":false},{"row":43,"status":"PASS_WITH_PUWER_OTHER_LAW","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"Some equipment is also subject to LOLER, pressure-system, PPE or product-supply law; PUWER compliance does not replace those duties.","quality_score":"3","adoption":"PUWER_MULTI_REGIME_GUARD","direct_score_input":false},{"row":44,"status":"PASS_WITH_PUWER_CONTEXT_NOT_PARCEL","source":"HSE PUWER overview","url":"https://www.hse.gov.uk/work-equipment-machinery/puwer-overview.htm","verified":"PUWER describes work-equipment controls and does not establish an inherent parcel-level risk score.","quality_score":"3","adoption":"PUWER_CONTEXT_ONLY","direct_score_input":false}]}