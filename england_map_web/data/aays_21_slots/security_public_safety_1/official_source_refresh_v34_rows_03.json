{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V34","part":3,"rows":[{"row":41,"status":"PASS_HSE_CONSTRUCTION_FIRE_PLAN","source":"HSE construction fire FAQs","url":"https://www.hse.gov.uk/construction/faq-fire.htm","verified":"Significant fire-risk findings, fire precautions and emergency arrangements should be recorded in the construction phase plan before work starts.","quality_score":"4","adoption":"CONSTRUCTION_FIRE_PLAN","direct_score_input":false},{"row":42,"status":"PASS_HSE_EMERGENCY_PROCEDURES","source":"HSE emergency procedures","url":"https://www.hse.gov.uk/workplace-health/emergency-procedures.htm","verified":"Workplaces need special procedures for emergencies including serious injury, explosion, flood, electrocution, fire and chemical spills.","quality_score":"4","adoption":"WORKPLACE_EMERGENCY_PROCEDURES","direct_score_input":false},{"row":43,"status":"PASS_HSE_ENOUGH_EXITS","source":"HSE emergency procedures","url":"https://www.hse.gov.uk/workplace-health/emergency-procedures.htm","verified":"There must be enough emergency exits for everyone to escape quickly.","quality_score":"4","adoption":"EMERGENCY_EXIT_CAPACITY","direct_score_input":false},{"row":44,"status":"PASS_HSE_ESCAPE_ROUTES_CLEAR","source":"HSE emergency procedures","url":"https://www.hse.gov.uk/workplace-health/emergency-procedures.htm","verified":"Emergency doors and escape routes must be kept unobstructed and clearly marked.","quality_score":"4","adoption":"ESCAPE_ROUTE_CLEARANCE","direct_score_input":false},{"row":45,"status":"PASS_HSE_EMERGENCY_TRAINING","source":"HSE emergency procedures","url":"https://www.hse.gov.uk/workplace-health/emergency-procedures.htm","verified":"Workers must be trained in emergency procedures.","quality_score":"4","adoption":"EMERGENCY_PROCEDURE_TRAINING","direct_score_input":false},{"row":46,"status":"PASS_HSE_ESCAPE_ROUTE_LIGHTING","source":"HSE construction general fire safety","url":"https://www.hse.gov.uk/construction/safetytopics/generalfire.htm","verified":"Enclosed escape routes should be provided with lighting and emergency lighting may be required.","quality_score":"4","adoption":"ESCAPE_ROUTE_LIGHTING","direct_score_input":false},{"row":47,"status":"PASS_HSE_SITE_EMERGENCY_ROUTE_LIGHT","source":"HSE construction site lighting","url":"https://www.hse.gov.uk/construction/safetytopics/site-lighting.htm","verified":"Emergency routes should remain well lit while workers are on the construction site.","quality_score":"4","adoption":"SITE_EMERGENCY_ROUTE_LIGHTING","direct_score_input":false},{"row":48,"status":"PASS_HSE_FIRE_HOUSEKEEPING","source":"HSE construction process fire risks","url":"https://www.hse.gov.uk/construction/safetytopics/processfire.htm","verified":"Good housekeeping and site tidiness help prevent fire and keep emergency routes unobstructed.","quality_score":"4","adoption":"CONSTRUCTION_FIRE_HOUSEKEEPING","direct_score_input":false},{"row":49,"status":"PASS_HSE_FIRE_ORDER_SCOPE","source":"HSE construction process fire risks","url":"https://www.hse.gov.uk/construction/safetytopics/processfire.htm","verified":"The Regulatory Reform Fire Safety Order covers construction-site general fire safety including means of escape.","quality_score":"4","adoption":"CONSTRUCTION_FIRE_ORDER_SCOPE","direct_score_input":false},{"row":50,"status":"PASS_HSE_PRECONSTRUCTION_FIRE_REDUCTION","source":"HSE fire safety in construction","url":"https://www.hse.gov.uk/pubns/books/hsg168.htm","verified":"Fire risks should be eliminated or reduced during pre-construction planning under CDM arrangements.","quality_score":"4","adoption":"PRECONSTRUCTION_FIRE_REDUCTION","direct_score_input":false},{"row":51,"status":"PASS_HSE_TIMBER_FRAME_EXTRA_CONTROLS","source":"HSE construction general fire safety","url":"https://www.hse.gov.uk/construction/safetytopics/generalfire.htm","verified":"Timber-frame construction requires significant additional fire-safety measures.","quality_score":"4","adoption":"TIMBER_FRAME_FIRE_CONTROLS","direct_score_input":false},{"row":52,"status":"PASS_HSE_SITE_RULES_FIRE_PREVENTION","source":"HSE site rules and induction","url":"https://www.hse.gov.uk/construction/safetytopics/site-rules-induction.htm","verified":"Construction site rules and inductions should cover fire prevention and emergency arrangements.","quality_score":"4","adoption":"SITE_RULES_FIRE_EMERGENCY","direct_score_input":false},{"row":53,"status":"PASS_HSE_PEDESTRIAN_ROUTES_INDUCTION","source":"HSE site rules and induction","url":"https://www.hse.gov.uk/construction/safetytopics/site-rules-induction.htm","verified":"Site induction and rules should identify pedestrian routes relevant to safe movement and evacuation.","quality_score":"4","adoption":"SITE_PEDESTRIAN_ROUTE_INDUCTION","direct_score_input":false},{"row":54,"status":"PASS_HSE_EMERGENCY_ACCESS_ROUTES","source":"HSE workplace transport route guidance","url":"https://www.hse.gov.uk/workplacetransport/factsheets/traffic.htm","verified":"Site traffic planning should identify emergency access routes for fire engines, ambulances and other responders.","quality_score":"4","adoption":"EMERGENCY_VEHICLE_ACCESS_ROUTE","direct_score_input":false},{"row":55,"status":"PASS_HSE_ALARM_AND_WARNING_PLAN","source":"HSE emergency procedures","url":"https://www.hse.gov.uk/workplace-health/emergency-procedures.htm","verified":"Emergency arrangements should include effective warning and communication methods suitable for the workplace.","quality_score":"4","adoption":"EMERGENCY_WARNING_METHOD","direct_score_input":false},{"row":56,"status":"PASS_HSE_RESPONSIBLE_PEOPLE","source":"HSE emergency procedures","url":"https://www.hse.gov.uk/workplace-health/emergency-procedures.htm","verified":"Emergency plans should identify competent people with specific responsibilities for evacuation and response.","quality_score":"4","adoption":"EMERGENCY_RESPONSIBILITY_ASSIGNMENT","direct_score_input":false},{"row":57,"status":"PASS_HSE_FIRE_FIGHTING_EQUIPMENT","source":"HSE construction general fire safety","url":"https://www.hse.gov.uk/construction/safetytopics/generalfire.htm","verified":"Suitable fire-fighting equipment should be provided and remain accessible as part of site fire precautions.","quality_score":"4","adoption":"CONSTRUCTION_FIRE_EQUIPMENT","direct_score_input":false},{"row":58,"status":"PASS_WITH_CONSTRUCTION_PLAN_SITE_SPECIFIC","source":"HSE construction fire safety","url":"https://www.hse.gov.uk/construction/faq-fire.htm","verified":"Fire precautions and emergency arrangements must reflect the actual site layout, construction stage, materials and workforce.","quality_score":"3","adoption":"CONSTRUCTION_FIRE_SCOPE_GUARD","direct_score_input":false},{"row":59,"status":"PASS_WITH_EMERGENCY_LIGHTING_CONTEXT","source":"HSE construction general fire safety","url":"https://www.hse.gov.uk/construction/safetytopics/generalfire.htm","verified":"Whether emergency lighting is required depends on escape-route enclosure, available light and the site's risk assessment.","quality_score":"3","adoption":"EMERGENCY_LIGHTING_SCOPE_GUARD","direct_score_input":false},{"row":60,"status":"PASS_WITH_CONSTRUCTION_NOT_PARCEL_SCORE","source":"HSE construction fire safety","url":"https://www.hse.gov.uk/pubns/books/hsg168.htm","verified":"Construction emergency controls describe temporary site arrangements and are not converted into parcel-level safety probability.","quality_score":"3","adoption":"CONSTRUCTION_EMERGENCY_CONTEXT_ONLY","direct_score_input":false}]}