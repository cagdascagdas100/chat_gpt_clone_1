{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V62","part":1,"rows":[{"row":1,"status":"PASS_CAA_LITHIUM_01","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/packright","verified":"Vapes and power banks must be carried in the cabin rather than checked baggage because they can overheat and cause a fire.","quality_score":"4","adoption":"CAA_LITHIUM_01","direct_score_input":false},{"row":2,"status":"PASS_CAA_LITHIUM_02","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/packright","verified":"Passengers should keep spare batteries in the cabin and protect them from physical damage.","quality_score":"4","adoption":"CAA_LITHIUM_02","direct_score_input":false},{"row":3,"status":"PASS_CAA_LITHIUM_03","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/packright","verified":"CAA guidance limits passengers to two power banks and states that power banks must not be recharged onboard.","quality_score":"4","adoption":"CAA_LITHIUM_03","direct_score_input":false},{"row":4,"status":"PASS_CAA_LITHIUM_04","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/packright","verified":"Damaged, overheated or swollen batteries should not be used or carried on an aircraft.","quality_score":"4","adoption":"CAA_LITHIUM_04","direct_score_input":false},{"row":5,"status":"PASS_CAA_LITHIUM_05","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/packright","verified":"Lithium batteries rated between 100Wh and 160Wh require airline approval for passenger carriage.","quality_score":"4","adoption":"CAA_LITHIUM_05","direct_score_input":false},{"row":6,"status":"PASS_CAA_LITHIUM_06","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/packright","verified":"Lithium batteries over 160Wh are prohibited in passenger baggage and must be transported as dangerous-goods cargo.","quality_score":"4","adoption":"CAA_LITHIUM_06","direct_score_input":false},{"row":7,"status":"PASS_CAA_LITHIUM_07","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/commercial-industry/airlines/dangerous-goods/changes-to-rules-on-the-carriage-of-lithium-cellsbatteries-and-power-banks/","verified":"From 27 March 2026, power banks must be individually protected when not in use and must remain in carry-on baggage.","quality_score":"4","adoption":"CAA_LITHIUM_07","direct_score_input":false},{"row":8,"status":"PASS_CAA_LITHIUM_08","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/batteries","verified":"Lithium batteries transported as cargo must be packed, marked, labelled and documented in accordance with applicable dangerous-goods instructions.","quality_score":"4","adoption":"CAA_LITHIUM_08","direct_score_input":false},{"row":9,"status":"PASS_WITH_CAA_LITHIUM_09","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/packright","verified":"Aviation battery risk depends on chemistry, energy rating, condition, packaging, terminal protection, baggage location, airline approval and handling.","quality_score":"3","adoption":"CAA_LITHIUM_GUARD_09","direct_score_input":false},{"row":10,"status":"PASS_WITH_CAA_LITHIUM_10","source":"CAA passenger lithium-battery safety","url":"https://www.caa.co.uk/batteries","verified":"CAA lithium-battery evidence is battery-, device-, baggage-, operator- and flight-specific and is not an exact parcel-level fire probability.","quality_score":"3","adoption":"CAA_LITHIUM_GUARD_10","direct_score_input":false},{"row":11,"status":"PASS_CAA_LASER_01","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"Laser attacks can distract or temporarily impair flight crew during high-workload phases such as approach and landing.","quality_score":"4","adoption":"CAA_LASER_01","direct_score_input":false},{"row":12,"status":"PASS_CAA_LASER_02","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"Laser incidents affect commercial aircraft, general aviation and emergency helicopters.","quality_score":"4","adoption":"CAA_LASER_02","direct_score_input":false},{"row":13,"status":"PASS_CAA_LASER_03","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"Single-pilot operations are particularly vulnerable because no second flight-crew member may be available to manage distraction or incapacitation.","quality_score":"4","adoption":"CAA_LASER_03","direct_score_input":false},{"row":14,"status":"PASS_CAA_LASER_04","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"Members of the public who see a laser being shone at an aircraft should contact the police.","quality_score":"4","adoption":"CAA_LASER_04","direct_score_input":false},{"row":15,"status":"PASS_CAA_LASER_05","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"The Laser Misuse (Vehicles) Act 2018 provides criminal penalties for endangering aircraft with lasers.","quality_score":"4","adoption":"CAA_LASER_05","direct_score_input":false},{"row":16,"status":"PASS_CAA_LASER_06","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"Laser misuse can lead to an unlimited fine and imprisonment of up to five years.","quality_score":"4","adoption":"CAA_LASER_06","direct_score_input":false},{"row":17,"status":"PASS_CAA_LASER_07","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"The CAA coordinates the UK Laser Working Group to identify and mitigate risks associated with laser attacks.","quality_score":"4","adoption":"CAA_LASER_07","direct_score_input":false},{"row":18,"status":"PASS_CAA_LASER_08","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"Laser attacks are commonly reported near large city airports but occur across the UK.","quality_score":"4","adoption":"CAA_LASER_08","direct_score_input":false},{"row":19,"status":"PASS_WITH_CAA_LASER_09","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"Laser-event risk depends on laser power and wavelength, distance, angle, cockpit exposure, flight phase, crew composition and local response.","quality_score":"3","adoption":"CAA_LASER_GUARD_09","direct_score_input":false},{"row":20,"status":"PASS_WITH_CAA_LASER_10","source":"CAA laser safety in aviation","url":"https://www.caa.co.uk/safety-initiatives/additional-aviation-safety-mitigations/mitigating-key-safety-risks/laser-safety-in-aviation/","verified":"CAA laser evidence is event-, aircraft-, crew-, location- and time-specific and is not an exact parcel-level aviation-incident probability.","quality_score":"3","adoption":"CAA_LASER_GUARD_10","direct_score_input":false}]}