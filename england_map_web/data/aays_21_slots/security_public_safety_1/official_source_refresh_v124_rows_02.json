{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V124","part":2,"row_range":[21,40],"rows":[{"row":21,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"Confined-space duties apply where an assessment identifies risks of serious injury from work in the space.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":22,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Entry should be avoided where the work can reasonably be completed from outside.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":23,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"If entry is unavoidable, a safe system of work must be followed.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":24,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Adequate emergency arrangements must be in place before work begins.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":25,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"The risk assessment must identify hazards and determine the precautions required.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":26,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Atmospheric risks can include insufficient oxygen, toxic fumes, fire or explosion.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":27,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Workers entering confined spaces need suitable capability, training and emergency-equipment competence.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":28,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/introduction.htm","verified":"Rescue arrangements should not rely only on the public emergency services.","quality_score":"4","adoption":"HSE_CONFINED_SPACES_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":29,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"Confined-space risk depends on geometry, access, atmosphere, residues, process connections, isolation, ventilation, work method and rescue capability.","quality_score":"3","adoption":"HSE_CONFINED_SPACES_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":30,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE confined-spaces guidance","family_id":"HSE_CONFINED_SPACES","url":"https://www.hse.gov.uk/confinedspace/legislation.htm","verified":"A space being safe at one time does not prove it remains safe, and general guidance is not an exact parcel-level fatality probability.","quality_score":"3","adoption":"HSE_CONFINED_SPACES_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":31,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE workplace-transport safety guidance","family_id":"HSE_WORKPLACE_TRANSPORT","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Workplace-transport assessments should cover vehicle and pedestrian movements, loading, unloading and less frequent tasks.","quality_score":"4","adoption":"HSE_WORKPLACE_TRANSPORT_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":32,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE workplace-transport safety guidance","family_id":"HSE_WORKPLACE_TRANSPORT","url":"https://www.hse.gov.uk/workplacetransport/management/risk.htm","verified":"Site plans can help identify locations where pedestrians and vehicles interact.","quality_score":"4","adoption":"HSE_WORKPLACE_TRANSPORT_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":33,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE workplace-transport safety guidance","family_id":"HSE_WORKPLACE_TRANSPORT","url":"https://www.hse.gov.uk/pubns/books/hsg136.htm","verified":"Separate pedestrian and vehicle routes should be provided where reasonably practicable.","quality_score":"4","adoption":"HSE_WORKPLACE_TRANSPORT_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:28:00Z"},{"row":34,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE workplace-transport safety guidance","family_id":"HSE_WORKPLACE_TRANSPORT","url":"https://www.hse.gov.uk/pubns/books/hsg136.htm","verified":"Reversing should be avoided or reduced where possible and suitable crossing points provided.","quality_score":"4","adoption":"HSE_WORKPLACE_TRANSPORT_REFERENCE_04","direct_score_input":false,"checked_at":"2