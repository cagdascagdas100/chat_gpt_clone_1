{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V64","part":4,"rows":[{"row":61,"status":"PASS_COSMETICS_01","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/making-cosmetic-products-available-to-consumers-in-great-britain","verified":"Every cosmetic product made available to consumers in Great Britain must have a Responsible Person.","quality_score":"4","adoption":"COSMETICS_01","direct_score_input":false},{"row":62,"status":"PASS_COSMETICS_02","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/consumer-products-cosmetics","verified":"Cosmetic products must be safe whether sold, given away or used professionally on the public.","quality_score":"4","adoption":"COSMETICS_02","direct_score_input":false},{"row":63,"status":"PASS_COSMETICS_03","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/making-cosmetic-products-available-to-consumers-in-great-britain","verified":"The Responsible Person must maintain an up-to-date Product Information File.","quality_score":"4","adoption":"COSMETICS_03","direct_score_input":false},{"row":64,"status":"PASS_COSMETICS_04","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/making-cosmetic-products-available-to-consumers-in-great-britain","verified":"A qualified safety assessor must assess the cosmetic product before it is made available.","quality_score":"4","adoption":"COSMETICS_04","direct_score_input":false},{"row":65,"status":"PASS_COSMETICS_05","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/making-cosmetic-products-available-to-consumers-in-great-britain","verified":"Cosmetic manufacture must follow good manufacturing practice.","quality_score":"4","adoption":"COSMETICS_05","direct_score_input":false},{"row":66,"status":"PASS_COSMETICS_06","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/making-cosmetic-products-available-to-consumers-in-great-britain","verified":"Prohibited and restricted substances, including controls on colourants, preservatives and UV filters, must be observed.","quality_score":"4","adoption":"COSMETICS_06","direct_score_input":false},{"row":67,"status":"PASS_COSMETICS_07","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/consumer-products-cosmetics","verified":"Packaging must provide readable product purpose, precautions, responsible-person details, batch information and ingredients.","quality_score":"4","adoption":"COSMETICS_07","direct_score_input":false},{"row":68,"status":"PASS_COSMETICS_08","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/sue-and-safeguarding-notifications-for-cosmetics","verified":"Serious undesirable effects such as hospitalisation, disability, immediate vital risk or death must be reported to OPSS.","quality_score":"4","adoption":"COSMETICS_08","direct_score_input":false},{"row":69,"status":"PASS_WITH_COSMETICS_09","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/sue-and-safeguarding-notifications-for-cosmetics","verified":"Cosmetic risk depends on formulation, concentration, microbiological quality, packaging, user susceptibility, application and foreseeable misuse.","quality_score":"3","adoption":"COSMETICS_GUARD_09","direct_score_input":false},{"row":70,"status":"PASS_WITH_COSMETICS_10","source":"OPSS cosmetic-product safety","url":"https://www.gov.uk/guidance/sue-and-safeguarding-notifications-for-cosmetics","verified":"Cosmetic-product evidence is formulation-, batch-, user-, exposure- and market-specific and is not an exact parcel-level harm probability.","quality_score":"3","adoption":"COSMETICS_GUARD_10","direct_score_input":false},{"row":71,"status":"PASS_BIRDSTRIKE_01","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/commercial-industry/aerodromes/aerodrome-safety/birdstrikes/","verified":"Wildlife strikes, including birdstrikes, are a significant threat to aircraft.","quality_score":"4","adoption":"BIRDSTRIKE_01","direct_score_input":false},{"row":72,"status":"PASS_BIRDSTRIKE_02","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/about-us/make-a-report-or-complaint/report-something/mor/the-mors-code/","verified":"All wildlife and birdstrikes, with or without damage, are reportable occurrences.","quality_score":"4","adoption":"BIRDSTRIKE_02","direct_score_input":false},{"row":73,"status":"PASS_BIRDSTRIKE_03","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/about-us/make-a-report-or-complaint/report-something/mor/the-mors-code/","verified":"Suspected birdstrikes and encounters with flocks should also be reported.","quality_score":"4","adoption":"BIRDSTRIKE_03","direct_score_input":false},{"row":74,"status":"PASS_BIRDSTRIKE_04","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/cap-772/","verified":"Birdstrikes can damage aircraft and have the potential to cause an accident.","quality_score":"4","adoption":"BIRDSTRIKE_04","direct_score_input":false},{"row":75,"status":"PASS_BIRDSTRIKE_05","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/cap-772/","verified":"Appropriate bird-control measures can reduce birdstrike risk.","quality_score":"4","adoption":"BIRDSTRIKE_05","direct_score_input":false},{"row":76,"status":"PASS_BIRDSTRIKE_06","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/cap-772/","verified":"Aerodrome habitat and surrounding land management can reduce attraction to birds and wildlife.","quality_score":"4","adoption":"BIRDSTRIKE_06","direct_score_input":false},{"row":77,"status":"PASS_BIRDSTRIKE_07","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/data-and-publications/publications/documents/content/cap-772/","verified":"Aerodrome operators should maintain a Bird Control Management Plan within their safety-management system.","quality_score":"4","adoption":"BIRDSTRIKE_07","direct_score_input":false},{"row":78,"status":"PASS_BIRDSTRIKE_08","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/data-and-analysis/safety-and-security/birdstrike-data/","verified":"CAA warns that a higher number of reports at an aerodrome does not by itself demonstrate a greater hazard.","quality_score":"4","adoption":"BIRDSTRIKE_08","direct_score_input":false},{"row":79,"status":"PASS_WITH_BIRDSTRIKE_09","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/data-and-analysis/safety-and-security/birdstrike-data/","verified":"Birdstrike risk depends on species, flock size, season, habitat, flight phase, aircraft type, reporting and aerodrome controls.","quality_score":"3","adoption":"BIRDSTRIKE_GUARD_09","direct_score_input":false},{"row":80,"status":"PASS_WITH_BIRDSTRIKE_10","source":"CAA wildlife-strike and birdstrike safety","url":"https://www.caa.co.uk/data-and-analysis/safety-and-security/birdstrike-data/","verified":"CAA wildlife-strike evidence is event-, species-, aerodrome-, aircraft- and time-specific and is not an exact parcel-level accident probability.","quality_score":"3","adoption":"BIRDSTRIKE_GUARD_10","direct_score_input":false}]}