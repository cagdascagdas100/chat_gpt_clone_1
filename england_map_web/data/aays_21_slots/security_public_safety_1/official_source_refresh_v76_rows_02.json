{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V76","part":2,"rows":[{"row":21,"status":"PASS_FARM_TRANSPORT_01","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"HSE structures agricultural transport controls around Safe Stop, Safe Vehicle, Safe Driver and Safe Site.","quality_score":"4","adoption":"FARM_TRANSPORT_01","direct_score_input":false},{"row":22,"status":"PASS_FARM_TRANSPORT_02","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Safe Stop includes applying the handbrake, placing controls in neutral, switching off power and removing the key.","quality_score":"4","adoption":"FARM_TRANSPORT_02","direct_score_input":false},{"row":23,"status":"PASS_FARM_TRANSPORT_03","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Safe Stop should be followed before leaving the driving or operating position.","quality_score":"4","adoption":"FARM_TRANSPORT_03","direct_score_input":false},{"row":24,"status":"PASS_FARM_TRANSPORT_04","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Safe Stop should be followed before maintenance, adjustments or clearing a blockage.","quality_score":"4","adoption":"FARM_TRANSPORT_04","direct_score_input":false},{"row":25,"status":"PASS_FARM_TRANSPORT_05","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Farm vehicles and handling equipment should be suitable for the intended work.","quality_score":"4","adoption":"FARM_TRANSPORT_05","direct_score_input":false},{"row":26,"status":"PASS_FARM_TRANSPORT_06","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Vehicles and equipment should be inspected daily and faults repaired promptly.","quality_score":"4","adoption":"FARM_TRANSPORT_06","direct_score_input":false},{"row":27,"status":"PASS_FARM_TRANSPORT_07","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Reversing aids such as mirrors should be provided where needed.","quality_score":"4","adoption":"FARM_TRANSPORT_07","direct_score_input":false},{"row":28,"status":"PASS_FARM_TRANSPORT_08","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Site arrangements should separate people and vehicles so far as reasonably practicable.","quality_score":"4","adoption":"FARM_TRANSPORT_08","direct_score_input":false},{"row":29,"status":"PASS_WITH_FARM_TRANSPORT_09","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"Farm-transport risk depends on vehicle type, terrain, load, visibility, maintenance, driver competence, pedestrian activity and site controls.","quality_score":"3","adoption":"FARM_TRANSPORT_GUARD_09","direct_score_input":false},{"row":30,"status":"PASS_WITH_FARM_TRANSPORT_10","source":"HSE agricultural workplace-transport safety","url":"https://www.hse.gov.uk/agriculture/topics/machinery/farm-vehicles-1.htm","verified":"HSE agricultural-transport evidence is vehicle-, site-, task-, driver-, pedestrian- and time-specific and is not an exact parcel-level collision probability.","quality_score":"3","adoption":"FARM_TRANSPORT_GUARD_10","direct_score_input":false},{"row":31,"status":"PASS_FOOD_MACHINE_01","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/food/safety-hazards/machinery.htm","verified":"Conveyors account for a substantial share of machinery accidents in food and drink manufacturing.","quality_score":"4","adoption":"FOOD_MACHINE_01","direct_score_input":false},{"row":32,"status":"PASS_FOOD_MACHINE_02","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/Food/safety-hazards/index.htm","verified":"Flat-belt conveyors are associated with many conveyor injuries.","quality_score":"4","adoption":"FOOD_MACHINE_02","direct_score_input":false},{"row":33,"status":"PASS_FOOD_MACHINE_03","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/food/safety-hazards/machinery.htm","verified":"Common conveyor hazards include in-running transmission parts and trapping points.","quality_score":"4","adoption":"FOOD_MACHINE_03","direct_score_input":false},{"row":34,"status":"PASS_FOOD_MACHINE_04","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/Food/safety-hazards/index.htm","verified":"Many accidents occur during foreseeable activities such as production and clearing blockages.","quality_score":"4","adoption":"FOOD_MACHINE_04","direct_score_input":false},{"row":35,"status":"PASS_FOOD_MACHINE_05","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/food/safety-hazards/machinery.htm","verified":"Hazardous parts may require fixed, hinged or removable interlocked guarding.","quality_score":"4","adoption":"FOOD_MACHINE_05","direct_score_input":false},{"row":36,"status":"PASS_FOOD_MACHINE_06","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/Food/safety-hazards/index.htm","verified":"Cleaning systems should prevent exposure to unguarded moving parts.","quality_score":"4","adoption":"FOOD_MACHINE_06","direct_score_input":false},{"row":37,"status":"PASS_FOOD_MACHINE_07","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/food/safety-hazards/machinery.htm","verified":"Safe cleaning procedures should be formalised and workers trained.","quality_score":"4","adoption":"FOOD_MACHINE_07","direct_score_input":false},{"row":38,"status":"PASS_FOOD_MACHINE_08","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/Food/safety-hazards/index.htm","verified":"Purchasers should specify safety requirements and verify that supplied machinery is suitable and compliant.","quality_score":"4","adoption":"FOOD_MACHINE_08","direct_score_input":false},{"row":39,"status":"PASS_WITH_FOOD_MACHINE_09","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/food/safety-hazards/machinery.htm","verified":"Food-machinery risk depends on machine type, guarding, cleaning method, blockage clearing, maintenance, product flow, training and supervision.","quality_score":"3","adoption":"FOOD_MACHINE_GUARD_09","direct_score_input":false},{"row":40,"status":"PASS_WITH_FOOD_MACHINE_10","source":"HSE food-processing machinery safety","url":"https://www.hse.gov.uk/Food/safety-hazards/index.htm","verified":"HSE food-machinery evidence is machine-, task-, safeguard-, worker-, hygiene- and time-specific and is not an exact parcel-level injury probability.","quality_score":"3","adoption":"FOOD_MACHINE_GUARD_10","direct_score_input":false}]}