{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V125","part":3,"row_range":[41,60],"rows":[{"row":41,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Employers must protect workers from injury risks arising from hazardous manual handling.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":42,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Manual handling includes lifting, putting down, pushing, pulling, carrying or moving a load by hand or bodily force.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":43,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"A manual-handling load can be an object, person or animal.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":44,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Hazardous manual handling should be avoided so far as reasonably practicable.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":45,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Unavoidable hazardous manual-handling operations must be assessed.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":46,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"The risk of injury from unavoidable manual handling must be reduced as low as reasonably practicable.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":47,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"The law does not set a single specific weight limit for manual handling.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":48,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Where injury risk exists and it is reasonably practicable, information should be provided about load weight and centre of gravity.","quality_score":"4","adoption":"HSE_MANUAL_HANDLING_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":49,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"Manual-handling risk depends on the load, posture, reach, frequency, carrying distance, work environment, individual capability and available handling aids.","quality_score":"3","adoption":"HSE_MANUAL_HANDLING_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":50,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE manual-handling-at-work guidance","family_id":"HSE_MANUAL_HANDLING","url":"https://www.hse.gov.uk/msd/manual-handling/index.htm","verified":"General manual-handling guidance does not establish an exact injury probability for an individual task or parcel.","quality_score":"3","adoption":"HSE_MANUAL_HANDLING_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":51,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/cleancampaign.htm","verified":"Contamination is involved in almost all slip accidents and can include water, oil, dust and other material on a floor.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":52,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/cleancampaign.htm","verified":"Sources of floor contamination should be identified, including spills, leaks, overflow, cleaning activity, run-off and footwear.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":53,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/cleancampaign.htm","verified":"Controls such as guards, drip trays, lids, revised work practices and entrance matting can stop contamination reaching floors.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":54,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/cleaning.htm","verified":"Access to wet or drying floors should be restricted, or a dry route maintained, until the floor is safe.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":55,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/cleaning.htm","verified":"Cleaning products, methods and equipment must suit the floor and contamination, and spillages should be removed promptly.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":56,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/flooring.htm","verified":"Workplace floors must be suitable, in good condition and free from obstructions so people can move safely.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":57,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/flooring.htm","verified":"Where frequent contamination is expected, flooring should still allow people to walk without slipping.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":58,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/environment.htm","verified":"Lighting, weather, rainwater, frost, ice and condensation can materially affect slip and trip risk.","quality_score":"4","adoption":"HSE_SLIPS_AND_TRIPS_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":59,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/cleancampaign.htm","verified":"Slip and trip risk depends on contamination, floor material and condition, cleaning method, footwear, lighting, weather, layout and human behaviour.","quality_score":"3","adoption":"HSE_SLIPS_AND_TRIPS_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":60,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE slips-and-trips prevention guidance","family_id":"HSE_SLIPS_AND_TRIPS","url":"https://www.hse.gov.uk/slips/cleancampaign.htm","verified":"General slip-and-trip evidence does not prove current conditions or establish an exact incident probability at an individual parcel.","quality_score":"3","adoption":"HSE_SLIPS_AND_TRIPS_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"}]}