{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V70","part":1,"rows":[{"row":1,"status":"PASS_WORKPLACE_TRANSPORT_01","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Workplace-transport risk assessment should include vehicle movements, loading, unloading and less-frequent transport tasks.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_01","direct_score_input":false},{"row":2,"status":"PASS_WORKPLACE_TRANSPORT_02","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Mapping vehicle and pedestrian movements can reveal where people and vehicles interact.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_02","direct_score_input":false},{"row":3,"status":"PASS_WORKPLACE_TRANSPORT_03","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/pubns/books/hsg136.htm","verified":"Pedestrian and vehicle routes should be separated as far as reasonably practicable.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_03","direct_score_input":false},{"row":4,"status":"PASS_WORKPLACE_TRANSPORT_04","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/information/riskassessment.htm","verified":"HSE structures workplace-transport controls around a safe site, safe vehicle and safe driver.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_04","direct_score_input":false},{"row":5,"status":"PASS_WORKPLACE_TRANSPORT_05","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Reversing should be avoided where possible and controlled effectively when unavoidable.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_05","direct_score_input":false},{"row":6,"status":"PASS_WORKPLACE_TRANSPORT_06","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Traffic routes and driving surfaces should be suitable for their intended use.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_06","direct_score_input":false},{"row":7,"status":"PASS_WORKPLACE_TRANSPORT_07","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/pubns/books/hsg136.htm","verified":"Vehicle speed should be managed as part of workplace traffic control.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_07","direct_score_input":false},{"row":8,"status":"PASS_WORKPLACE_TRANSPORT_08","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/information/riskassessment.htm","verified":"Employers should inspect and review workplace-transport arrangements rather than relying on informal custom.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_08","direct_score_input":false},{"row":9,"status":"PASS_WITH_WORKPLACE_TRANSPORT_09","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/about.htm","verified":"Workplace-transport risk depends on site layout, vehicle type, pedestrian activity, loading tasks, traffic controls, visibility and driver competence.","quality_score":"3","adoption":"WORKPLACE_TRANSPORT_GUARD_09","direct_score_input":false},{"row":10,"status":"PASS_WITH_WORKPLACE_TRANSPORT_10","source":"HSE workplace-transport safety","url":"https://www.hse.gov.uk/workplacetransport/information/riskassessment.htm","verified":"HSE workplace-transport evidence is site-, vehicle-, task-, worker- and time-specific and is not an exact parcel-level collision probability.","quality_score":"3","adoption":"WORKPLACE_TRANSPORT_GUARD_10","direct_score_input":false},{"row":11,"status":"PASS_LIFT_TRUCK_01","source":"HSE lift-truck safety","url":"https://www.hse.gov.uk/workplacetransport/lift-trucks/managing-lift-trucks.htm","verified":"Lift trucks are particularly dangerous workplace vehicles and are involved in a substantial share of workplace-transport accidents.","quality_score":"4","adoption":"LI