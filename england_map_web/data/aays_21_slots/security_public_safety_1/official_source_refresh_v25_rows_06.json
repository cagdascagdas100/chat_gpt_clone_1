{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V25","part":6,"rows":[{"row":116,"status":"PASS_CCA_GENERIC_FRAMEWORK","source":"Cabinet Office Emergency Preparedness","url":"https://www.gov.uk/government/publications/emergency-preparedness","verified":"Emergency Preparedness and Emergency Response and Recovery provide the generic UK civil-protection framework under Part 1 of the Civil Contingencies Act 2004.","quality_score":"4","adoption":"CIVIL_PROTECTION_FRAMEWORK","direct_score_input":false},{"row":117,"status":"PASS_CCA_RISK_ASSESSMENT_DUTY","source":"GOV.UK responder responsibilities","url":"https://www.gov.uk/guidance/preparation-and-planning-for-emergencies-responsibilities-of-responder-agencies-and-others","verified":"Category 1 responders must assess emergency risks and use the assessment to inform contingency planning.","quality_score":"4","adoption":"RESPONDER_RISK_ASSESSMENT_DUTY","direct_score_input":false},{"row":118,"status":"PASS_CCA_EMERGENCY_PLAN_DUTY","source":"GOV.UK responder responsibilities","url":"https://www.gov.uk/guidance/preparation-and-planning-for-emergencies-responsibilities-of-responder-agencies-and-others","verified":"Emergency planning is a core civil-protection duty for Category 1 responders.","quality_score":"4","adoption":"EMERGENCY_PLAN_DUTY","direct_score_input":false},{"row":119,"status":"PASS_CCA_BUSINESS_CONTINUITY_DUTY","source":"GOV.UK resilience in society","url":"https://www.gov.uk/guidance/resilience-in-society-infrastructure-communities-and-businesses","verified":"Category 1 responders must maintain business-continuity arrangements for all their functions, not only civil-protection functions.","quality_score":"4","adoption":"RESPONDER_BUSINESS_CONTINUITY","direct_score_input":false},{"row":120,"status":"PASS_CCA_PUBLIC_AWARENESS_DUTY","source":"GOV.UK preparation and planning","url":"https://www.gov.uk/guidance/preparation-and-planning-for-emergencies-the-capabilities-programme","verified":"Public a