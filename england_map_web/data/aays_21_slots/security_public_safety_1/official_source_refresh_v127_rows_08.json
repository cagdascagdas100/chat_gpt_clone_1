{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V127","part":8,"row_range":[141,160],"rows":[{"row":141,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/outdoor-working.htm","verified":"Outdoor weather can have immediate or longer-term effects on worker health if risks are not properly managed.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":142,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/cold-stress.htm","verified":"Cold and adverse weather can also reduce a worker's ability to operate machinery or perform tasks safely.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":143,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/outdoor-working.htm","verified":"Personal protective equipment issued for cold outdoor work must be appropriate for the conditions and task.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":144,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/cold-stress.htm","verified":"Employers should provide suitable facilities for warming up and access to warm drinks where appropriate.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":145,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/outdoor-working.htm","verified":"More frequent rest breaks can reduce cold exposure.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":146,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/cold-stress.htm","verified":"Work may need to be delayed or rescheduled for warmer conditions where this can be done without creating other safety risks.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":147,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/outdoor-working.htm","verified":"Workers should be able to recognise early symptoms of cold stress and know how to obtain help.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":148,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/cold-stress.htm","verified":"Indoor guidance normally suggests at least 16°C, or 13°C for rigorous physical work, but risk assessment must still consider the actual task and conditions.","quality_score":"4","adoption":"HSE_OUTDOOR_COLD_WORK_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":149,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/outdoor-working.htm","verified":"Cold-weather risk depends on temperature, wind, rain, clothing, work rate, duration, shelter, health, fatigue, equipment handling and emergency arrangements.","quality_score":"3","adoption":"HSE_OUTDOOR_COLD_WORK_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":150,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE outdoor-working and cold-weather guidance","family_id":"HSE_OUTDOOR_COLD_WORK","url":"https://www.hse.gov.uk/temperature/employer/outdoor-working.htm","verified":"General PPE, warm facilities, breaks, scheduling, symptom recognition and weather-related work controls guidance does not prove current conditions or control performance at an individual parcel and does not establish an exact incident, exposure or illness probability.","quality_score":"3","adoption":"HSE_OUTDOOR_COLD_WORK_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":151,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/safeuse.htm","verified":"LPG can be used safely when fire, explosion and structural risks are properly identified and managed.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":152,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/storagetank.htm","verified":"Site operators should know the installation layout, pipework route, risk assessments and maintenance history.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":153,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/servicepipework.htm","verified":"The LPG supplier commonly maintains the storage tank, while ownership and maintenance responsibility for service pipework may rest with the premises owner.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":154,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/legalframework.htm","verified":"Tank users remain responsible for safe siting, ventilation, tanker access, security, impact protection and emergency arrangements.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":155,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/safeuse.htm","verified":"Tank valves should be secured against unauthorised access, and larger tanks normally require suitable fencing that preserves natural ventilation.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":156,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/storagetank.htm","verified":"Tanks and associated pipework should be protected from vehicle impact using effective barriers or bollards where traffic cannot be excluded.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":157,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/servicepipework.htm","verified":"Service pipework must be regularly inspected and maintained by a competent person because impact or corrosion can release LPG and cause fire or explosion.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":158,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/legalframework.htm","verified":"Emergency plans should include evacuation, supplier contact details and safe isolation of shut-off valves where this can be done without endangering people.","quality_score":"4","adoption":"HSE_LPG_BULK_INSTALLATIONS_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":159,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/safeuse.htm","verified":"LPG risk depends on tank and pipework condition, siting, ventilation, ignition sources, traffic impact, security, ownership, maintenance, leak detection and emergency response.","quality_score":"3","adoption":"HSE_LPG_BULK_INSTALLATIONS_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"},{"row":160,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE LPG bulk-installation safety guidance","family_id":"HSE_LPG_BULK_INSTALLATIONS","url":"https://www.hse.gov.uk/gas/lpg/safeuse.htm","verified":"General tank siting, security, impact protection, pipework maintenance and emergency arrangements guidance does not prove current conditions or control performance at an individual parcel and does not establish an exact incident, exposure or illness probability.","quality_score":"3","adoption":"HSE_LPG_BULK_INSTALLATIONS_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T11:42:00Z"}]}