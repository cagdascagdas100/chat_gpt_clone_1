{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V36","part":1,"rows":[{"row":1,"status":"PASS_WORKPLACE_TRANSPORT_01","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Employers must manage risks created by vehicles operating in workplaces.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_01","direct_score_input":false},{"row":2,"status":"PASS_WORKPLACE_TRANSPORT_02","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Pedestrians and vehicles should be separated wherever reasonably practicable.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_02","direct_score_input":false},{"row":3,"status":"PASS_WORKPLACE_TRANSPORT_03","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Pedestrian-only and vehicle-only routes should be clearly marked.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_03","direct_score_input":false},{"row":4,"status":"PASS_WORKPLACE_TRANSPORT_04","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Where routes cross, suitable marked and protected crossing points should be provided.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_04","direct_score_input":false},{"row":5,"status":"PASS_WORKPLACE_TRANSPORT_05","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Shared routes should be wide enough for vehicles to pass pedestrians safely.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_05","direct_score_input":false},{"row":6,"status":"PASS_WORKPLACE_TRANSPORT_06","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Materials or spillages that create road hazards should be removed promptly.","quality_score":"4","adoption":"WORKPLACE_TRANSPORT_06","d