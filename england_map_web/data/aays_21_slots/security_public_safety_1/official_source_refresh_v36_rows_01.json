SS_WITH_WORKPLACE_TRANSPORT_19","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Controls must reflect the actual site layout, vehicle mix, pedestrian behaviour and changing operations.","quality_score":"3","adoption":"WORKPLACE_TRANSPORT_GUARD_19","direct_score_input":false},{"row":20,"status":"PASS_WITH_WORKPLACE_TRANSPORT_20","source":"HSE workplace transport safety","url":"https://www.hse.gov.uk/workplacetransport/index.htm","verified":"Workplace transport guidance is operational context and is not an exact parcel-level safety probability.","quality_score":"3","adoption":"WORKPLACE_TRANSPORT_GUARD_20","direct_score_input":false}]}