{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V20","part":3,"rows":[{"row":37,"status":"PASS_ASBESTOS_NORMAL_OCCUPANCY_SCOPE","source":"HSE asbestos presence guidance","url":"https://www.hse.gov.uk/asbestos/duty/is-asbestos-present.htm","verified":"Dutyholders must identify materials that could be damaged or disturbed during normal occupancy.","quality_score":"4","adoption":"NORMAL_USE_DISTURBANCE_GATE","direct_score_input":false},{"row":38,"status":"PASS_ASBESTOS_GOOD_CONDITION_MANAGEMENT","source":"HSE asbestos safety introduction","url":"https://www.hse.gov.uk/asbestos/introduction/","verified":"Asbestos-containing material in good condition and unlikely to be disturbed can be left in place with controlled management.","quality_score":"4","adoption":"MANAGE_IN_PLACE_OPTION","direct_score_input":false},{"row":39,"status":"PASS_ASBESTOS_POOR_CONDITION_ACTION","source":"HSE asbestos safety introduction","url":"https://www.hse.gov.uk/asbestos/introduction/","verified":"Material in poor condition or likely to be damaged should be removed when it cannot be safely repaired or enclosed.","quality_score":"4","adoption":"REMOVE_IF_UNCONTROLLED","direct_score_input":false},{"row":40,"status":"PASS_ASBESTOS_WORKER_LOCATION_INFO","source":"HSE asbestos safety introduction","url":"https://www.hse.gov.uk/asbestos/introduction/","verified":"Workers must be informed of specific known or presumed asbestos locations in the areas they use.","quality_score":"4","adoption":"WORKER_LOCATION_DISCLOSURE","direct_score_input":false},{"row":41,"status":"PASS_ASBESTOS_EMERGENCY_SERVICE_INFO","source":"HSE asbestos information guidance","url":"https://www.hse.gov.uk/asbestos/duty/provide-information.htm","verified":"The management plan should provide emergency services with the location and condition of known asbestos-containing materials.","quality_score":"4","adoption":"EMERGENCY_SERVICE_INFORMATION","direct_score_input":false},{"row":42,"status":"PASS_ASBESTOS_PREWORK_DISCLOSURE","source":"HSE asbestos information guidance","url":"https://www.hse.gov.uk/asbestos/duty/provide-information.htm","verified":"Employees and contractors must receive asbestos-management information before work begins on the building fabric.","quality_score":"4","adoption":"PREWORK_INFORMATION_GATE","direct_score_input":false},{"row":43,"status":"PASS_ASBESTOS_CONTRACTOR_SCOPE","source":"HSE asbestos information guidance","url":"https://www.hse.gov.uk/asbestos/duty/provide-information.htm","verified":"The disclosure duty covers construction, installation, maintenance, excavation and demolition workers who may disturb materials.","quality_score":"4","adoption":"CONTRACTOR_ROLE_SCOPE","direct_score_input":false},{"row":44,"status":"PASS_ASBESTOS_PLAN_RESPONSIBILITY_FIELDS","source":"HSE asbestos management plan","url":"https://www.hse.gov.uk/asbestos/duty/asbestos-management-plan.htm","verified":"The management plan should identify the responsible person and deputies.","quality_score":"4","adoption":"PLAN_RESPONSIBILITY_SCHEMA","direct_score_input":false},{"row":45,"status":"PASS_ASBESTOS_SITE_PLAN_FIELDS","source":"HSE asbestos management plan","url":"https://www.hse.gov.uk/asbestos/duty/asbestos-management-plan.htm","verified":"The plan should include the asbestos register, a site plan and areas that were not inspected.","quality_score":"4","adoption":"SITE_PLAN_AND_GAP_SCHEMA","direct_score_input":false},{"row":46,"status":"PASS_ASBESTOS_MONITORING_SCHEDULE","source":"HSE asbestos management plan","url":"https://www.hse.gov.uk/asbestos/duty/asbestos-management-plan.htm","verified":"The plan should specify a schedule for monitoring the condition of asbestos-containing materials.","quality_score":"4","adoption":"CONDITION_MONITORING_SCHEDULE","direct_score_input":false},{"row":47,"status":"PASS_WITH_DOMESTIC_DUTY_BOUNDARY","source":"HSE asbestos role guidance","url":"https://www.hse.gov.uk/asbestos/introduction/actions.htm","verified":"The regulation-4 duty does not apply inside owner-occupied homes, although contractors still have duties to control exposure from their work.","quality_score":"3","adoption":"DOMESTIC_SCOPE_BOUNDARY","direct_score_input":false},{"row":48,"status":"PASS_ASBESTOS_AWARENESS_LIMIT","source":"HSE asbestos duty guidance","url":"https://www.hse.gov.uk/asbestos/duty/check.htm","verified":"Asbestos-awareness training does not authorise routine maintenance workers to work on asbestos.","quality_score":"4","adoption":"TRAINING_NOT_WORK_PERMISSION","direct_score_input":false},{"row":49,"status":"PASS_ASBESTOS_REGULATION4","source":"HSE asbestos legislation","url":"https://www.hse.gov.uk/asbestos/introduction/relevant-law.htm","verified":"Regulation 4 requires identification and management of asbestos in non-domestic premises and common parts of multi-occupancy domestic premises.","quality_score":"4","adoption":"REGULATION4_LEGAL_GATE","direct_score_input":false},{"row":50,"status":"PASS_ASBESTOS_COSHH_HOME_WORK","source":"HSE asbestos legislation","url":"https://www.hse.gov.uk/asbestos/introduction/relevant-law.htm","verified":"Where regulation 4 does not apply inside homes, COSHH duties still apply to employers controlling exposure from work activities.","quality_score":"4","adoption":"COSHH_WORK_ACTIVITY_GATE","direct_score_input":false},{"row":51,"status":"PASS_LEGIONELLA_FATAL_PNEUMONIA","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Legionnaires' disease is described as a potentially fatal pneumonia.","quality_score":"4","adoption":"LEGIONELLA_HARM_SEMANTIC","direct_score_input":false},{"row":52,"status":"PASS_LEGIONELLA_DROPLET_TRANSMISSION","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Exposure occurs through inhalation of small contaminated water droplets.","quality_score":"4","adoption":"AEROSOL_TRANSMISSION_CONTEXT","direct_score_input":false},{"row":53,"status":"PASS_LEGIONELLA_MANMADE_SYSTEM_SCOPE","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Man-made hot and cold water systems can provide conditions in which legionella grows.","quality_score":"4","adoption":"WATER_SYSTEM_HAZARD_SCOPE","direct_score_input":false},{"row":54,"status":"PASS_LEGIONELLA_LANDLORD_DUTY","source":"HSE Legionella landlord guidance","url":"https://www.hse.gov.uk/legionnaires/legionella-landlords-responsibilities.htm","verified":"Landlords have legal responsibilities to keep rented property safe and control tenant health risks.","quality_score":"4","adoption":"LANDLORD_HEALTH_DUTY","direct_score_input":false}]}