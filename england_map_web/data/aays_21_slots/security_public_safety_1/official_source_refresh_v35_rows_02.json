{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V35","part":2,"rows":[{"row":41,"status":"PASS_EXC_THREE_ELEMENTS","source":"HSE HSG47 underground services","url":"https://www.hse.gov.uk/pubns/books/hsg47.htm","verified":"A safe excavation system has three basic elements: planning, locating and identifying services, and safe excavation.","quality_score":"4","adoption":"PASS_EXC_THREE_ELEMENTS","direct_score_input":false},{"row":42,"status":"PASS_EXC_CABLE_ELECTRIC_SHOCK","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Damaging an underground cable can cause fatal or serious electric shock.","quality_score":"4","adoption":"PASS_EXC_CABLE_ELECTRIC_SHOCK","direct_score_input":false},{"row":43,"status":"PASS_EXC_CABLE_ARC_EXPLOSION","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Damaged underground cables can create electrical arcs and explosions.","quality_score":"4","adoption":"PASS_EXC_CABLE_ARC_EXPLOSION","direct_score_input":false},{"row":44,"status":"PASS_EXC_CABLE_FLAME_BURNS","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Cable damage can produce flames and severe burns.","quality_score":"4","adoption":"PASS_EXC_CABLE_FLAME_BURNS","direct_score_input":false},{"row":45,"status":"PASS_EXC_DAMAGE_CUT_OR_CRUSH","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Underground cables can be damaged by cutting with tools or crushing with heavy objects or machinery.","quality_score":"4","adoption":"PASS_EXC_DAMAGE_CUT_OR_CRUSH","direct_score_input":false},{"row":46,"status":"PASS_EXC_PREVIOUS_DAMAGE_RISK","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Previously damaged but unreported or unrepaired cables can later cause incidents.","quality_score":"4","adoption":"PASS_EXC_PREVIOUS_DAMAGE_RISK","direct_score_input":false},{"row":47,"status":"PASS_EXC_LOCATE_MARK_BEFORE_WORK","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Underground cables must be located, identified and clearly marked before work begins.","quality_score":"4","adoption":"PASS_EXC_LOCATE_MARK_BEFORE_WORK","direct_score_input":false},{"row":48,"status":"PASS_EXC_USE_PLANS_AND_LOCATOR","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Plans and other information should be used with a suitable locating device to identify likely service positions.","quality_score":"4","adoption":"PASS_EXC_USE_PLANS_AND_LOCATOR","direct_score_input":false},{"row":49,"status":"PASS_EXC_LOCATOR_REPEAT","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Locating devices should be used frequently and repeatedly during excavation work.","quality_score":"4","adoption":"PASS_EXC_LOCATOR_REPEAT","direct_score_input":false},{"row":50,"status":"PASS_EXC_LOCATOR_TRAINING","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"People using cable locators require thorough training in their use and limitations.","quality_score":"4","adoption":"PASS_EXC_LOCATOR_TRAINING","direct_score_input":false},{"row":51,"status":"PASS_EXC_LOCATOR_MAINTENANCE","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Locating devices should be checked and maintained in good working order.","quality_score":"4","adoption":"PASS_EXC_LOCATOR_MAINTENANCE","direct_score_input":false},{"row":52,"status":"PASS_EXC_TRIAL_HOLES","source":"HSE excavation electrical guidance","url":"https://www.hse.gov.uk/electricity/information/excavations.htm","verified":"Suitable hand-dug trial holes may be needed to confirm the position of a located service.","quality_score":"4","adoption":"PASS_EXC_TRIAL_HOLES","direct_score_input":false},{"row":53,"status":"PASS_EXC_DIG_ALONGSIDE_SERVICE","source":"HSE excavation electrical guidance","url":"https://www.hse.gov.uk/electricity/information/excavations.htm","verified":"Excavation should proceed alongside a service rather than directly above it.","quality_score":"4","adoption":"PASS_EXC_DIG_ALONGSIDE_SERVICE","direct_score_input":false},{"row":54,"status":"PASS_EXC_HORIZONTAL_FINAL_EXPOSURE","source":"HSE excavation electrical guidance","url":"https://www.hse.gov.uk/electricity/information/excavations.htm","verified":"Final exposure by horizontal digging improves control of hand-tool force.","quality_score":"4","adoption":"PASS_EXC_HORIZONTAL_FINAL_EXPOSURE","direct_score_input":false},{"row":55,"status":"PASS_EXC_INSULATED_TOOLS","source":"HSE excavation electrical guidance","url":"https://www.hse.gov.uk/electricity/information/excavations.htm","verified":"Insulated tools should be used when hand digging near electric cables.","quality_score":"4","adoption":"PASS_EXC_INSULATED_TOOLS","direct_score_input":false},{"row":56,"status":"PASS_EXC_COMPETENT_SHIFT_INSPECTION","source":"HSE excavation safety","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"A competent person must inspect excavation supports or battering at the start of the shift and at specified times.","quality_score":"4","adoption":"PASS_EXC_COMPETENT_SHIFT_INSPECTION","direct_score_input":false},{"row":57,"status":"PASS_EXC_CLIENT_INFORMATION","source":"HSE excavation safety","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Commercial clients must provide relevant ground, underground-structure, watercourse and existing-service information before work.","quality_score":"4","adoption":"PASS_EXC_CLIENT_INFORMATION","direct_score_input":false},{"row":58,"status":"PASS_WITH_EXC_PLANS_NOT_EXACT","source":"HSE underground cables","url":"https://www.hse.gov.uk/electricity/underground.htm","verified":"Service plans guide locating work but do not prove the exact live position or depth of every buried service.","quality_score":"3","adoption":"PASS_WITH_EXC_PLANS_NOT_EXACT","direct_score_input":false},{"row":59,"status":"PASS_WITH_EXC_CONDITIONS_CHANGE","source":"HSE excavation safety","url":"https://www.hse.gov.uk/construction/safetytopics/excavations.htm","verified":"Excavations require reinspection after events that could affect strength or stability, so a prior inspection is not permanently valid.","quality_score":"3","adoption":"PASS_WITH_EXC_CONDITIONS_CHANGE","direct_score_input":false},{"row":60,"status":"PASS_WITH_EXC_NOT_PARCEL_SCORE","source":"HSE excavation safety","url":"https://www.hse.gov.uk/pubns/books/hsg47.htm","verified":"Excavation controls are task- and site-specific and are not converted into parcel-level safety probability.","quality_score":"3","adoption":"PASS_WITH_EXC_NOT_PARCEL_SCORE","direct_score_input":false},{"row":61,"status":"PASS_DEMOLITION_CDM_APPLIES","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Demolition is treated as construction work and the Construction (Design and Management) Regulations 2015 apply.","quality_score":"4","adoption":"PASS_DEMOLITION_CDM_APPLIES","direct_score_input":false},{"row":62,"status":"PASS_DEMOLITION_COMPETENT_APPOINTMENTS","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Clients must appoint designers and contractors with relevant skills, knowledge and experience.","quality_score":"4","adoption":"PASS_DEMOLITION_COMPETENT_APPOINTMENTS","direct_score_input":false},{"row":63,"status":"PASS_DEMOLITION_PRECONSTRUCTION_INFORMATION","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"The commercial client and principal designer must provide necessary pre-construction information.","quality_score":"4","adoption":"PASS_DEMOLITION_PRECONSTRUCTION_INFORMATION","direct_score_input":false},{"row":64,"status":"PASS_DEMOLITION_PD_PRECONSTRUCTION","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"The principal designer plans and manages health and safety during the pre-construction phase.","quality_score":"4","adoption":"PASS_DEMOLITION_PD_PRECONSTRUCTION","direct_score_input":false},{"row":65,"status":"PASS_DEMOLITION_PC_CONSTRUCTION_PHASE","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"The principal contractor plans and manages health and safety during demolition.","quality_score":"4","adoption":"PASS_DEMOLITION_PC_CONSTRUCTION_PHASE","direct_score_input":false},{"row":66,"status":"PASS_DEMOLITION_SUPERVISION","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Site managers must ensure workers are supervised and follow safe working practices.","quality_score":"4","adoption":"PASS_DEMOLITION_SUPERVISION","direct_score_input":false},{"row":67,"status":"PASS_DEMOLITION_LOCAL_AUTHORITY_NOTICE","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Notice normally must be given to the local authority at least six weeks before demolition starts.","quality_score":"4","adoption":"PASS_DEMOLITION_LOCAL_AUTHORITY_NOTICE","direct_score_input":false},{"row":68,"status":"PASS_DEMOLITION_ASBESTOS_SURVEY","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"The client must provide a competent refurbishment or demolition asbestos survey.","quality_score":"4","adoption":"PASS_DEMOLITION_ASBESTOS_SURVEY","direct_score_input":false},{"row":69,"status":"PASS_DEMOLITION_STRUCTURE_INFORMATION","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Pre-construction information should cover structural stability, alterations, nearby structures and below-ground live services.","quality_score":"4","adoption":"PASS_DEMOLITION_STRUCTURE_INFORMATION","direct_score_input":false},{"row":70,"status":"PASS_DEMOLITION_METHOD_COMPETENT","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"The demolition method must be written by a competent person and control the hazards of the structure and site.","quality_score":"4","adoption":"PASS_DEMOLITION_METHOD_COMPETENT","direct_score_input":false},{"row":71,"status":"PASS_DEMOLITION_TOP_DOWN_CONTROL","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Top-down demolition can improve control of structural stability and debris build-up.","quality_score":"4","adoption":"PASS_DEMOLITION_TOP_DOWN_CONTROL","direct_score_input":false},{"row":72,"status":"PASS_DEMOLITION_DEBRIS_WITHIN_ZONE","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Work should be planned so collapse debris remains inside a defined area and does not breach the site boundary.","quality_score":"4","adoption":"PASS_DEMOLITION_DEBRIS_WITHIN_ZONE","direct_score_input":false},{"row":73,"status":"PASS_DEMOLITION_EXCLUSION_ZONES","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"The demolition method should define safe working, exclusion and debris zones.","quality_score":"4","adoption":"PASS_DEMOLITION_EXCLUSION_ZONES","direct_score_input":false},{"row":74,"status":"PASS_DEMOLITION_ZONE_DYNAMIC","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Exclusion zones may need to change as the demolition technique and work stage change.","quality_score":"4","adoption":"PASS_DEMOLITION_ZONE_DYNAMIC","direct_score_input":false},{"row":75,"status":"PASS_DEMOLITION_COMPETENT_SURVEY","source":"HSE structural stability","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"A competent person should survey and assess the structure before potentially load-bearing parts are altered.","quality_score":"4","adoption":"PASS_DEMOLITION_COMPETENT_SURVEY","direct_score_input":false},{"row":76,"status":"PASS_DEMOLITION_TEMP_SUPPORT_DESIGN","source":"HSE structural stability","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Temporary support must be designed, installed and maintained for foreseeable loads.","quality_score":"4","adoption":"PASS_DEMOLITION_TEMP_SUPPORT_DESIGN","direct_score_input":false},{"row":77,"status":"PASS_DEMOLITION_WRITTEN_SEQUENCE","source":"HSE structural stability","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Demolition or dismantling arrangements and the sequence preventing accidental collapse should be written before work starts.","quality_score":"4","adoption":"PASS_DEMOLITION_WRITTEN_SEQUENCE","direct_score_input":false},{"row":78,"status":"PASS_WITH_DEMOLITION_SCAFFOLD_BOUNDARY","source":"HSE structural stability","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"A standard tied scaffold does not restrain a building unless a competent specialist designs it for that purpose.","quality_score":"3","adoption":"PASS_WITH_DEMOLITION_SCAFFOLD_BOUNDARY","direct_score_input":false},{"row":79,"status":"PASS_WITH_DEMOLITION_METHOD_SITE_SPECIFIC","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"The appropriate demolition method depends on the structure, location, nearby people, available space and changing load paths.","quality_score":"3","adoption":"PASS_WITH_DEMOLITION_METHOD_SITE_SPECIFIC","direct_score_input":false},{"row":80,"status":"PASS_WITH_DEMOLITION_NOT_PARCEL_SCORE","source":"HSE demolition","url":"https://www.hse.gov.uk/construction/safetytopics/demolition.htm","verified":"Demolition controls describe project-specific risk management and are not parcel-level safety probabilities.","quality_score":"3","adoption":"PASS_WITH_DEMOLITION_NOT_PARCEL_SCORE","direct_score_input":false}]}