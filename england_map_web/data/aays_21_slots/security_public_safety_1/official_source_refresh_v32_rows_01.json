{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V32","part":1,"rows":[{"row":1,"status":"PASS_COSHH_ADEQUATE_CONTROL","source":"HSE COSHH basics","url":"https://www.hse.gov.uk/coshh/basics/overview.htm","verified":"COSHH requires workplace exposure to materials that cause ill health to be adequately controlled.","quality_score":"4","adoption":"COSHH_ADEQUATE_CONTROL","direct_score_input":false},{"row":2,"status":"PASS_COSHH_CHEMICALS_PRODUCTS","source":"HSE hazardous-substance scope","url":"https://www.hse.gov.uk/coshh/basics/substance.htm","verified":"COSHH covers chemicals and products containing chemicals.","quality_score":"4","adoption":"COSHH_CHEMICAL_SCOPE","direct_score_input":false},{"row":3,"status":"PASS_COSHH_AIRBORNE_FORMS","source":"HSE hazardous-substance scope","url":"https://www.hse.gov.uk/coshh/basics/substance.htm","verified":"COSHH covers fumes, dusts, vapours and mists.","quality_score":"4","adoption":"COSHH_AIRBORNE_SCOPE","direct_score_input":false},{"row":4,"status":"PASS_COSHH_GASES_ASPHYXIANTS","source":"HSE hazardous-substance scope","url":"https://www.hse.gov.uk/coshh/basics/substance.htm","verified":"COSHH covers gases and asphyxiating gases.","quality_score":"4","adoption":"COSHH_GAS_SCOPE","direct_score_input":false},{"row":5,"status":"PASS_COSHH_BIOLOGICAL_AGENTS","source":"HSE hazardous-substance scope","url":"https://www.hse.gov.uk/coshh/basics/substance.htm","verified":"COSHH covers biological agents and disease-causing germs within its scope.","quality_score":"4","adoption":"COSHH_BIOLOGICAL_SCOPE","direct_score_input":false},{"row":6,"status":"PASS_COSHH_SEPARATE_REGIMES","source":"HSE hazardous-substance scope","url":"https://www.hse.gov.uk/coshh/basics/substance.htm","verified":"Lead, asbestos and radioactive substances are outside COSHH because separate regulations apply.","quality_score":"4","adoption":"COSHH_SEPARATE_REGIME_BOUNDARY","direct_score_input":false},{"row":7,"status":"PASS_COSHH_RISK_ASSESSMENT","source":"HSE COSHH cleaning guidance","url":"https://www.hse.gov.uk/cleaning/topics/coshh.htm","verified":"Employers must assess risks arising from the use of hazardous substances.","quality_score":"4","adoption":"COSHH_RISK_ASSESSMENT","direct_score_input":false},{"row":8,"status":"PASS_COSHH_EMERGENCY_ASSESSMENT","source":"HSE COSHH cleaning guidance","url":"https://www.hse.gov.uk/cleaning/topics/coshh.htm","verified":"The assessment must include arrangements for accidents, incidents and emergencies such as serious spillages.","quality_score":"4","adoption":"COSHH_EMERGENCY_PLANNING","direct_score_input":false},{"row":9,"status":"PASS_COSHH_STORAGE_HANDLING_DISPOSAL","source":"HSE COSHH cleaning guidance","url":"https://www.hse.gov.uk/cleaning/topics/coshh.htm","verified":"The assessment includes health and safety risks from storage, handling and disposal.","quality_score":"4","adoption":"COSHH_LIFECYCLE_SCOPE","direct_score_input":false},{"row":10,"status":"PASS_COSHH_PREVENT_OR_CONTROL","source":"HSE COSHH cleaning guidance","url":"https://www.hse.gov.uk/cleaning/topics/coshh.htm","verified":"Employers must prevent exposure or, where prevention is not reasonably practicable, control it.","quality_score":"4","adoption":"COSHH_PREVENT_CONTROL_HIERARCHY","direct_score_input":false},{"row":11,"status":"PASS_COSHH_INFORMATION_TRAINING","source":"HSE COSHH cleaning guidance","url":"https://www.hse.gov.uk/cleaning/topics/coshh.htm","verified":"Staff must receive information, instruction and training on risks and precautions.","quality_score":"4","adoption":"COSHH_WORKER_INFORMATION","direct_score_input":false},{"row":12,"status":"PASS_COSHH_PREVENT_AT_SOURCE","source":"HSE COSHH controls","url":"https://www.hse.gov.uk/coshh/basics/whatdo.htm","verified":"Exposure should first be prevented at source where possible.","quality_score":"4","adoption":"COSHH_SOURCE_PREVENTION","direct_score_input":false},{"row":13,"status":"PASS_COSHH_SUBSTITUTE_SAFER","source":"HSE COSHH controls","url":"https://www.hse.gov.uk/coshh/basics/whatdo.htm","verified":"A hazardous substance or process should be substituted with a safer option where possible.","quality_score":"4","adoption":"COSHH_SUBSTITUTION","direct_score_input":false},{"row":14,"status":"PASS_COSHH_SAFER_FORM","source":"HSE COSHH controls","url":"https://www.hse.gov.uk/coshh/basics/whatdo.htm","verified":"Using a safer physical form, such as a solid instead of a splash-prone liquid or dusty powder, can reduce exposure.","quality_score":"4","adoption":"COSHH_SAFER_FORM","direct_score_input":false},{"row":15,"status":"PASS_COSHH_CONTROLS_WORKING","source":"HSE COSHH controls","url":"https://www.hse.gov.uk/coshh/basics/whatdo.htm","verified":"Adequate control requires control measures to remain in good working order.","quality_score":"4","adoption":"COSHH_CONTROL_MAINTENANCE","direct_score_input":false},{"row":16,"status":"PASS_COSHH_BELOW_WEL","source":"HSE COSHH controls","url":"https://www.hse.gov.uk/coshh/basics/whatdo.htm","verified":"Where a Workplace Exposure Limit exists, exposure must be below that limit.","quality_score":"4","adoption":"COSHH_WEL_GATE","direct_score_input":false},{"row":17,"status":"PASS_COSHH_CMR_ALARP","source":"HSE workplace exposure limits","url":"https://www.hse.gov.uk/coshh/basics/exposurelimits.htm","verified":"Exposure to carcinogens, mutagens and asthmagens must be controlled as low as reasonably practicable.","quality_score":"4","adoption":"COSHH_CMR_ALARP","direct_score_input":false},{"row":18,"status":"PASS_WITH_COSHH_WEL_PARTIAL_COVERAGE","source":"HSE workplace exposure limits","url":"https://www.hse.gov.uk/coshh/basics/exposurelimits.htm","verified":"Only a subset of workplace substances have a WEL, so absence of a listed limit is not evidence of no hazard.","quality_score":"3","adoption":"COSHH_WEL_COVERAGE_GUARD","direct_score_input":false},{"row":19,"status":"PASS_WITH_COSHH_ESSENTIALS_GENERIC","source":"HSE COSHH frequently asked questions","url":"https://www.hse.gov.uk/coshh/faq.htm","verified":"COSHH Essentials gives generic advice and does not replace a suitable and sufficient task-specific assessment.","quality_score":"3","adoption":"COSHH_ESSENTIALS_SCOPE_GUARD","direct_score_input":false},{"row":20,"status":"PASS_WITH_COSHH_NOT_PARCEL_SCORE","source":"HSE COSHH basics","url":"https://www.hse.gov.uk/coshh/basics/overview.htm","verified":"COSHH duties describe workplace exposure controls and are not a universal parcel-level safety probability.","quality_score":"3","adoption":"COSHH_CONTEXT_ONLY","direct_score_input":false}]}