{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V36","part":6,"rows":[{"row":101,"status":"PASS_FAIRGROUND_INFLATABLES_01","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Fairground attractions should be designed, manufactured, inspected and operated through a structured safety system.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_01","direct_score_input":false},{"row":102,"status":"PASS_FAIRGROUND_INFLATABLES_02","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"HSG175 provides guidance for controllers, operators, organisers, designers, manufacturers and inspection bodies.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_02","direct_score_input":false},{"row":103,"status":"PASS_FAIRGROUND_INFLATABLES_03","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Controllers and operators should use competent inspection bodies.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_03","direct_score_input":false},{"row":104,"status":"PASS_FAIRGROUND_INFLATABLES_04","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"HSE recognises ADIPS and PIPA schemes for relevant amusement-device inspections.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_04","direct_score_input":false},{"row":105,"status":"PASS_FAIRGROUND_INFLATABLES_05","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"An initial test should confirm that a new or modified device performs as intended.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_05","direct_score_input":false},{"row":106,"status":"PASS_FAIRGROUND_INFLATABLES_06","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Design review and documentation should be available before operation.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_06","direct_score_input":false},{"row":107,"status":"PASS_FAIRGROUND_INFLATABLES_07","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"An operations manual should describe safe setup, operation, maintenance and emergency procedures.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_07","direct_score_input":false},{"row":108,"status":"PASS_FAIRGROUND_INFLATABLES_08","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Amusement devices require periodic in-service inspection by a competent inspection body.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_08","direct_score_input":false},{"row":109,"status":"PASS_FAIRGROUND_INFLATABLES_09","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"For sealed inflatables, in-service inspection should occur at intervals not exceeding 12 months.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_09","direct_score_input":false},{"row":110,"status":"PASS_FAIRGROUND_INFLATABLES_10","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"A successful annual inspection can produce a Declaration of Operational Compliance or equivalent evidence.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_10","direct_score_input":false},{"row":111,"status":"PASS_FAIRGROUND_INFLATABLES_11","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Operators should complete pre-use and routine checks before admitting users.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_11","direct_score_input":false},{"row":112,"status":"PASS_FAIRGROUND_INFLATABLES_12","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Anchoring, stability and wind limits should follow the design and operating instructions.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_12","direct_score_input":false},{"row":113,"status":"PASS_FAIRGROUND_INFLATABLES_13","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Inflatables can present serious risks from loss of pressure, structural failure or high winds.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_13","direct_score_input":false},{"row":114,"status":"PASS_FAIRGROUND_INFLATABLES_14","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"User numbers, size limits and behaviour controls should be enforced.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_14","direct_score_input":false},{"row":115,"status":"PASS_FAIRGROUND_INFLATABLES_15","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Emergency deflation and evacuation arrangements should be understood by attendants.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_15","direct_score_input":false},{"row":116,"status":"PASS_FAIRGROUND_INFLATABLES_16","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Electrical, gas, working-at-height and manual-handling risks must also be controlled.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_16","direct_score_input":false},{"row":117,"status":"PASS_FAIRGROUND_INFLATABLES_17","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Accidents, defects and significant changes should be reported and assessed before further use.","quality_score":"4","adoption":"FAIRGROUND_INFLATABLES_17","direct_score_input":false},{"row":118,"status":"PASS_WITH_FAIRGROUND_INFLATABLES_18","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Scheme registration or a current declaration does not guarantee safety if setup, weather or operation is incorrect.","quality_score":"3","adoption":"FAIRGROUND_INFLATABLES_GUARD_18","direct_score_input":false},{"row":119,"status":"PASS_WITH_FAIRGROUND_INFLATABLES_19","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Inspection scope and operating limits are device-specific and must match the actual equipment.","quality_score":"3","adoption":"FAIRGROUND_INFLATABLES_GUARD_19","direct_score_input":false},{"row":120,"status":"PASS_WITH_FAIRGROUND_INFLATABLES_20","source":"HSE fairground and inflatable safety","url":"https://www.hse.gov.uk/entertainment/fairgrounds/inflatables/index.htm","verified":"Fairground evidence is attraction-specific and is not converted into parcel-level probability.","quality_score":"3","adoption":"FAIRGROUND_INFLATABLES_GUARD_20","direct_score_input":false}]}