nce","url":"https://www.hse.gov.uk/cdg/manual/adrcarriage.htm","verified":"Many carriers, packers, fillers, loaders and intermediate unloaders must appoint a Dangerous Goods Safety Adviser, subject to exemptions.","quality_score":"4","adoption":"ADR_DGSA_SCOPE","direct_score_input":false},{"row":125,"status":"PASS_ADR_ENFORCEMENT_AUTHORITIES","source":"DfT and HSE dangerous-goods guidance","url":"https://www.gov.uk/guidance/moving-dangerous-goods","verified":"Road enforcement in Great Britain involves HSE, ONR, DfT, police and DVSA according to the material and activity.","quality_score":"4","adoption":"ADR_ENFORCEMENT","direct_score_input":false},{"row":126,"status":"PASS_WITH_ADR_TUNNEL_DYNAMIC","source":"DfT and HSE dangerous-goods guidance","url":"https://www.gov.uk/government/publications/transporting-dangerous-goods-adr-tunnel-categories","verified":"Tunnel categories control permitted dangerous-goods movements and the official list must be checked for current route changes.","quality_score":"3","adoption":"ADR_TUNNEL_DYNAMIC_GUARD","direct_score_input":false},{"row":127,"status":"PASS_WITH_ADR_DEROGATION_SCOPE","source":"DfT and HSE dangerous-goods guidance","url":"https://www.gov.uk/guidance/moving-dangerous-goods","verified":"Domestic exemptions, derogations and international rules differ and must be assessed for the actual journey.","quality_score":"3","adoption":"ADR_DEROGATION_GUARD","direct_score_input":false},{"row":128,"status":"PASS_WITH_ADR_NOT_PARCEL_SCORE","source":"DfT and HSE dangerous-goods guidance","url":"https://www.gov.uk/guidance/moving-dangerous-goods","verified":"Dangerous-goods transport rules describe consignments, vehicles and routes rather than universal parcel-level risk.","quality_score":"3","adoption":"ADR_CONTEXT_ONLY","direct_score_input":false}]}