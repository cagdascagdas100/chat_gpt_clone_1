{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V28","part":6,"rows":[{"row":101,"status":"PASS_HSE_ASBESTOS_DUTYHOLDER","source":"HSE duty to manage asbestos","url":"https://www.hse.gov.uk/asbestos/duty/index.htm","verified":"The asbestos dutyholder can be the owner, landlord or organisation responsible for maintenance or repair.","quality_score":"4","adoption":"ASBESTOS_DUTYHOLDER","direct_score_input":false},{"row":102,"status":"PASS_HSE_ASBESTOS_NON_DOMESTIC_SCOPE","source":"HSE asbestos duty scope","url":"https://www.hse.gov.uk/asbestos/duty/check.htm","verified":"The duty to manage covers non-domestic premises including industrial, commercial and public buildings.","quality_score":"4","adoption":"ASBESTOS_NON_DOMESTIC_SCOPE","direct_score_input":false},{"row":103,"status":"PASS_HSE_ASBESTOS_COMMON_PARTS_SCOPE","source":"HSE asbestos duty scope","url":"https://www.hse.gov.uk/asbestos/duty/check.htm","verified":"The duty also covers common parts of multi-occupancy domestic premises such as purpose-built flats.","quality_score":"4","adoption":"ASBESTOS_COMMON_PARTS_SCOPE","direct_score_input":false},{"row":104,"status":"PASS_HSE_ASBESTOS_PRESENCE_CONDITION","source":"HSE duty to manage asbestos","url":"https://www.hse.gov.uk/asbestos/duty/","verified":"Dutyholders must assess whether asbestos-containing materials are present, their amount, location and condition.","quality_score":"4","adoption":"ASBESTOS_PRESENCE_CONDITION","direct_score_input":false},{"row":105,"status":"PASS_HSE_ASBESTOS_PRESUMPTION","source":"HSE duty to manage asbestos","url":"https://www.hse.gov.uk/asbestos/duty/","verified":"Materials must be presumed to contain asbestos unless there is strong evidence that they do not.","quality_score":"4","adoption":"ASBESTOS_PRESUMPTION_RULE","direct_score_input":false},{"row":106,"status":"PASS_HSE_ASBESTOS_REGISTER","source":"HSE asbestos register","url":"https://www.hse.gov.uk/asbestos/duty/register-and-assess-risk.htm","verified":"A live asbestos register must record known and presumed asbestos-containing materials.","quality_score":"4","adoption":"ASBESTOS_REGISTER","direct_score_input":false},{"row":107,"status":"PASS_HSE_ASBESTOS_REGISTER_FIELDS","source":"HSE asbestos register","url":"https://www.hse.gov.uk/asbestos/duty/register-and-assess-risk.htm","verified":"The register should record material type, amount, condition, inspection dates, fibre-release potential and disturbance likelihood.","quality_score":"4","adoption":"ASBESTOS_REGISTER_SCHEMA","direct_score_input":false},{"row":108,"status":"PASS_HSE_ASBESTOS_ANNUAL_UPDATE","source":"HSE asbestos register","url":"https://www.hse.gov.uk/asbestos/duty/register-and-assess-risk.htm","verified":"The register should be updated at least annually or sooner when risk changes.","quality_score":"4","adoption":"ASBESTOS_REGISTER_REVIEW","direct_score_input":false},{"row":109,"status":"PASS_HSE_ASBESTOS_RISK_ASSESSMENT","source":"HSE asbestos register","url":"https://www.hse.gov.uk/asbestos/duty/register-and-assess-risk.htm","verified":"Risk assessment considers condition, access, nearby work, occupancy and planned maintenance or refurbishment.","quality_score":"4","adoption":"ASBESTOS_RISK_ASSESSMENT","direct_score_input":false},{"row":110,"status":"PASS_HSE_ASBESTOS_MANAGEMENT_PLAN","source":"HSE asbestos management plan","url":"https://www.hse.gov.uk/asbestos/duty/asbestos-management-plan.htm","verified":"The management plan sets procedures and arrangements for managing asbestos risk.","quality_score":"4","adoption":"ASBESTOS_MANAGEMENT_PLAN","direct_score_input":false},{"row":111,"status":"PASS_HSE_ASBESTOS_PLAN_RESPONSIBILITY","source":"HSE asbestos management plan","url":"https://www.hse.gov.uk/asbestos/duty/asbestos-management-plan.htm","verified":"The plan should identify who is responsible for asbestos management and their deputies.","quality_score":"4","adoption":"ASBESTOS_PLAN_RESPONSIBILITY","direct_score_input":false},{"row":112,"status":"PASS_HSE_ASBESTOS_MONITOR_SCHEDULE","source":"HSE asbestos management plan","url":"https://www.hse.gov.uk/asbestos/duty/asbestos-management-plan.htm","verified":"The plan should include a schedule for monitoring the condition of asbestos-containing materials.","quality_score":"4","adoption":"ASBESTOS_MONITORING_SCHEDULE","direct_score_input":false},{"row":113,"status":"PASS_HSE_ASBESTOS_SURVEY_PURPOSE","source":"HSE asbestos survey","url":"https://www.hse.gov.uk/asbestos/duty/arrange-asbestos-survey.htm","verified":"An asbestos survey records location, amount and condition and supports the register and management plan.","quality_score":"4","adoption":"ASBESTOS_SURVEY_PURPOSE","direct_score_input":false},{"row":114,"status":"PASS_HSE_TWO_SURVEY_TYPES","source":"HSE asbestos survey","url":"https://www.hse.gov.uk/asbestos/duty/arrange-asbestos-survey.htm","verified":"HSE distinguishes management surveys from refurbishment or demolition surveys.","quality_score":"4","adoption":"ASBESTOS_SURVEY_TYPES","direct_score_input":false},{"row":115,"status":"PASS_HSE_REFURB_DEMOLITION_SURVEY","source":"HSE asbestos survey","url":"https://www.hse.gov.uk/asbestos/duty/arrange-asbestos-survey.htm","verified":"A refurbishment or demolition survey must locate hidden materials before structural work begins.","quality_score":"4","adoption":"ASBESTOS_INTRUSIVE_SURVEY","direct_score_input":false},{"row":116,"status":"PASS_HSE_COMPETENT_SURVEYOR","source":"HSE asbestos survey","url":"https://www.hse.gov.uk/asbestos/duty/arrange-asbestos-survey.htm","verified":"Refurbishment or demolition surveys must be carried out by a competent surveyor.","quality_score":"4","adoption":"ASBESTOS_SURVEYOR_COMPETENCE","direct_score_input":false},{"row":117,"status":"PASS_HSE_ASBESTOS_INFORMATION_TO_WORKERS","source":"HSE asbestos information sharing","url":"https://www.hse.gov.uk/asbestos/duty/provide-information.htm","verified":"Workers and contractors must be told about the asbestos plan before disturbing the building fabric.","quality_score":"4","adoption":"ASBESTOS_WORKER_INFORMATION","direct_score_input":false},{"row":118,"status":"PASS_WITH_HSE_PRE2000_ASSUMPTION","source":"HSE asbestos presence guidance","url":"https://www.hse.gov.uk/asbestos/duty/is-asbestos-present.htm","verified":"Buildings built or refurbished before 2000 should be assumed to contain asbestos, but the assumption is not material confirmation.","quality_score":"3","adoption":"ASBESTOS_AGE_ASSUMPTION_GUARD","direct_score_input":false},{"row":119,"status":"PASS_WITH_HSE_UNINSPECTED_PRESUMPTION","source":"HSE asbestos survey","url":"https://www.hse.gov.uk/asbestos/duty/arrange-asbestos-survey.htm","verified":"Areas excluded from a survey must be presumed to contain asbestos until inspected, so survey restrictions remain a material limitation.","quality_score":"3","adoption":"ASBESTOS_SURVEY_LIMIT_GUARD","direct_score_input":false},{"row":120,"status":"PASS_WITH_HSE_ASBESTOS_NOT_PARCEL_SCORE","source":"HSE duty to manage asbestos","url":"https://www.hse.gov.uk/asbestos/duty/index.htm","verified":"Asbestos duties and registers are building-specific controls and are not a universal parcel-level exposure probability.","quality_score":"3","adoption":"ASBESTOS_CONTEXT_ONLY","direct_score_input":false}]}