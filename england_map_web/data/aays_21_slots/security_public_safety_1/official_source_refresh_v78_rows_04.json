blind-cords","verified":"OPSS has reported chain-tidy failures that can allow cords to become slack and accessible.","quality_score":"4","adoption":"BLIND_CORD_07","direct_score_input":false},{"row":78,"status":"PASS_BLIND_CORD_08","source":"OPSS blind-cord and window-covering safety","url":"https://www.gov.uk/guidance/child-safety-blind-cords","verified":"Corrective action for an affected blind product included replacing an adhesive fixing with a screwed retaining clip.","quality_score":"4","adoption":"BLIND_CORD_08","direct_score_input":false},{"row":79,"status":"PASS_WITH_BLIND_CORD_09","source":"OPSS blind-cord and window-covering safety","url":"https://www.gov.uk/guidance/child-safety-blind-cords","verified":"Blind-cord risk depends on loop accessibility, fixing strength, cord length, child age, supervision and product condition.","quality_score":"3","adoption":"BLIND_CORD_GUARD_09","direct_score_input":false},{"row":80,"status":"PASS_WITH_BLIND_CORD_10","source":"OPSS blind-cord and window-covering safety","url":"https://www.gov.uk/guidance/child-safety-blind-cords","verified":"OPSS blind-cord evidence is product-, fitting-, child-, use-, control- and time-specific and is not an exact parcel-level strangulation probability.","quality_score":"3","adoption":"BLIND_CORD_GUARD_10","direct_score_input":false}]}