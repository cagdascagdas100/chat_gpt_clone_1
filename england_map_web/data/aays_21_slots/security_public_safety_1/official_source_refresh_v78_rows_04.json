{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V78","part":4,"rows":[{"row":61,"status":"PASS_CHICKENPOX_01","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"UKHSA guidance covers the diagnosis, management and epidemiology of chickenpox.","quality_score":"4","adoption":"CHICKENPOX_01","direct_score_input":false},{"row":62,"status":"PASS_CHICKENPOX_02","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"Post-exposure prophylaxis is offered to people at high risk of severe chickenpox after exposure.","quality_score":"4","adoption":"CHICKENPOX_02","direct_score_input":false},{"row":63,"status":"PASS_CHICKENPOX_03","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"High-risk groups include immunosuppressed people, newborn babies and pregnant women.","quality_score":"4","adoption":"CHICKENPOX_03","direct_score_input":false},{"row":64,"status":"PASS_CHICKENPOX_04","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"Antiviral medication is the post-exposure treatment of choice for immunosuppressed patients and pregnant women.","quality_score":"4","adoption":"CHICKENPOX_04","direct_score_input":false},{"row":65,"status":"PASS_CHICKENPOX_05","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"Varicella-zoster immunoglobulin is reserved for specified neonatal exposures around delivery.","quality_score":"4","adoption":"CHICKENPOX_05","direct_score_input":false},{"row":66,"status":"PASS_CHICKENPOX_06","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"Laboratory confirmation is not normally required but is available through UKHSA laboratories.","quality_score":"4","adoption":"CHICKENPOX_06","direct_score_input":false},{"row":67,"status":"PASS_CHICKENPOX_07","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"Antibiotics do not treat chickenpox because it is a viral infection.","quality_score":"4","adoption":"CHICKENPOX_07","direct_score_input":false},{"row":68,"status":"PASS_CHICKENPOX_08","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"Vaccination is used to prevent chickenpox and England introduced routine MMRV vaccination in 2026.","quality_score":"4","adoption":"CHICKENPOX_08","direct_score_input":false},{"row":69,"status":"PASS_WITH_CHICKENPOX_09","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"Chickenpox risk depends on immunity, vaccination, contact intensity, pregnancy, age, immune status and timing.","quality_score":"3","adoption":"CHICKENPOX_GUARD_09","direct_score_input":false},{"row":70,"status":"PASS_WITH_CHICKENPOX_10","source":"UKHSA chickenpox public-health management","url":"https://www.gov.uk/government/collections/chickenpox-public-health-management-and-guidance","verified":"UKHSA chickenpox evidence is case-, contact-, patient-, vaccination-, treatment- and time-specific and is not an exact parcel-level infection probability.","quality_score":"3","adoption":"CHICKENPOX_GUARD_10","direct_score_input":false},{"row":71,"status":"PASS_BLIND_CORD_01","source":"OPSS blind-cord and window-covering safety",