{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V46","part":2,"rows":[{"row":21,"status":"PASS_DRINKING_WATER_01","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"A boil-water notice means tap water may contain harmful bacteria, viruses or parasites.","quality_score":"4","adoption":"DRINKING_WATER_01","direct_score_input":false},{"row":22,"status":"PASS_DRINKING_WATER_02","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"Water under a boil notice should be brought to a rolling boil and allowed to cool naturally.","quality_score":"4","adoption":"DRINKING_WATER_02","direct_score_input":false},{"row":23,"status":"PASS_DRINKING_WATER_03","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"Boiled water should be used for drinking, brushing teeth, making ice, preparing food, cleaning feeding equipment and pets.","quality_score":"4","adoption":"DRINKING_WATER_03","direct_score_input":false},{"row":24,"status":"PASS_DRINKING_WATER_04","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"Cooled boiled water should be stored in a clean container in a refrigerator and discarded if unused after 24 hours.","quality_score":"4","adoption":"DRINKING_WATER_04","direct_score_input":false},{"row":25,"status":"PASS_DRINKING_WATER_05","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"Water under a boil notice can still be used for showering and bathing if it is not swallowed.","quality_score":"4","adoption":"DRINKING_WATER_05","direct_score_input":false},{"row":26,"status":"PASS_DRINKING_WATER_06","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"A cease-use notice requires bottled water or an alternative supply provided by the water company or provider.","quality_score":"4","adoption":"DRINKING_WATER_06","direct_score_input":false},{"row":27,"status":"PASS_DRINKING_WATER_07","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/consumers/learn-more-about-your-water/discoloured-water/","verified":"Suddenly discoloured tap water should not be assumed safe to drink until advice is obtained from the water company.","quality_score":"4","adoption":"DRINKING_WATER_07","direct_score_input":false},{"row":28,"status":"PASS_DRINKING_WATER_08","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/consumers/learn-more-about-your-water/discoloured-water/","verified":"Consumers should contact their water company immediately when discoloured water affects them and nearby properties.","quality_score":"4","adoption":"DRINKING_WATER_08","direct_score_input":false},{"row":29,"status":"PASS_WITH_DRINKING_WATER_09","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"Drinking-water action depends on the notice, contaminant, affected supply, duration, consumer vulnerability and current water-company instructions.","quality_score":"3","adoption":"DRINKING_WATER_GUARD_09","direct_score_input":false},{"row":30,"status":"PASS_WITH_DRINKING_WATER_10","source":"Drinking Water Inspectorate consumer safety","url":"https://www.dwi.gov.uk/receiving-a-boil-water-notice/","verified":"Drinking-water evidence is supply-, incident- and time-specific and is not an exact parcel-level contamination probability.","quality_score":"3","adoption":"DRINKING_WATER_GUARD_10","direct_score_input":false},{"row":31,"status":"PASS_MOTORWAY_01","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/driving-on-motorways/","verified":"Drivers should know what to do if a breakdown or incident occurs on a motorway.","quality_score":"4","adoption":"MOTORWAY_01","direct_score_input":false},{"row":32,"status":"PASS_MOTORWAY_02","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/driving-on-motorways/","verified":"Where possible, a driver with vehicle trouble should move left towards a place of relative safety.","quality_score":"4","adoption":"MOTORWAY_02","direct_score_input":false},{"row":33,"status":"PASS_MOTORWAY_03","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/the-hard-shoulder/","verified":"The hard shoulder is for emergencies and should not be used as a normal traffic lane when signals are blank.","quality_score":"4","adoption":"MOTORWAY_03","direct_score_input":false},{"row":34,"status":"PASS_MOTORWAY_04","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/driving-on-motorways/","verified":"If it is unsafe to leave the vehicle, occupants should remain inside with seat belts fastened and contact emergency assistance.","quality_score":"4","adoption":"MOTORWAY_04","direct_score_input":false},{"row":35,"status":"PASS_MOTORWAY_05","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/ecall/","verified":"The eCall SOS function is for emergencies and should not be used only for routine breakdown recovery.","quality_score":"4","adoption":"MOTORWAY_05","direct_score_input":false},{"row":36,"status":"PASS_MOTORWAY_06","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/how-to-check-your-vehicle/","verified":"Pre-journey vehicle checks can reduce avoidable breakdowns on busy roads and motorways.","quality_score":"4","adoption":"MOTORWAY_06","direct_score_input":false},{"row":37,"status":"PASS_MOTORWAY_07","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/tailgating/","verified":"Drivers should maintain a safe following distance and can use the two-second rule in normal conditions.","quality_score":"4","adoption":"MOTORWAY_07","direct_score_input":false},{"row":38,"status":"PASS_MOTORWAY_08","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/driving-on-motorways/","verified":"Red X lane-closure signals must be obeyed and the closed lane must not be used.","quality_score":"4","adoption":"MOTORWAY_08","direct_score_input":false},{"row":39,"status":"PASS_WITH_MOTORWAY_09","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/driving-on-motorways/","verified":"Breakdown actions depend on road layout, traffic, vehicle condition, occupants, visibility, signals and whether a safe refuge can be reached.","quality_score":"3","adoption":"MOTORWAY_GUARD_09","direct_score_input":false},{"row":40,"status":"PASS_WITH_MOTORWAY_10","source":"National Highways motorway breakdown safety","url":"https://nationalhighways.co.uk/road-safety/driving-on-motorways/","verified":"Motorway-safety evidence is journey-, incident- and condition-specific and is not an exact parcel-level collision probability.","quality_score":"3","adoption":"MOTORWAY_GUARD_10","direct_score_input":false}]}