{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V45","part":3,"rows":[{"row":41,"status":"PASS_EXPLOSIVES_01","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/licensing/storage/index.htm","verified":"Most manufacture or storage of explosives requires an appropriate licence unless a specific exemption applies.","quality_score":"4","adoption":"EXPLOSIVES_01","direct_score_input":false},{"row":42,"status":"PASS_EXPLOSIVES_02","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/licensing/safety-requirements.htm","verified":"Permitted quantity, location and storage duration depend on the explosive type and quantity.","quality_score":"4","adoption":"EXPLOSIVES_02","direct_score_input":false},{"row":43,"status":"PASS_EXPLOSIVES_03","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/fireworks/industry.htm","verified":"Required separation distances can continue to apply even where a limited storage exemption applies.","quality_score":"4","adoption":"EXPLOSIVES_03","direct_score_input":false},{"row":44,"status":"PASS_EXPLOSIVES_04","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/fireworks/industry.htm","verified":"Anyone manufacturing or storing explosives must take appropriate measures to prevent fire or explosion.","quality_score":"4","adoption":"EXPLOSIVES_04","direct_score_input":false},{"row":45,"status":"PASS_EXPLOSIVES_05","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/fireworks/industry.htm","verified":"Controls must limit the extent and spread of fire or explosion between locations.","quality_score":"4","adoption":"EXPLOSIVES_05","direct_score_input":false},{"row":46,"status":"PASS_EXPLOSIVES_06","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/fireworks/industry.htm","verified":"Explosives controls must protect people from the effects of fire or explosion.","quality_score":"4","adoption":"EXPLOSIVES_06","direct_score_input":false},{"row":47,"status":"PASS_EXPLOSIVES_07","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/fireworks/industry.htm","verified":"Robust security controls should be in place before explosives operations start and remain effective throughout the operation.","quality_score":"4","adoption":"EXPLOSIVES_07","direct_score_input":false},{"row":48,"status":"PASS_EXPLOSIVES_08","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/fireworks/industry.htm","verified":"Occupiers of licensed sites must take due precautions to prevent unauthorised access.","quality_score":"4","adoption":"EXPLOSIVES_08","direct_score_input":false},{"row":49,"status":"PASS_WITH_EXPLOSIVES_09","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/licensing/storage/index.htm","verified":"Explosives controls depend on hazard type, net mass, duration, storage construction, separation distance, licence and site security.","quality_score":"3","adoption":"EXPLOSIVES_GUARD_09","direct_score_input":false},{"row":50,"status":"PASS_WITH_EXPLOSIVES_10","source":"HSE explosives and fireworks storage","url":"https://www.hse.gov.uk/explosives/licensing/storage/index.htm","verified":"Explosives evidence is material-, quantity-, licence- and site-specific and is not an exact parcel-level explosion probability.","quality_score":"3","adoption":"EXPLOSIVES_GUARD_10","direct_score_input":false},{"row":51,"status":"PASS_FSA_ALLERGENS_01","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Retail and catering food businesses must provide allergen information for prepacked and non-prepacked food and drink.","quality_score":"4","adoption":"FSA_ALLERGENS_01","direct_score_input":false},{"row":52,"status":"PASS_FSA_ALLERGENS_02","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Food businesses must handle and manage food allergens effectively during preparation.","quality_score":"4","adoption":"FSA_ALLERGENS_02","direct_score_input":false},{"row":53,"status":"PASS_FSA_ALLERGENS_03","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Food-business staff should receive allergen training.","quality_score":"4","adoption":"FSA_ALLERGENS_03","direct_score_input":false},{"row":54,"status":"PASS_FSA_ALLERGENS_04","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Food law requires declaration of 14 regulated allergens when they are used as ingredients.","quality_score":"4","adoption":"FSA_ALLERGENS_04","direct_score_input":false},{"row":55,"status":"PASS_FSA_ALLERGENS_05","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Buffets should provide allergen information for each food item rather than for the buffet as a whole.","quality_score":"4","adoption":"FSA_ALLERGENS_05","direct_score_input":false},{"row":56,"status":"PASS_FSA_ALLERGENS_06","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Distance sales must provide allergen information before purchase and again when food is delivered.","quality_score":"4","adoption":"FSA_ALLERGENS_06","direct_score_input":false},{"row":57,"status":"PASS_FSA_ALLERGENS_07","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Businesses should record allergen ingredients in product specifications, labels and recipes and keep the information up to date.","quality_score":"4","adoption":"FSA_ALLERGENS_07","direct_score_input":false},{"row":58,"status":"PASS_FSA_ALLERGENS_08","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Cross-contamination controls include suitable cleaning, handwashing and separate labelled storage.","quality_score":"4","adoption":"FSA_ALLERGENS_08","direct_score_input":false},{"row":59,"status":"PASS_WITH_FSA_ALLERGENS_09","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Allergen controls depend on ingredients, recipes, suppliers, preparation flow, cross-contact risk, service model and current labelling.","quality_score":"3","adoption":"FSA_ALLERGENS_GUARD_09","direct_score_input":false},{"row":60,"status":"PASS_WITH_FSA_ALLERGENS_10","source":"Food Standards Agency allergen management","url":"https://www.food.gov.uk/business-guidance/allergen-guidance-for-food-businesses","verified":"Allergen evidence is product-, process- and consumer-specific and is not an exact parcel-level allergic-reaction probability.","quality_score":"3","adoption":"FSA_ALLERGENS_GUARD_10","direct_score_input":false}]}