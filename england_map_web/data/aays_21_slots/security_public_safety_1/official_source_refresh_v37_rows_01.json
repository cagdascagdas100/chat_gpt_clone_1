{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V37","part":1,"rows":[{"row":1,"status":"PASS_ELECTRICAL_SAFETY_01","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Electricity can kill or severely injure people and can damage property.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_01","direct_score_input":false},{"row":2,"status":"PASS_ELECTRICAL_SAFETY_02","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Main electrical hazards include shock and burns from contact with live parts.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_02","direct_score_input":false},{"row":3,"status":"PASS_ELECTRICAL_SAFETY_03","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Electrical arcing can cause injury when electricity jumps between circuits.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_03","direct_score_input":false},{"row":4,"status":"PASS_ELECTRICAL_SAFETY_04","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Faulty electrical equipment or installations can cause fire.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_04","direct_score_input":false},{"row":5,"status":"PASS_ELECTRICAL_SAFETY_05","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Unsuitable electrical apparatus can cause explosions.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_05","direct_score_input":false},{"row":6,"status":"PASS_ELECTRICAL_SAFETY_06","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Static electricity can ignite flammable vapours or dusts.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_06","direct_score_input":false},{"row":7,"status":"PASS_ELECTRICAL_SAFETY_07","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Electrical equipment must be maintained to prevent danger.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_07","direct_score_input":false},{"row":8,"status":"PASS_ELECTRICAL_SAFETY_08","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"The type and frequency of checks, inspections and testing should reflect equipment, environment and previous results.","quality_score":"4","adoption":"ELECTRICAL_SAFETY_08","direct_score_input":false},{"row":9,"status":"PASS_WITH_ELECTRICAL_SAFETY_09","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"A fixed testing interval is not suitable for every item or workplace; the risk assessment and evidence history matter.","quality_score":"3","adoption":"ELECTRICAL_SAFETY_GUARD_09","direct_score_input":false},{"row":10,"status":"PASS_WITH_ELECTRICAL_SAFETY_10","source":"HSE electrical safety","url":"https://www.hse.gov.uk/electricity/introduction.htm","verified":"Electrical guidance is operational safety context and is not an exact parcel-level probability.","quality_score":"3","adoption":"ELECTRICAL_SAFETY_GUARD_10","direct_score_input":false},{"row":11,"status":"PASS_WORK_AT_HEIGHT_01","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"Work at height includes any place where a person could fall a distance liable to cause personal injury.","quality_score":"4","adoption":"WORK_AT_HEIGHT_01","direct_score_input":false},{"row":12,"status":"PASS_WORK_AT_HEIGHT_02","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"Work at height must be properly planned.","quality_score":"4","adoption":"WORK_AT_HEIGHT_02","direct_score_input":false},{"row":13,"status":"PASS_WORK_AT_HEIGHT_03","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"Work at height must be appropriately supervised.","quality_score":"4","adoption":"WORK_AT_HEIGHT_03","direct_score_input":false},{"row":14,"status":"PASS_WORK_AT_HEIGHT_04","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"Work at height must be carried out by competent people.","quality_score":"4","adoption":"WORK_AT_HEIGHT_04","direct_score_input":false},{"row":15,"status":"PASS_WORK_AT_HEIGHT_05","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"The correct type of equipment must be used for the task.","quality_score":"4","adoption":"WORK_AT_HEIGHT_05","direct_score_input":false},{"row":16,"status":"PASS_WORK_AT_HEIGHT_06","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"The control hierarchy starts by avoiding work at height where reasonably practicable.","quality_score":"4","adoption":"WORK_AT_HEIGHT_06","direct_score_input":false},{"row":17,"status":"PASS_WORK_AT_HEIGHT_07","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"Where work at height cannot be avoided, measures should prevent falls.","quality_score":"4","adoption":"WORK_AT_HEIGHT_07","direct_score_input":false},{"row":18,"status":"PASS_WORK_AT_HEIGHT_08","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"Where falls cannot be prevented, measures should minimise fall distance and consequences.","quality_score":"4","adoption":"WORK_AT_HEIGHT_08","direct_score_input":false},{"row":19,"status":"PASS_WITH_WORK_AT_HEIGHT_09","source":"HSE work at height","url":"https://www.hse.gov.uk/work-at-height/introduction.htm","verified":"The proportionate control depends on the task, duration, surface, access method and foreseeable rescue needs.","quality_score":"3","adoption":"WORK_AT_HEIGHT_GUARD_09","direct_score_input":false},{"row":20,"status":"PA