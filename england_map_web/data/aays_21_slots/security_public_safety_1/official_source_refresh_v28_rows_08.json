rified":"Maritime Safety Information is available by NAVTEX out to approximately 270 miles.","quality_score":"4","adoption":"MSI_NAVTEX_RANGE","direct_score_input":false},{"row":146,"status":"PASS_MCA_VHF_RANGE","source":"MCA maritime safety guide","url":"https://www.gov.uk/maritime-safety-weather-and-navigation","verified":"Maritime Safety Information is broadcast by VHF out to approximately 30 miles.","quality_score":"4","adoption":"MSI_VHF_RANGE","direct_score_input":false},{"row":147,"status":"PASS_MCA_MF_RANGE","source":"MCA maritime safety guide","url":"https://www.gov.uk/maritime-safety-weather-and-navigation","verified":"Maritime Safety Information is broadcast by MF out to approximately 150 miles.","quality_score":"4","adoption":"MSI_MF_RANGE","direct_score_input":false},{"row":148,"status":"PASS_MCA_MSI_CONTENT","source":"MCA maritime safety guide","url":"https://www.gov.uk/maritime-safety-weather-and-navigation","verified":"MSI includes wind, visibility, sea-condition and navigational warning information.","quality_score":"4","adoption":"MSI_CONTENT_SCHEMA","direct_score_input":false},{"row":149,"status":"PASS_MCA_MARINER_CHECK_DUTY","source":"MCA maritime safety guide","url":"https://www.gov.uk/maritime-safety-weather-and-navigation","verified":"Mariners must check MSI, weather and tide information and understand warnings relevant to their voyage.","quality_score":"4","adoption":"MARINER_MSI_CHECK","direct_score_input":false},{"row":150,"status":"PASS_MCA_COASTAL_WARNINGS_INTERVAL","source":"MCA navigational warnings","url":"https://www.gov.uk/government/publications/navigational-warnings-reporting-and-broadcasting-hazards-at-sea/navigational-warnings","verified":"UK coastal warnings are broadcast at routine four-hourly transmission times and immediately for vital information.","quality_score":"4","adoption":"COASTAL_WARNING_BROADCAST","direct_score_input":false},{"row":151,"status":"PASS_MCA_WARNING_VALID_UNTIL_CANCEL","source":"MCA navigational warnings","url":"https://www.gov.uk/government/publications/navigational-warnings-reporting-and-broadcasting-hazards-at-sea/navigational-warnings","verified":"Navigational warnings remain in force until cancelled while the information remains valid.","quality_score":"4","adoption":"NAV_WARNING_LIFECYCLE","direct_score_input":false},{"row":152,"status":"PASS_MCA_HAZARD_AIDS_TO_NAVIGATION","source":"MCA navigational guidance","url":"https://www.gov.uk/maritime-safety-weather-and-navigation/navigational-guidance-and-warnings","verified":"Reportable hazards include damaged lights, fog signals, buoys and other navigation aids affecting shipping lanes.","quality_score":"4","adoption":"NAV_AID_HAZARD_SCOPE","direct_score_input":false},{"row":153,"status":"PASS_MCA_HAZARD_WRECKS_SHOALS","source":"MCA navigational guidance","url":"https://www.gov.uk/maritime-safety-weather-and-navigation/navigational-guidance-and-warnings","verified":"Warnings may cover wrecks, reefs, rocks and shoals that endanger main shipping lanes.","quality_score":"4","adoption":"WRECK_SHOAL_HAZARD_SCOPE","direct_score_input":false},{"row":154,"status":"PASS_MCA_HAZARD_DRIFTING_OBJECTS","source":"MCA navigational guidance","url":"https://www.gov.uk/maritime-safety-weather-and-navigation/navigational-guidance-and-warnings","verified":"Warnings may cover drifting hazards such as derelict vessels, mines or ice.","quality_score":"4","adoption":"DRIFTING_HAZARD_SCOPE","direct_score_input":false},{"row":155,"status":"PASS_MCA_HAZARD_ROUTE_CHANGES","source":"MCA navigational guidance","url":"https://www.gov.uk/maritime-safety-weather-and-navigation/navigational-guidance-and-warnings","verified":"Unexpected route changes or closures can require navigational warnings.","quality_score":"4","adoption":"ROUTE_CHANGE_WARNING_SCOPE","direct_score_input":false},{"row":156,"status":"PASS_MCA_HAZARD_OPERATIONS","source":"MCA navigational guidance","url":"https://www.gov.uk/maritime-safety-weather-and-navigation/navigational-guidance-and-warnings","verified":"Cable laying, naval exercises and underwater operations can trigger warnings when they endanger shipping.","quality_score":"4","adoption":"MARINE_OPERATION_WARNING_SCOPE","direct_score_input":false},{"row":157,"status":"PASS_MCA_COASTGUARD_EMERGENCY_ROUTE","source":"HM Coastguard contact guidance","url":"https://www.gov.uk/guidance/hm-coastguard-rescue-coordination-centre-contact-details","verified":"For an emergency on the coast call 999 and ask for the Coastguard; at sea use a Mayday distress alert on Channel 16 or call 999.","quality_score":"4","adoption":"COASTGUARD_EMERGENCY_ROUTE","direct_score_input":false},{"row":158,"status":"PASS_WITH_MCA_WARNING_DYNAMIC","source":"MCA navigational warnings","url":"https://www.gov.uk/maritime-safety-weather-and-navigation/navigational-guidance-and-warnings","verified":"In-force warnings and temporary hazards are dynamic and require current voyage-time checking.","quality_score":"3","adoption":"DYNAMIC_NAV_WARNING_GUARD","direct_score_input":false},{"row":159,"status":"PASS_WITH_MCA_BROADCAST_INTERRUPTION","source":"MCA maritime safety guide","url":"https://www.gov.uk/maritime-safety-weather-and-navigation","verified":"MSI broadcasts may be interrupted or delayed by search-and-rescue operations, so multiple approved information routes may be needed.","quality_score":"3","adoption":"MSI_INTERRUPTION_GUARD","direct_score_input":false},{"row":160,"status":"PASS_WITH_MCA_NOT_PARCEL_SCORE","source":"MCA navigation safety","url":"https://www.gov.uk/guidance/navigation-safety-for-uk-seafarers","verified":"Maritime warnings and navigation controls are voyage- and hazard-specific and are not universal parcel-level safety probabilities.","quality_score":"3","adoption":"MARITIME_CONTEXT_ONLY","direct_score_input":false}]}