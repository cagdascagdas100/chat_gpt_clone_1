ion":"PREPARE_05","direct_score_input":false},{"row":86,"status":"PASS_PREPARE_06","source":"UK Government Prepare campaign","url":"https://prepare.campaign.gov.uk/get-prepared-for-emergencies/alerts/","verified":"Emergency contacts and relevant medical information can be stored on a phone with suitable privacy consideration.","quality_score":"4","adoption":"PREPARE_06","direct_score_input":false},{"row":87,"status":"PASS_PREPARE_07","source":"UK Government Prepare campaign","url":"https://prepare.campaign.gov.uk/get-prepared-for-emergencies/","verified":"Households should know how to turn off gas, electricity and water when instructed or when it is safe and necessary.","quality_score":"4","adoption":"PREPARE_07","direct_score_input":false},{"row":88,"status":"PASS_PREPARE_08","source":"UK Government Prepare campaign","url":"https://prepare.campaign.gov.uk/get-prepared-for-emergencies/alerts/","verified":"Smoke alarms should be checked regularly, with the campaign suggesting at least monthly checks.","quality_score":"4","adoption":"PREPARE_08","direct_score_input":false},{"row":89,"status":"PASS_WITH_PREPARE_09","source":"UK Government Prepare campaign","url":"https://prepare.campaign.gov.uk/get-prepared-for-emergencies/","verified":"Households should consider essential supplies for disruption lasting several days or an evacuation.","quality_score":"3","adoption":"PREPARE_GUARD_09","direct_score_input":false},{"row":90,"status":"PASS_WITH_PREPARE_10","source":"UK Government Prepare campaign","url":"https://prepare.campaign.gov.uk/get-prepared-for-emergencies/alerts/","verified":"Preparedness measures must be adapted to household needs, disability, caring responsibilities, local hazards and official incident instructions.","quality_score":"3","adoption":"PREPARE_GUARD_10","direct_score_input":false},{"row":91,"status":"PASS_STRUCTURAL_STABILITY_01","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Alteration, demolition and dismantling work must be planned and carried out by competent people to avoid unplanned structural collapse.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_01","direct_score_input":false},{"row":92,"status":"PASS_STRUCTURAL_STABILITY_02","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/admin.htm","verified":"Commercial clients must provide relevant information about the building's structure and stability to contractors.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_02","direct_score_input":false},{"row":93,"status":"PASS_STRUCTURAL_STABILITY_03","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Structural information should include structural form, significant design assumptions and relevant work methods or sequences.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_03","direct_score_input":false},{"row":94,"status":"PASS_STRUCTURAL_STABILITY_04","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/admin.htm","verified":"Contractors must use the supplied structural information when planning and carrying out the work.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_04","direct_score_input":false},{"row":95,"status":"PASS_STRUCTURAL_STABILITY_05","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Workers and passers-by must be protected from structural collapse and debris.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_05","direct_score_input":false},{"row":96,"status":"PASS_STRUCTURAL_STABILITY_06","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/admin.htm","verified":"The stability implications of alteration, demolition and dismantling should be assessed before work begins.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_06","direct_score_input":false},{"row":97,"status":"PASS_STRUCTURAL_STABILITY_07","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"Demolition, dismantling or structural-alteration arrangements must be recorded in writing before work starts.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_07","direct_score_input":false},{"row":98,"status":"PASS_STRUCTURAL_STABILITY_08","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/admin.htm","verified":"Inspection reports, method statements and other records support the practical controls required on site.","quality_score":"4","adoption":"STRUCTURAL_STABILITY_08","direct_score_input":false},{"row":99,"status":"PASS_WITH_STRUCTURAL_STABILITY_09","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/buildings.htm","verified":"The safe method depends on the actual structure, condition, loading, sequence and temporary works and may require structural-engineering advice.","quality_score":"3","adoption":"STRUCTURAL_STABILITY_GUARD_09","direct_score_input":false},{"row":100,"status":"PASS_WITH_STRUCTURAL_STABILITY_10","source":"HSE structural stability and demolition","url":"https://www.hse.gov.uk/construction/safetytopics/admin.htm","verified":"Structural-stability evidence is project- and building-specific and is not an exact parcel-level probability.","quality_score":"3","adoption":"STRUCTURAL_STABILITY_GUARD_10","direct_score_input":false}]}