{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V31","part":7,"rows":[{"row":121,"status":"PASS_HSE_VIOLENCE_DEFINITION","source":"HSE work-related violence guidance","url":"https://www.hse.gov.uk/violence/employer/index.htm","verified":"HSE defines work-related violence as abuse, threats or assault in circumstances relating to work.","quality_score":"4","adoption":"WORK_VIOLENCE_DEFINITION","direct_score_input":false},{"row":122,"status":"PASS_HSE_VERBAL_ONLINE_PHYSICAL_SCOPE","source":"HSE work-related violence guidance","url":"https://www.hse.gov.uk/violence/employer/index.htm","verified":"The definition includes verbal abuse, telephone or online threats and physical attacks.","quality_score":"4","adoption":"VIOLENCE_FORM_SCOPE","direct_score_input":false},{"row":123,"status":"PASS_HSE_WORK_CONNECTION_BOUNDARY","source":"HSE work-related violence guidance","url":"https://www.hse.gov.uk/violence/employer/index.htm","verified":"The incident must be connected with work activity to fall within the work-related violence definition.","quality_score":"4","adoption":"WORK_CONNECTION_BOUNDARY","direct_score_input":false},{"row":124,"status":"PASS_HSE_HEALTH_IMPACTS","source":"HSE work-related violence guidance","url":"https://www.hse.gov.uk/violence/employer/index.htm","verified":"Work-related violence can cause injury, stress, mental ill-health, disability or death.","quality_score":"4","adoption":"VIOLENCE_HEALTH_IMPACT","direct_score_input":false},{"row":125,"status":"PASS_HSE_EMPLOYER_PROTECTION_DUTY","source":"HSE violence law guidance","url":"https://www.hse.gov.uk/violence/employer/the-law.htm","verified":"Employers must protect workers from work-related violence so far as reasonably practicable.","quality_score":"4","adoption":"VIOLENCE_EMPLOYER_DUTY","direct_score_input":false},{"row":126,"status":"PASS_HSE_HEALTH_SAFETY_POLICY","source":"HSE violence law guidance","url":"https://www.hse.gov.uk/violence/employer/the-law.htm","verified":"Businesses must have arrangements or a policy for managing health and safety, including violence risk.","quality_score":"4","adoption":"VIOLENCE_POLICY_CONTROL","direct_score_input":false},{"row":127,"status":"PASS_HSE_RISK_ASSESSMENT_DUTY","source":"HSE violence risk guidance","url":"https://www.hse.gov.uk/violence/employer/assessing-the-risks.htm","verified":"Employers must assess significant violence risks and implement effective controls.","quality_score":"4","adoption":"VIOLENCE_RISK_ASSESSMENT","direct_score_input":false},{"row":128,"status":"PASS_HSE_WORKER_CONSULTATION","source":"HSE violence risk guidance","url":"https://www.hse.gov.uk/violence/employer/assessing-the-risks.htm","verified":"Workers and their representatives must be consulted on health and safety risks and controls.","quality_score":"4","adoption":"VIOLENCE_WORKER_CONSULTATION","direct_score_input":false},{"row":129,"status":"PASS_HSE_HAZARD_IDENTIFICATION_INPUTS","source":"HSE violence risk guidance","url":"https://www.hse.gov.uk/violence/employer/assessing-the-risks.htm","verified":"Hazards can be identified through worker experience, workplace observation and incident records.","quality_score":"4","adoption":"VIOLENCE_HAZARD_INPUTS","direct_score_input":false},{"row":130,"status":"PASS_HSE_ADDITIONAL_RISK_GROUPS","source":"HSE violence risk guidance","url":"https://www.hse.gov.uk/violence/employer/assessing-the-risks.htm","verified":"Lone workers, new starters, trainees and other vulnerable workers may face additional risk.","quality_score":"4","adoption":"VIOLENCE_VULNERABLE_WORKER_SCOPE","direct_score_input":false},{"row":131,"status":"PASS_HSE_RECORD_AND_REVIEW","source":"HSE violence risk guidance","url":"https://www.hse.gov.uk/violence/employer/assessing-the-risks.htm","verified":"Risk findings must be recorded and reviewed periodically after controls are selected.","quality_score":"4","adoption":"VIOLENCE_RISK_REVIEW","direct_score_input":false},{"row":132,"status":"PASS_HSE_LAYERED_CONTROLS","source":"HSE violence controls","url":"https://www.hse.gov.uk/violence/employer/controls-to-prevent.htm","verified":"HSE advises using multiple control measures because a single control may not be fully effective.","quality_score":"4","adoption":"VIOLENCE_LAYERED_CONTROLS","direct_score_input":false},{"row":133,"status":"PASS_HSE_WORKPLACE_DESIGN_CONTROLS","source":"HSE violence controls","url":"https://www.hse.gov.uk/violence/employer/controls-to-prevent.htm","verified":"Controls can include layout, visibility, lighting, queue management, CCTV, alarms and building security.","quality_score":"4","adoption":"VIOLENCE_WORKPLACE_CONTROLS","direct_score_input":false},{"row":134,"status":"PASS_HSE_STAFFING_COMMUNICATION_CONTROLS","source":"HSE violence controls","url":"https://www.hse.gov.uk/violence/employer/controls-to-prevent.htm","verified":"Controls can include communication, adequate staffing and arrangements to keep in touch with workers away from base.","quality_score":"4","adoption":"VIOLENCE_OPERATIONAL_CONTROLS","direct_score_input":false},{"row":135,"status":"PASS_HSE_TRAINING_SCOPE","source":"HSE violence controls","url":"https://www.hse.gov.uk/violence/employer/controls-to-prevent.htm","verified":"Training should match the specific activities and include all exposed workers, including temporary and agency staff.","quality_score":"4","adoption":"VIOLENCE_TRAINING_SCOPE","direct_score_input":false},{"row":136,"status":"PASS_HSE_DEESCALATION_METHODS","source":"HSE violence controls","url":"https://www.hse.gov.uk/violence/employer/controls-to-prevent.htm","verified":"HSE lists calm communication, personal space, empathy and avoiding argument among de-escalation techniques.","quality_score":"4","adoption":"VIOLENCE_DEESCALATION_METHOD","direct_score_input":false},{"row":137,"status":"PASS_HSE_POST_INCIDENT_ACTIONS","source":"HSE violence reporting guidance","url":"https://www.hse.gov.uk/violence/employer/reporting-learning-from-incidents.htm","verified":"After violence, employers should support workers, record and report incidents, and review whether controls need changing.","quality_score":"4","adoption":"VIOLENCE_POST_INCIDENT_CONTROL","direct_score_input":false},{"row":138,"status":"PASS_HSE_RIDDOR_VIOLENCE_THRESHOLD","source":"HSE violence reporting guidance","url":"https://www.hse.gov.uk/violence/employer/reporting-learning-from-incidents.htm","verified":"Violence causing death, specified injury or more than seven days' incapacity can be RIDDOR-reportable when connected with work.","quality_score":"4","adoption":"VIOLENCE_RIDDOR_THRESHOLD","direct_score_input":false},{"row":139,"status":"PASS_WITH_HSE_PERSONAL_DISPUTE_BOUNDARY","source":"HSE violence reporting guidance","url":"https://www.hse.gov.uk/violence/employer/reporting-learning-from-incidents.htm","verified":"A personal dispute unrelated to work is outside the stated work-connected RIDDOR example.","quality_score":"3","adoption":"VIOLENCE_PERSONAL_DISPUTE_GUARD","direct_score_input":false},{"row":140,"status":"PASS_WITH_HSE_VIOLENCE_NOT_PARCEL_SCORE","source":"HSE work-related violence guidance","url":"https://www.hse.gov.uk/violence/employer/index.htm","verified":"Workplace violence controls describe organisational risk and are not a parcel-level public-safety probability.","quality_score":"3","adoption":"VIOLENCE_CONTEXT_ONLY","direct_score_input":false}]}