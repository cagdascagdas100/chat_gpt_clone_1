{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V34","part":1,"rows":[{"row":1,"status":"PASS_HSE_FIRST_AID_IMMEDIATE_HELP","source":"HSE first aid at work","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/","verified":"Employers must make sure employees receive immediate help if they are injured or become ill at work.","quality_score":"4","adoption":"FIRST_AID_IMMEDIATE_HELP","direct_score_input":false},{"row":2,"status":"PASS_HSE_FIRST_AID_NEEDS_ASSESSMENT","source":"HSE first aid at work","url":"https://www.hse.gov.uk/firstaid/legislation.htm","verified":"Employers should assess first-aid needs to determine suitable provision.","quality_score":"4","adoption":"FIRST_AID_NEEDS_ASSESSMENT","direct_score_input":false},{"row":3,"status":"PASS_HSE_APPOINTED_PERSON_MINIMUM","source":"HSE first aid FAQs","url":"https://www.hse.gov.uk/firstaid/faqs.htm","verified":"Where the assessment shows a trained first-aider is unnecessary, the minimum requirement is an appointed person for first-aid arrangements.","quality_score":"4","adoption":"FIRST_AID_APPOINTED_PERSON","direct_score_input":false},{"row":4,"status":"PASS_HSE_FIRST_AID_BOX","source":"HSE employee first-aid guidance","url":"https://www.hse.gov.uk/firstaid/employee.htm","verified":"Workplaces must provide adequate facilities and a suitably stocked first-aid box.","quality_score":"4","adoption":"FIRST_AID_BOX_FACILITIES","direct_score_input":false},{"row":5,"status":"PASS_HSE_EMPLOYEE_INFORMATION","source":"HSE employee first-aid guidance","url":"https://www.hse.gov.uk/firstaid/employee.htm","verified":"Employees must be told about the workplace first-aid arrangements.","quality_score":"4","adoption":"FIRST_AID_EMPLOYEE_INFORMATION","direct_score_input":false},{"row":6,"status":"PASS_HSE_FIRST_AIDER_COUNT_ASSESSMENT","source":"HSE first-aider guidance","url":"https://www.hse.gov.uk/firstaid/first-aider.htm","verified":"The needs assessment determines how many suitably trained first-aiders are required.","quality_score":"4","adoption":"FIRST_AIDER_COUNT_ASSESSMENT","direct_score_input":false},{"row":7,"status":"PASS_HSE_TRAINING_PROVIDER_COMPETENCE","source":"HSE employer first-aid guidance","url":"https://www.hse.gov.uk/firstaid/what-employers-need-to-do.htm","verified":"The employer must ensure the selected first-aid training provider is competent.","quality_score":"4","adoption":"FIRST_AID_TRAINER_COMPETENCE","direct_score_input":false},{"row":8,"status":"PASS_HSE_EFAW_ROUTE","source":"HSE first-aid training","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/first-aid-training.htm","verified":"Emergency first aid at work is a recognised training level for emergency first aid to an injured or ill worker.","quality_score":"4","adoption":"EFAW_TRAINING_ROUTE","direct_score_input":false},{"row":9,"status":"PASS_HSE_FAW_ROUTE","source":"HSE first-aid training","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/first-aid-training.htm","verified":"First aid at work is a recognised training level selected according to the needs assessment.","quality_score":"4","adoption":"FAW_TRAINING_ROUTE","direct_score_input":false},{"row":10,"status":"PASS_HSE_MENTAL_HEALTH_NEEDS","source":"HSE first aid regulations guidance","url":"https://www.hse.gov.uk/pubns/books/l74.htm","verified":"Employers should take employee mental health into account in the first-aid needs assessment.","quality_score":"4","adoption":"FIRST_AID_MENTAL_HEALTH_SCOPE","direct_score_input":false},{"row":11,"status":"PASS_HSE_APPOINTED_PERSON_EQUIPMENT","source":"HSE first aid FAQs","url":"https://www.hse.gov.uk/firstaid/faqs.htm","verified":"The appointed person looks after first-aid equipment and facilities.","quality_score":"4","adoption":"APPOINTED_PERSON_EQUIPMENT","direct_score_input":false},{"row":12,"status":"PASS_HSE_APPOINTED_PERSON_EMERGENCY_CALL","source":"HSE first aid FAQs","url":"https://www.hse.gov.uk/firstaid/faqs.htm","verified":"The appointed person calls the emergency services when required.","quality_score":"4","adoption":"APPOINTED_PERSON_EMERGENCY_CALL","direct_score_input":false},{"row":13,"status":"PASS_HSE_APPOINTED_PERSON_AVAILABILITY","source":"HSE appointed-person guidance","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/first-aid-appoint-someone.htm","verified":"An appointed person must be available whenever people are at work.","quality_score":"4","adoption":"APPOINTED_PERSON_AVAILABILITY","direct_score_input":false},{"row":14,"status":"PASS_HSE_APPOINTED_PERSON_NO_TRAINING_DUTY","source":"HSE first aid FAQs","url":"https://www.hse.gov.uk/firstaid/faqs.htm","verified":"An appointed person does not need first-aid training solely to fulfil the appointed-person role.","quality_score":"4","adoption":"APPOINTED_PERSON_TRAINING_BOUNDARY","direct_score_input":false},{"row":15,"status":"PASS_HSE_UNFORESEEN_ABSENCE_COVER","source":"HSE first aid FAQs","url":"https://www.hse.gov.uk/firstaid/faqs.htm","verified":"An appointed person may provide emergency cover within competence for an unforeseen first-aider absence; planned annual leave is not treated as unforeseen.","quality_score":"4","adoption":"FIRST_AID_ABSENCE_COVER","direct_score_input":false},{"row":16,"status":"PASS_HSE_NON_EMPLOYEE_LEGAL_BOUNDARY","source":"HSE first aid legislation","url":"https://www.hse.gov.uk/firstaid/legislation.htm","verified":"The First-Aid Regulations do not place the same legal duty on employers to provide first aid for non-employees such as the public.","quality_score":"4","adoption":"FIRST_AID_NON_EMPLOYEE_BOUNDARY","direct_score_input":false},{"row":17,"status":"PASS_HSE_MOBILE_WORKER_KIT","source":"HSE first aid legislation","url":"https://www.hse.gov.uk/firstaid/legislation.htm","verified":"A needs assessment may identify a personal first-aid kit for workers who drive long distances or are continuously on the road.","quality_score":"4","adoption":"MOBILE_WORKER_FIRST_AID_KIT","direct_score_input":false},{"row":18,"status":"PASS_WITH_FIRST_AID_PROVISION_TASK_SPECIFIC","source":"HSE first aid at work","url":"https://www.hse.gov.uk/firstaid/","verified":"Required provision depends on workplace hazards, workforce, work patterns and other assessment factors rather than one universal configuration.","quality_score":"3","adoption":"FIRST_AID_TASK_SCOPE_GUARD","direct_score_input":false},{"row":19,"status":"PASS_WITH_FIRST_AID_NUMBERS_NOT_FIXED_RATIO","source":"HSE first-aider guidance","url":"https://www.hse.gov.uk/firstaid/first-aider.htm","verified":"Published staffing tables are general guidance and do not replace the employer's first-aid needs assessment.","quality_score":"3","adoption":"FIRST_AID_RATIO_GUARD","direct_score_input":false},{"row":20,"status":"PASS_WITH_FIRST_AID_NOT_PARCEL_SCORE","source":"HSE first aid at work","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/","verified":"Workplace first-aid arrangements are organisation-specific controls and are not converted into parcel-level safety probability.","quality_score":"3","adoption":"FIRST_AID_CONTEXT_ONLY","direct_score_input":false}]}