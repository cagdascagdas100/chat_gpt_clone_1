{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V30","part":7,"rows":[{"row":121,"status":"PASS_HSE_EVENT_CROWD_RISK_ASSESSMENT","source":"HSE crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management-assess.htm","verified":"Event organisers and others involved in crowd management must assess how crowd movement, dynamics and behaviour may cause harm.","quality_score":"4","adoption":"EVENT_CROWD_RISK_ASSESSMENT","direct_score_input":false},{"row":122,"status":"PASS_HSE_EVENT_VULNERABLE_PEOPLE","source":"HSE crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management-assess.htm","verified":"Crowd-risk controls should consider young people and people with disabilities or learning difficulties.","quality_score":"4","adoption":"EVENT_VULNERABLE_PEOPLE","direct_score_input":false},{"row":123,"status":"PASS_HSE_EVENT_PROPORTIONATE_CONTROLS","source":"HSE crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management-assess.htm","verified":"Organisers should take proportionate steps to eliminate or reduce identified crowd risks.","quality_score":"4","adoption":"EVENT_PROPORTIONATE_CONTROLS","direct_score_input":false},{"row":124,"status":"PASS_HSE_EVENT_CROWD_PLAN","source":"HSE crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management-assess.htm","verified":"A crowd management plan should be created after risks are assessed.","quality_score":"4","adoption":"EVENT_CROWD_MANAGEMENT_PLAN","direct_score_input":false},{"row":125,"status":"PASS_HSE_EVENT_PLAN_REVIEW","source":"HSE crowd safety","url":"https://www.hse.gov.uk/event-safety/crowd-management-assess.htm","verified":"Crowd-management methods should be checked periodically and reviewed after significant incidents or changes.","quality_score":"4","adoption":"EVENT_PLAN_REVIEW","direct_score_input":false},{"row":126,"status":"PASS_HSE_EVENT_ARRIVAL_PHASE","source":"HSE crowd controls","url":"https://www.hse.gov.uk/event-safety/crowd-management-controls.htm","verified":"Crowd controls should address arrival and entry routes, queues and entrances.","quality_score":"4","adoption":"EVENT_ARRIVAL_CONTROL","direct_score_input":false},{"row":127,"status":"PASS_HSE_EVENT_CIRCULATION_PHASE","source":"HSE crowd controls","url":"https://www.hse.gov.uk/event-safety/crowd-management-controls.htm","verified":"Crowd controls should address circulation inside the venue and around facilities.","quality_score":"4","adoption":"EVENT_CIRCULATION_CONTROL","direct_score_input":false},{"row":128,"status":"PASS_HSE_EVENT_DISPERSAL_PHASE","source":"HSE crowd controls","url":"https://www.hse.gov.uk/event-safety/crowd-management-controls.htm","verified":"Crowd controls should address departure, exits and dispersal.","quality_score":"4","adoption":"EVENT_DISPERSAL_CONTROL","direct_score_input":false},{"row":129,"status":"PASS_HSE_EVENT_EXITS_READY","source":"HSE crowd controls","url":"https://www.hse.gov.uk/event-safety/crowd-management-controls.htm","verified":"Before admission, exits should be unlocked, pedestrian routes clear and emergency arrangements in place.","quality_score":"4","adoption":"EVENT_EXIT_READINESS","direct_score_input":false},{"row":130,"status":"PASS_HSE_EVENT_QUEUE_CONTROLS","source":"HSE crowd controls","url":"https://www.hse.gov.uk/event-safety/crowd-management-controls.htm","verified":"Queuing systems, signage, suitable barriers and stewarding can be combined to control crowd flow and pressure.","quality_score":"4","adoption":"EVENT_QUEUE_CONTROLS","direct_score_input":false},{"row":131,"status":"PASS_HSE_EVENT_SECURITY_SEARCH_CROWD_GUARD","source":"HSE crowd controls","url":"https://www.hse.gov.uk/event-safety/crowd-management-controls.htm","verified":"Security searches should not create an overcrowding hazard.","quality_score":"4","adoption":"EVENT_SEARCH_OVERCROWDING_GUARD","direct_score_input":false},{"row":132,"status":"PASS_HSE_EVENT_EMERGENCY_PLAN","source":"HSE incident planning","url":"https://www.hse.gov.uk/event-safety/incidents-and-emergencies.htm","verified":"Events require an emergency plan proportionate to event risks and potential incident severity.","quality_score":"4","adoption":"EVENT_EMERGENCY_PLAN","direct_score_input":false},{"row":133,"status":"PASS_HSE_EVENT_EMERGENCY_REQUIREMENTS","source":"HSE incident planning","url":"https://www.hse.gov.uk/event-safety/incidents-and-emergencies.htm","verified":"Plans should cover moving people from danger, summoning services, casualties, displaced people and authority handover.","quality_score":"4","adoption":"EVENT_EMERGENCY_REQUIREMENTS","direct_score_input":false},{"row":134,"status":"PASS_HSE_EVENT_ACCESSIBLE_EVACUATION","source":"HSE incident planning","url":"https://www.hse.gov.uk/event-safety/incidents-and-emergencies.htm","verified":"Emergency procedures should include evacuation arrangements for disabled people.","quality_score":"4","adoption":"EVENT_ACCESSIBLE_EVACUATION","direct_score_input":false},{"row":135,"status":"PASS_HSE_EVENT_MEDICAL_ASSESSMENT","source":"HSE incident planning","url":"https://www.hse.gov.uk/event-safety/incidents-and-emergencies.htm","verified":"Organisers should assess first-aid, medical and ambulance needs for workers and the visiting public.","quality_score":"4","adoption":"EVENT_MEDICAL_NEEDS_ASSESSMENT","direct_score_input":false},{"row":136,"status":"PASS_HSE_EVENT_TABLETOP_TEST","source":"HSE incident planning","url":"https://www.hse.gov.uk/event-safety/incidents-and-emergencies.htm","verified":"Emergency plans can be validated through table-top exercises and communication-system testing.","quality_score":"4","adoption":"EVENT_EMERGENCY_TESTING","direct_score_input":false},{"row":137,"status":"PASS_HSE_EVENT_ROLE_ACCOUNTABILITY","source":"HSE crowd roles","url":"https://www.hse.gov.uk/event-safety/crowd-management-roles.htm","verified":"Organisers retain overall responsibility for public safety even when work such as stewarding is contracted.","quality_score":"4","adoption":"EVENT_ORGANISER_ACCOUNTABILITY","direct_score_input":false},{"row":138,"status":"PASS_HSE_EVENT_MULTI_AGENCY_LIAISON","source":"HSE crowd liaison","url":"https://www.hse.gov.uk/event-safety/crowd-management-work-with-others.htm","verified":"Organisers should liaise with local authorities, emergency services, police, transport operators and relevant neighbours.","quality_score":"4","adoption":"EVENT_MULTI_AGENCY_LIAISON","direct_score_input":false},{"row":139,"status":"PASS_WITH_HSE_EVENT_SITE_SPECIFIC","source":"HSE event safety","url":"https://www.hse.gov.uk/event-safety/","verified":"Controls depend on event scale, venue, audience, activity and current conditions and require event-specific assessment.","quality_score":"3","adoption":"EVENT_SITE_SCOPE_GUARD","direct_score_input":false},{"row":140,"status":"PASS_WITH_HSE_EVENT_NOT_PARCEL_SCORE","source":"HSE event safety","url":"https://www.hse.gov.uk/event-safety/","verified":"Event plans and crowd controls are operational arrangements rather than parcel-level safety probabilities.","quality_score":"3","adoption":"EVENT_CONTEXT_ONLY","direct_score_input":false}]}