{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V34","part":9,"rows":[{"row":161,"status":"PASS_OFWAT_PSR_COMPANY_REGISTER","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Water companies serving household customers should establish and maintain a Priority Services Register containing information needed to provide appropriate support.","quality_score":"4","adoption":"WATER_PSR_REGISTER","direct_score_input":false},{"row":162,"status":"PASS_OFWAT_PSR_ALTERNATIVE_WATER","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Priority services can include delivery of alternative water supplies during an interruption.","quality_score":"4","adoption":"WATER_PSR_ALTERNATIVE_SUPPLY","direct_score_input":false},{"row":163,"status":"PASS_OFWAT_PSR_KNOCK_WAIT","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Priority services can include knock-and-wait arrangements for customers who need additional time to answer the door.","quality_score":"4","adoption":"WATER_PSR_KNOCK_WAIT","direct_score_input":false},{"row":164,"status":"PASS_OFWAT_PSR_INCIDENT_CONTACT","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Priority services can include additional communication, contact and support around outages or incidents.","quality_score":"4","adoption":"WATER_PSR_INCIDENT_CONTACT","direct_score_input":false},{"row":165,"status":"PASS_OFWAT_PSR_ACCESSIBLE_FORMAT","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Priority services can include accessible formats such as braille, audio information and large print.","quality_score":"4","adoption":"WATER_PSR_ACCESSIBLE_FORMAT","direct_score_input":false},{"row":166,"status":"PASS_OFWAT_PSR_TRUSTED_CONTACT","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"A nominated trusted contact can be allowed to manage communications or the account on a customer's behalf.","quality_score":"4","adoption":"WATER_PSR_TRUSTED_CONTACT","direct_score_input":false},{"row":167,"status":"PASS_OFWAT_PSR_PASSWORD","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Password facilities can help a customer verify company staff or contacts.","quality_score":"4","adoption":"WATER_PSR_PASSWORD","direct_score_input":false},{"row":168,"status":"PASS_OFWAT_PSR_PRIORITY_OUTAGE_CONTACT","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Companies should provide priority contact before or during actual or potential outages to understand impact and support needs.","quality_score":"4","adoption":"WATER_PSR_PRIORITY_CONTACT","direct_score_input":false},{"row":169,"status":"PASS_OFWAT_PSR_TEMPORARY_NEED","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Priority-services support can apply to customers who need help for only a short or intermittent period.","quality_score":"4","adoption":"WATER_PSR_TEMPORARY_NEED","direct_score_input":false},{"row":170,"status":"PASS_OFWAT_PSR_DATA_REVIEW","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Companies should keep records of customer service requirements current and review them regularly.","quality_score":"4","adoption":"WATER_PSR_DATA_REVIEW","direct_score_input":false},{"row":171,"status":"PASS_OFWAT_PSR_PROMPT_REGISTRATION","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"A requested Priority Services Register entry should be implemented and relevant services provided as soon as possible.","quality_score":"4","adoption":"WATER_PSR_PROMPT_REGISTRATION","direct_score_input":false},{"row":172,"status":"PASS_OFWAT_PSR_CONFIRMATION","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Companies should confirm registration and explain the support the customer will receive.","quality_score":"4","adoption":"WATER_PSR_CONFIRMATION","direct_score_input":false},{"row":173,"status":"PASS_OFWAT_PSR_SUPPORT_CIRCUMSTANCES","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"Registration communications should explain the circumstances in which different support, such as bottled-water delivery, can be expected.","quality_score":"4","adoption":"WATER_PSR_SUPPORT_CONDITIONS","direct_score_input":false},{"row":174,"status":"PASS_OFWAT_CONSTANT_SUPPLY_SUPPORT","source":"Ofwat Service for All guidance","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/service-for-all-vulnerability-guidance/","verified":"During incidents, home delivery of bottled water should be considered for customers requiring a constant supply or unable to collect from distribution points.","quality_score":"4","adoption":"WATER_CONSTANT_SUPPLY_SUPPORT","direct_score_input":false},{"row":175,"status":"PASS_OFWAT_INCLUSIVE_COMMUNICATION","source":"Ofwat Service for All guidance","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/service-for-all-vulnerability-guidance/","verified":"Companies should provide inclusive communication channels and adaptations for different customer needs.","quality_score":"4","adoption":"WATER_INCLUSIVE_COMMUNICATION","direct_score_input":false},{"row":176,"status":"PASS_OFWAT_INCIDENT_LIFE_IMPACT","source":"Ofwat Service for All guidance","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/service-for-all-vulnerability-guidance/","verified":"Water-service interruptions can have major and potentially life-threatening effects for some customers, making adapted incident support important.","quality_score":"4","adoption":"WATER_VULNERABILITY_INCIDENT_IMPACT","direct_score_input":false},{"row":177,"status":"PASS_OFWAT_CUSTOMER_NEEDS_LICENCE","source":"Ofwat customer-focused licence condition","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/customer-focused-licence-condition/","verified":"Water companies must understand customer needs and provide appropriate support, particularly during incidents and for customers in vulnerable circumstances.","quality_score":"4","adoption":"WATER_CUSTOMER_NEEDS_DUTY","direct_score_input":false},{"row":178,"status":"PASS_WITH_PSR_SUPPORT_NOT_AUTOMATIC","source":"Ofwat Priority Services Register standards","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/priority-services-register-guidance/","verified":"The nature and timing of support depend on the customer's recorded needs, incident circumstances and the company's published service arrangements.","quality_score":"3","adoption":"WATER_PSR_SUPPORT_SCOPE_GUARD","direct_score_input":false},{"row":179,"status":"PASS_WITH_PSR_NOT_CONTINUITY_GUARANTEE","source":"Ofwat Priority Services","url":"https://www.ofwat.gov.uk/households/customer-assistance/special-assistance/","verified":"Priority registration supports contingency assistance but does not guarantee uninterrupted piped supply or immediate delivery in every incident.","quality_score":"3","adoption":"WATER_PSR_CONTINUITY_GUARD","direct_score_input":false},{"row":180,"status":"PASS_WITH_WATER_PSR_NOT_PARCEL_SCORE","source":"Ofwat vulnerability guidance","url":"https://www.ofwat.gov.uk/regulated-companies/vulnerability/service-for-all-vulnerability-guidance/","verified":"Priority-services records concern individual customer needs and company response and are not parcel-level safety probabilities.","quality_score":"3","adoption":"WATER_PSR_CONTEXT_ONLY","direct_score_input":false}]}