{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V35","part":5,"rows":[{"row":161,"status":"PASS_RAD_GO_IN","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"If told that a radiation emergency is nearby, the public should go indoors as soon as possible.","quality_score":"4","adoption":"PASS_RAD_GO_IN","direct_score_input":false},{"row":162,"status":"PASS_RAD_CLOSE_DOORS_WINDOWS","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"People sheltering should close external doors and windows.","quality_score":"4","adoption":"PASS_RAD_CLOSE_DOORS_WINDOWS","direct_score_input":false},{"row":163,"status":"PASS_RAD_AWAY_EXTERNAL_WALLS","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"People should stay as far from external walls as practicable while sheltering.","quality_score":"4","adoption":"PASS_RAD_AWAY_EXTERNAL_WALLS","direct_score_input":false},{"row":164,"status":"PASS_RAD_STAY_IN","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Staying indoors reduces exposure to radiation outside.","quality_score":"4","adoption":"PASS_RAD_STAY_IN","direct_score_input":false},{"row":165,"status":"PASS_RAD_TURN_OFF_FANS_AC","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Fans and air-conditioning should be turned off where possible during sheltering.","quality_score":"4","adoption":"PASS_RAD_TURN_OFF_FANS_AC","direct_score_input":false},{"row":166,"status":"PASS_RAD_CLOSE_VENTS","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"External vents should be closed where possible.","quality_score":"4","adoption":"PASS_RAD_CLOSE_VENTS","direct_score_input":false},{"row":167,"status":"PASS_RAD_TUNE_IN","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"People should monitor official news and advice for the next actions.","quality_score":"4","adoption":"PASS_RAD_TUNE_IN","direct_score_input":false},{"row":168,"status":"PASS_RAD_MULTIPLE_OFFICIAL_CHANNELS","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Advice may be delivered by radio, television, internet, social media or police.","quality_score":"4","adoption":"PASS_RAD_MULTIPLE_OFFICIAL_CHANNELS","direct_score_input":false},{"row":169,"status":"PASS_RAD_LOCAL_ADVICE","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Emergency services and local authorities provide location-specific instructions.","quality_score":"4","adoption":"PASS_RAD_LOCAL_ADVICE","direct_score_input":false},{"row":170,"status":"PASS_RAD_CANNOT_SENSE","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Ionising radiation cannot be seen, heard, smelled, tasted or felt.","quality_score":"4","adoption":"PASS_RAD_CANNOT_SENSE","direct_score_input":false},{"row":171,"status":"PASS_RAD_EVACUATE_ONLY_WHEN_ADVISED","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"People should not evacuate unless advised because leaving shelter can increase exposure.","quality_score":"4","adoption":"PASS_RAD_EVACUATE_ONLY_WHEN_ADVISED","direct_score_input":false},{"row":172,"status":"PASS_RAD_ADVICE_CHANGES","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Protective advice may change as the incident develops.","quality_score":"4","adoption":"PASS_RAD_ADVICE_CHANGES","direct_score_input":false},{"row":173,"status":"PASS_RAD_OVERSEAS_LOCAL_ADVICE","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"People overseas should follow local official advice and contact British consular services when safe if needed.","quality_score":"4","adoption":"PASS_RAD_OVERSEAS_LOCAL_ADVICE","direct_score_input":false},{"row":174,"status":"PASS_RAD_PUBLIC_SELF_DECONTAMINATION","source":"UKHSA radiation emergency information","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public","verified":"UKHSA provides public guidance on removing radioactive material from skin and clothes.","quality_score":"4","adoption":"PASS_RAD_PUBLIC_SELF_DECONTAMINATION","direct_score_input":false},{"row":175,"status":"PASS_RAD_PUBLIC_AND_LOCAL_AUTHORITY_USE","source":"UKHSA radiation emergency information","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public","verified":"The public guidance can also support local authorities issuing nuclear emergency advice.","quality_score":"4","adoption":"PASS_RAD_PUBLIC_AND_LOCAL_AUTHORITY_USE","direct_score_input":false},{"row":176,"status":"PASS_RAD_UKHSA_RESPONSE_ARRANGEMENTS","source":"UKHSA radiation incident collection","url":"https://www.gov.uk/government/collections/radiation-incidents-public-health-preparedness-and-response","verified":"UKHSA maintains response arrangements and facilities for radiological or nuclear emergencies affecting public health.","quality_score":"4","adoption":"PASS_RAD_UKHSA_RESPONSE_ARRANGEMENTS","direct_score_input":false},{"row":177,"status":"PASS_RAD_MONITORING_ANALYSIS_DOSIMETRY","source":"UKHSA radiation incident collection","url":"https://www.gov.uk/government/collections/radiation-incidents-public-health-preparedness-and-response","verified":"UKHSA can provide monitoring, sample analysis and dosimetry during relevant emergencies.","quality_score":"4","adoption":"PASS_RAD_MONITORING_ANALYSIS_DOSIMETRY","direct_score_input":false},{"row":178,"status":"PASS_WITH_RAD_SHELTER_DURATION_VARIABLE","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Shelter duration and later protective actions depend on the release, location and official incident advice.","quality_score":"3","adoption":"PASS_WITH_RAD_SHELTER_DURATION_VARIABLE","direct_score_input":false},{"row":179,"status":"PASS_WITH_RAD_LOCATION_SPECIFIC","source":"UKHSA radiation emergency public guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public/what-to-do-in-a-radiation-emergency","verified":"Protective action depends on where a person is relative to the emergency, so generic guidance is not a live local instruction.","quality_score":"3","adoption":"PASS_WITH_RAD_LOCATION_SPECIFIC","direct_score_input":false},{"row":180,"status":"PASS_WITH_RAD_NOT_PARCEL_SCORE","source":"UKHSA radiation emergency guidance","url":"https://www.gov.uk/government/publications/radiation-emergencies-information-for-the-public","verified":"Radiation emergency guidance is protective-action context and is not converted into parcel-level probability.","quality_score":"3","adoption":"PASS_WITH_RAD_NOT_PARCEL_SCORE","direct_score_input":false},{"row":181,"status":"PASS_DSEAR_FIRE_EXPLOSION_CORROSION","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"DSEAR requires control of safety risks from fire, explosion and substances corrosive to metals.","quality_score":"4","adoption":"PASS_DSEAR_FIRE_EXPLOSION_CORROSION","direct_score_input":false},{"row":182,"status":"PASS_DSEAR_EMPLOYEES_PUBLIC","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"DSEAR protects employees, the self-employed and members of the public who may be put at risk by work activity.","quality_score":"4","adoption":"PASS_DSEAR_EMPLOYEES_PUBLIC","direct_score_input":false},{"row":183,"status":"PASS_DSEAR_SOLVENTS_PAINTS_VARNISHES","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Solvents, paints and varnishes can be dangerous substances under DSEAR.","quality_score":"4","adoption":"PASS_DSEAR_SOLVENTS_PAINTS_VARNISHES","direct_score_input":false},{"row":184,"status":"PASS_DSEAR_LPG_DUST_GASES","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"LPG, combustible dusts and pressurised gases can fall within DSEAR.","quality_score":"4","adoption":"PASS_DSEAR_LPG_DUST_GASES","direct_score_input":false},{"row":185,"status":"PASS_DSEAR_IDENTIFY_SUBSTANCES","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employers must identify dangerous substances and assess the risks they create.","quality_score":"4","adoption":"PASS_DSEAR_IDENTIFY_SUBSTANCES","direct_score_input":false},{"row":186,"status":"PASS_DSEAR_REMOVE_OR_CONTROL","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employers must remove dangerous-substance risks or control them where removal is not possible.","quality_score":"4","adoption":"PASS_DSEAR_REMOVE_OR_CONTROL","direct_score_input":false},{"row":187,"status":"PASS_DSEAR_MITIGATE_INCIDENT_EFFECTS","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Controls must reduce the effects of incidents involving dangerous substances.","quality_score":"4","adoption":"PASS_DSEAR_MITIGATE_INCIDENT_EFFECTS","direct_score_input":false},{"row":188,"status":"PASS_DSEAR_EMERGENCY_PLANS","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employers must prepare plans and procedures for dangerous-substance accidents and emergencies.","quality_score":"4","adoption":"PASS_DSEAR_EMERGENCY_PLANS","direct_score_input":false},{"row":189,"status":"PASS_DSEAR_INFORMATION_TRAINING","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employees must receive appropriate information and training about dangerous-substance risks and controls.","quality_score":"4","adoption":"PASS_DSEAR_INFORMATION_TRAINING","direct_score_input":false},{"row":190,"status":"PASS_DSEAR_CLASSIFY_EXPLOSIVE_AREAS","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Areas where explosive atmospheres may occur must be identified and classified.","quality_score":"4","adoption":"PASS_DSEAR_CLASSIFY_EXPLOSIVE_AREAS","direct_score_input":false},{"row":191,"status":"PASS_DSEAR_CONTROL_IGNITION","source":"HSE DSEAR overview","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Ignition sources must be avoided in classified explosive-atmosphere areas.","quality_score":"4","adoption":"PASS_DSEAR_CONTROL_IGNITION","direct_score_input":false},{"row":192,"status":"PASS_FLAMMABLE_CONTAINER_SCOPE","source":"HSE HSG51","url":"https://www.hse.gov.uk/pubns/books/hsg51.htm","verified":"HSG51 applies to workplace storage of flammable liquids in containers up to 1000 litres.","quality_score":"4","adoption":"PASS_FLAMMABLE_CONTAINER_SCOPE","direct_score_input":false},{"row":193,"status":"PASS_FLAMMABLE_USE_SCOPE","source":"HSE HSG140","url":"https://www.hse.gov.uk/pubns/books/hsg140.htm","verified":"HSG140 covers safe use and handling of flammable liquids in general work, small-scale processing and spraying.","quality_score":"4","adoption":"PASS_FLAMMABLE_USE_SCOPE","direct_score_input":false},{"row":194,"status":"PASS_FLAMMABLE_TANK_SCOPE","source":"HSE HSG176","url":"https://www.hse.gov.uk/pubns/books/hsg176.htm","verified":"HSG176 covers above- and below-ground fixed bulk tanks and can apply to larger portable or skid-mounted vessels.","quality_score":"4","adoption":"PASS_FLAMMABLE_TANK_SCOPE","direct_score_input":false},{"row":195,"status":"PASS_FLAMMABLE_TANK_LIFECYCLE","source":"HSE HSG176","url":"https://www.hse.gov.uk/pubns/books/hsg176.htm","verified":"Tank guidance covers design, construction, operation and maintenance.","quality_score":"4","adoption":"PASS_FLAMMABLE_TANK_LIFECYCLE","direct_score_input":false},{"row":196,"status":"PASS_FLAMMABLE_WORKROOM_MINIMUM","source":"HSE flammable liquids in workrooms","url":"https://www.hse.gov.uk/fireandexplosion/storageflammliquids.htm","verified":"Only the minimum quantity needed for frequent activity or roughly half a day or one shift should normally be kept in a workroom.","quality_score":"4","adoption":"PASS_FLAMMABLE_WORKROOM_MINIMUM","direct_score_input":false},{"row":197,"status":"PASS_FLAMMABLE_RISK_JUSTIFICATION","source":"HSE flammable liquids in workrooms","url":"https://www.hse.gov.uk/fireandexplosion/storageflammliquids.htm","verified":"The dutyholder must justify workroom quantities through the DSEAR risk assessment.","quality_score":"4","adoption":"PASS_FLAMMABLE_RISK_JUSTIFICATION","direct_score_input":false},{"row":198,"status":"PASS_WITH_DSEAR_HEALTH_LAW_BOUNDARY","source":"HSE DSEAR in detail","url":"https://www.hse.gov.uk/fireandexplosion/dsear-background.htm","verified":"DSEAR controls physical safety risks; toxic and irritant health risks may also require separate COSHH controls.","quality_score":"3","adoption":"PASS_WITH_DSEAR_HEALTH_LAW_BOUNDARY","direct_score_input":false},{"row":199,"status":"PASS_WITH_FLAMMABLE_PROPORTIONATE_RISK","source":"HSE DSEAR in detail","url":"https://www.hse.gov.uk/fireandexplosion/dsear-background.htm","verified":"Classification as flammable does not alone determine the control package; actual storage, temperature, process and exposure conditions require proportionate assessment.","quality_score":"3","adoption":"PASS_WITH_FLAMMABLE_PROPORTIONATE_RISK","direct_score_input":false},{"row":200,"status":"PASS_WITH_FLAMMABLE_NOT_PARCEL_SCORE","source":"HSE flammable-liquid guidance","url":"https://www.hse.gov.uk/pubns/books/hsg51.htm","verified":"Flammable-liquid duties are workplace and installation controls and are not exact parcel-level safety probabilities.","quality_score":"3","adoption":"PASS_WITH_FLAMMABLE_NOT_PARCEL_SCORE","direct_score_input":false}]}