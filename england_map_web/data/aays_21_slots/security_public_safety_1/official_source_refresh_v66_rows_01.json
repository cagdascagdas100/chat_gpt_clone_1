{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V66","part":1,"rows":[{"row":1,"status":"PASS_LISTERIA_01","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/government/collections/listeria-guidance-data-and-analysis","verified":"Listeria causes listeriosis, a rare but potentially life-threatening disease.","quality_score":"4","adoption":"LISTERIA_01","direct_score_input":false},{"row":2,"status":"PASS_LISTERIA_02","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/government/collections/listeria-guidance-data-and-analysis","verified":"Healthy adults often have mild illness, while pregnancy, older age and weakened immunity increase the risk of severe listeriosis.","quality_score":"4","adoption":"LISTERIA_02","direct_score_input":false},{"row":3,"status":"PASS_LISTERIA_03","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/government/collections/listeria-guidance-data-and-analysis","verified":"Listeria is typically spread through contaminated food.","quality_score":"4","adoption":"LISTERIA_03","direct_score_input":false},{"row":4,"status":"PASS_LISTERIA_04","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/government/collections/listeria-guidance-data-and-analysis","verified":"Listeria can grow at refrigeration temperatures below 5°C.","quality_score":"4","adoption":"LISTERIA_04","direct_score_input":false},{"row":5,"status":"PASS_LISTERIA_05","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/government/collections/listeria-guidance-data-and-analysis","verified":"Thorough cooking and pasteurisation kill Listeria.","quality_score":"4","adoption":"LISTERIA_05","direct_score_input":false},{"row":6,"status":"PASS_LISTERIA_06","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/government/publications/listeriosis-and-high-risk-groups","verified":"Listeriosis commonly follows consumption of contaminated ready-to-eat food.","quality_score":"4","adoption":"LISTERIA_06","direct_score_input":false},{"row":7,"status":"PASS_LISTERIA_07","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/government/publications/listeriosis-and-high-risk-groups","verified":"Smoked fish is a higher-risk product for invasive listeriosis in vulnerable groups, although overall population risk remains low.","quality_score":"4","adoption":"LISTERIA_07","direct_score_input":false},{"row":8,"status":"PASS_LISTERIA_08","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/guidance/listeria-monocytogenes-in-ready-to-eat-products-advice-for-health-professionals","verified":"People in specified high-risk groups should avoid certain chilled ready-to-eat products and follow careful handling, storage and preparation advice.","quality_score":"4","adoption":"LISTERIA_08","direct_score_input":false},{"row":9,"status":"PASS_WITH_LISTERIA_09","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/guidance/listeria-monocytogenes-in-ready-to-eat-products-advice-for-health-professionals","verified":"Listeria risk depends on food type, contamination level, storage duration and temperature, dose, pregnancy, age and immune status.","quality_score":"3","adoption":"LISTERIA_GUARD_09","direct_score_input":false},{"row":10,"status":"PASS_WITH_LISTERIA_10","source":"UKHSA and FSA listeriosis prevention","url":"https://www.gov.uk/guidance/listeria-monocytogenes-in-ready-to-eat-products-advice-for-health-professionals","verified":"Listeria evidence is product-, batch-, consumer-, handling- and time-specific and is not an exact parcel-level illness probability.","quality_score":"3","adoption":"LISTERIA_GUARD_10","direct_score_input":false},{"row":11,"status":"PASS_SALMONELLA_01","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"More than 2,500 strains of Salmonella bacteria are recognised.","quality_score":"4","adoption":"SALMONELLA_01","direct_score_input":false},{"row":12,"status":"PASS_SALMONELLA_02","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Salmonella bacteria live in the intestines of domestic and wild animals.","quality_score":"4","adoption":"SALMONELLA_02","direct_score_input":false},{"row":13,"status":"PASS_SALMONELLA_03","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Salmonella is a cause of food poisoning.","quality_score":"4","adoption":"SALMONELLA_03","direct_score_input":false},{"row":14,"status":"PASS_SALMONELLA_04","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Eggs, chicken, pork and dairy products can carry Salmonella.","quality_score":"4","adoption":"SALMONELLA_04","direct_score_input":false},{"row":15,"status":"PASS_SALMONELLA_05","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Fruit and vegetables can become contaminated through livestock, manure or untreated water.","quality_score":"4","adoption":"SALMONELLA_05","direct_score_input":false},{"row":16,"status":"PASS_SALMONELLA_06","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Hand washing and thorough cleaning of kitchen equipment help prevent spread from raw meat to other foods.","quality_score":"4","adoption":"SALMONELLA_06","direct_score_input":false},{"row":17,"status":"PASS_SALMONELLA_07","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Infection can also follow contact with a person with diarrhoea or an unwell animal.","quality_score":"4","adoption":"SALMONELLA_07","direct_score_input":false},{"row":18,"status":"PASS_SALMONELLA_08","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Symptoms usually begin 12 to 72 hours after infection and illness commonly lasts 4 to 7 days.","quality_score":"4","adoption":"SALMONELLA_08","direct_score_input":false},{"row":19,"status":"PASS_WITH_SALMONELLA_09","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Salmonella risk depends on strain, food or animal source, contamination level, cooking, hygiene, host factors and exposure dose.","quality_score":"3","adoption":"SALMONELLA_GUARD_09","direct_score_input":false},{"row":20,"status":"PASS_WITH_SALMONELLA_10","source":"UKHSA Salmonella prevention and surveillance","url":"https://www.gov.uk/government/collections/salmonella-guidance-data-and-analysis","verified":"Salmonella evidence is food-, animal-, case-, outbreak- and time-specific and is not an exact parcel-level illness probability.","quality_score":"3","adoption":"SALMONELLA_GUARD_10","direct_score_input":false}]}