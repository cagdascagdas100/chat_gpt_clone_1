{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V29","part":5,"rows":[{"row":87,"status":"PASS_RESERVOIR_EA_ENFORCER","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"The Environment Agency is the enforcement authority for reservoir safety in England.","quality_score":"4","adoption":"RESERVOIR_EA_ENFORCEMENT","direct_score_input":false},{"row":88,"status":"PASS_RESERVOIR_REGISTER","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"The Environment Agency maintains a register of reservoirs subject to the regime.","quality_score":"4","adoption":"RESERVOIR_REGISTER","direct_score_input":false},{"row":89,"status":"PASS_RESERVOIR_UNDERTAKER_RESPONSIBILITY","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"Reservoir owners and operators are responsible for keeping their reservoirs safe.","quality_score":"4","adoption":"RESERVOIR_UNDERTAKER_DUTY","direct_score_input":false},{"row":90,"status":"PASS_RESERVOIR_HIGH_RISK_DESIGNATION","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"A reservoir may be designated high risk where uncontrolled release could endanger human life.","quality_score":"4","adoption":"RESERVOIR_HIGH_RISK_DESIGNATION","direct_score_input":false},{"row":91,"status":"PASS_RESERVOIR_SUPERVISING_ENGINEER","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-supervising-engineers-written-statements-and-site-visit-reports","verified":"High-risk reservoirs must have a supervising engineer appointed continuously.","quality_score":"4","adoption":"RESERVOIR_SUPERVISING_ENGINEER","direct_score_input":false},{"row":92,"status":"PASS_RESERVOIR_INSPECTING_ENGINEER","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-inspecting-engineers-safety-inspection-of-reservoirs","verified":"High-risk reservoirs require statutory inspection by an independent qualified inspecting engineer.","quality_score":"4","adoption":"RESERVOIR_INSPECTING_ENGINEER","direct_score_input":false},{"row":93,"status":"PASS_RESERVOIR_TEN_YEAR_INSPECTION","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"Statutory inspection is required at least every ten years or sooner when specified.","quality_score":"4","adoption":"RESERVOIR_INSPECTION_INTERVAL","direct_score_input":false},{"row":94,"status":"PASS_RESERVOIR_ANNUAL_STATEMENT","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-supervising-engineers-written-statements-and-site-visit-reports","verified":"The supervising engineer provides a written statement at least annually.","quality_score":"4","adoption":"RESERVOIR_ANNUAL_STATEMENT","direct_score_input":false},{"row":95,"status":"PASS_RESERVOIR_SITE_VISIT","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-supervising-engineers-written-statements-and-site-visit-reports","verified":"Supervising engineers should visit often enough to perform their duties, ordinarily at least annually.","quality_score":"4","adoption":"RESERVOIR_SITE_VISIT","direct_score_input":false},{"row":96,"status":"PASS_RESERVOIR_EVENT_VISIT","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-supervising-engineers-written-statements-and-site-visit-reports","verified":"A prompt site visit is advised after significant floods, extreme weather, seismic activity or operational change.","quality_score":"4","adoption":"RESERVOIR_EVENT_TRIGGERED_VISIT","direct_score_input":false},{"row":97,"status":"PASS_RESERVOIR_MIOS","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-inspecting-engineers-safety-inspection-of-reservoirs","verified":"Inspecting engineers can recommend measures in the interests of safety with enforceable completion deadlines.","quality_score":"4","adoption":"RESERVOIR_MIOS","direct_score_input":false},{"row":98,"status":"PASS_RESERVOIR_MIOS_CERTIFICATE","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-inspecting-engineers-safety-inspection-of-reservoirs","verified":"A qualified engineer certifies completion of measures in the interests of safety.","quality_score":"4","adoption":"RESERVOIR_MIOS_CERTIFICATION","direct_score_input":false},{"row":99,"status":"PASS_RESERVOIR_MAINTENANCE","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"Undertakers must complete statutory maintenance and safety recommendations.","quality_score":"4","adoption":"RESERVOIR_MAINTENANCE_DUTY","direct_score_input":false},{"row":100,"status":"PASS_RESERVOIR_ONSITE_FLOOD_PLAN","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"Large raised reservoirs in England require an on-site emergency flood plan.","quality_score":"4","adoption":"RESERVOIR_ONSITE_FLOOD_PLAN","direct_score_input":false},{"row":101,"status":"PASS_RESERVOIR_PLAN_PREVENT_CONTAIN","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"The plan covers efforts to prevent dam failure and contain or reduce its consequences.","quality_score":"4","adoption":"RESERVOIR_PLAN_CONTENT","direct_score_input":false},{"row":102,"status":"PASS_RESERVOIR_OFFSITE_PLAN","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"Local councils coordinate off-site reservoir-flood plans and community preparedness.","quality_score":"4","adoption":"RESERVOIR_OFFSITE_PLAN","direct_score_input":false},{"row":103,"status":"PASS_RESERVOIR_INCIDENT_CALL","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"Registered-reservoir incidents that could cause injury or damage must be reported to the Environment Agency incident line.","quality_score":"4","adoption":"RESERVOIR_INCIDENT_REPORTING","direct_score_input":false},{"row":104,"status":"PASS_RESERVOIR_INCIDENT_EXAMPLES","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/reservoirs-a-guide-for-owners-and-operators","verified":"Overtopping, leaks, slope instability, dam cracks, abnormal movement, material failure and pollution are incident examples.","quality_score":"4","adoption":"RESERVOIR_INCIDENT_SCHEMA","direct_score_input":false},{"row":105,"status":"PASS_WITH_RESERVOIR_FLOOD_MAP_ASSUMPTIONS","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-flood-maps-when-and-how-to-use-them","verified":"Reservoir flood maps model uncontrolled releases using assumptions and are planning tools rather than live failure forecasts.","quality_score":"3","adoption":"RESERVOIR_MAP_ASSUMPTION_GUARD","direct_score_input":false},{"row":106,"status":"PASS_WITH_RESERVOIR_MIOS_NOT_IMMEDIATE_FAILURE","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-inspecting-engineers-safety-inspection-of-reservoirs","verified":"An outstanding safety measure identifies required work but does not alone prove an immediate dam-failure threat.","quality_score":"3","adoption":"RESERVOIR_MIOS_SCOPE_GUARD","direct_score_input":false},{"row":107,"status":"PASS_WITH_RESERVOIR_NOT_PARCEL_SCORE","source":"Environment Agency reservoir safety guidance","url":"https://www.gov.uk/guidance/reservoir-flood-maps-when-and-how-to-use-them","verified":"Reservoir regulation and flood mapping do not provide a universal exact parcel-level failure probability.","quality_score":"3","adoption":"RESERVOIR_CONTEXT_ONLY","direct_score_input":false}]}