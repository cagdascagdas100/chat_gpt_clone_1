{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V125","part":2,"row_range":[21,40],"rows":[{"row":21,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/responsibilities.htm","verified":"Employers must assess hand-arm vibration risk and reduce exposure that produces health and safety risks.","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":22,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/responsibilities.htm","verified":"The hand-arm vibration daily exposure action value is 2.5 m/s² A(8).","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":23,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/responsibilities.htm","verified":"The hand-arm vibration daily exposure limit value is 5 m/s² A(8) and should not be exceeded.","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":24,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/responsibilities.htm","verified":"Employers must provide information and training and arrange health surveillance where there is a risk to health.","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":25,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/advice-to-employers.htm","verified":"Regular and frequent exposure can cause permanent hand-arm vibration syndrome and conditions such as carpal tunnel syndrome.","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":26,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/protect.htm","verified":"Employers should use alternative methods and select the lowest-vibration suitable tool that can complete the work efficiently.","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":27,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/protect.htm","verified":"Maintenance programmes and work schedules should limit avoidable vibration and long continuous exposure periods.","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":28,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/protect.htm","verified":"Gloves may keep hands warm but should not be relied upon to protect workers from vibration.","quality_score":"4","adoption":"HSE_HAND_ARM_VIBRATION_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":29,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/responsibilities.htm","verified":"Hand-arm vibration risk depends on tool vibration, task method, grip force, trigger time, maintenance, temperature and individual health factors.","quality_score":"3","adoption":"HSE_HAND_ARM_VIBRATION_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":30,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE hand-arm vibration guidance","family_id":"HSE_HAND_ARM_VIBRATION","url":"https://www.hse.gov.uk/vibration/hav/responsibilities.htm","verified":"General hand-arm vibration guidance does not establish an exact individual or parcel-level probability of HAVS.","quality_score":"3","adoption":"HSE_HAND_ARM_VIBRATION_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":31,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"Whole-body vibration can be transmitted through the seat or feet of workers who drive mobile machines or vehicles over rough surfaces.","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":32,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"Large shocks and jolts may create health risks including back pain.","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":33,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"Employers should eliminate vibration exposure where possible and otherwise reduce it as low as reasonably practicable.","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":34,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"Control measures are required when daily exposure is likely to exceed the exposure action value, and exposure must not exceed the limit value.","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":35,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"Vehicle choice, ergonomic design, seating, tyres and visibility can contribute to reducing whole-body vibration risk.","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":36,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"Maintaining vehicles, seats, suspension, unmade roads and ground conditions can reduce shocks and jolts.","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":37,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"The whole-body vibration exposure action value is 0.5 m/s² A(8).","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":38,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"The whole-body vibration exposure limit value is 1.15 m/s² A(8).","quality_score":"4","adoption":"HSE_WHOLE_BODY_VIBRATION_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":39,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"Whole-body vibration risk depends on the vehicle or machine, surface condition, seat and suspension, shocks, posture, duration and individual factors.","quality_score":"3","adoption":"HSE_WHOLE_BODY_VIBRATION_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":40,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE whole-body vibration guidance","family_id":"HSE_WHOLE_BODY_VIBRATION","url":"https://www.hse.gov.uk/vibration/wbv/index.htm","verified":"General whole-body vibration guidance does not quantify the back-injury probability for a specific driver, task or parcel.","quality_score":"3","adoption":"HSE_WHOLE_BODY_VIBRATION_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"}]}