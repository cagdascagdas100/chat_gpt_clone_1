{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V24","part":6,"rows":[{"row":101,"status":"PASS_CDM_ALL_CONSTRUCTION_SCOPE","source":"HSE CDM FAQ","url":"https://www.hse.gov.uk/construction/cdm/faq/","verified":"CDM 2015 applies to construction work including domestic projects.","quality_score":"4","adoption":"CDM_CONSTRUCTION_SCOPE","direct_score_input":false},{"row":102,"status":"PASS_CDM_NOTIFIABLE_THRESHOLDS","source":"HSE CDM FAQ","url":"https://www.hse.gov.uk/construction/cdm/faq/","verified":"A project is notifiable when it is expected to exceed 30 working days with more than 20 workers at once or exceed 500 person-days.","quality_score":"4","adoption":"CDM_NOTIFICATION_THRESHOLD","direct_score_input":false},{"row":103,"status":"PASS_CDM_DAY_COUNT_METHOD","source":"HSE CDM FAQ","url":"https://www.hse.gov.uk/construction/cdm/faq/","verified":"Every day on which construction work is expected, including weekends and holidays, counts toward the notification calculation.","quality_score":"4","adoption":"CDM_DAY_COUNT_METHOD","direct_score_input":false},{"row":104,"status":"PASS_CDM_CLIENT_NOTIFICATION_DUTY","source":"HSE CDM FAQ","url":"https://www.hse.gov.uk/construction/cdm/faq/","verified":"The client holds the duty to notify a notifiable project, although another person may submit on the client's behalf.","quality_score":"4","adoption":"CDM_CLIENT_NOTIFICATION_OWNER","direct_score_input":false},{"row":105,"status":"PASS_CDM_CONSTRUCTION_PHASE_PLAN","source":"HSE CDM FAQ","url":"https://www.hse.gov.uk/construction/cdm/faq/","verified":"A sole contractor or principal contractor must prepare a construction phase plan for construction work.","quality_score":"4","adoption":"CONSTRUCTION_PHASE_PLAN_GATE","direct_score_input":false},{"row":106,"status":"PASS_CDM_PROPORTIONATE_PLAN","source":"HSE CDM FAQ","url":"https://www.hse.gov.uk/construction/cdm/faq/","verified":"The construction phase plan should be proportionate to the size and scale of the job.","quality_score":"4","adoption":"PROPORTIONATE_PLAN_METHOD","direct_score_input":false},{"row":107,"status":"PASS_CDM_PRINCIPAL_DESIGNER_APPOINTMENT","source":"HSE principal designer guidance","url":"https://www.hse.gov.uk/construction/areyou/principal-designer.htm","verified":"The client must appoint a principal designer in writing when a project involves or is likely to involve more than one contractor.","quality_score":"4","adoption":"PRINCIPAL_DESIGNER_APPOINTMENT","direct_score_input":false},{"row":108,"status":"PASS_CDM_PRINCIPAL_DESIGNER_TIMING","source":"HSE principal designer guidance","url":"https://www.hse.gov.uk/construction/areyou/principal-designer.htm","verified":"The principal designer should be appointed as early as possible, where practicable at concept stage.","quality_score":"4","adoption":"EARLY_DESIGN_SAFETY_GATE","direct_score_input":false},{"row":109,"status":"PASS_CDM_PRINCIPAL_CONTRACTOR_APPOINTMENT","source":"HSE principal contractor guidance","url":"https://www.hse.gov.uk/construction/areyou/principalcontractor.htm","verified":"The client must appoint a principal contractor in writing for a project involving more than one contractor.","quality_score":"4","adoption":"PRINCIPAL_CONTRACTOR_APPOINTMENT","direct_score_input":false},{"row":110,"status":"PASS_CDM_PC_MANAGEMENT_DUTY","source":"HSE principal contractor responsibilities","url":"https://www.hse.gov.uk/construction/cdm/2015/principal-contractors.htm","verified":"The principal contractor plans, manages, monitors and coordinates the construction phase.","quality_score":"4","adoption":"CONSTRUCTION_PHASE_MANAGEMENT","direct_score_input":false},{"row":111,"status":"PASS_CDM_PUBLIC_RISK_SCOPE","source":"HSE principal contractor responsibilities","url":"https://www.hse.gov.uk/construction/cdm/2015/principal-contractors.htm","verified":"Construction-phase planning must consider risks to workers and other people affected by the work, including the public.","quality_score":"4","adoption":"PUBLIC_CONSTRUCTION_RISK_SCOPE","direct_score_input":false},{"row":112,"status":"PASS_CDM_DUTYHOLDER_LIAISON","source":"HSE principal contractor responsibilities","url":"https://www.hse.gov.uk/construction/cdm/2015/principal-contractors.htm","verified":"The principal contractor must liaise with the client and principal designer so risks are managed.","quality_score":"4","adoption":"DUTYHOLDER_LIAISON","direct_score_input":false},{"row":113,"status":"PASS_CDM_PLAN_REVIEW","source":"HSE principal contractor responsibilities","url":"https://www.hse.gov.uk/construction/cdm/2015/principal-contractors.htm","verified":"The written construction phase plan must be implemented and regularly reviewed and revised.","quality_score":"4","adoption":"CONSTRUCTION_PLAN_REVIEW","direct_score_input":false},{"row":114,"status":"PASS_CDM_DESIGN_LIFECYCLE_EFFECT","source":"HSE designer responsibilities","url":"https://www.hse.gov.uk/construction/cdm/2015/designers.htm","verified":"Design decisions can affect construction, use, maintenance, refurbishment and eventual demolition safety.","quality_score":"4","adoption":"DESIGN_LIFECYCLE_SAFETY","direct_score_input":false},{"row":115,"status":"PASS_HSE_CONSTRUCTION_DUST_RISK","source":"HSE construction dust","url":"https://www.hse.gov.uk/construction/healthrisks/hazardous-substances/construction-dust.htm","verified":"Construction dust can cause lung cancer, asthma, COPD and silicosis and is not merely a nuisance.","quality_score":"4","adoption":"CONSTRUCTION_DUST_HEALTH_RISK","direct_score_input":false},{"row":116,"status":"PASS_HSE_DUST_ACR_METHOD","source":"HSE construction dust","url":"https://www.hse.gov.uk/construction/healthrisks/hazardous-substances/construction-dust.htm","verified":"COSHH control follows an Assess, Control and Review model.","quality_score":"4","adoption":"DUST_ASSESS_CONTROL_REVIEW","direct_score_input":false},{"row":117,"status":"PASS_HSE_RCS_MATERIAL_SCOPE","source":"HSE silica guidance","url":"https://www.hse.gov.uk/construction/healthrisks/cancer-and-construction/silica-dust.htm","verified":"Respirable crystalline silica can be generated by cutting, drilling, grinding or polishing common stone, brick, concrete and mortar materials.","quality_score":"4","adoption":"RCS_TASK_AND_MATERIAL_SCOPE","direct_score_input":false},{"row":118,"status":"PASS_WITH_HSE_SILICA_MORTALITY_ESTIMATE","source":"HSE construction dust","url":"https://www.hse.gov.uk/construction/healthrisks/hazardous-substances/construction-dust.htm","verified":"HSE cites an estimate that more than 500 construction workers die each year from silica exposure; this is an estimated burden rather than a current incident count.","quality_score":"3","adoption":"SILICA_ESTIMATE_GUARD","direct_score_input":false},{"row":119,"status":"PASS_HSE_DRY_SWEEPING_CONTROL","source":"HSE dry sweeping guidance","url":"https://www.hse.gov.uk/construction/healthrisks/hazardous-substances/sweeping-cleaning.htm","verified":"Dry sweeping can generate high dust levels and should be avoided where possible.","quality_score":"4","adoption":"DUST_CLEANING_CONTROL","direct_score_input":false},{"row":120,"status":"PASS_WITH_CONSTRUCTION_NOT_PARCEL_SCORE","source":"HSE CDM 2015","url":"https://www.hse.gov.uk/construction/CDM/2015/","verified":"Construction duties and occupational-health controls describe project and work activity requirements and are not parcel-level risk measurements.","quality_score":"3","adoption":"CONSTRUCTION_CONTEXT_ONLY","direct_score_input":false}]}