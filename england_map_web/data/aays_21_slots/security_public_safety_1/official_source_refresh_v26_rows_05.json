AIN","direct_score_input":false},{"row":96,"status":"PASS_NHS_EPRR_PLAN_MAINTENANCE","source":"NHS EPRR core standards guidance","url":"https://www.england.nhs.uk/long-read/nhs-core-standards-for-emergency-preparedness-resilience-and-response-guidance/","verified":"Maintaining emergency and business-continuity plans is a core standards requirement.","quality_score":"4","adoption":"EPRR_PLAN_MAINTENANCE","direct_score_input":false},{"row":97,"status":"PASS_NHS_EPRR_TRAIN_EXERCISE","source":"NHS EPRR core standards guidance","url":"https://www.england.nhs.uk/long-read/nhs-core-standards-for-emergency-preparedness-resilience-and-response-guidance/","verified":"Training and exercising arrangements form a separate EPRR domain.","quality_score":"4","adoption":"EPRR_TRAINING_EXERCISE","direct_score_input":false},{"row":98,"status":"PASS_NHS_EPRR_WARNING_COOPERATION","source":"NHS EPRR core standards guidance","url":"https://www.england.nhs.uk/long-read/nhs-core-standards-for-emergency-preparedness-resilience-and-response-guidance/","verified":"Warning and informing, and inter-organisational cooperation, are separate core domains.","quality_score":"4","adoption":"EPRR_WARNING_COOPERATION","direct_score_input":false},{"row":99,"status":"PASS_WITH_NHS_EPRR_SELF_RATING_CAVEAT","source":"NHS England 2026/27 EPRR assurance","url":"https://www.england.nhs.uk/long-read/2026-27-eprr-annual-assurance-process/","verified":"The organisational rating begins with self-assessment and should not be treated as independent proof of live incident capability.","quality_score":"3","adoption":"EPRR_SELF_RATING_GUARD","direct_score_input":false},{"row":100,"status":"PASS_WITH_NHS_EPRR_NOT_PARCEL_SCORE","source":"NHS EPRR annual assurance","url":"https://www.england.nhs.uk/publication/emergency-preparedness-resilience-and-response-annual-assurance/","verified":"EPRR assurance describes organisational preparedness and does not measure parcel-level emergency-service safety.","quality_score":"3","ad