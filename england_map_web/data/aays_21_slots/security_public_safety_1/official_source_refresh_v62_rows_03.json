{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V62","part":3,"rows":[{"row":41,"status":"PASS_MCA_STABILITY_01","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"Insufficient stability is a major cause of fatal capsizing incidents on fishing vessels under 24 metres, especially vessels under 15 metres.","quality_score":"4","adoption":"MCA_STABILITY_01","direct_score_input":false},{"row":42,"status":"PASS_MCA_STABILITY_02","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"A high centre of gravity can make a vessel top-heavy and unstable.","quality_score":"4","adoption":"MCA_STABILITY_02","direct_score_input":false},{"row":43,"status":"PASS_MCA_STABILITY_03","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"Insufficient freeboard caused by overloading is a principal source of fishing-vessel instability.","quality_score":"4","adoption":"MCA_STABILITY_03","direct_score_input":false},{"row":44,"status":"PASS_MCA_STABILITY_04","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"Loose water or fish and lifting operations involving cranes or derricks can adversely affect stability.","quality_score":"4","adoption":"MCA_STABILITY_04","direct_score_input":false},{"row":45,"status":"PASS_MCA_STABILITY_05","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"Modifications to a vessel or changes in fishing method can alter the vessel's stability characteristics.","quality_score":"4","adoption":"MCA_STABILITY_05","direct_score_input":false},{"row":46,"status":"PASS_MCA_STABILITY_06","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"Safe operation depends on decisions made while fishing as well as the vessel's underlying stability characteristics.","quality_score":"4","adoption":"MCA_STABILITY_06","direct_score_input":false},{"row":47,"status":"PASS_MCA_STABILITY_07","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"Roll and heel tests can help owners and skippers assess whether a small fishing vessel is tender or stiff in a specified condition.","quality_score":"4","adoption":"MCA_STABILITY_07","direct_score_input":false},{"row":48,"status":"PASS_MCA_STABILITY_08","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/government/publications/the-code-of-practice-for-the-safety-of-small-fishing-vessels-of-less-than-15m-length-overall/the-code-of-practice-for-the-safety-of-small-fishing-vessels-of-less-than-15m-length-overall","verified":"Fishing-vessel stability information must be available onboard and instructions concerning stability must be followed by those on watch.","quality_score":"4","adoption":"MCA_STABILITY_08","direct_score_input":false},{"row":49,"status":"PASS_WITH_MCA_STABILITY_09","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/guidance/fishing-vessel-stability","verified":"Capsize risk depends on vessel design, loading, freeboard, centre of gravity, sea state, lifting, modifications and operational decisions.","quality_score":"3","adoption":"MCA_STABILITY_GUARD_09","direct_score_input":false},{"row":50,"status":"PASS_WITH_MCA_STABILITY_10","source":"MCA fishing-vessel stability","url":"https://www.gov.uk/government/publications/fishing-vessel-stability-guidance","verified":"MCA stability evidence is vessel-, load-, operation-, weather- and voyage-specific and is not an exact parcel-level capsize probability.","quality_score":"3","adoption":"MCA_STABILITY_GUARD_10","direct_score_input":false},{"row":51,"status":"PASS_MCA_LSA_01","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"All emergency life-saving equipment must be safe to use and crew must know how to use it properly.","quality_score":"4","adoption":"MCA_LSA_01","direct_score_input":false},{"row":52,"status":"PASS_MCA_LSA_02","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"Lifejackets must be inspected regularly in accordance with the manufacturer's instructions.","quality_score":"4","adoption":"MCA_LSA_02","direct_score_input":false},{"row":53,"status":"PASS_MCA_LSA_03","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"Immersion suits and lifejackets must be compatible with the intended life-saving arrangements.","quality_score":"4","adoption":"MCA_LSA_03","direct_score_input":false},{"row":54,"status":"PASS_MCA_LSA_04","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"Crews on vessels fitted with marine evacuation systems must be trained to operate those systems.","quality_score":"4","adoption":"MCA_LSA_04","direct_score_input":false},{"row":55,"status":"PASS_MCA_LSA_05","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"Onboard lifejackets must be suitable for safe use with the vessel's marine evacuation system.","quality_score":"4","adoption":"MCA_LSA_05","direct_score_input":false},{"row":56,"status":"PASS_MCA_LSA_06","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"Liferafts require suitable stowage and float-free hydrostatic-release arrangements.","quality_score":"4","adoption":"MCA_LSA_06","direct_score_input":false},{"row":57,"status":"PASS_MCA_LSA_07","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"Fuels and lubricating oils used in emergency lifeboat engines must remain safe to use at low temperatures.","quality_score":"4","adoption":"MCA_LSA_07","direct_score_input":false},{"row":58,"status":"PASS_MCA_LSA_08","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"Retro-reflective material on life-saving appliances must be checked at regular intervals to confirm effectiveness.","quality_score":"4","adoption":"MCA_LSA_08","direct_score_input":false},{"row":59,"status":"PASS_WITH_MCA_LSA_09","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/guidance/fishing-vessel-lifesaving-appliances-and-safety-equipment","verified":"Life-saving performance depends on vessel type, equipment specification, inspection, stowage, compatibility, training, weather and casualty condition.","quality_score":"3","adoption":"MCA_LSA_GUARD_09","direct_score_input":false},{"row":60,"status":"PASS_WITH_MCA_LSA_10","source":"MCA life-saving equipment safety","url":"https://www.gov.uk/emergency-and-lifesaving-equipment-on-ships/safe-use-of-emergency-equipment","verified":"MCA life-saving evidence is vessel-, equipment-, crew-, environment- and incident-specific and is not an exact parcel-level survival probability.","quality_score":"3","adoption":"MCA_LSA_GUARD_10","direct_score_input":false}]}