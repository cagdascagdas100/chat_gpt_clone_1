{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V57","part":3,"rows":[{"row":41,"status":"PASS_SURFACE_ENGINEERING_01","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Surface engineering includes electroplating, anodising and electropolishing processes.","quality_score":"4","adoption":"SURFACE_ENGINEERING_01","direct_score_input":false},{"row":42,"status":"PASS_SURFACE_ENGINEERING_02","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Electroless processes can deposit metals such as copper, nickel, gold and tin by chemical reduction.","quality_score":"4","adoption":"SURFACE_ENGINEERING_02","direct_score_input":false},{"row":43,"status":"PASS_SURFACE_ENGINEERING_03","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Liquid organic coatings may be solvent- or water-based and applied by dipping, flow coating, spraying or electrophoretic methods.","quality_score":"4","adoption":"SURFACE_ENGINEERING_03","direct_score_input":false},{"row":44,"status":"PASS_SURFACE_ENGINEERING_04","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Powder coatings are commonly applied by electrostatic spraying or fluidised-bed techniques.","quality_score":"4","adoption":"SURFACE_ENGINEERING_04","direct_score_input":false},{"row":45,"status":"PASS_SURFACE_ENGINEERING_05","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Surface engineering also includes heat treatment, galvanising, tinning, metal spraying and vitreous enamelling.","quality_score":"4","adoption":"SURFACE_ENGINEERING_05","direct_score_input":false},{"row":46,"status":"PASS_SURFACE_ENGINEERING_06","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Principal injury mechanisms include manual handling, being struck, slips and trips, harmful substances, falls and moving machinery.","quality_score":"4","adoption":"SURFACE_ENGINEERING_06","direct_score_input":false},{"row":47,"status":"PASS_SURFACE_ENGINEERING_07","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Important occupational-health risks include musculoskeletal injury, dermatitis, work-related asthma and vibration white finger.","quality_score":"4","adoption":"SURFACE_ENGINEERING_07","direct_score_input":false},{"row":48,"status":"PASS_SURFACE_ENGINEERING_08","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/Research/rrhtm/rr1184.htm","verified":"Electrolytic nickel-plating exposure can occur by inhalation, skin absorption, ingestion or combinations of these routes.","quality_score":"4","adoption":"SURFACE_ENGINEERING_08","direct_score_input":false},{"row":49,"status":"PASS_WITH_SURFACE_ENGINEERING_09","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/surfaceengineering/surfaceengineering.htm","verified":"Surface-engineering risk depends on process chemistry, bath or coating type, temperature, machine energy, ventilation, access and maintenance.","quality_score":"3","adoption":"SURFACE_ENGINEERING_GUARD_09","direct_score_input":false},{"row":50,"status":"PASS_WITH_SURFACE_ENGINEERING_10","source":"HSE surface-engineering safety","url":"https://www.hse.gov.uk/Research/rrhtm/rr1184.htm","verified":"Surface-engineering evidence is process-, chemical-, machine-, task- and worker-specific and is not an exact parcel-level incident probability.","quality_score":"3","adoption":"SURFACE_ENGINEERING_GUARD_10","direct_score_input":false},{"row":51,"status":"PASS_POWDER_COATING_01","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Uncured powder-coating products can present health, safety and environmental hazards.","quality_score":"4","adoption":"POWDER_COATING_01","direct_score_input":false},{"row":52,"status":"PASS_POWDER_COATING_02","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Exposure occurs principally through direct skin contact and inhalation of airborne powder.","quality_score":"4","adoption":"POWDER_COATING_02","direct_score_input":false},{"row":53,"status":"PASS_POWDER_COATING_03","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Significant exposure can cause occupational asthma, skin irritation and skin sensitisation.","quality_score":"4","adoption":"POWDER_COATING_03","direct_score_input":false},{"row":54,"status":"PASS_POWDER_COATING_04","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Some powders contain especially hazardous agents including TGIC, TMA and lead-chromate pigments.","quality_score":"4","adoption":"POWDER_COATING_04","direct_score_input":false},{"row":55,"status":"PASS_POWDER_COATING_05","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Safety data sheets identify harmful ingredients and the risk-management measures supplied with the product.","quality_score":"4","adoption":"POWDER_COATING_05","direct_score_input":false},{"row":56,"status":"PASS_POWDER_COATING_06","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"High-exposure tasks include poorly ventilated spraying, leaning into booths, powder transfer, maintenance and cleaning.","quality_score":"4","adoption":"POWDER_COATING_06","direct_score_input":false},{"row":57,"status":"PASS_POWDER_COATING_07","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Controls include enclosure, effective ventilation, planned storage and disposal, cleanable workplaces, welfare facilities and suitable PPE.","quality_score":"4","adoption":"POWDER_COATING_07","direct_score_input":false},{"row":58,"status":"PASS_POWDER_COATING_08","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Control measures, ventilation, work practices, PPE and training should be checked and reviewed regularly.","quality_score":"4","adoption":"POWDER_COATING_08","direct_score_input":false},{"row":59,"status":"PASS_WITH_POWDER_COATING_09","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Powder-coating risk depends on formulation, particle size, booth airflow, spraying method, transfer and cleaning tasks, maintenance and PPE.","quality_score":"3","adoption":"POWDER_COATING_GUARD_09","direct_score_input":false},{"row":60,"status":"PASS_WITH_POWDER_COATING_10","source":"HSE powder-coating controls","url":"https://www.hse.gov.uk/surfaceengineering/reducing-risks-using-coating-powders-employers.htm","verified":"Powder-coating evidence is product-, booth-, task-, exposure- and worker-specific and is not an exact parcel-level health probability.","quality_score":"3","adoption":"POWDER_COATING_GUARD_10","direct_score_input":false}]}