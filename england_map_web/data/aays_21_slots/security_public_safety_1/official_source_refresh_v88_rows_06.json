{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V88","part":6,"rows":[{"row":101,"status":"PASS_FLOOD_WARN_01","source":"Environment Agency flood-warning safety","url":"https://www.gov.uk/guidance/flood-alerts-and-warnings-what-they-are-and-what-to-do","verified":"The Environment Agency uses flood alerts, flood warnings and severe flood warnings in England.","quality_score":"4","adoption":"FLOOD_WARN_01","direct_score_input":false},{"row":102,"status":"PASS_FLOOD_WARN_02","source":"Environment Agency flood-warning safety","url":"https://www.gov.uk/government/publications/get-flood-warnings","verified":"A flood alert means flooding is possible and people should prepare.","quality_score":"4","adoption":"FLOOD_WARN_02","direct_score_input":false},{"row":103,"status":"PASS_FLOOD_WARN_03","source":"Environment Agency flood-warning safety","url":"https://www.gov.uk/guidance/flood-alerts-and-warnings-what-they-are-and-what-to-do","verified":"A flood warning means flooding is expected and protective action should be taken.","quality_score":"4","adoption":"FLOOD_WARN_03","direct_score_input":false},{"row":104,"status":"PASS_FLOOD_WARN_04","source":"Environment Agency flood-warning safety","url":"https://www.gov.uk/government/publications/get-flood-warnings","verified":"A severe flood warning indicates possible danger to life and significant community disruption.","quality_score":"4","adoption":"FLOOD_WARN_04","direct_score_input":false},{"row":105,"status":"PASS_FLOOD_WARN_05","source":"Environment Agency flood-warning safety","url":"https://www.gov.uk/guidance/flood-alerts-and-warnings-what-they-are-and-what-to-do","verified":"People can check the five-day flood outlook and register for warnings by phone, text or email.","quality_score":"4","adoption":"FLOOD_WARN_05","direct_score_input":false},{"row":106,"status":"PASS_FLOOD_WARN_06","source":"Environment Agency flood-warning safety","url":"https://www.gov.uk/government/publications/get-flood-warnings","v