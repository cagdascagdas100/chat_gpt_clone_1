{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V25","part":5,"rows":[{"row":91,"status":"PASS_ICO_BREACH_DEFINITION","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"A personal data breach is a security breach causing accidental or unlawful destruction, loss, alteration, unauthorised disclosure of or access to personal data.","quality_score":"4","adoption":"PERSONAL_DATA_BREACH_DEFINITION","direct_score_input":false},{"row":92,"status":"PASS_ICO_CIA_SCOPE","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"A personal data breach can affect confidentiality, integrity or availability of personal data.","quality_score":"4","adoption":"DATA_CIA_BREACH_SCOPE","direct_score_input":false},{"row":93,"status":"PASS_ICO_ACCIDENTAL_DELIBERATE_CAUSES","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"Personal data breaches include both accidental and deliberate causes.","quality_score":"4","adoption":"ACCIDENTAL_AND_DELIBERATE_CAUSES","direct_score_input":false},{"row":94,"status":"PASS_ICO_UNAUTHORISED_ACCESS_EXAMPLE","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"Unauthorised third-party access is an example of a personal data breach.","quality_score":"4","adoption":"UNAUTHORISED_ACCESS_EXAMPLE","direct_score_input":false},{"row":95,"status":"PASS_ICO_WRONG_RECIPIENT_EXAMPLE","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"Sending personal data to the wrong recipient is a breach example.","quality_score":"4","adoption":"WRONG_RECIPIENT_EXAMPLE","direct_score_input":false},{"row":96,"status":"PASS_ICO_LOST_DEVICE_EXAMPLE","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"Loss or theft of a device containing personal data can constitute a breach.","quality_score":"4","adoption":"LOST_DEVICE_EXAMPLE","direct_score_input":false},{"row":97,"status":"PASS_ICO_UNAUTHORISED_ALTERATION","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"Alteration of personal data without permission is included in the breach definition.","quality_score":"4","adoption":"UNAUTHORISED_ALTERATION_EXAMPLE","direct_score_input":false},{"row":98,"status":"PASS_ICO_AVAILABILITY_BREACH","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"Loss of data availability can be a breach where unavailability has a significant negative effect on individuals.","quality_score":"4","adoption":"DATA_AVAILABILITY_BREACH","direct_score_input":false},{"row":99,"status":"PASS_ICO_72_HOUR_DUTY","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"A notifiable personal data breach must be reported without undue delay and within 72 hours of awareness where feasible.","quality_score":"4","adoption":"GDPR_72_HOUR_REPORTING","direct_score_input":false},{"row":100,"status":"PASS_ICO_AWARENESS_CLOCK","source":"ICO first 72 hours guidance","url":"https://ico.org.uk/for-organisations/advice-for-small-organisations/personal-data-breaches/72-hours-how-to-respond-to-a-personal-data-breach/","verified":"The reporting clock starts when the organisation becomes aware of the breach, not when the underlying event occurred.","quality_score":"4","adoption":"BREACH_AWARENESS_CLOCK","direct_score_input":false},{"row":101,"status":"PASS_ICO_DELAY_REASON","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"A report submitted after 72 hours must explain the delay.","quality_score":"4","adoption":"LATE_REPORT_REASON","direct_score_input":false},{"row":102,"status":"PASS_ICO_HIGH_RISK_INDIVIDUAL_NOTICE","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"If a breach is likely to create a high risk to individuals' rights and freedoms, affected people must be informed without undue delay.","quality_score":"4","adoption":"HIGH_RISK_INDIVIDUAL_NOTIFICATION","direct_score_input":false},{"row":103,"status":"PASS_ICO_ALL_BREACH_RECORDS","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?q=r","verified":"Organisations must keep records of personal data breaches even when notification is not required.","quality_score":"4","adoption":"ALL_BREACH_RECORDING","direct_score_input":false},{"row":104,"status":"PASS_ICO_RESPONSE_PROCEDURES","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?q=r","verified":"Robust breach detection, investigation and internal reporting procedures are required to support notification decisions.","quality_score":"4","adoption":"BREACH_RESPONSE_PROCEDURE","direct_score_input":false},{"row":105,"status":"PASS_ICO_REPORT_EARLY_UPDATE_LATER","source":"ICO UK GDPR breach reporting","url":"https://ico.org.uk/pdb","verified":"ICO guidance emphasises reporting early and updating later when all facts are not yet available.","quality_score":"4","adoption":"EARLY_REPORT_LATER_UPDATE","direct_score_input":false},{"row":106,"status":"PASS_ICO_REPORT_NATURE_AND_SCALE","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"A notification should describe the breach nature and, where possible, the categories and approximate numbers of people and records affected.","quality_score":"4","adoption":"BREACH_NATURE_SCALE_SCHEMA","direct_score_input":false},{"row":107,"status":"PASS_ICO_REPORT_CONTACT_POINT","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"The notification must provide data-protection-officer or other contact details for further information.","quality_score":"4","adoption":"BREACH_CONTACT_SCHEMA","direct_score_input":false},{"row":108,"status":"PASS_ICO_REPORT_CONSEQUENCES","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"The likely consequences of the breach must be described.","quality_score":"4","adoption":"BREACH_CONSEQUENCE_SCHEMA","direct_score_input":false},{"row":109,"status":"PASS_ICO_REPORT_MITIGATION","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"The report must describe measures taken or proposed to address and mitigate the breach.","quality_score":"4","adoption":"BREACH_MITIGATION_SCHEMA","direct_score_input":false},{"row":110,"status":"PASS_ICO_PROCESSOR_CONTRACT","source":"ICO personal data breach guide","url":"https://ico.org.uk/for-organisations/report-a-breach/personal-data-breach/personal-data-breaches-a-guide/?reg=uk","verified":"Controller-processor contracts should specify breach-reporting requirements.","quality_score":"4","adoption":"PROCESSOR_BREACH_CONTRACT","direct_score_input":false},{"row":111,"status":"PASS_ICO_NIS_GDPR_SEPARATION","source":"ICO NIS incident reporting","url":"https://ico.org.uk/for-organisations/the-guide-to-nis/incident-reporting/","verified":"A NIS incident and a UK GDPR personal data breach are separate concepts and may require separate assessments.","quality_score":"4","adoption":"NIS_GDPR_SEPARATION","direct_score_input":false},{"row":112,"status":"PASS_WITH_ICO_NIS_SECTOR_THRESHOLD","source":"ICO NIS incident reporting","url":"https://ico.org.uk/for-organisations/the-guide-to-nis/incident-reporting/","verified":"NIS notification applies to relevant digital service providers when an incident substantially affects service provision, so applicability is sector and threshold specific.","quality_score":"3","adoption":"NIS_APPLICABILITY_GUARD","direct_score_input":false},{"row":113,"status":"PASS_ICO_NIS_72_HOURS","source":"ICO NIS incident reporting","url":"https://ico.org.uk/for-organisations/the-guide-to-nis/incident-reporting/","verified":"A reportable NIS incident must be notified without undue delay and not later than 72 hours where feasible.","quality_score":"4","adoption":"NIS_72_HOUR_REPORTING","direct_score_input":false},{"row":114,"status":"PASS_WITH_ICO_NIS_IMPACT_FACTORS","source":"ICO NIS incident reporting","url":"https://ico.org.uk/for-organisations/the-guide-to-nis/incident-reporting/","verified":"NIS assessment considers affected users, duration, geographical spread, disruption and impact; numerical thresholds are specific to the regulated service context.","quality_score":"3","adoption":"NIS_IMPACT_THRESHOLD_GUARD","direct_score_input":false},{"row":115,"status":"PASS_WITH_ICO_GUIDANCE_REVIEW","source":"ICO security and breach guidance","url":"https://ico.org.uk/for-organisations/uk-gdpr-guidance-and-resources/security/","verified":"ICO marks parts of its guidance as under review following the Data (Use and Access) Act, so current legal updates must be rechecked before operational use.","quality_score":"3","adoption":"CURRENT_GUIDANCE_RECHECK","direct_score_input":false}]}