{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V125","part":4,"row_range":[61,80],"rows":[{"row":61,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/index.htm","verified":"Employers must manage health and safety risks before people work alone.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":62,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/index.htm","verified":"Lone-working duties apply to contracted workers, including self-employed people working for the employer.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":63,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/manage-the-risks-of-working-alone.htm","verified":"Lone workers must be trained, supervised and monitored, with systems to keep in touch and respond to incidents.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":64,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/manage-the-risks-of-working-alone.htm","verified":"Where a lone worker operates at another employer's workplace, relevant risks and controls should be obtained from that employer.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":65,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/manage-the-risks-of-working-alone.htm","verified":"Risk assessment should consider violence, stress, medical suitability and isolated or rural workplaces.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":66,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/manage-the-risks-of-working-alone.htm","verified":"Some high-risk work, including specified confined-space, live-electrical, diving, explosives-vehicle and fumigation work, requires another person.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":67,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/training-supervision-monitoring.htm","verified":"The level of supervision should be based on risk and the worker's ability to identify and manage health and safety issues.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":68,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/training-supervision-monitoring.htm","verified":"Monitoring systems and emergency procedures should be tested regularly so lone workers can be contacted when a problem is identified.","quality_score":"4","adoption":"HSE_LONE_WORKING_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":69,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/index.htm","verified":"Lone-working risk depends on the task, location, communications, supervision, competence, health, violence potential, travel and rescue arrangements.","quality_score":"3","adoption":"HSE_LONE_WORKING_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":70,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE lone-working risk-management guidance","family_id":"HSE_LONE_WORKING","url":"https://www.hse.gov.uk/lone-working/employer/index.htm","verified":"General lone-working guidance does not prove that a specific worker is adequately protected or quantify an exact parcel-level incident probability.","quality_score":"3","adoption":"HSE_LONE_WORKING_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":71,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/index.htm","verified":"Employers must ensure employees receive immediate help if they become ill or are injured at work.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":72,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/index.htm","verified":"First-aid duties apply to every workplace and to self-employed people.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":73,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/index.htm","verified":"A suitably stocked first-aid kit must be available.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_03","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":74,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/index.htm","verified":"An appointed person or people must take charge of first-aid arrangements.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_04","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":75,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/index.htm","verified":"Employees must be informed about the first-aid arrangements.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_05","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":76,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/assess-business-need.htm","verified":"First-aid needs assessment should consider work type, hazards, workforce size, work patterns, absences and accident history.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_06","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":77,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/assess-business-need.htm","verified":"Assessment may also consider travelling, remote and lone workers, distance to emergency services, shared sites and non-employees.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_07","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":78,"status":"PASS_OFFICIAL_PRIMARY","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/assess-business-need.htm","verified":"What is adequate and appropriate depends on the nature of the work and where it is carried out.","quality_score":"4","adoption":"HSE_FIRST_AID_AT_WORK_REFERENCE_08","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":79,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/index.htm","verified":"First-aid requirements depend on hazards, workforce size, shifts, geography, emergency-service access, vulnerable people and foreseeable injuries or illness.","quality_score":"3","adoption":"HSE_FIRST_AID_AT_WORK_SCOPE_GUARD_01","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"},{"row":80,"status":"PASS_WITH_SCOPE_CAVEAT","source":"HSE first-aid-at-work guidance","family_id":"HSE_FIRST_AID_AT_WORK","url":"https://www.hse.gov.uk/simple-health-safety/firstaid/index.htm","verified":"General first-aid guidance does not prove that a specific workplace has adequate current supplies, trained coverage or response performance.","quality_score":"3","adoption":"HSE_FIRST_AID_AT_WORK_SCOPE_GUARD_02","direct_score_input":false,"checked_at":"2026-07-30T10:53:00Z"}]}