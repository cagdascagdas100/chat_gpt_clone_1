{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V25","part":1,"rows":[{"row":1,"status":"PASS_OFCOM_EMERGENCY_ACCESS_DUTY","source":"Ofcom emergency-call compliance programme","url":"https://www.ofcom.org.uk/phones-and-broadband/telecoms-infrastructure/compliance-programme-into-access-to-emergency-services","verified":"Regulated voice providers must take all necessary measures to ensure uninterrupted access to emergency organisations.","quality_score":"4","adoption":"EMERGENCY_ACCESS_DUTY","direct_score_input":false},{"row":2,"status":"PASS_OFCOM_999_112_LOCATION","source":"Ofcom emergency-call compliance programme","url":"https://www.ofcom.org.uk/phones-and-broadband/telecoms-infrastructure/compliance-programme-into-access-to-emergency-services","verified":"Providers must make accurate and reliable caller-location information available for 999 and 112 calls where technically feasible.","quality_score":"4","adoption":"CALLER_LOCATION_DUTY","direct_score_input":false},{"row":3,"status":"PASS_OFCOM_LOCATION_AT_ANSWER","source":"Ofcom General Conditions investigation","url":"https://www.ofcom.org.uk/phones-and-broadband/telecoms-infrastructure/investigation-into-gigaclear-limiteds-compliance-with-general-conditions-a3.5-and-a3.6a","verified":"Caller-location information must be available when the emergency organisation answers the call.","quality_score":"4","adoption":"LOCATION_AT_CALL_ANSWER","direct_score_input":false},{"row":4,"status":"PASS_OFCOM_LOCATION_NO_CHARGE","source":"Ofcom General Conditions investigation","url":"https://www.ofcom.org.uk/phones-and-broadband/telecoms-infrastructure/investigation-into-gigaclear-limiteds-compliance-with-general-conditions-a3.5-and-a3.6a","verified":"Emergency caller-location information must be supplied without charge to callers or emergency organisations.","quality_score":"4","adoption":"NO_CHARGE_LOCATION_DATA","direct_score_input":false},{"row":5,"status":"PASS_OFCOM_PROGRAMME_CURRENT_CLOSE","source":"Of