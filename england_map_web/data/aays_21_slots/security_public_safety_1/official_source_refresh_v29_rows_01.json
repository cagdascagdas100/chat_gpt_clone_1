{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V29","part":1,"rows":[{"row":1,"status":"PASS_LOLER_DUTYHOLDER_SCOPE","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"LOLER applies to people and companies that own, operate or control lifting equipment.","quality_score":"4","adoption":"LOLER_DUTYHOLDER_SCOPE","direct_score_input":false},{"row":2,"status":"PASS_LOLER_EMPLOYEE_USE_SCOPE","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Businesses are within scope where employees use lifting equipment even when the business does not own it.","quality_score":"4","adoption":"LOLER_EMPLOYEE_USE_SCOPE","direct_score_input":false},{"row":3,"status":"PASS_LOLER_PUWER_LINK","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Most lifting equipment is also work equipment, so PUWER inspection and maintenance duties normally apply alongside LOLER.","quality_score":"4","adoption":"LOLER_PUWER_LINK","direct_score_input":false},{"row":4,"status":"PASS_LOLER_COMPETENT_PLANNING","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Every lifting operation involving lifting equipment must be properly planned by a competent person.","quality_score":"4","adoption":"COMPETENT_LIFT_PLANNING","direct_score_input":false},{"row":5,"status":"PASS_LOLER_APPROPRIATE_SUPERVISION","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm","verified":"Lifting operations must be supervised at a level appropriate to their risk and complexity.","quality_score":"4","adoption":"APPROPRIATE_LIFT_SUPERVISION","direct_score_input":false},{"row":6,"status":"PASS_LOLER_SAFE_EXECUTION","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"The lift must be carried out in a safe manner in accordance with the plan and controls.","quality_score":"4","adoption":"SAFE_LIFT_EXECUTION","direct_score_input":false},{"row":7,"status":"PASS_LOLER_FIT_FOR_PURPOSE","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Lifting equipment must be fit for purpose.","quality_score":"4","adoption":"LIFTING_EQUIPMENT_FITNESS","direct_score_input":false},{"row":8,"status":"PASS_LOLER_TASK_APPROPRIATE","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"The selected lifting equipment must be appropriate for the task.","quality_score":"4","adoption":"TASK_APPROPRIATE_LIFTING","direct_score_input":false},{"row":9,"status":"PASS_LOLER_MARKING","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Lifting equipment must be suitably marked, including safe working information where relevant.","quality_score":"4","adoption":"LIFTING_EQUIPMENT_MARKING","direct_score_input":false},{"row":10,"status":"PASS_LOLER_THOROUGH_EXAMINATION","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"Many items of lifting equipment require statutory periodic thorough examination.","quality_score":"4","adoption":"STATUTORY_THOROUGH_EXAM","direct_score_input":false},{"row":11,"status":"PASS_LOLER_EXAM_REPORT","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"A competent person completing a thorough examination must produce a written report.","quality_score":"4","adoption":"THOROUGH_EXAM_REPORT","direct_score_input":false},{"row":12,"status":"PASS_LOLER_EXAM_DATE_FIELDS","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"The written report records the examination date and when the next examination is due.","quality_score":"4","adoption":"EXAMINATION_DATE_SCHEMA","direct_score_input":false},{"row":13,"status":"PASS_LOLER_DEFECT_FIELDS","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"The report must identify defects that are or could become dangerous to people.","quality_score":"4","adoption":"LIFT_DEFECT_SCHEMA","direct_score_input":false},{"row":14,"status":"PASS_LOLER_SERIOUS_DEFECT_IMMEDIATE_NOTICE","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Serious defects must be reported immediately to the dutyholder, followed by written reporting.","quality_score":"4","adoption":"SERIOUS_DEFECT_IMMEDIATE_NOTICE","direct_score_input":false},{"row":15,"status":"PASS_LOLER_ENFORCER_DEFECT_COPY","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"A copy of a serious-defect report must also be sent to the relevant enforcing authority.","quality_score":"4","adoption":"LOLER_ENFORCER_REPORTING","direct_score_input":false},{"row":16,"status":"PASS_LOLER_FIRST_USE_EXAM","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Equipment may require thorough examination before first use unless the stated declaration and assembly conditions are satisfied.","quality_score":"4","adoption":"FIRST_USE_EXAM_GATE","direct_score_input":false},{"row":17,"status":"PASS_LOLER_POST_ASSEMBLY_EXAM","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Equipment requiring assembly or installation must be examined after assembly and before use at each location.","quality_score":"4","adoption":"POST_ASSEMBLY_EXAM","direct_score_input":false},{"row":18,"status":"PASS_LOLER_EXCEPTIONAL_EVENT_EXAM","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Damage, long disuse or major safety-critical modification can trigger an additional thorough examination.","quality_score":"4","adoption":"EXCEPTIONAL_EVENT_EXAM","direct_score_input":false},{"row":19,"status":"PASS_LOLER_SIX_MONTH_PEOPLE","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Equipment and accessories used to lift people are normally thoroughly examined every six months unless an examination scheme specifies otherwise.","quality_score":"4","adoption":"SIX_MONTH_PEOPLE_EXAM","direct_score_input":false},{"row":20,"status":"PASS_LOLER_SIX_MONTH_ACCESSORIES","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Lifting accessories are normally thoroughly examined every six months unless an examination scheme specifies otherwise.","quality_score":"4","adoption":"SIX_MONTH_ACCESSORY_EXAM","direct_score_input":false},{"row":21,"status":"PASS_WITH_LOLER_TWELVE_MONTH_OTHER","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/thorough-examinations-lifting-equipment.htm","verified":"Other lifting equipment is normally examined every twelve months, but a competent-person examination scheme may set different intervals.","quality_score":"3","adoption":"LOLER_INTERVAL_SCHEME_GUARD","direct_score_input":false},{"row":22,"status":"PASS_WITH_LOLER_CONTEXT_NOT_PARCEL","source":"HSE LOLER guidance","url":"https://www.hse.gov.uk/work-equipment-machinery/loler-overview.htm","verified":"LOLER controls work equipment and lifting operations; it does not provide a universal parcel-level safety probability.","quality_score":"3","adoption":"LOLER_CONTEXT_ONLY","direct_score_input":false}]}