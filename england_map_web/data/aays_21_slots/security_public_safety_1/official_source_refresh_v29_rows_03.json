{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V29","part":3,"rows":[{"row":45,"status":"PASS_PSSR_STORED_ENERGY_AIM","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/books/l122.htm","verified":"PSSR aims to prevent serious injury from stored pressure energy released by failure of a pressure system or component.","quality_score":"4","adoption":"PSSR_STORED_ENERGY_AIM","direct_score_input":false},{"row":46,"status":"PASS_PSSR_WORK_SYSTEM_SCOPE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/books/l122.htm","verified":"The regulations cover pressure systems used at work.","quality_score":"4","adoption":"PSSR_WORK_SYSTEM_SCOPE","direct_score_input":false},{"row":47,"status":"PASS_PSSR_DUTYHOLDER_GROUPS","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/books/l122.htm","verified":"Users, owners, competent persons, designers, manufacturers, importers, suppliers and installers can hold duties under PSSR.","quality_score":"4","adoption":"PSSR_DUTYHOLDER_GROUPS","direct_score_input":false},{"row":48,"status":"PASS_PSSR_SAFE_DESIGN_USE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/books/l122.htm","verified":"PSSR addresses both safe design and safe use of pressure systems.","quality_score":"4","adoption":"PSSR_DESIGN_USE","direct_score_input":false},{"row":49,"status":"PASS_PSSR_SAFE_OPERATING_LIMITS","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"Owners and users must know and document the safe operating limits of their pressure systems.","quality_score":"4","adoption":"PRESSURE_SAFE_LIMITS","direct_score_input":false},{"row":50,"status":"PASS_PSSR_WRITTEN_SCHEME_BEFORE_USE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"A suitable written scheme of examination must be in place before the relevant system is operated.","quality_score":"4","adoption":"PSSR_WRITTEN_SCHEME","direct_score_input":false},{"row":51,"status":"PASS_PSSR_EXAM_TO_SCHEME","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"The pressure system must actually be examined in accordance with the written scheme.","quality_score":"4","adoption":"PSSR_SCHEME_EXAMINATION","direct_score_input":false},{"row":52,"status":"PASS_PSSR_COMPETENT_PERSON_ROLE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/books/l122.htm","verified":"A competent person determines or certifies the examination scheme and examination requirements.","quality_score":"4","adoption":"PSSR_COMPETENT_PERSON","direct_score_input":false},{"row":53,"status":"PASS_PSSR_SYSTEM_BOUNDARY","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"The scheme should define the pressure system and safety-critical parts covered.","quality_score":"4","adoption":"PSSR_SYSTEM_BOUNDARY","direct_score_input":false},{"row":54,"status":"PASS_PSSR_EXAM_NATURE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"The written scheme identifies the nature of examinations required.","quality_score":"4","adoption":"PSSR_EXAM_NATURE","direct_score_input":false},{"row":55,"status":"PASS_PSSR_EXAM_FREQUENCY","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"The scheme identifies examination intervals or the basis for determining them.","quality_score":"4","adoption":"PSSR_EXAM_FREQUENCY","direct_score_input":false},{"row":56,"status":"PASS_PSSR_PREPARATION_REQUIREMENTS","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"The scheme can specify preparation and protective measures needed before examination.","quality_score":"4","adoption":"PSSR_EXAM_PREPARATION","direct_score_input":false},{"row":57,"status":"PASS_PSSR_REPORT_FINDINGS","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg178.htm","verified":"Examination findings and any defects affecting safety must be reported.","quality_score":"4","adoption":"PSSR_EXAM_REPORTING","direct_score_input":false},{"row":58,"status":"PASS_PSSR_REPAIR_BEFORE_REUSE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg261.htm","verified":"Dangerous defects require repair or other action before continued operation under unsafe conditions.","quality_score":"4","adoption":"PSSR_DEFECT_ACTION","direct_score_input":false},{"row":59,"status":"PASS_PSSR_OPERATING_INSTRUCTIONS","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg261.htm","verified":"Dutyholders should provide suitable operating instructions for safe system use.","quality_score":"4","adoption":"PSSR_OPERATING_INSTRUCTIONS","direct_score_input":false},{"row":60,"status":"PASS_PSSR_MAINTENANCE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg261.htm","verified":"Pressure systems must be properly maintained so they remain safe.","quality_score":"4","adoption":"PSSR_MAINTENANCE","direct_score_input":false},{"row":61,"status":"PASS_PSSR_EMERGENCY_RESPONSE","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg261.htm","verified":"Operators need arrangements for foreseeable pressure-system failures and emergencies.","quality_score":"4","adoption":"PSSR_EMERGENCY_ARRANGEMENTS","direct_score_input":false},{"row":62,"status":"PASS_PSSR_FAILURE_CONSEQUENCES","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg261.htm","verified":"Failure can kill or seriously injure people nearby and cause major property damage.","quality_score":"4","adoption":"PSSR_FAILURE_CONSEQUENCE","direct_score_input":false},{"row":63,"status":"PASS_WITH_PSSR_APPLICABILITY_DECISION","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/books/l122.htm","verified":"PSSR applicability depends on system contents, pressure and configuration and should be checked using the official decision approach.","quality_score":"3","adoption":"PSSR_APPLICABILITY_GUARD","direct_score_input":false},{"row":64,"status":"PASS_WITH_PSSR_PROPORTIONATE_SMALL_SYSTEM","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/books/l122.htm","verified":"The ACOP includes proportionate treatment for small pressure vessels, so identical controls are not inferred for every system.","quality_score":"3","adoption":"PSSR_PROPORTIONALITY_GUARD","direct_score_input":false},{"row":65,"status":"PASS_WITH_PSSR_CONTEXT_NOT_PARCEL","source":"HSE Pressure Systems Safety guidance","url":"https://www.hse.gov.uk/pubns/indg261.htm","verified":"Pressure-system duties depend on installed equipment and operation, not a universal land-parcel probability.","quality_score":"3","adoption":"PSSR_CONTEXT_ONLY","direct_score_input":false}]}