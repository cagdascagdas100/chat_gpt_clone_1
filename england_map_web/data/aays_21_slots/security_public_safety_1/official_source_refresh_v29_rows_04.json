{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V29","part":4,"rows":[{"row":66,"status":"PASS_DSEAR_FIRE_EXPLOSION_CORROSION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"DSEAR requires control of workplace safety risks from fire, explosion and substances corrosive to metals.","quality_score":"4","adoption":"DSEAR_CORE_SCOPE","direct_score_input":false},{"row":67,"status":"PASS_DSEAR_EMPLOYER_SELFEMPLOYED","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Duties apply to employers and relevant self-employed people.","quality_score":"4","adoption":"DSEAR_DUTYHOLDER_SCOPE","direct_score_input":false},{"row":68,"status":"PASS_DSEAR_PUBLIC_PROTECTION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Controls must also protect members of the public put at risk by work activity.","quality_score":"4","adoption":"DSEAR_PUBLIC_PROTECTION","direct_score_input":false},{"row":69,"status":"PASS_DSEAR_SOLVENTS_PAINTS","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Solvents, paints and varnishes can be dangerous substances within DSEAR.","quality_score":"4","adoption":"DSEAR_FLAMMABLE_LIQUID_SCOPE","direct_score_input":false},{"row":70,"status":"PASS_DSEAR_FLAMMABLE_GASES","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Flammable gases such as LPG are within the dangerous-substance scope.","quality_score":"4","adoption":"DSEAR_FLAMMABLE_GAS_SCOPE","direct_score_input":false},{"row":71,"status":"PASS_DSEAR_COMBUSTIBLE_DUST","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Dusts from machining, sanding and foodstuffs can create fire or explosion risks.","quality_score":"4","adoption":"DSEAR_DUST_SCOPE","direct_score_input":false},{"row":72,"status":"PASS_DSEAR_PRESSURISED_GASES","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Gases under pressure can fall within DSEAR risk assessment.","quality_score":"4","adoption":"DSEAR_PRESSURISED_GAS_SCOPE","direct_score_input":false},{"row":73,"status":"PASS_DSEAR_METAL_CORROSION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Substances corrosive to metal are included because they can weaken containment and create safety incidents.","quality_score":"4","adoption":"DSEAR_METAL_CORROSION_SCOPE","direct_score_input":false},{"row":74,"status":"PASS_DSEAR_INVENTORY","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employers must identify dangerous substances present or used at the workplace.","quality_score":"4","adoption":"DSEAR_SUBSTANCE_INVENTORY","direct_score_input":false},{"row":75,"status":"PASS_DSEAR_RISK_ASSESSMENT","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employers must assess the fire, explosion and corrosion risks created by those substances.","quality_score":"4","adoption":"DSEAR_RISK_ASSESSMENT","direct_score_input":false},{"row":76,"status":"PASS_DSEAR_ELIMINATION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Risks should be removed where possible.","quality_score":"4","adoption":"DSEAR_RISK_ELIMINATION","direct_score_input":false},{"row":77,"status":"PASS_DSEAR_CONTROL","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Where removal is not possible, suitable control measures must reduce the risk.","quality_score":"4","adoption":"DSEAR_RISK_CONTROL","direct_score_input":false},{"row":78,"status":"PASS_DSEAR_MITIGATION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Controls must reduce the effects of incidents involving dangerous substances.","quality_score":"4","adoption":"DSEAR_CONSEQUENCE_MITIGATION","direct_score_input":false},{"row":79,"status":"PASS_DSEAR_EMERGENCY_PLANS","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Plans and procedures must address accidents, incidents and emergencies.","quality_score":"4","adoption":"DSEAR_EMERGENCY_PLAN","direct_score_input":false},{"row":80,"status":"PASS_DSEAR_EMPLOYEE_INFORMATION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employees must receive information about dangerous substances and controls.","quality_score":"4","adoption":"DSEAR_EMPLOYEE_INFORMATION","direct_score_input":false},{"row":81,"status":"PASS_DSEAR_TRAINING","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Employees must be trained to control risks and respond to incidents.","quality_score":"4","adoption":"DSEAR_TRAINING","direct_score_input":false},{"row":82,"status":"PASS_DSEAR_HAZARDOUS_AREA_CLASSIFICATION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Areas where explosive atmospheres may occur must be identified and classified.","quality_score":"4","adoption":"DSEAR_AREA_CLASSIFICATION","direct_score_input":false},{"row":83,"status":"PASS_DSEAR_IGNITION_CONTROL","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Ignition sources and unprotected equipment must be controlled in classified areas.","quality_score":"4","adoption":"DSEAR_IGNITION_CONTROL","direct_score_input":false},{"row":84,"status":"PASS_WITH_DSEAR_SUBSTANCE_CLASSIFICATION","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"Whether a material is dangerous depends on its properties, form, quantity and use; labels alone are not a complete site assessment.","quality_score":"3","adoption":"DSEAR_CLASSIFICATION_GUARD","direct_score_input":false},{"row":85,"status":"PASS_WITH_DSEAR_SITE_ACTIVITY_SCOPE","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"DSEAR controls depend on actual workplace substances, processes and ventilation rather than generic land use.","quality_score":"3","adoption":"DSEAR_SITE_SCOPE_GUARD","direct_score_input":false},{"row":86,"status":"PASS_WITH_DSEAR_CONTEXT_NOT_PARCEL","source":"HSE DSEAR guidance","url":"https://www.hse.gov.uk/fireandexplosion/dsear.htm","verified":"DSEAR evidence is not converted into a universal parcel-level explosion or fire probability.","quality_score":"3","adoption":"DSEAR_CONTEXT_ONLY","direct_score_input":false}]}