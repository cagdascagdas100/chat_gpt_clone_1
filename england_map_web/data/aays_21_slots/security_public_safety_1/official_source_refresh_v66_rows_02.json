{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V66","part":2,"rows":[{"row":21,"status":"PASS_CAMPY_01","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Campylobacter is the leading cause of bacterial food poisoning in the UK.","quality_score":"4","adoption":"CAMPY_01","direct_score_input":false},{"row":22,"status":"PASS_CAMPY_02","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Most people recover fully from Campylobacter food poisoning within about a week.","quality_score":"4","adoption":"CAMPY_02","direct_score_input":false},{"row":23,"status":"PASS_CAMPY_03","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Campylobacter can cause serious illness and, although rarely, can be fatal; severe symptoms are more likely in vulnerable groups.","quality_score":"4","adoption":"CAMPY_03","direct_score_input":false},{"row":24,"status":"PASS_CAMPY_04","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Common sources include undercooked poultry or red meat and unpasteurised milk.","quality_score":"4","adoption":"CAMPY_04","direct_score_input":false},{"row":25,"status":"PASS_CAMPY_05","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Some infections arise through animal faeces or contaminated water.","quality_score":"4","adoption":"CAMPY_05","direct_score_input":false},{"row":26,"status":"PASS_CAMPY_06","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Washing raw chicken can spread Campylobacter to hands, surfaces, clothing and equipment.","quality_score":"4","adoption":"CAMPY_06","direct_score_input":false},{"row":27,"status":"PASS_CAMPY_07","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Poultry should be cooked until steaming hot throughout, with no pink meat and clear juices.","quality_score":"4","adoption":"CAMPY_07","direct_score_input":false},{"row":28,"status":"PASS_CAMPY_08","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Risk reduction includes avoiding cross-contamination, chilling below 5°C, storing raw meat in leak-proof containers and regular hand washing.","quality_score":"4","adoption":"CAMPY_08","direct_score_input":false},{"row":29,"status":"PASS_WITH_CAMPY_09","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Campylobacter risk depends on food source, bacterial load, cooking, cross-contamination, water or animal exposure and host vulnerability.","quality_score":"3","adoption":"CAMPY_GUARD_09","direct_score_input":false},{"row":30,"status":"PASS_WITH_CAMPY_10","source":"FSA and UKHSA Campylobacter prevention","url":"https://www.gov.uk/government/publications/campylobacter/campylobacter","verified":"Campylobacter evidence is food-, animal-, water-, person- and time-specific and is not an exact parcel-level illness probability.","quality_score":"3","adoption":"CAMPY_GUARD_10","direct_score_input":false},{"row":31,"status":"PASS_STEC_01","source":"UKHSA STEC prevention and management","url":"https://www.gov.uk/government/publications/vero-cytotoxin-producing-escherichia-coli-symptoms-how-to-avoid-how-to-treat/vero-cytotoxin-producing-escherichia-coli-symptoms-how-to-avoid-how-to-treat","verified":"The most common STEC type in the UK is O157.","quality_score":"4","adoption":"STEC_01","direct_scor