ov.uk/government/publications/vero-cytotoxin-producing-escherichia-coli-symptoms-how-to-avoid-how-to-treat/vero-cytotoxin-producing-escherichia-coli-symptoms-how-to-avoid-how-to-treat","verified":"Direct or indirect contact with infected animals or animal faeces can transmit STEC.","quality_score":"4","adoption":"STEC_06","direct_score_input":false},{"row":37,"status":"PASS_STEC_07","source":"UKHSA STEC prevention and management","url":"https://www.gov.uk/government/publications/vero-cytotoxin-producing-escherichia-coli-symptoms-how-to-avoid-how-to-treat/vero-cytotoxin-producing-escherichia-coli-symptoms-how-to-avoid-how-to-treat","verified":"Person-to-person spread can occur through inadequate hand hygiene, particularly in households and childcare settings.","quality_score":"4","adoption":"STEC_07","direct_score_input":false},{"row":38,"status":"PASS_STEC_08","source":"UKHSA STEC prevention and management","url":"https://www.gov.uk/guidance/shiga-toxin-producing-escherichia-coli-stec-diagnosis-and-notification","verified":"Clinicians should recognise STEC and HUS promptly and follow statutory notification requirements.","quality_score":"4","adoption":"STEC_08","direct_score_input":false},{"row":39,"status":"PASS_WITH_STEC_09","source":"UKHSA STEC prevention and management","url":"https://www.gov.uk/guidance/shiga-toxin-producing-escherichia-coli-stec-diagnosis-and-notification","verified":"STEC risk depends on strain, infectious dose, food or animal source, hygiene, setting, age and clinical vulnerability.","quality_score":"3","adoption":"STEC_GUARD_09","direct_score_input":false},{"row":40,"status":"PASS_WITH_STEC_10","source":"UKHSA STEC prevention and management","url":"https://www.gov.uk/guidance/shiga-toxin-producing-escherichia-coli-stec-diagnosis-and-notification","verified":"STEC evidence is strain-, exposure-, case-, setting- and time-specific and is not an exact parcel-level infection probability.","quality_score":"3","adoption":"STEC_GUARD_10","direct_score_input":false}]}