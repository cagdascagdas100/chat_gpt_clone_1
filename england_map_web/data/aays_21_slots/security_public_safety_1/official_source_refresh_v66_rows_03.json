score_input":false},{"row":57,"status":"PASS_DIPHTHERIA_07","source":"UKHSA diphtheria control","url":"https://www.gov.uk/guidance/diphtheria-migrant-health-guide","verified":"Immunisation and infection-prevention controls are the most important preventive measures.","quality_score":"4","adoption":"DIPHTHERIA_07","direct_score_input":false},{"row":58,"status":"PASS_DIPHTHERIA_08","source":"UKHSA diphtheria control","url":"https://www.gov.uk/guidance/diphtheria-migrant-health-guide","verified":"People with uncertain or incomplete immunisation status should be brought up to date with the UK schedule.","quality_score":"4","adoption":"DIPHTHERIA_08","direct_score_input":false},{"row":59,"status":"PASS_WITH_DIPHTHERIA_09","source":"UKHSA diphtheria control","url":"https://www.gov.uk/guidance/diphtheria-migrant-health-guide","verified":"Diphtheria risk depends on toxigenic strain, respiratory or skin presentation, contact intensity, immunity, setting and response timing.","quality_score":"3","adoption":"DIPHTHERIA_GUARD_09","direct_score_input":false},{"row":60,"status":"PASS_WITH_DIPHTHERIA_10","source":"UKHSA diphtheria control","url":"https://www.gov.uk/guidance/diphtheria-migrant-health-guide","verified":"Diphtheria evidence is case-, contact-, strain-, setting- and time-specific and is not an exact parcel-level infection probability.","quality_score":"3","adoption":"DIPHTHERIA_GUARD_10","direct_score_input":false}]}