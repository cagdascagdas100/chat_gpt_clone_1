{"schema_version":1,"slot_id":"security_public_safety_1","batch":"V66","part":3,"rows":[{"row":41,"status":"PASS_BOTULISM_01","source":"UKHSA and FSA botulism controls","url":"https://www.gov.uk/government/publications/botulism-clinical-and-public-health-management/botulism-clinical-and-public-health-management","verified":"Botulism is a rare but potentially life-threatening syndrome caused by botulinum neurotoxin.","quality_score":"4","adoption":"BOTULISM_01","direct_score_input":false},{"row":42,"status":"PASS_BOTULISM_02","source":"UKHSA and FSA botulism controls","url":"https://www.gov.uk/government/publications/botulism-clinical-and-public-health-management/botulism-clinical-and-public-health-management","verified":"Clostridium botulinum spores occur naturally in soil, water and marine sediments.","quality_score":"4","adoption":"BOTULISM_02","direct_score_input":false},{"row":43,"status":"PASS_BOTULISM_03","source":"UKHSA and FSA botulism controls","url":"https://www.gov.uk/government/publications/botulism-clinical-and-public-health-management/botulism-clinical-and-public-health-management","verified":"Exposure can occur through ingestion, injection or bacterial wound infection.","quality_score":"4","adoption":"BOTULISM_03","direct_score_input":false},{"row":44,"status":"PASS_BOTULISM_04","source":"UKHSA and FSA botulism controls","url":"https://www.gov.uk/government/publications/botulism-clinical-and-public-health-management/botulism-clinical-and-public-health-management","verified":"Botulism characteristically causes bilateral, symmetrical descending flaccid paralysis.","quality_score":"4","adoption":"BOTULISM_04","direct_score_input":false},{"row":45,"status":"PASS_BOTULISM_05","source":"UKHSA and FSA botulism controls","url":"https://www.gov.uk/government/publications/botulism-clinical-and-public-health-management/botulism-clinical-and-public-health-management","verified":"The UKHSA Botulism Service supports clinical management and antitoxin delivery.","qua