rs":["HASHED_330_LOGICAL_RESULT_EXPORT_NOT_COMMITTED","CANONICAL_SINGLE_RUNNER_HEARTBEAT_STALE_OR_MISSING","CUSTOM_POINT_API_RESPONSES_NOT_CAPTURED_BY_CURRENT_WEB_SECURITY_LAYER"],"final_ready":false,"fake_data":false,"batches":[{"n":283,"s":"Enfield","t":"Enfield listed/local heritage exact-asset gate","c":"Listed and locally significant heritage assets are material planning evidence, but candidate impact requires exact asset/curtilage/location binding; borough-level heritage presence is not parcel evidence.","u":["https://www.enfield.gov.uk/services/planning/heritage/listed-buildings","https://www.enfield.gov.uk/services/planning/heritage","https://www.enfield.gov.uk/services/planning/heritage/conservation-areas","https://www.enfield.gov.uk/services/planning/local-plan-proposals-map"]},{"n":284,"s":"Enfield","t":"Enfield TPO geometry and consent gate","c":"Enfield publishes TPO map data in CSV, GeoJSON and GPKG. Candidate effect requires exact protected-tree/area geometry and current order status; nearby protected trees are not transferable.","u":["https://www.enfield.gov.uk/services/environment/tree-protection-and-planning","https://www.enfield.gov.uk/services/planning/heritage/conservation-areas","https://www.enfield.gov.uk/services/planning/local-plan-proposals-map","https://www.enfield.gov.uk/services/planning/how-to-make-a-planning-application"]},{"n":285,"s":"Enfield","t":"Enfield SFRA future-development risk gate","c":"Enfield Level 1/2 SFRAs support future-development decision making. Borough or growth-area flood evidence must be tied to the candidate location and current flood datasets before scoring.","u":["https://www.enfield.gov.uk/services/environment/flood-management","https://www.enfield.gov.uk/services/planning/evidence-base","https://www.enfield.gov.uk/__data/assets/pdf_file/0011/53102/Enfield-level-2-strategic-flood-risk-assessment-2023-Planning.pdf","https://www.enfield.gov.uk/services/planning/local-plan-proposals-map"]},{"n":286,"s":"Enfield","t":"Enfield AMR / 5-year housing-supply gate","c":"The AMR monitors policy implementation and five-year housing land supply at borough level. It informs growth context but does not make an individual parcel deliverable or allocated.","u":["https://www.enfield.gov.uk/services/planning/monitoring","https://www.enfield.gov.uk/__data/assets/pdf_file/0029/95294/Authority-monitoring-report-and-5-year-housing-land-supply-2023-to-2024-Planning.pdf","https://www.enfield.gov.uk/services/planning/evidence-base","https://www.enfield.gov.uk/services/planning/new-enfield-local-plan"]},{"n":287,"s":"Enfield","t":"Enfield infrastructure-delivery and phasing gate","c":"The Enfield IDP identifies infrastructure needed for future growth and is a living evidence document. Infrastructure need or planned investment is not parcel-level deliverability without a site/project link.","u":["https://www.enfield.gov.uk/services/planning/evidence-base","https://www.enfield.gov.uk/services/planning/new-enfield-local-plan","https://www.enfield.gov.uk/services/planning/monitoring","https://www.enfield.gov.uk/services/planning/adopted-plans"]},{"n":288,"s":"Enfield","t":"Enfield planning-validation evidence gate","c":"Local validation requirements govern evidence needed for applications. They are proposal-dependent requirements and must not be treated as an existing parcel constraint or permission outcome.","u":["https://www.enfield.gov.uk/services/planning/how-to-make-a-planning-application","https://www.enfield.gov.uk/services/planning/planning-application","https://www.enfield.gov.uk/services/planning/the-planning-register","https://www.enfield.gov.uk/services/planning"]},{"n":289,"s":"Enfield","t":"Enfield plan-programme and consultation-status gate","c":"The May 2025 LDS sets the plan-making programme and the SCI governs engagement. Programme milestones or consultation status are not adopted policy and cannot be promoted as parcel constraints.","u":["https://www.enfield.gov.uk/services/planning/local-development-scheme","https://www.enfield.gov.uk/services/planning/new-enfield-local-plan","https://www.enfield.gov.uk/services/planning/adopted-plans","https://www.enfield.gov.uk/services/planning/monitoring"]},{"n":290,"s":"Enfield","t":"Enfield proposed site-allocation evidence gate","c":"The Regulation 19 site-allocation evidence describes proposed allocations supporting the emerging plan. Proposed allocations remain emerging until adoption and require exact candidate-site matching.","u":["https://www.enfield.gov.uk/__data/assets/pdf_file/0028/54955/Site-allocation-topic-paper-for-regulation-19-Planning.pdf","https://www.enfield.gov.uk/services/planning/new-enfield-local-plan","https://www.enfield.gov.uk/services/planning/evidence-base","https://www.enfield.gov.uk/services/planning/local-plan-proposals-map"]},{"n":291,"s":"Havering","t":"Havering listed-building exact-asset gate","c":"Havering listed-building evidence identifies nationally protected assets. Candidate effect requires exact asset/curtilage/location binding; a listed building elsewhere in the borough is irrelevant.","u":["https://www.havering.gov.uk/planning-3/heritage/3","https://www.havering.gov.uk/planning-3/heritage","https://www.havering.gov.uk/planning-3/heritage/2","https://www.havering.gov.uk/map"]},{"n":292,"s":"Havering","t":"Havering TPO/conservation-tree exact-location gate","c":"Havering requires consent for protected trees and provides an online map to check TPO/conservation-area protection. Exact tree/location matching is required before promotion.","u":["https://www.havering.gov.uk/environmental-issues/trees-grass-hedges-leaves-weeds/3","https://www.havering.gov.uk/trees","https://www.havering.gov.uk/map","https://www.havering.gov.uk/ldcapplication"]},{"n":293,"s":"Havering","t":"Havering SFRA spatial-risk gate","c":"Havering's SFRA evidence includes Level 1 assessment and mapped figures. It is strategic evidence; candidate scoring requires location-specific flood-zone/risk binding and current data.","u":["https://www.havering.gov.uk/downloads/download/153/strategic-flood-risk-assessment-2017","https://www.havering.gov.uk/planning-3/planning-policy/3","https://www.havering.gov.uk/map","https://www.havering.gov.uk/planning-3"]},{"n":294,"s":"Havering","t":"Havering AMR / housing-trajectory gate","c":"The 2024/25 AMR and housing trajectory monitor plan performance and five-year supply. Borough-wide monitoring is growth context, not evidence that a specific parcel is allocated or deliverable.","u":["https://www.havering.gov.uk/planning-3/planning-policy/5","https://www.havering.gov.uk/downloads/download/601/authority-monitoring-reports","https://democracy.havering.gov.uk/ieDecisionDetails.aspx?Id=9302","https://www.havering.gov.uk/planning-3/planning-policy/12"]},{"n":295,"s":"Havering","t":"Havering infrastructure-delivery evidence gate","c":"Havering's IDP identifies infrastructure gaps, costs and delivery needs supporting planned growth. It does not establish parcel-level capacity without a site/project and timing link.","u":["https://www.havering.gov.uk/planning-3/infrastructure-planning","https://www.havering.gov.uk/planning-3/planning-policy/3","https://www.havering.gov.uk/cil","https://www.havering.gov.uk/localplandocuments"]},{"n":296,"s":"Havering","t":"Havering 2025-2027 plan-programme gate","c":"The current LDS covers 2025-2027 and schedules plan preparation. Timetable/programme evidence is not adopted policy and must be separated from the adopted 2021 Local Plan.","u":["https://www.havering.gov.uk/planning-3/planning-policy/4","https://www.havering.gov.uk/localplandocuments","https://www.havering.gov.uk/planning-3/planning-policy/2","https://www.havering.gov.uk/ldf"]},{"n":297,"s":"Havering","t":"Havering housing-delivery performance gate","c":"The Housing Delivery Test compares delivered homes with requirements and can trigger an action plan. It is borough-level delivery evidence, not parcel-level planning permission or capacity.","u":["https://www.havering.gov.uk/planning-3/planning-policy/12","https://www.havering.gov.uk/planning-3/planning-policy/5","https://www.havering.gov.uk/downloads/download/601/authority-monitoring-reports","https://www.havering.gov.uk/localplandocuments"]},{"n":298,"s":"Havering","t":"Havering character-and-growth strategy gate","c":"The Havering Character Study supports a place-based approach to managing development. Character guidance must be tied to the candidate location and applicable adopted/emerging policy before use.","u":["https://www.havering.gov.uk/planning-3/planning-policy/16","https://www.havering.gov.uk/planning-3/planning-policy/3","https://www.havering.gov.uk/planning-3/planning-policy/2","https://www.havering.gov.uk/map"]},{"n":299,"s":"Lambeth","t":"Lambeth statutory-listed exact-asset gate","c":"Lambeth has over 2,000 statutory listed buildings. Candidate impact requires exact listed-asset/curtilage/location binding; borough-level counts or nearby assets are not parcel evidence.","u":["https://www.lambeth.gov.uk/planning-and-building-control/conservation-and-listed-buildings/statutory-listed-buildings","https://www.lambeth.gov.uk/planning-and-building-control/conservation-and-listed-buildings/conservation-area-profiles","https://www.lambeth.gov.uk/planning-building-control/planning-applications/find-out-which-planning-constraints-affect-your-property","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021"]},{"n":300,"s":"Lambeth","t":"Lambeth local-heritage exact-asset gate","c":"Local heritage assets are material considerations but not statutory listing. Candidate use requires exact asset identification and proposal relationship; local-list membership elsewhere is irrelevant.","u":["https://www.lambeth.gov.uk/planning-building-control/conservation-listed-buildings/local-heritage-list","https://www.lambeth.gov.uk/planning-building-control/conservation-listed-buildings/local-heritage-list/find-out-if-asset-local-heritage-list","https://www.lambeth.gov.uk/planning-and-building-control/conservation-and-listed-buildings/locally-listed-buildings/how","https://www.lambeth.gov.uk/planning-and-building-control/conservation-and-listed-buildings/locally-listed-buildings/why-council-lists-local-buildings"]},{"n":301,"s":"Lambeth","t":"Lambeth TPO schedule and status gate","c":"Around 5,000 trees are protected by TPOs in Lambeth. Candidate impact requires exact tree/order or conservation-area binding and current order/consent status.","u":["https://www.lambeth.gov.uk/planning-building-control/trees/trees-private-property/tree-preservation-orders-tpos","https://www.lambeth.gov.uk/planning-building-control/trees/trees-private-property/questions-tpos","https://www.lambeth.gov.uk/planning-building-control/trees/trees-private-property","https://www.lambeth.gov.uk/planning-building-control/trees/trees-private-property/apply-permission-work-tree"]},{"n":302,"s":"Lambeth","t":"Lambeth SFRA/local-flood-risk gate","c":"Lambeth publishes SFRA, local flood strategy, SWMP and PFRA evidence. Strategic flood evidence requires exact candidate-location and current risk-layer binding before scoring.","u":["https://www.lambeth.gov.uk/environmental-services/flooding/flooding-prevention-reporting-information/flood-risk-assessment","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021/evidence-base/infrastructure","https://www.lambeth.gov.uk/planning-building-control/planning-applications/find-out-which-planning-constraints-affect-your-property","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021/local-plan-policies-map"]},{"n":303,"s":"Lambeth","t":"Lambeth AMR policy-performance gate","c":"Lambeth AMRs monitor policy indicators, LDS progress and neighbourhood planning. Monitoring evidence provides borough context and cannot by itself establish parcel allocation or deliverability.","u":["https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/planning-policy-monitoring/authoritys-monitoring-reports-amr","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/planning-policy-monitoring/housing","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/new-lambeth-local-plan/local-plan-timetable"]},{"n":304,"s":"Lambeth","t":"Lambeth housing-pipeline / HDT gate","c":"Lambeth's housing pipeline lists permissions completed, under construction and not started, while the HDT action plan addresses delivery performance. Exact site/application matching is required for candidate use.","u":["https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/planning-policy-monitoring/housing","https://www.lambeth.gov.uk/planning-building-control/planning-applications/weekly-planning-lists","https://www.lambeth.gov.uk/planning-building-control/planning-applications/search-submit-comment-applications","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021"]},{"n":305,"s":"Lambeth","t":"Lambeth infrastructure-delivery evidence gate","c":"The Lambeth IDP identifies infrastructure requirements supporting the Local Plan. It is strategic evidence; candidate benefit or constraint requires a linked project, location, delivery status and timing.","u":["https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021/evidence-base/infrastructure","https://www.lambeth.gov.uk/planning-building-control/developer-contributions/community-infrastructure-levy-cil","https://www.lambeth.gov.uk/planning-building-control/developer-contributions/section-106-planning-obligations","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021"]},{"n":306,"s":"Lambeth","t":"Lambeth weekly-list exact-record gate","c":"Weekly lists identify received and validated planning applications and link to Public Access. Candidate use requires exact address/site/application binding; nearby applications are not transferable.","u":["https://www.lambeth.gov.uk/planning-building-control/planning-applications/weekly-planning-lists","https://www.lambeth.gov.uk/planning-building-control/planning-applications/search-submit-comment-applications","https://www.lambeth.gov.uk/planning-building-control/planning-applications/find-out-which-planning-constraints-affect-your-property","https://www.lambeth.gov.uk/planning-building-control/planning-policy-guidance/lambeth-local-plan-2021/local-plan-policies-map"]}]}