ARATE_PUBLIC_AUTHORITY_ASPIRATIONS_NOT_IN_OPERATOR_PLANS","H1"],[27344,15,"B","FAIL_CLOSED_BOUNDARY_4_NO_PARCEL_PROMOTION","HF"]],"boundary_texts":[[1,"Train-route measurements and aggregate pass rates cannot establish mobile signal, technology or performance at a specific parcel."],[2,"Public call-box protection rules and local safety criteria do not prove fixed or mobile service availability at an individual parcel."],[3,"Consumer rules for nuisance marketing and complaint routing contain no parcel-level broadband or mobile coverage evidence."],[4,"Silent-call identification and complaint procedures do not establish internet availability, speed or resilience at a parcel."],[5,"Guidance for threatening calls is a safety and complaint process, not evidence of connectivity at a specific parcel."],[6,"A legal right to request a USO connection and eligibility thresholds do not prove that service is installed, active or performant at a parcel."],[7,"Provider obligations for emergency calls during power cuts do not prove that a particular parcel has backup power or resilient service."],[8,"General regulatory conditions apply to providers and cannot be converted into parcel-level availability, technology or speed."],[9,"Telephony universal-service policy and call-box duties do not establish broadband or mobile performance at an individual parcel."],[10,"Telephone-number categories and call charges contain no evidence of broadband availability, mobile signal or parcel speed."],[11,"Historical USO implementation and provider-designation rules do not prove that an eligible parcel received a completed connection."],[12,"Power-outage compliance monitoring and network-architecture descriptions do not prove resilience or active service at a parcel."],[13,"Connected Nations figures are national or predicted coverage aggregates and cannot be promoted to measured parcel truth."],[14,"A discussion paper and future policy update do not establish current service, technology or performance at an individual parcel."],[15,"Forward-looking operator deployment plans are not proof that a network is built, orderable or active at a specific parcel."]],"fake_data":false,"db_write":false,"migration":false,"production_deploy":false}