thority scopes distinct.","risk_prevented":"Prevents geographic overreach."},{"pattern_id":"PRESERVE_ACCOUNTING_BASIS","handling":"Keep territorial, residence and footprint accounting bases distinct.","risk_prevented":"Prevents incompatible inventory comparisons."},{"pattern_id":"PRESERVE_ACTIVITY_VS_EMISSIONS","handling":"Do not treat activity, vehicle-stock, fuel-supply or infrastructure statistics as measured emissions.","risk_prevented":"Prevents activity-to-emissions substitution."},{"pattern_id":"PRESERVE_STOCK_VS_FLOW","handling":"Keep infrastructure and vehicle stocks, annual flows and cumulative series distinct.","risk_prevented":"Prevents stock-flow confusion."},{"pattern_id":"PRESERVE_MODEL_VS_OBSERVATION","handling":"Keep forecasts and scenarios distinct from observed inventory values.","risk_prevented":"Prevents model outputs being presented as observations."},{"pattern_id":"PRESERVE_SCHEME_UPTAKE_VS_OUTCOME","handling":"Keep grants, certificates, applications and redemptions distinct from emissions outcomes.","risk_prevented":"Prevents programme-uptake claims becoming GHG claims."},{"pattern_id":"PRESERVE_UNIT","handling":"Keep reported physical and monetary units unchanged.","risk_prevented":"Prevents unit-conversion errors."},{"pattern_id":"PRESERVE_DENOMINATOR","handling":"Keep totals, percentages and geographic denominators explicit.","risk_prevented":"Prevents ratio-total confusion."},{"pattern_id":"PRESERVE_METHOD_VERSION","handling":"Retain methodology and dataset-edition context.","risk_prevented":"Prevents stale method reuse."},{"pattern_id":"PRESERVE_REVISION_STATUS","handling":"Retain revision, correction and supersession status.","risk_prevented":"Prevents obsolete-series reuse."},{"pattern_id":"PRESERVE_POLICY_VS_OBSERVATION","handling":"Keep mandates, consultations, eligibility rules and plans distinct from observed outcomes.","risk_prevented":"Prevents policy text becoming fabricated measurements."},{"pattern_id":"NO_FUTURE_RELEASE_AS_OBSERVED","handling":"Do not treat announced future releases as available data.","risk_prevented":"Prevents future-data fabrication."},{"pattern_id":"NO_UNSUPPORTED_CONVERSION","handling":"Do not convert activity, energy, fuel, vehicle, grant or certificate data to GHG without an explicit accepted model.","risk_prevented":"Prevents unsupported derived emissions."},{"pattern_id":"DO_NOT_INFER_PARCEL_VALUE","handling":"Do not derive parcel-level emissions from national, regional, facility, forecast, programme or activity data.","risk_prevented":"Prevents unsupported parcel binding."},{"pattern_id":"REQUIRE_SCOPE_REVIEW","handling":"Review geography, period, basis, status and unit before PASS.","risk_prevented":"Prevents scope mismatch."},{"pattern_id":"REQUIRE_EXPLICIT_QA_REVIEW","handling":"Require source and handling checks before PASS.","risk_prevented":"Prevents automatic unreviewed acceptance."}],"counts":{"source_surfaces":24,"guard_patterns":20},"new_unique_source_surfaces":null,"new_unique_source_surfaces_status":"NOT_DEDUPLICATED_AGAINST_PRIOR_SURFACES","parcel_binding":false,"fake_data":false}