eep stocks, annual flows and cumulative series distinct.","risk_prevented":"Prevents stock/flow substitution."},{"pattern_id":"PRESERVE_ACTIVITY_EMISSIONS","handling":"Do not treat activity statistics as measured emissions.","risk_prevented":"Prevents activity-to-emissions inference."},{"pattern_id":"PRESERVE_CONSUMPTION_EMISSIONS","handling":"Do not equate energy consumption with greenhouse-gas emissions without an explicit factor model.","risk_prevented":"Prevents unsupported emissions conversion."},{"pattern_id":"PRESERVE_FACTOR_MEASUREMENT","handling":"Treat emission factors as conversion inputs, not direct measurements.","risk_prevented":"Prevents factor-as-observation errors."},{"pattern_id":"PRESERVE_MODEL_OBSERVATION","handling":"Keep modelled/reallocated estimates distinct from observed quantities.","risk_prevented":"Prevents model outputs being described as measurements."},{"pattern_id":"PRESERVE_REVISION_STATUS","handling":"Retain revision and supersession status across releases.","risk_prevented":"Prevents stale-series reuse."},{"pattern_id":"PRESERVE_SECTOR_CLASSIFICATION","handling":"Keep TES, SIC and other sector classifications explicit.","risk_prevented":"Prevents category mismatch."},{"pattern_id":"NO_FUTURE_RELEASE_AS_OBSERVED","handling":"Do not treat announced future releases as available data.","risk_prevented":"Prevents future-data fabrication."},{"pattern_id":"DO_NOT_INFER_PARCEL_VALUE","handling":"Do not derive parcel-level emissions from national, regional, local-authority or activity data.","risk_prevented":"Prevents unsupported parcel binding."},{"pattern_id":"REQUIRE_EXPLICIT_QA_REVIEW","handling":"Require source, scope and handling checks before PASS.","risk_prevented":"Prevents automatic unreviewed acceptance."}],"counts":{"source_surfaces":14,"guard_patterns":20},"new_unique_source_surfaces":null,"new_unique_source_surfaces_status":"NOT_DEDUPLICATED_AGAINST_PRIOR_SURFACES","parcel_binding":false,"fake_data":false}