ion."},{"pattern_id":"PRESERVE_PUBLICATION_DATE","handling":"Keep publication and update dates attached to evidence.","risk_prevented":"Prevents mixing data vintages."},{"pattern_id":"PRESERVE_REFERENCE_PERIOD","handling":"Keep the statistical reference period unchanged.","risk_prevented":"Prevents current-year mislabelling."},{"pattern_id":"PRESERVE_PROVISIONAL_FINAL_STATUS","handling":"Keep provisional, current, final and announcement-only states explicitly distinct.","risk_prevented":"Prevents provisional or future values being presented as final observed data."},{"pattern_id":"PRESERVE_GEOGRAPHY","handling":"Keep UK, Great Britain, England, region, local-authority, facility and property scopes distinct.","risk_prevented":"Prevents geographic overreach."},{"pattern_id":"PRESERVE_ACCOUNTING_BASIS","handling":"Keep territorial, residence, footprint and activity-accounting bases distinct.","risk_prevented":"Prevents incompatible inventory comparisons."},{"pattern_id":"PRESERVE_ACTIVITY_VS_EMISSIONS","handling":"Do not treat activity, infrastructure, survey or energy-use statistics as measured emissions.","risk_prevented":"Prevents activity-to-emissions substitution."},{"pattern_id":"PRESERVE_STOCK_VS_FLOW","handling":"Keep stocks, annual flows, cumulative scheme counts and rates distinct.","risk_prevented":"Prevents stock-flow confusion."},{"pattern_id":"PRESERVE_FACILITY_VS_PARCEL","handling":"Keep facility, permit, road-link, project and parcel units distinct.","risk_prevented":"Prevents unsupported cadastral attribution."},{"pattern_id":"PRESERVE_SCHEME_UPTAKE_VS_OUTCOME","handling":"Keep grant applications, vouchers, installations and project stages distinct from emissions outcomes.","risk_prevented":"Prevents programme uptake becoming a fabricated GHG claim."},{"pattern_id":"PRESERVE_UNIT","handling":"Keep reported physical, monetary and percentage units unchanged.","risk_prevented":"Prevents unit-conversion errors."},{"pattern_id":"PRESERVE_DENOMINATOR","handling":"Keep totals, percentages, vehicle miles, holdings and geographic denominators explicit.","risk_prevented":"Prevents ratio-total confusion."},{"pattern_id":"PRESERVE_METHOD_VERSION","handling":"Retain methodology, factor version and dataset-edition context.","risk_prevented":"Prevents stale method reuse."},{"pattern_id":"PRESERVE_REVISION_STATUS","handling":"Retain revision, supersession and statistics-in-development status.","risk_prevented":"Prevents obsolete-series reuse."},{"pattern_id":"PRESERVE_POLICY_VS_OBSERVATION","handling":"Keep plans, modelling, announcements and eligibility rules distinct from observed outcomes.","risk_prevented":"Prevents policy or model text becoming fabricated measurements."},{"pattern_id":"NO_FUTURE_RELEASE_AS_OBSERVED","handling":"Do not treat announced future releases as available observed data.","risk_prevented":"Prevents future-data fabrication."},{"pattern_id":"NO_UNSUPPORTED_CONVERSION","handling":"Do not convert energy, traffic, grants, survey responses or deployment into GHG without an explicit accepted model.","risk_prevented":"Prevents unsupported derived emissions."},{"pattern_id":"DO_NOT_INFER_PARCEL_VALUE","handling":"Do not derive parcel-level emissions from national, regional, facility, road, survey, project or programme data.","risk_prevented":"Prevents unsupported parcel binding."},{"pattern_id":"REQUIRE_SCOPE_REVIEW","handling":"Review geography, period, basis, unit and provisional status before PASS.","risk_prevented":"Prevents scope mismatch."},{"pattern_id":"REQUIRE_EXPLICIT_QA_REVIEW","handling":"Require source and handling checks before PASS.","risk_prevented":"Prevents automatic unreviewed acceptance."}],"counts":{"source_surfaces":28,"guard_patterns":20},"new_unique_source_surfaces":null,"new_unique_source_surfaces_status":"NOT_DEDUPLICATED_AGAINST_PRIOR_SURFACES","parcel_binding":false,"fake_data":false}