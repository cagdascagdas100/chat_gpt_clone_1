{"schema_version":1,"workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1","slot_id":"internet_access_3","continuation_key":"d4b44f265a8ba0ff5fdd1f76f07a20f1f41c8023ed1f6bce91061f5ea94d0c0c","task_id":"aays1-internet-access-3-migrate-existing-then-no-data-20260722","attempt_id":"internet-access-3-20260722-001","wave":14,"checked_at":"2026-07-23T20:21:30Z","state":"SUPPORT_WAVE_COMPLETE_RUNTIME_BLOCKED","scope":"REMOTE_NATIVE_GEOMETRY_REPROJECTION_OPEN_UPRN_FULL_SUPPLY_CODEPOINT_PQI_AND_ONSPD_LIFECYCLE_AUDIT_ONLY","source_head_before":"49d638d2bec22d56fac6b3fe71461cf5077272bc","official_sources":[{"source_id":"hmlr_inspire_current_supply","authority":"HM Land Registry","url":"https://use-land-property-data.service.gov.uk/datasets/inspire","accuracy_score":100,"verified_facts":["INSPIRE Index Polygons are a freehold subset for England and Wales","files are published as GML by local authority","the first-Sunday monthly release represents the previous month","cross-local-authority polygons can occur in more than one file"]},{"source_id":"hmlr_inspire_gml_projection_guidance","authority":"HM Land Registry","url":"https://use-land-property-data.service.gov.uk/datasets/inspire/tech-guidance","accuracy_score":100,"verified_facts":["source polygons are captured in British National Grid","native CRS is EPSG:27700","reprojection to web-map systems can introduce positional shifts up to 15 metres","converted geometry must not replace the native exact-join evidence"]},{"source_id":"os_open_uprn_feature_contract","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/identifiers/os-open-uprn/os-open-uprn-technical-specification/feature-type/os-open-uprn","accuracy_score":100,"verified_facts":["UPRN and four coordinate attributes are mandatory","X and Y are BNG metre coordinates","latitude and longitude are ETRS89 values","GeoPackage geometry is a BNG address-record point and FID is non-persistent"]},{"source_id":"os_open_uprn_full_supply_contract","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/identifiers/os-open-uprn/os-open-uprn-overview/product-supply","accuracy_score":100,"verified_facts":["CSV and GeoPackage are supported formats","the CSV is one whole-of-Great-Britain file","CSV includes headers and one record per line","there is no change-only Open UPRN supply"]},{"source_id":"codepoint_open_pqi_domain","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/addressing-and-location/code-point-open/code-point-open-technical-specification/product-structure","accuracy_score":100,"verified_facts":["PQI values 10, 20, 30, 40, 50, 60 and 90 have distinct meanings","PQI 30 is approximate, normally within 50 metres and sometimes 100 metres for developing sites","PQI 60 is a postcode-sector mean","PQI 90 has no coordinates"]},{"source_id":"codepoint_open_position_and_crs","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/areas-and-zones-portfolio/code-point-open/code-point-open-overview/product-details","accuracy_score":100,"verified_facts":["the postcode point is a notional location represented by the delivery point nearest the postcode mean","coordinates are supplied at one-metre resolution","several postcode units may share one surveyed position","Great Britain coordinates use BNG EPSG:27700"]},{"source_id":"codepoint_open_product_boundary","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/areas-and-zones-portfolio/code-point-open/code-point-open-products-comparison","accuracy_score":100,"verified_facts":["Code-Point Open contains no polygons","it contains no domestic or non-domestic delivery-point counts","Northern Ireland is outside Code-Point Open coverage","postcode points cannot be promoted to parcel geometry"]},{"source_id":"onspd_record_lifecycle_fields","authority":"Office for National Statistics","url":"https://www.ons.gov.uk/file?uri=%2Faboutus%2Ftransparencyandgovernance%2Ffreedomofinformationfoi%2Fukpostcodesandcorrespondinglocalauthorityfebruary2025%2Fonspduserguidefeb2025.pdf","accuracy_score":99,"verified_facts":["DOINTR and DOTERM are separate YYYYMM lifecycle fields","a null DOTERM denotes a live postcode","OSGRDIND values distinguish building, approximate, mean, imputed, historic and coordinate-missing states","OSLAUA may be null when no assignment information is available"]},{"source_id":"ons_current_postcode_filter_and_assignment","authority":"Office for National Statistics","url":"https://www.ons.gov.uk/aboutus/transparencyandgovernance/freedomofinformationfoi/unitaryauthoritiesintheukmappedtofullpostcodes","accuracy_score":99,"verified_facts":["DOTERM is the recommended field for filtering current postcodes","ONSPD assigns districts from the postcode grid reference","NSPL provides best-fit assignment through output areas for statistical use","ONSPD and NSPL assignment methods must not be interchanged"]},{"source_id":"ons_postal_geography_change_semantics","authority":"Office for National Statistics","url":"https://www.ons.gov.uk/methodology/geography/ukgeographies/postalgeography","accuracy_score":99,"verified_facts":["postcode directories match postcode centroid grid references to digital boundaries","postcode units change as addresses and large-user status change","postcode areas are not stable cadastral boundaries","temporal postcode edition must remain explicit"]}],"operations":[{"line":256,"operation":"REQUIRE_HMLR_NATIVE_GML_EVIDENCE","status":"PASS","detail":"INSPIRE polygon acceptance requires the original local-authority GML member"},{"line":257,"operation":"REQUIRE_HMLR_NATIVE_EPSG_27700","status":"PASS","detail":"exact polygon tests run against native British National Grid geometry"},{"line":258,"operation":"HASH_NATIVE_GEOMETRY_BEFORE_REPROJECTION","status":"PASS","detail":"native geometry is fingerprinted before any display conversion"},{"line":259,"operation":"RECORD_REPROJECTION_TARGET_CRS","status":"PASS","detail":"every display conversion retains its destination CRS"},{"line":260,"operation":"RECORD_REPROJECTION_SHIFT_RISK","status":"PASS","detail":"web-map conversion retains the documented up-to-15-metre shift warning"},{"line":261,"operation":"REJECT_REPROJECTED_GEOMETRY_AS_EXACT_EVIDENCE","status":"PASS","detail":"converted geometry cannot independently satisfy an exact parcel join"},{"line":262,"operation":"REQUIRE_INSPIRE_MONTHLY_RELEASE_DATE","status":"PASS","detail":"the first-Sunday publication date is retained"},{"line":263,"operation":"REQUIRE_INSPIRE_REPRESENTED_MONTH","status":"PASS","detail":"the previous-month data period remains separate from publication date"},{"line":264,"operation":"REQUIRE_INSPIRE_LOCAL_AUTHORITY_SHARD_ID","status":"PASS","detail":"every polygon retains its downloaded local-authority shard"},{"line":265,"operation":"DEDUPE_CROSS_AUTHORITY_INSPIRE_RECORDS","status":"PASS","detail":"boundary duplicates are reconciled by INSPIRE ID and native geometry fingerprint"},{"line":266,"operation":"PRESERVE_INSPIRE_FREEHOLD_SUBSET_SCOPE","status":"PASS","detail":"the source is not labelled a complete registered-property inventory"},{"line":267,"operation":"REJECT_INSPIRE_AS_LEASEHOLD_COMPLETENESS_PROOF","status":"PASS","detail":"leasehold completeness is never inferred from the freehold subset"},{"line":268,"operation":"REQUIRE_OPEN_UPRN_FIVE_CORE_ATTRIBUTES","status":"PASS","detail":"UPRN, X, Y, latitude and longitude are mandatory"},{"line":269,"operation":"VALIDATE_UPRN_LEXICAL_DIGITS","status":"PASS","detail":"UPRN is preserved losslessly as a digit identifier without float conversion"},{"line":270,"operation":"VALIDATE_UPRN_X_PRECISION_SCALE","status":"PASS","detail":"BNG X is checked against the documented 8,2 field shape"},{"line":271,"operation":"VALIDATE_UPRN_Y_PRECISION_SCALE","status":"PASS","detail":"BNG Y is checked against the documented 9,2 field shape"},{"line":272,"operation":"VALIDATE_UPRN_LATITUDE_PRECISION_SCALE","status":"PASS","detail":"ETRS89 latitude is checked against the documented 9,7 field shape"},{"line":273,"operation":"VALIDATE_UPRN_LONGITUDE_PRECISION_SCALE","status":"PASS","detail":"ETRS89 longitude is checked against the documented 8,7 field shape"},{"line":274,"operation":"REQUIRE_UPRN_BNG_POINT_GEOMETRY_MATCH","status":"PASS","detail":"GeoPackage point coordinates must agree with X and Y attributes"},{"line":275,"operation":"REJECT_UPRN_POINT_AS_PARCEL_BOUNDARY","status":"PASS","detail":"an address-record point cannot replace polygon evidence"},{"line":276,"operation":"REQUIRE_OPEN_UPRN_FULL_GB_CSV","status":"PASS","detail":"the single-file CSV is validated as whole-of-Great-Britain supply"},{"line":277,"operation":"VALIDATE_OPEN_UPRN_CSV_HEADER","status":"PASS","detail":"mandatory core headers are checked before row ingestion"},{"line":278,"operation":"VALIDATE_OPEN_UPRN_ONE_RECORD_PER_LINE","status":"PASS","detail":"multiline or malformed rows fail closed"},{"line":279,"operation":"REJECT_PARTIAL_OPEN_UPRN_AS_FULL_SUPPLY","status":"PASS","detail":"a truncated file cannot be labelled a complete epoch"},{"line":280,"operation":"CLASSIFY_CODEPOINT_PQI_SEVEN_STATE_DOMAIN","status":"PASS","detail":"PQI 10,20,30,40,50,60,90 remain distinct"},{"line":281,"operation":"ALLOW_ONLY_PQI_10_20_FOR_BUILDING_LEVEL_POSTCODE_POINT","status":"PASS","detail":"only building-level postcode points enter later point validation"},{"line":282,"operation":"REJECT_PQI_30_50_60_FOR_EXACT_PROPERTY_JOIN","status":"PASS","detail":"approximate, estimated and sector-mean points cannot select a property"},{"line":283,"operation":"REJECT_PQI_90_SPATIAL_INFERENCE","status":"PASS","detail":"coordinate-missing postcode records receive no nearest-point fallback"},{"line":284,"operation":"REJECT_CODEPOINT_OPEN_POLYGON_ASSUMPTION","status":"PASS","detail":"the open product supplies no postcode polygons"},{"line":285,"operation":"REJECT_CODEPOINT_OPEN_DELIVERY_COUNT_ASSUMPTION","status":"PASS","detail":"open records do not expose domestic or non-domestic delivery count