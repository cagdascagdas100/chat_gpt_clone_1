{"schema_version":1,"workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1","slot_id":"internet_access_3","continuation_key":"d4b44f265a8ba0ff5fdd1f76f07a20f1f41c8023ed1f6bce91061f5ea94d0c0c","task_id":"aays1-internet-access-3-migrate-existing-then-no-data-20260722","attempt_id":"internet-access-3-20260722-001","wave":19,"checked_at":"2026-07-24T03:09:00Z","state":"SUPPORT_WAVE_COMPLETE_RUNTIME_BLOCKED","scope":"REMOTE_BLPU_HIERARCHY_LPI_STREET_ONS_UPRN_TOPOGRAPHY_ACCURACY_VERSION_AND_CHANGE_HISTORY_AUDIT_ONLY","source_head_before":"d2dacaf22ec0493e6a7611674455f94be62aae46","official_sources":[{"source_id":"os_blpu_parent_multiocc_rpc_contract","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/addresses-and-names-portfolio/addressbase-premium/addressbase-premium-technical-specification/feature-types/blpu-type-21-record","accuracy_score":100,"verified_facts":["BLPU is record type 21 with UPRN identity and optional parent UPRN","MULTI_OCC_COUNT records the number of child UPRNs where a parent-child relation exists","postcode locator provenance must be interpreted with the RPC field","GeoPackage fid is autogenerated and non-persistent"]},{"source_id":"os_lpi_key_language_lifecycle_contract","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/addresses-and-names-portfolio/addressbase-premium-islands/addressbase-premium-islands-technical-specification/structured-data-types/lpi-type-24-record","accuracy_score":100,"verified_facts":["LPI is record type 24 and a BLPU may have more than one LPI","LPI_KEY is the 14-character table primary key while UPRN is the BLPU foreign key","language and logical status are mandatory coded fields","start, end, last-update and entry dates have distinct lifecycle meanings"]},{"source_id":"os_street_type11_usrn_contract","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/addresses-and-names-portfolio/addressbase-premium-islands/addressbase-premium-islands-technical-specification/feature-types/street-type-11-record","accuracy_score":100,"verified_facts":["Street is record type 11","USRN is the unique key and Street-table primary key","the record stores street type plus start and end coordinates","street geometry semantics are not property-boundary semantics"]},{"source_id":"os_lids_blpu_uprn_street_usrn_method","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/identifiers/os-open-linked-identifiers/os-open-linked-identifiers-technical-specification/blpu_uprn_street_usrn_11","accuracy_score":100,"verified_facts":["UPRN-USRN relations are extracted from AddressBase Premium","Street joins to LPI by USRN and LPI joins to BLPU by UPRN","the extraction covers live, provisional and historic BLPU records and open roads","the relationship table contains identifiers rather than parcel geometry"]},{"source_id":"ons_national_statistics_uprn_products","authority":"Office for National Statistics","url":"https://www.ons.gov.uk/methodology/geography/geographicalproducts/nationalstatisticsaddressproducts","accuracy_score":99,"verified_facts":["NSUL and ONSUD have Great Britain coverage and six-week releases","NSUL is a quoted CSV with field headings and a user guide","ONSUD uses UPRN grid-reference point-in-polygon allocation to higher geographies","ONS UPRN products supplement AddressBase use and do not provide parcel boundaries"]},{"source_id":"os_mastermap_topography_accuracy_model","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/topography/os-mastermap-topography-layer","accuracy_score":100,"verified_facts":["Topography Layer updates every six weeks","accuracy is defined as absolute accuracy, relative accuracy and geometric fidelity","capture scales vary between urban, rural and mountain or moorland contexts","TOID persists through a feature lifecycle but attributes and geometry may change"]},{"source_id":"os_topographicline_accuracy_change_contract","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-technical-specification/feature-types/topographicline","accuracy_score":100,"verified_facts":["accuracyOfPosition is metres at the 95 percent confidence level","accuracyOfPosition is present in GML and GeoPackage but not vector tiles","changeHistory may contain multiple chronologically ordered entries","nonBoundingLine identifies a line that is not a TopographicArea boundary"]},{"source_id":"os_boundaryline_accuracy_encoding_contract","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-technical-specification/feature-types/boundaryline","accuracy_score":100,"verified_facts":["BoundaryLine accuracyOfPosition uses metres at 95 percent confidence","the accuracy field is not supplied in vector tiles","feature change history and classification are explicit attributes","an administrative boundary feature is not automatically a property boundary"]},{"source_id":"os_topography_gml_version_history_examples","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-technical-specification/gml-overview/gml-examples","accuracy_score":100,"verified_facts":["GML examples carry feature version and versionDate","changeHistory includes changeDate and reasonForChange","multiple history records can include New, Restructured and Modified events","GML geometries identify osgb:BNG as the spatial reference"]},{"source_id":"os_open_uprn_position_linkage_scope","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/addresses-and-names-portfolio/os-open-uprn/os-open-uprn-technical-specification","accuracy_score":100,"verified_facts":["OS Open UPRN contains each AddressBase Premium record position and its UPRN","the product supports identifier and position based association","it is suitable for GIS and spatial-database loading","an address point is not a parcel polygon"]},{"source_id":"os_addressbase_premium_lifecycle_scope","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/addressing-and-location/addressbase-premium/addressbase-premium-technical-specification","accuracy_score":100,"verified_facts":["AddressBase Premium covers address lifecycle from creation to retirement","the product includes current, alternative, provisional and historic information","Local Authority, Ordnance Survey and Royal Mail address sources coexist","source and lifecycle roles must be preserved rather than flattened"]},{"source_id":"os_lpi_language_and_status_encoding","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/addresses-and-names-portfolio/addressbase-premium-islands/addressbase-premium-islands-technical-specification/structured-data-types/lpi-type-24-record","accuracy_score":100,"verified_facts":["GML language is carried using xml:lang while CSV and GeoPackage use LANGUAGE","logical status is a mandatory one-character coded value","end date is optional and denotes the date the record ceased to exist","SAO number and suffix fields have documented parent-field conditions"]}],"operations":[{"line":450,"operation":"REQUIRE_BLPU_RECORD_IDENTIFIER_21","status":"PASS","detail":"accepted BLPU rows must retain record type 21"},{"line":451,"operation":"REQUIRE_BLPU_UPRN_PRIMARY_IDENTITY","status":"PASS","detail":"UPRN remains the stable BLPU identity and is never converted through floating point"},{"line":452,"operation":"REQUIRE_PARENT_UPRN_SELF_JOIN","status":"PASS","detail":"parent-child relationships resolve only through a valid BLPU-to-BLPU UPRN self join"},{"line":453,"operation":"REJECT_ORPHAN_PARENT_UPRN","status":"PASS","detail":"a non-null parent UPRN that does not resolve fails the hierarchy gate"},{"line":454,"operation":"REJECT_SELF_PARENT_UPRN","status":"PASS","detail":"a BLPU cannot identify itself as its own parent"},{"line":455,"operation":"DETECT_PARENT_UPRN_CYCLE","status":"PASS","detail":"multi-level parent chains are checked for cycles before use"},{"line":456,"operation":"COMPARE_MULTI_OCC_COUNT_WITH_CHILD_ROWS","status":"PASS","detail":"MULTI_OCC_COUNT is compared with resolved direct child UPRNs"},{"line":457,"operation":"REJECT_NEGATIVE_MULTI_OCC_COUNT","status":"PASS","detail":"negative child counts are invalid"},{"line":458,"operation":"REJECT_MULTI_OCC_COUNT_AS_PREMISE_TOTAL","status":"PASS","detail":"multi-occupancy count is not converted into Ofcom premise totals"},{"line":459,"operation":"REQUIRE_RPC_WITH_POSTCODE_LOCATOR","status":"PASS","detail":"postcode locator is interpreted only with its RPC provenance code"},{"line":460,"operation":"REJECT_SPATIALLY_DERIVED_POSTCODE_AS_PAF_MATCH","status":"PASS","detail":"a nearest-neighbour or spatially assigned postcode is not labelled a Royal Mail PAF match"},{"line":461,"operation":"REJECT_POSTCODE_LOCATOR_AS_EXACT_POINT","status":"PASS","detail":"postcode text cannot replace the BLPU position or parcel geometry"},{"line":462,"operation":"REQUIRE_LPI_RECORD_IDENTIFIER_24","status":"PASS","detail":"accepted LPI rows must retain record type 24"},{"line":463,"operation":"REQUIRE_LPI_KEY_PRIMARY_IDENTITY","status":"PASS","detail":"LPI_KEY remains the table primary key"},{"line":464,"operation":"REQUIRE_LPI_UPRN_FOREIGN_KEY","status":"PASS","detail":"each LPI must resolve to its BLPU through UPRN"},{"line":465,"operation":"ALLOW_MULTIPLE_LPI_PER_BLPU","status":"PASS","detail":"one BLPU may have multiple language, historic or alternative LPI records"},{"line":466,"operation":"REJECT_LPI_ROW_POSITION_JOIN","status":"PASS","detail":"LPI and BLPU tables cannot be aligned by file order"},{"line":467,"operation":"REQUIRE_LPI_LANGUAGE_CODE","status":"PASS","detail":"the documented language code is retained with PAO and SAO text"},{"line":468,"operation":"REQUIRE_LPI_LOGICAL_STATUS","s