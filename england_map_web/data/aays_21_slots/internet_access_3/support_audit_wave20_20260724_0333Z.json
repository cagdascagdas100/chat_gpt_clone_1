atures","temporary update states can duplicate polygon boundaries, remove polygons or break lines","completed edits can restore original feature identity and history"]},{"source_id":"os_topography_gml_chunking","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-overview/product-supply/gml-supply-options","accuracy_score":100,"verified_facts":["geographic chunks can repeat the same feature across adjacent files","point features can occur in multiple chunks when touching shared boundaries","non-geographic chunking supplies each feature in only one chunk"]},{"source_id":"os_topography_feature_lifecycle","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-technical-specification/feature-lifecycles-and-tracking-change","accuracy_score":100,"verified_facts":["TOIDs persist through the life of a feature and are never reassigned","feature versions increment for geometry or attribute changes","version date differs from local load date","only the current version is supplied in the product"]},{"source_id":"os_topography_polygon_lifecycle","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-technical-specification/feature-lifecycles-and-tracking-change/polygon-feature-lifecycle-rules","accuracy_score":100,"verified_facts":["new polygon objects receive new TOIDs","removed polygon objects are deleted and reported in COU","geometry changes may retain a TOID when the real-world object remains the same"]},{"source_id":"os_topography_point_lifecycle","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-technical-specification/feature-lifecycles-and-tracking-change/general-point-feature-lifecycle-rules","accuracy_score":100,"verified_facts":["real-world point-object replacement generally creates a new feature","positional error correction can retain and modify the existing feature"]},{"source_id":"os_topography_line_lifecycle_boundary_exclusion","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/maps-and-imagery-portfolio/os-mastermap-topography-layer/os-mastermap-topography-layer-technical-specification/feature-lifecycles-and-tracking-change/line-feature-lifecycle-rules","accuracy_score":100,"verified_facts":["polygon-closing links do not constitute legal property boundaries","inferred links are identified through descriptive-group attribution"]},{"source_id":"os_open_toid_data_structure","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/buildings-and-infrastructure-portfolio/os-open-toid/os-open-toid-technical-specification/data-structure","accuracy_score":100,"verified_facts":["the product schema requires TOID, version metadata, source product, easting and northing","GeoPackage id is autogenerated and non-persistent","GeoPackage layers are divided by source product"]},{"source_id":"os_open_toid_generalisation","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/buildings-and-infrastructure-portfolio/os-open-toid/os-open-toid-technical-specification/product-details","accuracy_score":100,"verified_facts":["point locations are rounded to the nearest metre","line locations use the rounded midpoint","polygon locations use a point-of-inaccessibility algorithm","multi-polygon SiteExtent uses the largest polygon"]},{"source_id":"os_open_toid_scope_and_persistence","authority":"Ordnance Survey","url":"https://docs.os.uk/os-downloads/products/buildings-and-infrastructure-portfolio/os-open-toid","accuracy_score":100,"verified_facts":["OS Open TOID provides generalised locations for selected feature types","the open register is not exhaustive","the product updates every six weeks"]},{"source_id":"ons_uprn_postcode_provenance","authority":"Office for National Statistics","url":"https://www.ons.gov.uk/aboutus/transparencyandgovernance/freedomofinformationfoi/inclusionofpostcodesintheonsudandnsulproducts","accuracy_score":99,"verified_facts":["ONSUD and NSUL are updated every six weeks","the products contain UPRNs matched to statutory and statistical geography codes","postcode inclusion has documented AddressBase and Code-Point Open provenance"]}],"operations":[{"line":500,"operation":"REQUIRE_TOPOGRAPHICAREA_POLYGON_GEOMETRY","status":"PASS","detail":"TopographicArea must retain polygon geometry and cannot be downgraded to a point-only parcel representation"},{"line":501,"operation":"REQUIRE_TOPOGRAPHICAREA_TOID_FULL_STRING","status":"PASS","detail":"TopographicArea TOID is stored in full, including leading zeros"},{"line":502,"operation":"REQUIRE_TOPOGRAPHICAREA_VERSION","status":"PASS","detail":"feature version is retained with the TOID where supplied"},{"line":503,"operation":"REQUIRE_TOPOGRAPHICAREA_VERSION_DATE","status":"PASS","detail":"versionDate is retained separately from download and load dates"},{"line":504,"operation":"REJECT_VERSION_DATE_AS_REAL_WORLD_CHANGE_DATE","status":"PASS","detail":"versionDate records the database version becoming current, not necessarily the real-world change date"},{"line":505,"operation":"REQUIRE_TOPOGRAPHICAREA_THEME_ARRAY","status":"PASS","detail":"one or more themes are preserved without flattening to an arbitrary single value"},{"line":506,"operation":"REQUIRE_CALCULATED_AREA_VALUE","status":"PASS","detail":"polygon calculated area is retained in square metres when supplied"},{"line":507,"operation":"REJECT_CALCULATED_AREA_AS_LEGAL_AREA","status":"PASS","detail":"calculated cartographic area is not treated as a legal title area"},{"line":508,"operation":"REQUIRE_DESCRIPTIVE_GROUP_MULTIPLICITY","status":"PASS","detail":"one or more descriptive groups are retained"},{"line":509,"operation":"ALLOW_ZERO_OR_MORE_DESCRIPTIVE_TERMS","status":"PASS","detail":"absence of a descriptive term remains valid and is not invented"},{"line":510,"operation":"REQUIRE_FEATURE_CODE_LOOKUP","status":"PASS","detail":"featureCode is interpreted only through the official lookup table"},{"line":511,"operation":"REJECT_FEATURE_CODE_AS_SELF_DESCRIBING","status":"PASS","detail":"the arbitrary numeric feature code is not treated as independently meaningful"},{"line":512,"operation":"SEPARATE_MAKE_FROM_FEATURE_CODE","status":"PASS","detail":"natural or man-made status cannot be inferred from featureCode alone"},{"line":513,"operation":"REQUIRE_PHYSICAL_LEVEL_ENUM","status":"PASS","detail":"physicalLevel is restricted to the documented underground, obscured, normal and overhead values"},{"line":514,"operation":"REJECT_PHYSICAL_LEVEL_AS_ELEVATION","status":"PASS","detail":"physicalLevel is a cartographic relation, not a height measurement"},{"line":515,"operation":"PRESERVE_PHYSICAL_PRESENCE_ROLE","status":"PASS","detail":"physicalPresence remains an object-nature attribute and not a parcel-access score"},{"line":516,"operation":"REJECT_EDGE_LIMIT_AS_ACCESS_OBSTRUCTION","status":"PASS","detail":"edge or limit presence is not automatically classified as an obstruction"},{"line":517,"operation":"REQUIRE_ORDERED_AREA_CHANGE_HISTORY","status":"PASS","detail":"TopographicArea changeHistory entries remain chronological"},{"line":518,"operation":"REQUIRE_CHANGE_DATE_AND_REASON_PAIR","status":"PASS","detail":"each change-history event retains both date and reason"},{"line":519,"operation":"REJECT_PERSISTENT_TOID_AS_UNCHANGED_AREA","status":"PASS","detail":"persistent TOID does not prove unchanged geometry or classification"},{"line":520,"operation":"REQUIRE_SEAMLESS_SUPPLY_UNCLIPPED_FEATURES","status":"PASS","detail":"features overlapping a nominal supply boundary are expected in full, not clipped"},{"line":521,"operation":"REJECT_PACKET_BOUNDARY_AS_