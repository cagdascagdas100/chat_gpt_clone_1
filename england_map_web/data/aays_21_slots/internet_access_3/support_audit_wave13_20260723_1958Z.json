ary 2026 availability snapshot","residential full-fibre and gigabit coverage use residential premises","full-fibre take-up and premises without decent access use all premises","coverage availability is distinct from measured active-connection performance"]},{"source_id":"ofcom_planned_deployment_temporal_role","authority":"Ofcom","url":"https://www.ofcom.org.uk/phones-and-broadband/coverage-and-speeds/connected-nations-planned-network-deployment/connected-nations-planned-network-deployments-2026","accuracy_score":100,"verified_facts":["planned deployment evidence is forward-looking through the end of 2028","plans reflect operator statements as of January 2026","planned coverage supplements but does not replace current coverage","public-authority aspirations outside operator plans are not separately counted"]}],"operations":[{"line":228,"operation":"REQUIRE_BLPU_STATE_DATE_WHEN_STATE_PRESENT","status":"PASS","detail":"BLPU_STATE_DATE is mandatory whenever BLPU_STATE is populated"},{"line":229,"operation":"VALIDATE_BLPU_LIFECYCLE_DATE_ORDER","status":"PASS","detail":"start, update and optional end dates are validated without inventing missing lifecycle events"},{"line":230,"operation":"PRESERVE_ENTRY_DATE_SEPARATELY","status":"PASS","detail":"local-authority entry date remains distinct from product start and last-update dates"},{"line":231,"operation":"REQUIRE_LOCAL_CUSTODIAN_PROVENANCE","status":"PASS","detail":"the maintaining custodian code is retained beside every BLPU lifecycle record"},{"line":232,"operation":"VALIDATE_BNG_COORDINATE_FIELD_PRECISION","status":"PASS","detail":"X and Y coordinate fields are parsed with their documented precision and scale"},{"line":233,"operation":"SEPARATE_BNG_AND_ETRS89_COORDINATES","status":"PASS","detail":"native BNG and ETRS89 fields cannot be silently swapped or mixed"},{"line":234,"operation":"REQUIRE_LPI_LIFECYCLE_FIELDS","status":"PASS","detail":"LPI logical status and lifecycle dates remain typed independently from BLPU 