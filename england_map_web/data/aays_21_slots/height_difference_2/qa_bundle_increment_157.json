 Defra","name":"National LIDAR Programme","url":"https://environment.data.gov.uk/dataset/2e8d0733-4f43-48b4-9e51-631c25d1b0a9","facts":["National LIDAR Programme provides 1m elevation data for all England","Phase 1 used 302 survey blocks captured January 2017 to February 2023","repeat captures receive incrementing phase numbers","data is published quarterly and official GeoJSON/GPKG/SHP/GDB coverage catalogues are provided"]},{"id":"S164","publisher":"Environment Agency / Defra","name":"LIDAR Time Stamped Point Cloud","url":"https://environment.data.gov.uk/dataset/094d4ec8-4c21-4aa6-817f-b7e45843c5e0","facts":["timestamped DTM/DSM grids are derived from the LIDAR point cloud","point clouds contain x/y/z and component attributes","point cloud coverage goes back to 2006 while site-specific surveys began in 1998","historical archive limitations mean a matching point cloud is not guaranteed for every surface model"]},{"id":"S165","publisher":"Ordnance Survey","name":"OS Terrain 50 per-tile metadata specification","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-technical-specification/metadata","facts":["per-tile XML identifies 10km National Grid tile","projected CRS is EPSG:27700 British National Grid","vertical CRS is EPSG:5701 Ordnance Datum Newlyn","earliest and latest flying dates are recorded for tiles with multiple capture dates"]},{"id":"S166","publisher":"Ordnance Survey","name":"OS Terrain 50 grid data specification","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-technical-specification/grid-data","facts":["ASCII grid heights are calculated from the centre of each pixel","each 10km tile contains 200 by 200 pixels","pixel size is 50m by 50m","height values are provided to nearest 0.1m","Metadata_<tile>.xml accompanies grid data"]},{"id":"S167","publisher":"Ordnance Survey","name":"OS Terrain 50 documentation","url":"https://docs.os.uk/os-downloads/height-and-imagery/os-terrain-50","facts":["OS Terrain 50 is an OpenData DTM product","product is updated annually in July","grid has regular 50m post spacing","grid and contour data are supplied as 10km by 10km National Grid tiles"]},{"id":"S168","publisher":"Ordnance Survey","name":"OS Terrain 50 current OpenData download","url":"https://osdatahub.os.uk/downloads/open/Terrain50","facts":["current version date is July 2026","coverage is all Great Britain","ASCII Grid and GML grid formats are available","product is free OpenData under the Open Government Licence"]}],"source_check_groups":[{"prefix":"AUTHORITY_ORIGIN","count":10,"status":"completed"},{"prefix":"CURRENTNESS_STATE","count":10,"status":"completed"},{"prefix":"CRS_VERTICAL_DATUM","count":10,"status":"completed"},{"prefix":"SURVEY_QC_SCOPE","count":10,"status":"completed"},{"prefix":"LINEAGE_CONTRACT","count":10,"status":"completed"},{"prefix":"PIXEL_CENTRE_CONTRACT","count":10,"status":"completed"},{"prefix":"TILE_METADATA_CONTRACT","count":10,"status":"completed"},{"prefix":"LICENSE_ACCESS","count":10,"status":"completed"},{"prefix":"FAIL_CLOSED_CLAIM_GUARD","count":10,"status":"completed"},{"prefix":"SOURCE_INDEPENDENCE_GUARD","count":10,"status":"completed"}],"target_check_groups":[{"prefix":"IDENTITY_NATIVE_GEOMETRY","count":300,"status":"completed"},{"prefix":"HMLR_CURRENT_MONTHLY_SOURCE","count":250,"status":"completed"},{"prefix":"HMLR_NATIVE_BNG_NO_REPROJECT","count":250,"status":"completed"},{"prefix":"EA_GROUNDTRUTH_QC_SCOPE","count":300,"status":"completed"},{"prefix":"EA_NATIONAL_PROGRAMME_LINEAGE","count":300,"status":"completed"},{"prefix":"EA_TIMESTAMPED_POINTCLOUD_PROVENANCE","count":250,"status":"completed"},{"prefix":"EA_WCS_RAW_PIXEL_ROUTE","count":300,"status":"completed"},{"prefix":"EA_COMPOSITE_LINEAGE_PROVENANCE","count":250,"status":"completed"},{"prefix":"OS_TERRAIN50_GRID_PIXEL_CENTRE","count":300,"status":"completed"},{"prefix":"OS_TERRAIN50_TILE_METADATA","count":300,"status":"comp