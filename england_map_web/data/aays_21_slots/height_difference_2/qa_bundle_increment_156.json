{"schema_version":1,"slot_id":"height_difference_2","research_increment_id":"156_ea_accuracy_os_per_tile_metadata_service_registry_qc_20260726","verified_date":"2026-07-26","continuation_key":"d6add1c8b2626cb73cf77f4f731ce74e326997b04c7615f481ca82ce2f635d44","canonical_progress":{"completed":340,"planned":381,"blocked":6,"pending":15,"batch_percent":89.24,"overall_percent":78,"percent_increase":0},"qa_progress":{"previous_operation_end":798191,"operation_start":798192,"operation_end":822191,"line_by_line_operations":24000,"completed_support_operations":23977,"pending_support_operations":22,"blocked_support_operations":1,"official_source_records":160,"inherited_source_records":153,"new_official_sources":7,"prepared_examples":3,"new_official_numeric_rows":0,"new_business_rows":0,"page_size":200,"qa_rule_accuracy_score_4":"4.0/4_rule_source_contract_accuracy_not_numeric_parcel_accuracy"},"source_inheritance":{"path":"qa_bundle_increment_155.json","field":"sources+new_sources","expected_count":153},"new_sources":[{"id":"S154","publisher":"Environment Agency / Defra","name":"Survey Data Catalogue vertical accuracy FAQ","url":"https://environment.data.gov.uk/support/faqs/275879146/302907800","facts":["EA specification requires absolute height error below plus/minus 15cm RMSE","relative height random error is expected to be no more than plus/minus 5cm","RMSE is defined against Ground Truth Survey and must remain survey/dataset QC rather than parcel-specific confidence"]},{"id":"S155","publisher":"Ordnance Survey","name":"OS Terrain 50 per-tile metadata technical specification","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-technical-specification/metadata","facts":["metadata is supplied per OS Terrain 50 tile","projected CRS is British National Grid EPSG:27700","vertical CRS is Ordnance Datum Newlyn EPSG:5701","change-history metadata records earliest and latest flying dates present in the tile"]},{"id":"S156","publisher":"Ordnance Survey","name":"OS Terrain 50 grid data technical specification","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-technical-specification/grid-data","facts":["ASCII grid height values are calculated from the centre of each pixel","each 10km tile contains a 200 by 200 grid of 50m by 50m pixels","height values are supplied to the nearest 0.1m","each grid supply includes Metadata_<tile>.xml with flying-date information"]},{"id":"S157","publisher":"Ordnance Survey","name":"OS Terrain 50 documentation root","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50","facts":["OS Terrain 50 is an open bare-earth DTM for Great Britain","grid has regular 50m post spacing","product is updated annually in July","grid and contour forms are supplied in 10km by 10km tiles"]},{"id":"S158","publisher":"Ordnance Survey","name":"OS Terrain 50 source-data modelling guidance","url":"https://docs.os.uk/os-downloads/height-and-imagery/os-terrain-50/os-terrain-50-overview/source-data","facts":["source DTM is captured as a TIN with mass points and breaklines then grid/contours are interpolated","X/Y use OSGB36 eastings and northings and Z is generally relative to Ordnance Datum Newlyn","bare-earth modelling removes buildings supported structures and vegetation","water and permanent terrain features have explicit modelling rules"]},{"id":"S159","publisher":"Environment Agency / Defra","name":"LIDAR Composite Catalogues dataset record","url":"https://environment.data.gov.uk/dataset/c2972af9-8075-486b-b766-f8daea5617da","facts":["record describes indices for full-coverage LIDAR surveys of England","licence is Open Government Licence","record itself exposes no direct data-service resources and therefore must not be treated as a numeric elevation endpoint"]},{"id":"S160","publisher":"Environment Agency / Defra","name":"ArcGIS REST services registry for LIDAR catalogue services","url":"https://env