nswws_impact_table_guard","official_url":"https://weather.metoffice.gov.uk/guides/severe-weather-advice","evidence_date":"2026-07-23","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Illustrative impact tables are interpretation guards and do not prove impacts at every location in a warning area.","evidence_fingerprint_sha256":"b123b6cad7d28bf2bc3e6e4d58b1c2a51c9e5e110c07de84dd09ce3700478df6"},{"line":434,"source_id":"SRC-434","name":"Met Office weather warnings","publisher":"Met Office","authority_accuracy":98,"decision":"promoted_weather_warning_series_context","official_url":"https://weather.metoffice.gov.uk/warnings-and-advice/uk-weather-warnings/met-office-weather-warnings","evidence_date":"2026-07-23","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Warning service history and communication design support series interpretation only.","evidence_fingerprint_sha256":"f13058ce3b648c3247ed5d704cdc901a64da699a94fc00100ba31e9532a22c00"},{"line":435,"source_id":"SRC-435","name":"National Severe Weather Warnings Archive","publisher":"Met Office","authority_accuracy":98,"decision":"held_historical_weather_warning_archive","official_url":"https://www.metoffice.gov.uk/research/library-and-archive/publications/national-severe-weather-warning-service","evidence_date":"2026-07-23","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Archived warnings are historical records and are not current parcel conditions.","evidence_fingerprint_sha256":"7b22431058e59350dc4043d6a5092a6f1a3630627c202df20dfc80d08a562f92"},{"line":436,"source_id":"SRC-436","name":"UK weather warnings accessible view","publisher":"Met Office","authority_accuracy":99,"decision":"held_dynamic_live_warning_view","official_url":"https://weather.metoffice.gov.uk/warnings-and-advice/accessible-uk-warnings","evidence_date":"2026-07-23","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"