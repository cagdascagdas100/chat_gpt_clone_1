k/media/6a50d68d9e9c95844ae64caf/A_Guide_to_the_2026_National_Risk_Register.pdf","evidence_date":"2026-07-14","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"The guide explains standardised scales, reasonable worst-case scenarios and local context; it is a methodology guard, not local evidence.","evidence_fingerprint_sha256":"ed108fc165006fe1315ab5307a29bb656194c4b882bf54807e39dd7639c30192"},{"line":399,"source_id":"SRC-399","name":"The UK Government Resilience Framework","publisher":"Cabinet Office","authority_accuracy":99,"decision":"promoted_resilience_policy_framework","official_url":"https://www.gov.uk/government/publications/the-uk-government-resilience-framework","evidence_date":"2022-12-19","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Whole-of-society resilience principles support governance and source-selection controls only.","evidence_fingerprint_sha256":"27e62380f0b59d22e07aa4a694ca2d69e72f60701c1bd781827c9bad7f9283fe"},{"line":400,"source_id":"SRC-400","name":"The UK Government Resilience Framework (HTML)","publisher":"Cabinet Office","authority_accuracy":99,"decision":"promoted_resilience_framework_methodology","official_url":"https://www.gov.uk/government/publications/the-uk-government-resilience-framework/the-uk-government-resilience-framework-html","evidence_date":"2023-12-04","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Anticipate, assess, prevent, mitigate, respond and recover concepts are methodological controls only.","evidence_fingerprint_sha256":"5c99e9bd497c3d5b4e91da1da131a8cfcb555a44c83c70140a7b2af217483a22"},{"line":401,"source_id":"SRC-401","name":"Emergency preparedness","publisher":"Cabinet Office","authority_accuracy":99,"decision":"promoted_civil_contingencies_statutory_guidance","official_url":"https://www.gov.uk/government/publications/emergency-preparedness","evidence_date":"2006-01-01","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Civil Contingencies Act duties and responder categories guide evidence governance; they do not establish parcel risk.","evidence_fingerprint_sha256":"15e6ef268a308feffad82a28cf74c3fcf5caeacc569bb107ddf82bede228d760"},{"line":402,"source_id":"SRC-402","name":"Emergency response and recovery","publisher":"Cabinet Office","authority_accuracy":99,"decision":"promoted_emergency_response_methodology","official_url":"https://www.gov.uk/guidance/emergency-response-and-recovery","evidence_date":"2013-02-20","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Multi-agency response and recovery principles are operational methodology and not local incident evidence.","evidence_fingerprint_sha256":"7b6f1c96e76dfb0c819f2fc7a8d48007896b1c4c02cbf574cf488d14ccf68a54"},{"line":403,"source_id":"SRC-403","name":"Emergency response and recovery publication","publisher":"Cabinet Office","authority_accuracy":99,"decision":"promoted_emergency_response_version_control","official_url":"https://www.gov.uk/government/publications/emergency-response-and-recovery","evidence_date":"2010-04-05","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"The publication landing page supports version control of the response guidance only.","evidence_fingerprint_sha256":"9ad0a2d54cf5ac7f35765935c2f7133d81236256ce7a1d59e26cf339af291508"},{"line":404,"source_id":"SRC-404","name":"Preparation and planning for emergencies: responsibilities of responder agencies and others","publisher":"Cabinet Office","authority_accuracy":99,"decision":"promoted_responder_responsibility_guard","official_url":"https://www.gov.uk/guidance/preparation-and-planning-for-emergencies-responsibilities-of-responder-agencies-and-others","evidence_date":"2013-02-20","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Responder responsibilities and planning cycles constrain interpretation; they do not create local readiness guarantees.","evidence_fingerprint_sha256":"2941212e49785b9b7ec46dee5caabe6ae5ca54484676604a3bdca52e73f121dc"},{"line":405,"source_id":"SRC-405","name":"Preparation and planning for emergencies","publisher":"Cabinet Office","authority_accuracy":98,"decision":"promoted_resilience_capabilities_methodology","official_url":"https://www.gov.uk/guidance/preparation-and-planning-for-emergencies-the-capabilities-programme","evidence_date":"2018-05-30","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Cross-government capability guidance is methodology context only.","evidence_fingerprint_sha256":"835525520a93879fd6ccb7cd8cd91cea481b3d680b279d42f1af945b2573cd7b"},{"line":406,"source_id":"SRC-406","name":"National Resilience Standards for Local Resilience Forums","publisher":"Cabinet Office","authority_accuracy":99,"decision":"promoted_lrf_self_assurance_guard","official_url":"https://www.gov.uk/government/publications/national-resilience-standards-for-local-resilience-forums-lrfs","evidence_date":"2020-08-27","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"Self-assurance standards describe good practice and do not prove local operational performance.","evidence_fingerprint_sha256":"05742c5c81e6f03e3a32ad9c3d033a5cc6d2a6e029505d6ddf6c53f063389bcb"},{"line":407,"source_id":"SRC-407","name":"The role of Local Resilience Forums","publisher":"Cabinet Office","authority_accuracy":98,"decision":"promoted_lrf_role_methodology","official_url":"https://www.gov.uk/government/publications/the-role-of-local-resilience-forums-a-reference-document","evidence_date":"2013-07-26","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"LRF roles and review checklists support governance QA only.","evidence_fingerprint_sha256":"ef49017c064ebd8edd56cc263641672c97963b254cd65e3ac28b431a47d38d5e"},{"line":408,"source_id":"SRC-408","name":"Local resilience forums: contact details","publisher":"Cabinet Office","authority_accuracy":98,"decision":"held_dynamic_lrf_directory","official_url":"https://www.gov.uk/guidance/local-resilience-forums-contact-details","evidence_date":"2026-02-11","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"A dynamic contact directory is not evidence of capability, coverage or response time.","evidence_fingerprint_sha256":"636e17f8be56f7548225653ea8d3adafdcf5ae1a3bd771df38d2974c4c8b68dc"},{"line":409,"source_id":"SRC-409","name":"Emergency preparedness, resilience and response: concept of operations","publisher":"UK Health Security Agency","authority_accuracy":99,"decision":"promoted_health_security_eprr_methodology","official_url":"https://www.gov.uk/government/publications/emergency-preparedness-resilience-and-response-concept-of-operations","evidence_date":"2025-01-15","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"UKHSA incident governance is a preparedness framework and not a measure of local health risk.","evidence_fingerprint_sha256":"7327ce511b4bb143c5fddcc7a0861728edec582c370dbe2f5aa145cbe8d1bfe5"},{"line":410,"source_id":"SRC-410","name":"Preparedness plan","publisher":"UK Health Security Agency","authority_accuracy":99,"decision":"promoted_health_security_preparedness_guard","official_url":"https://www.gov.uk/government/publications/emergency-preparedness-resilience-and-response-concept-of-operations/preparedness-plan","evidence_date":"2025-01-15","freshness_status":"verified_2026-07-23_official_primary_source","semantic_limit":"The annual preparedness cycle is an organisational method, not a local protection guarantee.","evidence_fingerprint_sha256":"07c7a11bae02e0481ba2cbd936f9d84c9f46043401a2422ed043210ecf004c08"},{"line":411,"source_id":"SRC-411","name":"The national flood emergency framework for England","publisher":"DEFRA / Environment Agency","authority_accuracy":99,"decision":"promoted_flood_emergency_framework","official_url":"https: