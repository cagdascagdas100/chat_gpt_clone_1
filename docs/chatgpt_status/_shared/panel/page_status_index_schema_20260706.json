{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAYS shared runner panel page status index",
  "type": "object",
  "required": ["generated_at", "runner_contract_version", "pages"],
  "properties": {
    "generated_at": { "type": "string" },
    "runner_contract_version": { "type": "string" },
    "single_runner_active": { "type": "boolean" },
    "runner_pid": { "type": ["integer", "null"] },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_key",
          "display_name",
          "latest_queue_status",
          "latest_task_id",
          "completion_percent",
          "remaining_percent",
          "final_ready",
          "blockers",
          "runner_contract_valid",
          "queue_contract_errors"
        ],
        "properties": {
          "page_key": { "type": "string" },
          "display_name": { "type": "string" },
          "latest_queue_status": { "type": "string" },
          "latest_task_id": { "type": "string" },
          "completion_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "remaining_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "final_ready": { "type": "boolean" },
          "last_heartbeat_at": { "type": ["string", "null"] },
          "last_completed_at": { "type": ["string", "null"] },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "evidence_paths": { "type": "array", "items": { "type": "string" } },
          "runner_contract_valid": { "type": "boolean" },
          "queue_contract_errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
