_name":"Low Level Waste Repository","target_id":"LLWR_ON_THE_LEVEL_MARCH_2026_NUMERIC_CARBON"}],"schema_version":3,"script_path":"docs/chatgpt_status/_shared/slots_21/gas_emissions_3/scripts/on_the_level_march_2026_llwr_carbon_gate.py","script_sha256":"b310dc0d1ddf546cd3111f5e65bc0b607b86d0d5c5c52b0c1b3f884d49304085","script_test_evidence":{"ast_parse":"PASS","production_snapshot_business_rows":0,"production_snapshot_execution":"PASS","production_snapshot_records_scanned":6,"production_snapshot_source_evidence_records":6,"production_snapshot_state":"NO_DATA_CONTINUE","py_compile":"PASS","relative_path_validation":"PASS_11_OF_11","script_content_sha256":"b310dc0d1ddf546cd3111f5e65bc0b607b86d0d5c5c52b0c1b3f884d49304085","synthetic_explicit_row_business_rows":1,"synthetic_explicit_row_execution":"PASS","synthetic_explicit_row_records_scanned":7,"synthetic_explicit_row_state":"EXACT_LLWR_NUMERIC_CARBON_ROW_VERIFIED","tested_at":"2026-08-03T20:19:00Z"},"shard_index":3,"slot_id":"gas_emissions_3","snapshot_policy":{"explicit_numeric_carbon_quantity_and_unit_required":true,"logistics_to_emissions_conversion_allowed":false,"maximum_records":20,"network_requests_by_runner":0},"source_evidence_manifest":{"accessed_at":"2026-08-03T20:16:00Z","content_sha256":"7c9b754648a67f379013d2924dd6d52b3c975934e7b57f1a7a56cfd1c79c9632","content_sha256_scope":"UTF-8 canonical JSON of official URL, access time, publisher, date, licence, snapshot hash, supported fields and six bounded HTML records","evidence_records":[{"excerpt":"Corporate report. On the Level March 2026, issue 45. Updated 26 March 2026.","line_end":57,"line_start":53,"record_id":"document_identity","sha256":"60fdf77fedc7ae270faea8b9e9d04ef048a1db21d7a0608e1883927ae767b930"},{"excerpt":"© Crown copyright 2026. This publication is licensed under the terms of the Open Government Licence v3.0 except where otherwise stated. This publication is available at https://www.gov.uk/government/publications/on-the-level-march-2026-issue-45/on-the-level-march-2026-issue-45","line_end":78,"line_start":74,"record_id":"licence_and_url","sha256":"cbdb1035e7758597a7ea6e88027e0083c27e9b13cd1fe17bfc0122afd250bf60"},{"excerpt":"A year in numbers. As we approach financial year end at the Repository site, it’s worth reflecting on some of the successes over the last 12 months: 12 containers of LLW received. 200 rail deliveries of aggregate to site for the STIM project, avoiding 8,868 HGV movements from the roads. 168,500 tonnes of aggregate delivered and 50,052m² of Geosynthetic Clay Liner laid. 1,495 recategorised drums forecast to be exported, diverting waste from the Repository.","line_end":86,"line_start":79,"record_id":"repository_year_numbers","sha256":"b80adffabab3a2b52da0098b8ae4c83da80b5be2fc317fd4028c09b87f24b41b"},{"excerpt":"Further progress at pace. The third campaign of rail deliveries of aggregate began in January 2026. This round is expected to finish in September 2026 and will see approximately 200 trains transport more than 175,000 tonnes of aggregate to the site. As of the end of February 2026, 39 trains had delivered 36,539 tonnes of aggregate, avoiding almost 2,000 HGV journeys during this campaign.","line_end":144,"line_start":138,"record_id":"current_campaign_logistics","sha256":"c3e2e9f8c061a0043941074a825852cbd2606a9666504a933bcad6eff1f09921"},{"excerpt":"Preparing our ESC. The Repository is a nuclear licensed and permitted site. The 2026 Environmental Safety Case is to be submitted to the Environment Agency on 1 May 2026. It demonstrates that mitigations do not detrimentally impact the area around the Repository, including local water sources, air quality, wildlife, and community wellbeing.","line_end":164,"line_start":157,"record_id":"esc_air_quality_context","sha256":"9a4780c197db93b2ac4da302aa6d8dceafe23a8ad096757d70758661918daccd"},{"excerpt":"A message from Mike. Operations at the LLW Repository are guided by operating safely while being a responsible neighbour. Around 200 trains are expected to deliver 175,000 tonnes of material. Using rail instead of road significantly reduces the impact on local traffic and cuts carbon emissions.","line_end":215,"line_start":208,"record_id":"repository_carbon_claim","sha256":"2a8166bdc644937827c23834f918a28df4bfe3281608a5f5289f3e91714daca8"}],"licence":"Open Government Licence v3.0","license_or_terms_url":"https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/","no_inferred_business_values":true,"prior_repo_evidence":{"blob_sha":"019ee8d1bd4b1627062e869f7377df6d82afaf4e","content_sha256":"38ab00ed7d20914d8114b8f46240a9716e82920c22f3ab41e09faeedadbe233d","path":"docs/chatgpt_status/gas_emissions/shards/gas_emissions_3/evidence/280_gas_emissions_3_rife30_appendix1_llwr_gaseous_ods_gate_20260803.json","supports_fields":["previous_NO_DATA_CONTINUE","next_unverified_step"]},"published_or_updated_date":"2026-03-26","publisher":"Nuclear Waste Services","snapshot_path":"docs/chatgpt_status/gas_emissions/shards/gas_emissions_3/source_snapshots/281_on_the_level_march_2026_llwr_carbon_20260803.json","snapshot_sha256":"7261c1388ba7ec96558dd85594ad690a43fe2ae6816f99c18e4c75f23b166c92","source_page_url":"https://www.gov.uk/government/publications/on-the-level-march-2026-issue-45/on-the-level-march-2026-issue-45","supports_fields":["publication_identity","Repository_site_context","rail_delivery_counts","avoided_HGV_movements","qualitative_carbon_reduction_claim","numeric_LLWR_CO2e_GHG_row_presence_or_absence"]},"source_head":"1f88cdef31d049be6bab3823df009503bc96994a","state":"DONE","status":"PUBLISHED_NO_DATA_CONTINUE","target_count":1,"task_id":"gas_emissions_3_on_the_level_march_2026_llwr_carbon_gate_batch_281_20260803","timeout_seconds":300,"updated_at":"2026-08-03T20:24:00Z","workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1"}