ate_20260802.py","script_py_compile":"PASS","script_relative_and_tracked":true,"script_self_test":"SELF_TEST_PASS","script_sha256":"bc41970ae5c18b043ef862ed44597cda5c8ecc866abdf5021c33b2103564c428","shard_index":2,"slot_id":"gas_emissions_2","source_branch":"codex/aays-single-runner-v5-20260706","source_evidence_manifest":[{"accessed_at":"2026-08-02T22:25:00Z","content_sha256":"cc1ac69ebea27123940aec06bae1a933643df44a7cbefd60bda7e22f9f9f244f","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://github.com/cagdascagdas100/chat_gpt_clone_1","publisher":"AAYS canonical GitHub branch","record_scope":"Three canonical sample rows and absent exact building identity.","relevant_record_ids_or_excerpt":"Three canonical Enfield Point carriers are parcel_30762 / HMLR INSPIRE 46058185 at -0.0407406,51.6769078; parcel_30763 / 46037757 at -0.052972,51.6767314; and parcel_30764 / 45981756 at -0.0482579,51.6776898. They lack exact building polygons, Overture GERS IDs and UPRNs.","source_blob_sha":"ce7bf324533ac073de9f11c767a2d77ba94cc448","source_id":"canonical_parcel_label_2_sample","source_url":"https://github.com/cagdascagdas100/chat_gpt_clone_1/blob/codex/aays-single-runner-v5-20260706/england_map_web/data/distance_property_types/parcel_label_2_canonical_sample_latest.json","supports_fields":["parcel_id","hmlr_inspire_id","longitude","latitude","london_authority","building_geometry_absent","gers_id_absent","uprn_absent"]},{"accessed_at":"2026-08-02T22:25:00Z","content_sha256":"10486c39791786cd28520ec0a8ee60f8162821cf3a222b64a934d4edd26748e5","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://docs.overturemaps.org/attribution/","publisher":"Overture Maps Foundation","record_scope":"Official STAC catalog and GeoParquet asset contract.","relevant_record_ids_or_excerpt":"Overture publishes a machine-readable STAC catalog that always points to the latest release and includes feature counts, spatial extents, column names and links to GeoParquet files on AWS and Azure. Core data is partitioned by theme and type and licensed under Overture attribution terms.","source_id":"overture_catalog_cloud_sources","source_url":"https://docs.overturemaps.org/getting-data/cloud-sources/","supports_fields":["STAC","latest_release","feature_counts","spatial_extent","columns","AWS_assets","Azure_assets","GeoParquet"]},{"accessed_at":"2026-08-02T22:25:00Z","content_sha256":"9c507934df0b5b2997f0a5456a14e8a3ab61311d22f27669cf18fc84e9b0319f","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://docs.overturemaps.org/attribution/","publisher":"Overture Maps Foundation","record_scope":"STAC root, building collection and per-file asset metadata.","relevant_record_ids_or_excerpt":"The Overture STAC root is https://stac.overturemaps.org/catalog.json and exposes a latest release. A building collection contains item links, feature count, ODbL-1.0 license, columns and per-file bboxes plus AWS and Azure Parquet paths.","source_id":"overture_stac_engineering_blog","source_url":"https://docs.overturemaps.org/blog/2026/02/11/stac/","supports_fields":["catalog_url","latest","building_collection","item_bbox","aws_href","azure_href","ODbL_1_0"]},{"accessed_at":"2026-08-02T22:25:00Z","content_sha256":"4c180ed3f0620943b4081f4f21b706a04d3991a51bd5a8f6d231756520395165","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://github.com/OvertureMaps/overturemaps-py/blob/main/LICENSE","publisher":"Overture Maps Foundation","record_scope":"Pinned official client implementation of STAC GeoParquet asset selection.","relevant_record_ids_or_excerpt":"The official Python client reads https://stac.overturemaps.org/catalog.json, obtains the latest release and reads https://stac.overturemaps.org/{release}/collections.parquet. It filters collection=building and Feature rows by bbox and extracts the AWS S3 asset href.","source_blob_sha":"63db0e154836f97557ac211b4cdf269358b3b362","source_id":"overturemaps_py_stac_index","source_url":"https://github.com/OvertureMaps/overturemaps-py/blob/main/overturemaps/core.py","supports_fields":["catalog_url","latest_release","collections_parquet","collection_filter","bbox_filter","aws_asset_href"]},{"accessed_at":"2026-08-02T22:25:00Z","content_sha256":"2fa0f0ab6b4b9c045d3f294f10039029c9508093edd9edb1cd8859e910955258","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://docs.overturemaps.org/attribution/","publisher":"Overture Maps Foundation","record_scope":"Official building fields and bbox semantics.","relevant_record_ids_or_excerpt":"The building dataset exposes id, Polygon or MultiPolygon geometry and a bbox struct with longitude/latitude xmin, ymin, xmax and ymax. A bbox-selected building is only a candidate and does not prove an HMLR parcel or UPRN identity.","source_id":"overture_buildings_guide","source_url":"https://docs.overturemaps.org/guides/buildings/","supports_fields":["building_id","geometry","bbox_xmin","bbox_ymin","bbox_xmax","bbox_ymax","candidate_not_exact_binding"]},{"accessed_at":"2026-08-02T22:25:00Z","content_sha256":"7b27785398748aede556881bf3618d43043e1c7af854b3c82f5f1ade63413b9e","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://www.apache.org/licenses/LICENSE-2.0","publisher":"Apache Software Foundation","record_scope":"Official Parquet footer/range-read structure.","relevant_record_ids_or_excerpt":"A Parquet file ends with File Metadata, a four-byte little-endian metadata length and the four-byte PAR1 magic. Readers first read the footer metadata to locate required column chunks, enabling bounded range access instead of downloading the full file.","source_id":"apache_parquet_file_format","source_url":"https://parquet.apache.org/docs/file-format/","supports_fields":["PAR1","footer_length_little_endian","file_metadata","column_chunk_locations","bounded_range_read"]}],"source_head":"12db3c76dcf01a0f4c0e04940ba904cca265f18c","state":"PUBLISHED_NO_DATA_CONTINUE","status":"published","target_branch":"codex/aays-single-runner-v5-20260706","task_id":"gas_emissions_2_official_technical_evidence_82_20260802","timeout_seconds":900,"updated_at":"2026-08-02T22:42:00Z","workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1"}
