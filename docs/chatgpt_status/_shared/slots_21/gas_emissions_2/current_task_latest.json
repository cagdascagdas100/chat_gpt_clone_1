_self_test":"SELF_TEST_PASS","script_sha256":"f2459aa50a5fca2004f67d432c0dfb868c1f9603b49bfd70f6a0d69f23064655","shard_index":2,"slot_id":"gas_emissions_2","source_branch":"codex/aays-single-runner-v5-20260706","source_evidence_manifest":[{"accessed_at":"2026-08-02T21:32:00Z","content_sha256":"51575a7a8c73bd8ac01becebed1e38dd72b7cd6d71d1d582f885d6163f364f19","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://github.com/cagdascagdas100/chat_gpt_clone_1","publisher":"AAYS canonical GitHub branch","record_scope":"Three canonical sample rows and missing exact building identity.","relevant_record_ids_or_excerpt":"Three canonical Enfield Point carriers are parcel_30762 / HMLR INSPIRE 46058185 at -0.0407406,51.6769078; parcel_30763 / 46037757 at -0.052972,51.6767314; and parcel_30764 / 45981756 at -0.0482579,51.6776898. They do not contain exact building polygons, Overture GERS IDs or UPRNs.","source_blob_sha":"ce7bf324533ac073de9f11c767a2d77ba94cc448","source_id":"canonical_parcel_label_2_sample","source_url":"https://github.com/cagdascagdas100/chat_gpt_clone_1/blob/codex/aays-single-runner-v5-20260706/england_map_web/data/distance_property_types/parcel_label_2_canonical_sample_latest.json","supports_fields":["parcel_id","hmlr_inspire_id","longitude","latitude","london_authority","building_geometry_absent","gers_id_absent","uprn_absent"]},{"accessed_at":"2026-08-02T21:32:00Z","content_sha256":"5a1bb495e08dd26c56df2685e7c03eb9e16452fcbb8dc0b89fe87ffe531a93d7","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://docs.overturemaps.org/attribution/","publisher":"Overture Maps Foundation","record_scope":"Current confirmed release and proposed-release boundary.","relevant_record_ids_or_excerpt":"At access time the official Overture release calendar identifies 2026-06-17.0 as the current release and lists 2026-07-22.0 as a proposed future release subject to change. Wave353 therefore queries the confirmed 2026-06-17.0 release.","source_id":"overture_release_calendar","source_url":"https://docs.overturemaps.org/release-calendar/","supports_fields":["current_release_2026_06_17_0","proposed_2026_07_22_0_not_confirmed"]},{"accessed_at":"2026-08-02T21:32:00Z","content_sha256":"105129239eb81c5af8b3924fee534d6c0715c745fb6d10d609e74849be6a04ab","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://docs.overturemaps.org/attribution/","publisher":"Overture Maps Foundation","record_scope":"Official S3 source-of-record path and cloud-native query contract.","relevant_record_ids_or_excerpt":"Overture publishes core map data as GeoParquet on Amazon S3 at s3://overturemaps-us-west-2/release/<RELEASE>. The official S3 and Azure distributions are the source of record, and DuckDB can query cloud files while transferring only requested data.","source_id":"overture_cloud_sources","source_url":"https://docs.overturemaps.org/getting-data/cloud-sources/","supports_fields":["official_s3","source_of_record","GeoParquet","DuckDB","partial_transfer"]},{"accessed_at":"2026-08-02T21:32:00Z","content_sha256":"af17b772f32ddb8e256a1984fe58fd805458b09bca7ece9ba403de6ca1aa3ed3","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://docs.overturemaps.org/attribution/","publisher":"Overture Maps Foundation","record_scope":"Official building query, release path and bbox-pruning pattern.","relevant_record_ids_or_excerpt":"The official DuckDB guide requires DuckDB 1.1.0 or newer plus httpfs for Amazon S3. It queries buildings from s3://overturemaps-us-west-2/release/2026-06-17.0/theme=buildings/type=building/* with hive_partitioning=1 and bbox filters.","source_id":"overture_duckdb_guide","source_url":"https://docs.overturemaps.org/getting-data/duckdb/","supports_fields":["duckdb_1_1_plus","httpfs","s3_region_us_west_2","building_path","hive_partitioning","bbox_filter"]},{"accessed_at":"2026-08-02T21:32:00Z","content_sha256":"9d80c95a17ee63fdf760082ae02b8b1c7f082f3f8263b7df7d0067c1d10630cf","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://github.com/duckdb/duckdb/blob/main/LICENSE","publisher":"DuckDB Foundation","record_scope":"DuckDB httpfs installation and S3 Parquet read contract.","relevant_record_ids_or_excerpt":"DuckDB documents that reading Parquet from S3 requires the httpfs extension, loaded with INSTALL httpfs and LOAD httpfs, followed by read_parquet on an s3:// path. Public file reads use HTTP range requests.","source_id":"duckdb_s3_parquet_import","source_url":"https://duckdb.org/docs/current/guides/network_cloud_storage/s3_import","supports_fields":["httpfs","INSTALL","LOAD","read_parquet","s3","HTTP_range_requests"]},{"accessed_at":"2026-08-02T21:32:00Z","content_sha256":"3f4922c1acdc1a3a42efb4f115ea01b812964b4907dbd56b0370daeb2c89d634","hash_scope":"normalized_source_excerpt_utf8","license_or_terms_url":"https://docs.overturemaps.org/attribution/","publisher":"Overture Maps Foundation","record_scope":"Building fields and bbox semantics.","relevant_record_ids_or_excerpt":"The buildings theme exposes id, geometry and a bbox struct whose xmin, ymin, xmax and ymax fields use longitude and latitude. Bbox filtering can produce nearby building candidates but does not prove HMLR parcel identity or UPRN.","source_id":"overture_buildings_guide","source_url":"https://docs.overturemaps.org/guides/buildings/","supports_fields":["building_id","geometry","bbox_xmin","bbox_ymin","bbox_xmax","bbox_ymax","candidate_not_identity"]}],"source_head":"8874a7b41ff6948f5e970b1b3c075d9602e41391","state":"PUBLISHED_NO_DATA_CONTINUE","status":"published","target_branch":"codex/aays-single-runner-v5-20260706","task_id":"gas_emissions_2_official_technical_evidence_81_20260802","timeout_seconds":900,"updated_at":"2026-08-02T21:40:00Z","workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1"}
