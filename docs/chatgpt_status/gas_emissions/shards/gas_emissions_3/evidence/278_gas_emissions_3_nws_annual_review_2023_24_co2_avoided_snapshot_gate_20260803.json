d":"gas_emissions_3","state":"ORGANISATION_REPOSITORY_LINKED_CO2_AVOIDED_ROW_VERIFIED","targets":[{"attempt_completed":true,"decision":"ORGANISATION_REPOSITORY_LINKED_CO2_AVOIDED_ROW_VERIFIED","matched_rows":1,"matches":[{"direct_site_emissions":false,"metric_type":"avoided_carbon_emissions_from_waste_diversion","period_source":"2023 to 2024","qualifier_source":"around","row_id":"NWS_REPOSITORY_DIVERSION_CO2_AVOIDED_2023_24","scope_source":"NWS waste diversion from disposal at the Repository site in Cumbria","source_record":{"line_end":330,"line_start":326,"record_id":"co2_avoided_metric","sha256":"85eeedceec6da986f6280c821394c9801d5fccdda6ba7e5af05911ce18e3cd46","text":"More than 1,600 tonnes of metal, around 3,000 metres cubed of combustible waste, and 5,000 metres cubed of very low level waste were all diverted for recycling. Overall, we’re diverting 98 per cent of waste from disposal at the Repository site in Cumbria. In the past year alone, this work has saved nearly £60m – on top of more than £900m saved through this work over the past decade. It’s benefiting the environment too; this work helped avoid around 20,000 tonnes of CO2 this year – the equivalent of more than 4,000 hot air balloons."},"unit_source":"tonnes CO2","value_source":"20,000"}],"organisation":"Nuclear Waste Services","site_name":"Low Level Waste Repository","target_id":"NWS_REPOSITORY_DIVERSION_CO2_AVOIDED_2023_24"}],"task_id":"gas_emissions_3_nws_annual_review_2023_24_co2_avoided_snapshot_gate_batch_278_20260803","workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1"}