{
  "schema_name": "aays_photo_ai_boundary_review_v1",
  "required_fields": [
    "row_id",
    "listing_url",
    "parcel_ref",
    "photo_urls",
    "photo_evidence_status",
    "photo_boundary_visible",
    "photo_shape_type",
    "existing_polygon_shape_type",
    "visual_match_score",
    "geometry_mismatch_flag",
    "confidence_before",
    "confidence_after",
    "ai_notes"
  ],
  "confidence_after_allowed_values": ["3/4", "3.25/4", "3.5/4", "3.75/4"],
  "upgrade_rule": "Allow 3.5/4 only when boundary is visible or marked and visual_match_score >= 0.75 with no mismatch flag.",
  "never_do": "Do not replace official parcel geometry using a listing photo alone."
}
