+from __future__ import annotations
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from app.api.routes import planned_assets as planned_assets_routes
+from app.db.session import get_db
+
+
+def _build_test_app() -> FastAPI:
+    app = FastAPI()
+    app.include_router(planned_assets_routes.router)
+    app.dependency_overrides[get_db] = lambda: object()
+    return app
+
+
+def test_planned_asset_parcel_layer_route_contract(monkeypatch):
+    app = _build_test_app()
+    captured = {}
+
+    def fake_layer(_db, **kwargs):
+        captured.update(kwargs)
+        return {
+            "type": "FeatureCollection",
+            "features": [
+                {
+                    "type": "Feature",
+                    "geometry": {
+                        "type": "Polygon",
+                        "coordinates": [[[-0.12, 51.50], [-0.11, 51.50], [-0.11, 51.51], [-0.12, 51.51], [-0.12, 51.50]]],
+                    },
+                    "properties": {
+                        "layer_kind": "planned_parcel",
+                        "parcel_id": 42,
+                        "planned_asset_count": 1,
+                        "top_title": "Sample planned structure",
+                        "top_asset_type": "transport",
+                        "top_delivery_probability_score": 78.0,
+                        "top_delivery_probability_label": "High",
+                        "top_source_confidence_score": 87.0,
+                        "top_value_impact_score": 64.0,
+                        "nearest_distance_m": 850.0,
+                        "evidence_summary": "Council evidence text",
+                        "source_url": "https://example.test/source",
+                    },
+                }
+            ],
+        }
+
+    monkeypatch.setattr(planned_assets_routes, "get_planned_asset_parcel_layer", fake_layer)
+
+    try:
+        response = TestClient(app).get(
+            "/planned-assets/parcel-layer?bbox=-0.2,51.4,0.0,51.6&limit=500&min_delivery_probability=50&asset_type=transport&status=approved"
+        )
+    finally:
+        app.dependency_overrides.clear()
+
+    assert response.status_code == 200
+    payload = response.json()
+    assert payload["type"] == "FeatureCollection"
+    assert payload["features"][0]["geometry"]["type"] == "Polygon"
+    assert payload["features"][0]["properties"]["layer_kind"] == "planned_parcel"
+    assert captured["bbox"] == "-0.2,51.4,0.0,51.6"
+    assert captured["limit"] == 500
+    assert captured["min_delivery_probability"] == 50
+    assert captured["asset_type"] == "transport"
+    assert captured["status_filter"] == "approved"
+
+
+def test_planned_asset_parcel_layer_invalid_bbox_returns_400():
+    app = _build_test_app()
+    try:
+        response = TestClient(app).get("/planned-assets/parcel-layer?bbox=bad")
+    finally:
+        app.dependency_overrides.clear()
+
+    assert response.status_code == 400
+    assert "bbox" in response.json()["detail"]
