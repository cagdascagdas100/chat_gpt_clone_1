{"schema_version":1,"architecture_version":3,"workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1","slot_id":"height_difference_3","task_id":"height_difference_3-canonical-api-measurement-20260721-01","continuation_key":"6e8e709b6bad7b9807055e2b8b5de98cd4945ee3dee57825e72ba1b824eadd0f","created_at":"2026-08-01T03:42:00Z","claim_commit_sha":"ca59e03b7323153aa3a1b0daa72f27d5ead446a3","state":"HMLR_INSPIRE_GEOMETRY_ID_VERSION_PUBLICATION_AND_DEDUP_GATE_QUALIFIED_RUNTIME_HELD","purpose":"Qualify fail-closed HM Land Registry INSPIRE polygon identity, publication version, GML geometry, CRS, lifecycle and deterministic spatial-join controls without executing the blocked portable runtime.","official_controls":[{"id":"HMLR_INSPIRE_SCOPE_ID_AND_TITLE_RELATION","source":"HM Land Registry Use land and property data","url":"https://use-land-property-data.service.gov.uk/datasets/inspire","role":"Primary polygon identity and scope","facts":["INSPIRE Index Polygons contain locations of freehold registered property in England and Wales","each polygon has a unique Land Registry-INSPIRE ID related to a registered title","one title can contain several separate polygons and each polygon has a separate INSPIRE ID","the polygons show indicative position and extent and do not establish the legal extent of a title"],"decision":"Bind exact INSPIRE ID, source title relation and freehold scope; treat each polygon as an independent spatial feature and never claim legal title extent from the INSPIRE geometry."},{"id":"HMLR_MONTHLY_RELEASE_AND_LOCAL_AUTHORITY_DUPLICATION","source":"HM Land Registry dataset and download service","url":"https://use-land-property-data.service.gov.uk/datasets/inspire/download","secondary_url":"https://use-land-property-data.service.gov.uk/datasets/inspire","role":"Publication snapshot and duplicate control","facts":["the current download page states the dataset was published on 5 July 2026","new files are published on the first Sunday of every month and contain data from the previous month","files are divided by local authority","a polygon on a local-authority boundary appears in both authority files"],"decision":"Pin publication date, effective month, local-authority file name and file hash; deduplicate boundary copies by stable INSPIRE ID plus canonical geometry hash rather than source-row count."},{"id":"HMLR_GML_BNG_AND_REPROJECTION_CONTROL","source":"HM Land Registry technical guidance for GML files","url":"https://use-land-property-data.service.gov.uk/datasets/inspire/tech-guidance","role":"Encoding and CRS safety","facts":["HMLR publishes the data as GML using an open standard","HMLR polygon coordinates are captured against British National Grid","the native CRS is EPSG:27700","reprojection to web-map CRSs may shift features by up to 15 metres"],"decision":"Parse and measure in native EPSG:27700; record GML namespace, srsName, source geometry hash and any transformation pipeline; forbid web-map or EPSG:3857 geometry for parcel measurement."},{"id":"HMLR_INDEX_POLYGON_LIFECYCLE_MODEL","source":"HM Land Registry National Polygon dataset technical specification","url":"https://use-land-property-data.service.gov.uk/datasets/nps/tech-spec/1?back=true","role":"Lifecycle and feature model cross-check","facts":["INSPIRE polygons are a subset of the National Polygon Dataset with simpler identifier, create-date and last-update attributes","an index polygon has a unique polygon identifier managed through lifecycle rules","the National Polygon model defines INSERT, UPDATE, Vers_No and Rec_Status lifecycle fields","the geometry of an index polygon is defined as a single area in the National Polygon specification"],"decision":"Preserve every lifecycle attribute actually present in the INSPIRE GML; do not invent National Polygon fields that are absent, but reject identifier reuse, date regression or contradictory lifecycle evidence when cross-check data exists."},{"id":"HMLR_INDICATIVE_EXTENT_AND_ACCURACY_LIMITS","source":"HM Land Registry INSPIRE guidance and public data accuracy statement","url":"https://www.gov.uk/guidance/inspire-index-polygons-spatial-data","secondary_url":"https://www.gov.uk/government/publications/hm-land-registry-data/public-data","role":"Meaning and accuracy boundary","facts":["INSPIRE polygons show indicative position and extent","the legal extent can only be identified from the individual title plan","HMLR uses quality processes and reasonable skill and care but does not guarantee fitness for a particular purpose","index polygons may follow OS MasterMap features, while ownership boundaries do not always follow mapped features"],"decision":"Use geometry only for deterministic candidate matching and raster sampling masks; publish no legal-boundary assertion and fail closed on ambiguous overlaps, slivers or topology repairs that change area materially."},{"id":"INSPIRE_CADASTRAL_PARCEL_SCHEMA_VALIDATION","source":"European Commission INSPIRE Knowledge Base","url":"https://knowledge-base.inspire.ec.europa.eu/cadastral-parcels_en","secondary_url":"https://knowledge-base.inspire.ec.europa.eu/tools/xml-schemas_en","role":"Schema and feature-type validation","facts":["Cadastral parcels are an INSPIRE Annex I theme","the official knowledge base provides UML models, XSD schemas and mapping tables","GML application schemas are the default encoding for INSPIRE spatial themes","maintained schema versions must be identified rather than assumed"],"decision":"Record schema and namespace versions, validate GML before extraction, retain feature identifiers and CRS declarations, and reject malformed, empty or schema-incompatible geometry without automatic numeric promotion."}],"quality_checks":[{"index":1,"group":"HMLR_INSPIRE_SCOPE_ID_AND_TITLE_RELATION","check":"official_hmlr_provider","result":"PASS"},{"index":2,"group":"HMLR_INSPIRE_SCOPE_ID_AND_TITLE_RELATION","check":"freehold_scope_recorded","result":"PASS"},{"index":3,"group":"HMLR_INSPIRE_SCOPE_ID_AND_TITLE_RELATION","check":"england_