{"schema_version":1,"architecture_version":3,"workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1","slot_id":"height_difference_3","task_id":"height_difference_3-canonical-api-measurement-20260721-01","continuation_key":"6e8e709b6bad7b9807055e2b8b5de98cd4945ee3dee57825e72ba1b824eadd0f","created_at":"2026-08-01T12:24:00Z","claim_commit_sha":"653794978cba04a0424586f42ea92661ac913b67","state":"DTM_PROCESSING_VOID_FILL_SPIKE_PIT_SLOPE_ROUGHNESS_AND_WATER_ARTEFACT_GATE_QUALIFIED_RUNTIME_HELD","purpose":"Qualify ground-classification limits, fill/resampling provenance, local spike/pit and terrain derivatives, water/tidal handling and robust artefact sensitivity without executing blocked runtime or promoting numeric values.","official_controls":[{"id":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","sources":["https://environment.data.gov.uk/dataset/13787b9a-26a4-4775-8523-806d13af58fc","https://environment.data.gov.uk/dataset/dbadf364-0192-4bcf-a223-f3d403f08682","https://environment.data.gov.uk/support/faqs/275879146/302907800"],"facts":["EA describes the DTM as a ground-surface model produced from last or only returns after automated classification and manual editing.","Removing buildings and vegetation is a processing objective, not proof that every local artefact has been eliminated.","EA quality specifications state absolute vertical RMSE below 15 cm and relative/random error expectations, but parcel-scale spikes or pits still require local diagnostics."],"decision":"Persist the survey/product identity, ground-classification provenance and local residual diagnostics; do not infer artefact-free terrain solely from the DTM label or global RMSE."},{"id":"EA_VOID_FILL_RESAMPLING_AND_INTERPOLATION_PROVENANCE","sources":["https://environment.data.gov.uk/dataset/2e8d0733-4f43-48b4-9e51-631c25d1b0a9","https://environment.data.gov.uk/dataset/13787b9a-26a4-4775-8523-806d13af58fc","https://gdal.org/en/stable/programs/gdal_fillnodata.html"],"facts":["EA states that no-data areas such as water bodies may be filled and that resampled composite data may use bilinear interpolation.","GDAL fill-nodata can use inverse-distance or nearest strategies with a configurable search distance and smoothing iterations.","Filled or resampled cells can alter local extrema and therefore P05-P95 unless the fill mask and parameters are recorded."],"decision":"Record original nodata mask, filled-cell mask, interpolation strategy, search distance, smoothing, source and output hashes, and exclude or sensitivity-test filled cells before promotion."},{"id":"LOCAL_SLOPE_TRI_ROUGHNESS_SPIKE_AND_PIT_DIAGNOSTICS","sources":["https://gdal.org/en/stable/programs/gdal_raster_slope.html","https://gdal.org/en/stable/programs/gdal_raster_tri.html","https://gdal.org/en/stable/programs/gdal_raster_roughness.html"],"facts":["GDAL slope derives local gradient from elevation.","TRI measures the difference between a central cell and surrounding cells.","Roughness is the largest inter-cell difference between a central cell and neighbours."],"decision":"Compute hash-bound slope, TRI, roughness, local-median residual, spike and pit masks using explicit edge and nodata policies; require the promotion decision to remain stable when flagged cells are excluded."},{"id":"WATER_SURFACE_HYDROLOGIC_AND_TIDAL_EDGE_HANDLING","sources":["https://docs.os.uk/os-downloads/height-and-imagery/os-terrain-50/os-terrain-50-overview/source-data","https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-overview/data-structure","https://environment.data.gov.uk/dataset/36e7f4d3-61b2-4e64-aaa2-2b85bceb61a9"],"facts":["OS states inland water surfaces are modelled flat and tidal areas can contain small discrete steps between adjacent tiles.","EA documents hydro-enforced derivatives because ordinary DTM surfaces can contain non-real-world flow obstructions.","Water fill, shoreline interpolation and tile-edge tidal representation can create valid product behaviour that is unsuitable for parcel relief without explicit classification."],"decision":"Record water/tidal intersection, flat-water and shoreline masks, hydro-enforcement status, tile-edge distance and cross-tile step diagnostics; return INCONCLUSIVE where relief is dominated by filled or tidal-water cells."},{"id":"ROBUST_ARTEFACT_SENSITIVITY_AND_CONFORMITY_DECISION","sources":["https://numpy.org/doc/stable/reference/generated/numpy.percentile.html","https://www.itl.nist.gov/div898/handbook/eda/section3/eda35h.htm","https://www.itl.nist.gov/div898/handbook/eda/section3/eda35h1.htm"],"facts":["Percentile output depends on the selected method and ordered observations.","Robust outlier diagnostics should be evaluated against local distribution and scale rather than a single universal elevation threshold.","Removing or replacing suspicious cells can change a tail-based P05-P95 statistic, so the acceptance rule must compare baseline and sensitivity states."],"decision":"Persist ordered-vector and diagnostic hashes, use local robust residuals and deterministic exclusion/replacement sensitivity, and emit PASS, FAIL or INCONCLUSIVE without inventing a universal slope or height threshold."}],"repository_controls":[{"id":"AAYS_013_WCS_PRODUCT_PROVENANCE_AND_FILL_MASK_GAP","path":"docs/chatgpt_status/topography/shards/height_difference_3/automation/013_fetch_ea_dtm_wcs_for_matches.py","sha":"53c7371701f4f3495a4712b472a3a45f1f4fed12","facts":["The fetcher validates official host, coverage identity, CRS, resolution, dimensions and parcel intersection.","It records dataset nodata but does not record source survey identity, original valid mask, filled-cell provenance, resampling/fill algorithm or water classification.","It therefore cannot distinguish measured ground cells from source-filled or resampled cells."],"decision":"Preserve the pinned fetcher and require a supplementary DTM processing and fill-provenance manifest."},{"id":"AAYS_009_LOCAL_ARTEFACT_AND_ROBUSTNESS_GAP","path":"docs/chatgpt_status/topography/shards/height_difference_3/automation/009_sample_ea_dtm_and_os_terrain50.py","sha":"42ac87801263b6b94532c0897dbb5211b79ebeb1","facts":["The measurement script checks finite elevation range and computes P05-P95 from accepted EA cells.","It does not calculate slope, TRI, roughness, local-median residual, spike/pit masks, water dominance or filled-cell sensitivity.","It can therefore produce a mathematically valid percentile from a locally unstable or processing-dominated surface."],"decision":"Require a per-candidate terrain-artefact stability manifest and fail closed when exclusion/replacement or water/fill sensitivity changes the promotion state."}],"quality_checks":[{"index":1,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"official_ea_dtm_ground_model_bound","result":"PASS"},{"index":2,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"classification_and_manual_editing_bound","result":"PASS"},{"index":3,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"global_rmse_not_local_proof_bound","result":"PASS"},{"index":4,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"source_survey_identity_required","result":"PASS"},{"index":5,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"classification_provenance_required","result":"PASS"},{"index":6,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"local_residual_diagnostics_required","result":"PASS"},{"index":7,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"ground_truth_linkage_required","result":"PASS"},{"index":8,"group":"EA_DTM_CLASSIFICATION_MANUAL_EDITING_AND_GROUND_MODEL_LIMITS","check":"candidate_ground_model_readback","result":"HELD_RUNTIME"},{"index":9,"group":"EA_VOID_FILL_RESAMPLING_AND_INTERPOLATION_PROVENANCE","check":"official_void_fill_and_resampling_bound","result":"PA