{"schema_version":1,"architecture_version":3,"workstream_id":"AAYS_21_SLOT_SAFE_PARALLEL_V1","slot_id":"height_difference_3","task_id":"height_difference_3-canonical-api-measurement-20260721-01","continuation_key":"6e8e709b6bad7b9807055e2b8b5de98cd4945ee3dee57825e72ba1b824eadd0f","created_at":"2026-08-01T06:10:00Z","claim_commit_sha":"0d998db6da2b9460eb64f241816c32ffeb967419","state":"OSTN15_OSGM15_COMPOUND_CRS_VERTICAL_DATUM_AND_UNCERTAINTY_GATE_QUALIFIED_RUNTIME_HELD","purpose":"Qualify fail-closed horizontal and vertical datum identity, compound CRS, OSGM15 grid operation, local datum exceptions, round-trip evidence and cross-source uncertainty controls without executing the blocked portable runtime.","official_controls":[{"id":"OS_NATIONAL_OSTN15_OSGM15_TRANSFORMATION_STANDARD","source":"Ordnance Survey coordinate transformations","url":"https://www.ordnancesurvey.co.uk/geodesy-positioning/coordinate-transformations","facts":["OSTN15 links ETRS89 positions to OSGB36 British National Grid","OSGM15 links ellipsoid height to mean-sea-level based height datums","OSTN15 and OSGM15 are the current national standard models","OSTN15 and OSGM15 replaced OSTN02 and OSGM02 in August 2016"],"decision":"Require current OSTN15 and OSGM15 operations; reject Helmert-only, OSTN02, OSGM02, ballpark or unknown vertical transformations."},{"id":"OS_OSGM15_DATUM_DOMAIN_INTERPOLATION_AND_ACCURACY","source":"Ordnance Survey National Geoid Model OSGM15","url":"https://docs.os.uk/more-than-maps/deep-dive/a-guide-to-coordinate-systems-in-great-britain/from-one-coordinate-system-to-another-geodetic-transformations/national-geoid-model-osgm15-etrs89-orthometric-height","facts":["OSGM15 converts ETRS89 ellipsoid height to orthometric height","mainland Britain output is Ordnance Datum Newlyn","the model also contains local island datums and ODN Offshore","the geoid grid has one-kilometre spacing and uses bilinear interpolation","nominal RMS accuracy is 8mm on mainland Britain, better than 2cm in other covered areas and 3cm for the Isle of Man"],"decision":"Classify the datum domain for every candidate, record interpolation cell and accuracy class, and fail closed on missing or mismatched local/offshore datum identity."},{"id":"OS_EPSG_COMPOUND_CRS_AND_OPERATION_IDENTIFIERS","source":"Ordnance Survey datum and EPSG identifier guide","url":"https://docs.os.uk/more-than-maps/a-guide-to-coordinate-systems-in-great-britain/datum-ellipsoid-and-projection-information","secondary_url":"https://epsg.org/crs/wkt/id/7405","facts":["EPSG:27700 identifies OSGB36 British National Grid","EPSG:5701 identifies ODN height","EPSG:7405 is the compound OSGB36 British National Grid plus ODN height CRS","EPSG:7711 identifies the OSGM15 transformation to ODN","separate EPSG operations exist for Orkney, offshore, Lerwick, Stornoway, St Marys and Douglas datum domains"],"decision":"Persist horizontal CRS, vertical CRS, compound CRS and exact coordinate-operation identifiers separately; never infer ODN solely from EPSG:27700."},{"id":"PROJ_VERTICAL_GRID_SHIFT_OPERATION_CONTRACT","source":"PROJ vertical grid shift documentation","url":"https://proj.org/en/stable/operations/transformations/vgridshift.html","facts":["vgridshift changes vertical datum using offsets from a loaded grid","vertical input and output are in metres","multiple grids may be configured with precedence","an optional-grid marker can allow a missing local grid to be skipped"],"decision":"Forbid optional or silently missing OSGM15 grids; record grid path, SHA-256, operation definition, direction and transformed height, and require the selected local grid to be available."},{"id":"OS_TERRAIN50_COMPOUND_REFERENCE_ALIGNMENT","source":"OS Terrain 50 metadata specification","url":"https://docs.os.uk/os-downloads/products/land-and-terrain-portfolio/os-terrain-50/os-terrain-50-technical-specification/metadata","facts":["Terrain 50 metadata identifies British National Grid EPSG:27700","Terrain 50 metadata identifies Ordnance Datum Newlyn EPSG:5701","tile metadata contains earliest and latest flying dates"],"decision":"Treat Terrain 50 values as compound horizontal-plus-vertical coordinates; require exact metadata readback and reject comparison to an EA value whose vertical datum or domain differs."}],"repository_contract_control":{"id":"AAYS_HORIZONTAL_ONLY_OSTN15_GATE_VERTICAL_GAP","source_paths":["docs/chatgpt_status/topography/shards/height_difference_3/automation/027_verify_batch116_proj_ostn15_gate.py","docs/chatgpt_status/topography/shards/height_difference_3/automation/034_verify_candidate_manifest_proj_ostn15_gate.py"],"source_blob_shas":["e5c8e0c78904695fe25683e6ca479fa6fb06a0ea","a7c94f8f2c9d4f82540f68e35cbb718cfd00cc6e"],"facts":["both existing gates transform EPSG:27700 to EPSG:4326","both require the OSTN15 horizontal grid and forbid ballpark operations","neither gate declares a vertical CRS, OSGM15 grid, orthometric height transform or compound CRS","the measurement script labels vertical reference textually but does not emit a candidate-specific vertical operation readback"],"decision":"Preserve existing horizontal gates and add a separate runtime vertical-datum manifest; do not reinterpret a successful display transform as proof that heights share ODN."},"quality_checks":[{"index":1,"group":"OS_NATIONAL_OSTN15_OSGM15_TRANSFORMATION_STANDARD","check":"official_os_provider","result":"PASS"},{"index":2,"group":"OS_NATIONAL_OSTN15_OSGM15_TRANSFORMATION_STANDARD","check":"ostn15_horizontal_role_recorded","result":"PASS"},{"index":3,"group":"OS_NATIONAL_OSTN15_OSGM15_TRANSFORMATION_STANDARD","check":"osgm15_vertical_role_recorded","result":"PASS"},{"index":4,"group":"OS_NATIONAL_OSTN15_OSGM15_TRANSFORMATION_STANDARD","check":"current_models_required","result":"PASS"},{"index":5,"group":"OS_NATIONAL_OSTN15_OSGM15_TRANSFORMATION_STANDARD","check":"ostn02_forbidden","result":"PASS"},{"index":6,"group":"OS_NATIONAL_OSTN15_OSGM15_TRANSFORMATION_STANDARD","check":"osgm02_forbid